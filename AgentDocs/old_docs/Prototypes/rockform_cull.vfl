// Stage 2: paste into an Attribute Wrangle, Run Over = Detail (only once).
// Input 0: rockform_network shared polygon network. No guide is required.
// use_guide = 0 (default): sculpt a procedural formation envelope.
// use_guide = 1: use an explicit closed polygon guide on input 1 instead.
// formation: 0 monolith, 1 inclined outcrop, 2 unequal columns, 3 low shelf.
// Start: formation 0, seed 17, bulk .3, taper .4, shoulders .4,
// lean .15, erosion .45, strata_frequency 5, selection 0.
// Zero-valued new controls still produce a complete baseline formation.
// keep_islands = 0 retains the largest face-connected procedural cluster;
// enable it to retain detached cells. Guide mode preserves all selected components.
// Each source face occurs once, wound from cell_a toward cell_b (-1 = exterior).
// rf_cell_sites: detail vector[] of interior seeds; rf_cell_active: detail int[].
// Both inputs and seed positions must use the same SOP coordinate space.
// Create integer parameter Selection (selection), default 0:
//   0 = seed inside; 1 = any cell vertex inside; 2 = all cell vertices inside.
// These are discrete whole-cell tests, NOT envelope-surface clipping.
// The envelope selects the silhouette; existing fracture surfaces form the skin.
// More network cells give finer boundary control; parameters do not slice new faces.
// Any-vertex selection is NOT a true cell/guide volume-intersection test.
// Output: welded boundary of retained cells, with outward hard vertex normals.
// Output cell_a is the retained cell; cell_b is the discarded neighbor or -1.
// piece/name identify the retained cell, not a connected component.

function float rf_shape_random(int seed; int stream)
{
    float value = rand(set(float(seed), float(stream), 73.0));
    return value;
}

// Signed occupancy field for a leaning, tapered, faceted mass (not a metric SDF).
// Dimensions are half-width, full height, half-depth; the base anchors it to ground.
function float rf_rock_mass(
    vector p;
    vector base;
    vector dimensions;
    float taper;
    vector lean;
    vector roof;
    float angle)
{
    vector q = p - base;
    float height = q.y / dimensions.y;
    float t = clamp(height, 0, 1);
    float width_scale = 1.0 - taper * t;
    float x = (q.x - lean.x * t) / (dimensions.x * width_scale);
    float z = (q.z - lean.z * t) / (dimensions.z * width_scale);
    float u = x * cos(angle) - z * sin(angle);
    float v = x * sin(angle) + z * cos(angle);
    float sides = max(max(abs(u), abs(v)), (abs(u) + abs(v)) * .70710678118) - 1;
    float crown = (q.y - dimensions.y + roof.x * q.x + roof.z * q.z) / dimensions.y;
    return max(sides, max(crown, -height));
}

// Composition, then erosion: a dominant mass, subordinate shoulders, a grounded
// toe, and a shared cleavage direction. No independent random deletion of cells.
function float rf_formation_field(
    vector p;
    int formation;
    int seed;
    float bulk;
    float taper;
    float shoulders;
    float lean;
    float erosion;
    float strata_frequency)
{
    float width = .95 + bulk * .35;
    float phase = fit01(rf_shape_random(seed, 1), -.3, .3);
    float main_x = -.16 + fit01(rf_shape_random(seed, 2), -.08, .08);
    float main_z = fit01(rf_shape_random(seed, 3), -.08, .08);
    vector bend = set(.35 * lean + fit01(rf_shape_random(seed, 4), -.08, .08),
        0, fit01(rf_shape_random(seed, 5), -.06, .06));
    vector roof = set(fit01(rf_shape_random(seed, 6), -.28, .28), 0,
        fit01(rf_shape_random(seed, 7), -.2, .2));
    float narrowing = .22 + taper * .4;
    float field;

    if (formation == 0)
    {
        field = rf_rock_mass(p, set(main_x, -.98, main_z),
            set(.59 * width, 1.86, .59 * width), narrowing, bend, roof, phase);
        float shoulder = rf_rock_mass(p, set(.46, -.98, .1),
            set(.36 * width, .7 + shoulders * .65, .45 * width),
            narrowing * .65, bend * .5, set(.28, 0, -.12), phase + .1);
        float buttress = rf_rock_mass(p, set(-.46, -.98, .36),
            set(.32 * width, .52 + shoulders * .45, .35 * width),
            narrowing * .55, bend * .25, set(-.2, 0, .12), phase - .12);
        field = min(field, min(shoulder, buttress));
    }
    else if (formation == 1)
    {
        // A high back/left face descends into a long lower shoulder.
        field = rf_rock_mass(p, set(-.16, -.98, -.08),
            set(.8 * width, 1.55, .65 * width), narrowing * .7,
            bend, set(.68, 0, .2), phase);
        float shoulder = rf_rock_mass(p, set(.46, -.98, .18),
            set(.48 * width, .55 + shoulders * .38, .54 * width),
            narrowing * .5, bend * .25, set(.4, 0, .08), phase);
        field = min(field, shoulder);
    }
    else if (formation == 2)
    {
        // Unequal attached pillars, not equal-height bars or a rounded blob.
        field = rf_rock_mass(p, set(-.25, -.98, -.04),
            set(.42 * width, 1.92, .52 * width), narrowing,
            bend, roof, phase);
        float right = rf_rock_mass(p, set(.33, -.98, .09),
            set(.35 * width, 1.05 + shoulders * .45, .47 * width),
            narrowing * .6, bend * .65, set(.22, 0, -.08), phase + .12);
        float left = rf_rock_mass(p, set(-.62, -.98, .25),
            set(.29 * width, .6 + shoulders * .38, .33 * width),
            narrowing * .45, bend * .3, set(-.18, 0, .16), phase - .08);
        field = min(field, min(right, left));
    }
    else
    {
        field = rf_rock_mass(p, set(0, -.98, .02),
            set(.86 * width, .5, .76 * width), narrowing * .3,
            bend * .2, set(.12, 0, .08), phase);
        float raised = rf_rock_mass(p, set(-.32, -.98, -.16),
            set(.47 * width, .75 + shoulders * .35, .49 * width),
            narrowing * .55, bend * .35, set(.25, 0, -.12), phase - .1);
        field = min(field, raised);
    }

    float toe = rf_rock_mass(p, set(.02, -.99, .12),
        set(.82 * width, .28 + shoulders * .12, .68 * width),
        .2, set(0, 0, 0), set(.1, 0, .08), phase);
    field = min(field, toe);

    // Weak beds retreat on the exposed face; the back spine and foot stay intact.
    float bedding = p.y + .2 * p.x + .08 * p.z;
    float band = .5 + .5 * cos(bedding * strata_frequency * 3.14159265359 + phase * 3);
    float exposure = smooth(-.15, .65, p.z) * smooth(-.65, .2, p.y);
    field += erosion * .16 * pow(band, 5.0) * exposure;

    // One directional, shallow fracture notch. It grows from outside the front,
    // rather than drilling random holes throughout the interior.
    if (erosion > 0)
    {
        float notch = max(abs(p.x + .22 * p.y - .08) - .11 * erosion,
            .9 - .62 * erosion - p.z);
        notch = max(notch, -.55 - p.y);
        field = max(field, -notch);
    }
    return field;
}

int source_prim_count = nprimitives(0);
int source_point_count = npoints(0);
if (source_prim_count == 0)
{
    error("rockform_cull: input 0 requires a shared polygon cell network.");
    return;
}
int use_guide = chi("use_guide");
if (use_guide && nprimitives(1) == 0)
{
    error("rockform_cull: Use Guide is enabled; connect a closed polygon guide to input 1.");
    return;
}
int formation = chi("formation");
if (!use_guide && (formation < 0 || formation > 3))
{
    error("rockform_cull: Formation must be 0 monolith, 1 outcrop, 2 columns, or 3 shelf.");
    return;
}
int seed = chi("seed");
float bulk = clamp(chf("bulk"), 0, 1);
float taper = clamp(chf("taper"), 0, 1);
float shoulders = clamp(chf("shoulders"), 0, 1);
float lean = clamp(chf("lean"), -1, 1);
float erosion = clamp(chf("erosion"), 0, 1);
float strata_frequency = max(1.0, chf("strata_frequency"));
vector bmin, bmax;
getbbox(0, bmin, bmax);
vector envelope_center = (bmin + bmax) * .5;
vector envelope_halfsize = (bmax - bmin) * .5;
if (min(envelope_halfsize.x, min(envelope_halfsize.y, envelope_halfsize.z)) <= 0)
{
    error("rockform_cull: the fracture network must have nonzero bounds on all axes.");
    return;
}
if (!hasprimattrib(0, "cell_a") || !hasprimattrib(0, "cell_b"))
{
    error("rockform_cull: input 0 requires primitive int cell_a and cell_b.");
    return;
}
if (!hasdetailattrib(0, "rf_cell_sites") ||
    !hasdetailattrib(0, "rf_cell_active"))
{
    error("rockform_cull: input 0 requires detail arrays rf_cell_sites and rf_cell_active.");
    return;
}

int selection = chi("selection");
if (selection < 0 || selection > 2)
{
    error("rockform_cull: Selection must be 0 (seed), 1 (any vertex), or 2 (all vertices).");
    return;
}

vector sites[] = detail(0, "rf_cell_sites");
int active[] = detail(0, "rf_cell_active");
int cell_count = len(sites);
if (cell_count == 0 || len(active) != cell_count)
{
    error("rockform_cull: cell detail arrays must have equal, nonzero lengths.");
    return;
}

int kept[];
resize(kept, cell_count);
for (int cell = 0; cell < cell_count; ++cell)
{
    if (active[cell] != 0 && active[cell] != 1)
    {
        error("rockform_cull: rf_cell_active must contain only 0 or 1.");
        return;
    }
    kept[cell] = 0;
    if (!active[cell])
        continue;
    if (selection == 0)
    {
        if (use_guide)
            kept[cell] = abs(windingnumber(1, sites[cell])) >= 0.5;
        else
        {
            vector p = (sites[cell] - envelope_center) / envelope_halfsize;
            kept[cell] = rf_formation_field(p, formation, seed, bulk, taper,
                shoulders, lean, erosion, strata_frequency) <= 0;
        }
    }
    else if (selection == 2)
        kept[cell] = 1;
}

// Snapshot source positions/topology before building or requesting deletion.
vector positions[];
int point_inside[];
int point_map[];
resize(positions, source_point_count);
resize(point_inside, source_point_count);
resize(point_map, source_point_count);
for (int pt = 0; pt < source_point_count; ++pt)
{
    positions[pt] = point(0, "P", pt);
    point_map[pt] = -1;
    if (selection != 0)
    {
        if (use_guide)
            point_inside[pt] = abs(windingnumber(1, positions[pt])) >= 0.5;
        else
        {
            vector p = (positions[pt] - envelope_center) / envelope_halfsize;
            point_inside[pt] = rf_formation_field(p, formation, seed, bulk, taper,
                shoulders, lean, erosion, strata_frequency) <= 0;
        }
    }
}

int face_offsets[];
int face_points[];
int face_a[];
int face_b[];
vector face_normals[];
int cell_seen[];
resize(cell_seen, cell_count);
append(face_offsets, 0);
for (int face = 0; face < source_prim_count; ++face)
{
    int a = prim(0, "cell_a", face);
    int b = prim(0, "cell_b", face);
    if (a < 0 || a >= cell_count || b < -1 || b >= cell_count || a == b)
    {
        error("rockform_cull: invalid cell adjacency on primitive %d.", face);
        return;
    }

    string primitive_type = primintrinsic(0, "typename", face);
    int closed = primintrinsic(0, "closed", face);
    int pts[] = primpoints(0, face);
    int vertex_count = len(pts);
    if (primitive_type != "Poly" || !closed || vertex_count < 3)
    {
        error("rockform_cull: primitive %d must be a closed polygon with at least 3 vertices.", face);
        return;
    }

    int face_any = 0;
    int face_all = 1;
    vector origin = positions[pts[0]];
    float position_scale = 0.0;
    foreach (int pt; pts)
    {
        append(face_points, pt);
        if (selection != 0)
        {
            face_any = face_any || point_inside[pt];
            face_all = face_all && point_inside[pt];
        }
        vector delta = positions[pt] - origin;
        position_scale = max(position_scale,
            max(abs(delta.x), max(abs(delta.y), abs(delta.z))));
    }

    // Sum signed triangle areas, not just the first three (possibly collinear)
    // vertices. Translation/scaling reduce cancellation and overflow/underflow.
    vector area = {0, 0, 0};
    if (position_scale > 0.0)
    {
        for (int vertex = 1; vertex < vertex_count - 1; ++vertex)
        {
            vector u = (positions[pts[vertex]] - origin) / position_scale;
            vector v = (positions[pts[vertex + 1]] - origin) / position_scale;
            area += cross(u, v);
        }
    }
    float area_scale = max(abs(area.x), max(abs(area.y), abs(area.z)));
    if (!(area_scale > 0.0))
    {
        error("rockform_cull: primitive %d has zero polygon area.", face);
        return;
    }
    append(face_normals, normalize(area / area_scale));
    append(face_offsets, len(face_points));
    append(face_a, a);
    append(face_b, b);

    int neighbors[] = array(a, b);
    foreach (int cell; neighbors)
    {
        if (cell < 0)
            continue;
        cell_seen[cell] = 1;
        if (!active[cell])
            continue;
        // Repeated shared vertices do not change these OR/AND reductions.
        if (selection == 1)
            kept[cell] = kept[cell] || face_any;
        else if (selection == 2)
            kept[cell] = kept[cell] && face_all;
    }
}

int kept_count = 0;
for (int cell = 0; cell < cell_count; ++cell)
{
    if (active[cell] && !cell_seen[cell])
    {
        error("rockform_cull: active cell %d has no network faces.", cell);
        return;
    }
    kept_count += kept[cell];
}

// A formation is a coherent mass, not stray cells left by the occupancy test.
// Only procedural mode applies this policy; explicit guides keep their components.
int removed_islands = 0;
if (!use_guide && !chi("keep_islands") && kept_count > 0)
{
    int component[] = {};
    resize(component, cell_count);
    for (int cell = 0; cell < cell_count; cell++)
        component[cell] = -1;
    int best_component = -1;
    int best_count = 0;
    float best_floor = 1e18;
    for (int root = 0; root < cell_count; root++)
    {
        if (!kept[root] || component[root] >= 0)
            continue;
        int queue[] = array(root);
        component[root] = root;
        float floor_y = sites[root].y;
        for (int head = 0; head < len(queue); head++)
        {
            int cell = queue[head];
            floor_y = min(floor_y, sites[cell].y);
            for (int face = 0; face < len(face_a); face++)
            {
                int neighbor = -1;
                if (face_a[face] == cell)
                    neighbor = face_b[face];
                else if (face_b[face] == cell)
                    neighbor = face_a[face];
                if (neighbor < 0)
                    continue;
                if (!kept[neighbor] || component[neighbor] >= 0)
                    continue;
                component[neighbor] = root;
                append(queue, neighbor);
            }
        }
        if (len(queue) > best_count || (len(queue) == best_count && floor_y < best_floor))
        {
            best_component = root;
            best_count = len(queue);
            best_floor = floor_y;
        }
    }
    for (int cell = 0; cell < cell_count; cell++)
    {
        if (kept[cell] && component[cell] != best_component)
        {
            kept[cell] = 0;
            removed_islands++;
        }
    }
    kept_count -= removed_islands;
}

addvertexattrib(0, "N", {0, 0, 0});
setattribtypeinfo(0, "vertex", "N", "normal");
for (int face = 0; face < source_prim_count; ++face)
{
    int a = face_a[face];
    int b = face_b[face];
    int keep_a = kept[a];
    int keep_b = 0;
    if (b >= 0)
        keep_b = kept[b];
    if (keep_a == keep_b)
        continue;

    int reverse_face = !keep_a;
    int owner = reverse_face ? b : a;
    int neighbor = reverse_face ? a : b;
    vector normal = reverse_face ? -face_normals[face] : face_normals[face];
    int output_prim = addprim(0, "poly");
    int start = face_offsets[face];
    int vertex_count = face_offsets[face + 1] - start;
    for (int vertex = 0; vertex < vertex_count; ++vertex)
    {
        int source_vertex = reverse_face ? vertex_count - 1 - vertex : vertex;
        int source_point = face_points[start + source_vertex];
        int output_point = point_map[source_point];
        if (output_point < 0)
        {
            output_point = addpoint(0, positions[source_point]);
            point_map[source_point] = output_point;
        }
        addvertex(0, output_prim, output_point);
        setvertexattrib(0, "N", output_prim, vertex, normal, "set");
    }
    setprimattrib(0, "cell_a", output_prim, owner, "set");
    setprimattrib(0, "cell_b", output_prim, neighbor, "set");
    setprimattrib(0, "piece", output_prim, owner, "set");
    setprimattrib(0, "name", output_prim, sprintf("cell_%d", owner), "set");
}

setdetailattrib(0, "rf_cell_kept", kept, "set");
setdetailattrib(0, "rf_cell_kept_count", kept_count, "set");
setdetailattrib(0, "rf_cell_removed_islands", removed_islands, "set");
setdetailattrib(0, "rf_formation_mode", use_guide ? -1 : formation, "set");
if (kept_count == 0)
    warning("rockform_cull: no cells selected; increase Bulk, refine the network, or change Selection.");

// Only the wrangle's output is edited; upstream nodes and input 1 stay intact.
// Delete originals explicitly, never output points; geometry edits are deferred.
for (int face = source_prim_count - 1; face >= 0; --face)
    removeprim(0, face, 0);
for (int pt = source_point_count - 1; pt >= 0; --pt)
    removepoint(0, pt);
