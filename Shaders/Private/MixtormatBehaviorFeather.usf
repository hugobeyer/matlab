#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatDriver.ush"
#include "/Plugin/Mixtormat/Private/MixtormatEikonal.ush"

int2 OutputSize;
float Radius;
float Strength;
float4 BehaviorDriverParamsA[2];
float4 BehaviorDriverParamsB[2];
Texture2D<float> BehaviorDriverSignal0;
Texture2D<float> BehaviorDriverSignal1;
float DirectionBias;
uint Side;
uint HasBoundary;
uint HasMask;

Texture2D<float> SourceHeight;
Texture2D<float2> BoundaryField;
Texture2D<float> MaskField;
Texture2D<float> Arrival;
SamplerState LinearWrapSampler;
RWTexture2D<float> OutHeight;
RWTexture2D<float> OutArrival;
Texture2D<float2> FeatherEnvelope;
RWTexture2D<float2> OutFeatherEnvelope;
int FeatherJump;

int2 WrapFeather(int2 P)
{
    return ((P % OutputSize) + OutputSize) % OutputSize;
}

float SampleHeight(int2 P)
{
    return SourceHeight.Load(int3(WrapFeather(P), 0));
}

float BlurHeight(float2 UV)
{
    const float2 Step = max(Radius, 0.0f) / (2.0f * float2(OutputSize));
    const float Center = SourceHeight.SampleLevel(LinearWrapSampler, UV, 0);
    float Sum = 0.0f;
    [unroll]
    for (int Y = -2; Y <= 2; ++Y)
    {
        const float Wy = Y == 0 ? 6.0f : abs(Y) == 1 ? 4.0f : 1.0f;
        [unroll]
        for (int X = -2; X <= 2; ++X)
        {
            const float Wx = X == 0 ? 6.0f : abs(X) == 1 ? 4.0f : 1.0f;
            const float V = X == 0 && Y == 0 ? Center :
                SourceHeight.SampleLevel(LinearWrapSampler, UV + float2(X, Y) * Step, 0);
            if (!isfinite(V)) { return Center; }
            Sum += (Wx * Wy) * V;
        }
    }
    return Sum * (1.0f / 256.0f);
}

// Each lane sweeps a full wrapped row or column; the opposite-direction passes
// make propagation independent of the tile width rather than iteration-limited.
#if FEATHER_STAGE == 4 || FEATHER_STAGE == 5
[numthreads(64, 1, 1)]
#else
[numthreads(8, 8, 1)]
#endif
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
#if FEATHER_STAGE == 4 || FEATHER_STAGE == 5
    const int Lane = int(DispatchThreadId.x);
#if FEATHER_STAGE == 4
    if (Lane >= OutputSize.y) { return; }
    const int Count = OutputSize.x;
#else
    if (Lane >= OutputSize.x) { return; }
    const int Count = OutputSize.y;
#endif
    const float Bias = clamp(DirectionBias, -1.0f, 1.0f) * 0.75f;
    const float Slope = rcp(max(Radius, 1.0e-4f));
#if FEATHER_STAGE == 4
    const float ForwardCost = Slope * (1.0f + Bias);
    const float ReverseCost = Slope * (1.0f - Bias);
#else
    const float ForwardCost = Slope;
    const float ReverseCost = Slope;
#endif
    float2 Running = 0.0f;
    [loop]
    for (int I = 0; I < Count; ++I)
    {
#if FEATHER_STAGE == 4
        const int2 Q = int2(I, Lane);
        const float H = SourceHeight.Load(int3(Q, 0));
        const float V = isfinite(H) ? H : 0.0f;
        const float2 Original = float2(V, V);
#else
        const int2 Q = int2(Lane, I);
        const float2 Original = FeatherEnvelope.Load(int3(Q, 0));
#endif
        Running = I == 0 ? Original : MixtormatEikonalEnvelopeStep(Original, Running, ForwardCost);
        OutFeatherEnvelope[Q] = Running;
    }

    // Seed from the opposite edge to propagate across the periodic seam.
#if FEATHER_STAGE == 4
    Running = OutFeatherEnvelope[int2(0, Lane)];
#else
    Running = OutFeatherEnvelope[int2(Lane, 0)];
#endif
    [loop]
    for (int I = Count - 1; I >= 0; --I)
    {
#if FEATHER_STAGE == 4
        const int2 Q = int2(I, Lane);
#else
        const int2 Q = int2(Lane, I);
#endif
        Running = MixtormatEikonalEnvelopeStep(OutFeatherEnvelope[Q], Running, ReverseCost);
        OutFeatherEnvelope[Q] = Running;
    }
#if FEATHER_STAGE == 4
    Running = OutFeatherEnvelope[int2(Count - 1, Lane)];
#else
    Running = OutFeatherEnvelope[int2(Lane, Count - 1)];
#endif
    [loop]
    for (int I = 0; I < Count; ++I)
    {
#if FEATHER_STAGE == 4
        const int2 Q = int2(I, Lane);
#else
        const int2 Q = int2(Lane, I);
#endif
        Running = MixtormatEikonalEnvelopeStep(OutFeatherEnvelope[Q], Running, ForwardCost);
        OutFeatherEnvelope[Q] = Running;
    }
#else
    const int2 P = int2(DispatchThreadId.xy);
    if (any(P >= OutputSize)) { return; }

#if FEATHER_STAGE == 0 || FEATHER_STAGE == 3
    const float2 UV = (float2(P) + 0.5f) / float2(OutputSize);
    const float H = SourceHeight.Load(int3(P, 0));
    if (!isfinite(H)) { OutHeight[P] = 0.0f; return; }
    const float M = HasMask != 0u ? MaskField.Load(int3(P, 0)) : 1.0f;
    const float Driven = MixtormatApplyDriver(Strength,
        BehaviorDriverSignal0.Load(int3(P, 0)),
        BehaviorDriverParamsA[0], BehaviorDriverParamsB[0]);
    float Weight = isfinite(M) && isfinite(Driven)
        ? Driven * saturate(M) : 0.0f;
#if FEATHER_STAGE == 3
    const float Distance = Arrival.Load(int3(P, 0));
    const float2 Boundary = HasBoundary != 0u
        ? BoundaryField.Load(int3(P, 0)) : float2(H, 1.0f);
    if (!isfinite(Distance) || !all(isfinite(Boundary))
        || (HasBoundary != 0u && Boundary.y <= 0.5f)) { Weight = 0.0f; }
    if (Side == 1u && Boundary.x >= 0.0f) { Weight = 0.0f; }
    if (Side == 2u && Boundary.x <= 0.0f) { Weight = 0.0f; }
    const float T = saturate(Distance / max(Radius, 1.0e-4f));
    Weight *= 1.0f - T * T * (3.0f - 2.0f * T);
#endif
    OutHeight[P] = Weight != 0.0f ? lerp(H, BlurHeight(UV), Weight) : H;
#elif FEATHER_STAGE == 1
    const float H = SampleHeight(P);
    bool Seed = false;
    if (HasBoundary != 0u)
    {
        const float2 B = BoundaryField.Load(int3(P, 0));
        Seed = all(isfinite(B)) && B.y > 0.5f
            && abs(B.x) <= 1.5f / (float)min(OutputSize.x, OutputSize.y);
    }
    else if (isfinite(H))
    {
        const float L = SampleHeight(P + int2(-1, 0));
        const float R = SampleHeight(P + int2(1, 0));
        const float D = SampleHeight(P + int2(0, -1));
        const float U = SampleHeight(P + int2(0, 1));
        Seed = all(isfinite(float4(L, R, D, U)))
            && ((H < 0.0f && max(max(L, R), max(D, U)) >= 0.0f)
                || (H > 0.0f && min(min(L, R), min(D, U)) <= 0.0f));
    }
    OutArrival[P] = Seed ? 0.0f : 65536.0f;
#elif FEATHER_STAGE == 2
    const float Center = Arrival.Load(int3(P, 0));
    const float L = Arrival.Load(int3(WrapFeather(P + int2(-1, 0)), 0));
    const float R = Arrival.Load(int3(WrapFeather(P + int2(1, 0)), 0));
    const float D = Arrival.Load(int3(WrapFeather(P + int2(0, -1)), 0));
    const float U = Arrival.Load(int3(WrapFeather(P + int2(0, 1)), 0));
    const float NW = Arrival.Load(int3(WrapFeather(P + int2(-1, 1)), 0));
    const float NE = Arrival.Load(int3(WrapFeather(P + int2(1, 1)), 0));
    const float SW = Arrival.Load(int3(WrapFeather(P + int2(-1, -1)), 0));
    const float SE = Arrival.Load(int3(WrapFeather(P + int2(1, -1)), 0));
    const float Bias = clamp(DirectionBias, -1.0f, 1.0f) * 0.75f;
    const float CostL = 1.0f + Bias;
    const float CostR = 1.0f - Bias;
    OutArrival[P] = MixtormatEikonalStepDirectional(Center, L, R, D, U, NW, NE, SW, SE,
        float2(1.0f, 1.0f), CostL, CostR, 1.0f, 1.0f,
        CostL, CostR, CostL, CostR);
#elif FEATHER_STAGE == 6
    float2 Envelope = FeatherEnvelope.Load(int3(P, 0));
    const float Slope = rcp(max(Radius, 1.0e-4f));
    const float Bias = clamp(DirectionBias, -1.0f, 1.0f) * 0.75f;
    [unroll]
    for (int Y = -1; Y <= 1; ++Y)
    {
        [unroll]
        for (int X = -1; X <= 1; ++X)
        {
            if (X == 0 && Y == 0) { continue; }
            const int2 Q = WrapFeather(P + int2(X, Y) * FeatherJump);
            const float2 Other = FeatherEnvelope.Load(int3(Q, 0));
            const float HorizontalBias = X < 0 ? 1.0f + Bias : X > 0 ? 1.0f - Bias : 1.0f;
            const float Cost = length(float2(X, Y)) * float(FeatherJump) * Slope * HorizontalBias;
            Envelope = MixtormatEikonalEnvelopeStep(Envelope, Other, Cost);
        }
    }
    OutFeatherEnvelope[P] = Envelope;
#elif FEATHER_STAGE == 7
    const float H = SourceHeight.Load(int3(P, 0));
    if (!isfinite(H)) { OutHeight[P] = 0.0f; return; }
    const float M = HasMask != 0u ? MaskField.Load(int3(P, 0)) : 1.0f;
    const float Driven = MixtormatApplyDriver(Strength,
        BehaviorDriverSignal0.Load(int3(P, 0)),
        BehaviorDriverParamsA[0], BehaviorDriverParamsB[0]);
    const float2 Bounds = FeatherEnvelope.Load(int3(P, 0));
    const float2 Boundary = HasBoundary != 0u
        ? BoundaryField.Load(int3(P, 0)) : float2(H, 1.0f);
    float Weight = isfinite(M) && isfinite(Driven) && all(isfinite(Bounds))
        && all(isfinite(Boundary)) && (HasBoundary == 0u || Boundary.y > 0.5f)
        ? Driven * saturate(M) : 0.0f;
    if (Side == 1u && Boundary.x >= 0.0f) { Weight = 0.0f; }
    if (Side == 2u && Boundary.x <= 0.0f) { Weight = 0.0f; }
    // The mean of the high-to-low and low-to-high slope envelopes bevels a
    // hard edge without moving the entire feature as a broad Gaussian does.
    const float Feathered = 0.5f * (Bounds.x + Bounds.y);
    OutHeight[P] = Weight != 0.0f ? lerp(H, Feathered, Weight) : H;
#endif
#endif
}
