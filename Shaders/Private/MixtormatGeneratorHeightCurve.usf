// Generator-layer Height Curve / Height Remap sublayer: remaps the running signed height through
// the shared scalar ramp with measured zero-preserving normalization, signed input range,
// offset, invert, and an Amount lerp against the original input.
//
// Processing order (locked, shared with CPU/UI):
//   input
//   -> optional zero-preserving normalization
//   -> signed input-range remap
//   -> curve

//   -> offset
//   -> invert
//   -> Amount lerp against original input

#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorHeightModules.ush"

int2 OutputSize;
float Amount;

float InputMin;
float InputMax;

float Offset;
uint bInvert;
uint CurveCount;
uint CurveInterpolation;
float4 CurvePoints[MIXTORMAT_SCALAR_RAMP_MAX_POINTS];
Texture2D<float> RunningHeight;
Texture2D<float> SourceHeight;
RWTexture2D<float> OutHeight;

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 Pixel = int2(DispatchThreadId.xy);
	if (any(Pixel >= OutputSize)) { return; }

	const float Original = RunningHeight.Load(int3(Pixel, 0));
	// The optional measured normalization is scheduled by C++ using the shared field utility.
	// Keep the original texture separate so Amount always blends against untouched height.
	float X = SourceHeight.Load(int3(Pixel, 0));

	// Signed input-range remap. The pivot is zero: positive values divide by InputMax, negative
	// by abs(InputMin). A degenerate range resolves to zero.
	{
		const float AbsMin = abs(InputMin);
		const float AbsMax = abs(InputMax);
		if (X >= 0.0f)
		{
			X = AbsMax > 1.0e-6f ? X / AbsMax : 0.0f;
		}
		else
		{
			X = AbsMin > 1.0e-6f ? X / AbsMin : 0.0f;
		}
	}

	// Curve: the signed-domain scalar ramp. The ramp is not saturated to 0..1.
	float Y = MixtormatEvalSignedScalarRamp(X, CurveCount, CurveInterpolation, CurvePoints) + Offset;

	// Invert: -x, not 1-x. Identity when false.
	if (bInvert != 0) { Y = -Y; }

	// Amount lerp against the original input. Identity at 1.
	OutHeight[Pixel] = lerp(Original, Y, saturate(Amount));
}
