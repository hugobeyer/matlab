// Normalizes a field on the GPU. Mode 0 is the original measured-range remap onto
// [OutLow, OutHigh]. Modes 1 and 2 are the generator signed-height contract:
//
// RANGE_STAGE 0 (Reduce):    per-group min/max in groupshared memory, then one atomic per group into
//   a two-entry buffer. The buffer is cleared to 0 beforehand; entry 0 holds max(~ordered(h)), which
//   is the minimum, and entry 1 holds max(ordered(h)), the maximum -- both reduce with InterlockedMax
//   from a zero clear. Only run when a measured range is actually needed.
// RANGE_STAGE 1 (Resolve):   mode 0 remaps (h - min) / (max - min) onto [OutLow, OutHigh]; mode 1
//   is zero-preserving max-absolute normalization (h / max(abs(min), abs(max))) clamped to -1..1;
//   mode 2 is the raw signed field clamped to -1..1. Both signed modes then multiply by OutputScale,
//   which is applied after the clamp and may push the result beyond -1..1.
//
// Nothing is clamped after OutputScale: the generator contract is on the base field, and the
// document/export level owns the final remap.

#include "/Engine/Public/Platform.ush"

int2 OutputSize;
float OutLow;
float OutHigh;
uint NormalizeMode;
float OutputScale;
Texture2D<float> SourceField;
RWStructuredBuffer<uint> OutRange;
StructuredBuffer<uint> Range;
RWTexture2D<float> OutField;

// Order-preserving float <-> uint: larger floats map to larger uints, negatives included.
uint FloatToOrdered(float Value)
{
	const uint Bits = asuint(Value);
	return (Bits & 0x80000000u) != 0u ? ~Bits : (Bits | 0x80000000u);
}

float OrderedToFloat(uint Ordered)
{
	return asfloat((Ordered & 0x80000000u) != 0u ? (Ordered & 0x7FFFFFFFu) : ~Ordered);
}

#if RANGE_STAGE == 0
groupshared uint GroupMinInv;
groupshared uint GroupMax;

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID, uint GroupIndex : SV_GroupIndex)
{
	if (GroupIndex == 0u)
	{
		GroupMinInv = 0u;
		GroupMax = 0u;
	}
	GroupMemoryBarrierWithGroupSync();

	const int2 Pixel = int2(DispatchThreadId.xy);
	if (all(Pixel < OutputSize))
	{
		const float Value = SourceField.Load(int3(Pixel, 0));
		if (!isnan(Value) && !isinf(Value))
		{
			const uint Ordered = FloatToOrdered(Value);
			InterlockedMax(GroupMinInv, ~Ordered);
			InterlockedMax(GroupMax, Ordered);
		}
	}
	GroupMemoryBarrierWithGroupSync();

	if (GroupIndex == 0u)
	{
		InterlockedMax(OutRange[0], GroupMinInv);
		InterlockedMax(OutRange[1], GroupMax);
	}
}
#endif

#if RANGE_STAGE == 1
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 Pixel = int2(DispatchThreadId.xy);
	if (any(Pixel >= OutputSize))
	{
		return;
	}
	const float Low = OrderedToFloat(~Range[0]);
	const float High = OrderedToFloat(Range[1]);
	const float Span = High - Low;
	const float Value = SourceField.Load(int3(Pixel, 0));
	if (NormalizeMode == 1u)
	{
		// Zero-preserving max-absolute normalization: the largest excursion maps to 1 and zero
		// stays exactly zero, so empty/background pixels acquire no height offset.
		const float MaxAbs = max(abs(Low), abs(High));
		OutField[Pixel] = (MaxAbs > 1e-12f
			? clamp(Value / MaxAbs, -1.0f, 1.0f)
			: 0.0f) * OutputScale;
	}
	else if (NormalizeMode == 2u)
	{
		// Normalize off: the raw signed field, clamped to the -1..1 generator contract, then
		// scaled. No reduction is needed for this path.
		OutField[Pixel] = clamp(Value, -1.0f, 1.0f) * OutputScale;
	}
	else
	{
		const float Unit = Span > 1e-12f ? (Value - Low) / Span : 0.0f;
		OutField[Pixel] = lerp(OutLow, OutHigh, Unit);
	}
}
#endif
