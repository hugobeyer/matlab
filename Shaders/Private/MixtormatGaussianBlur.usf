#include "/Engine/Public/Platform.ush"

int2 OutputSize;
float Radius;
float Amount;
float4 ChannelWeights;
uint ClampCoverage;
Texture2D<float> ScalarSource;
Texture2D<float4> VectorSource;
Texture2D<float> SourceWeights;
Texture2D<float> ScalarOriginal;
Texture2D<float4> VectorOriginal;
Texture2D<float> MaskTexture;
Texture2D<float> FlowValidity;
RWTexture2D<float> ScalarOutput;
RWTexture2D<float4> VectorOutput;
RWTexture2D<float> OutputWeights;

int2 WrapPixel(int2 P)
{
	return (P % OutputSize + OutputSize) % OutputSize;
}

// FIELD_TYPE: scalar, float4, encoded normal, Flow with separate validity.
// The axis passes carry unnormalized sums AND mass, so invalid samples are
// excluded from the complete 2D kernel rather than renormalized per row.
[numthreads(8, 8, 1)]
void MainCS(uint3 ID : SV_DispatchThreadID)
{
	const int2 P = int2(ID.xy);
	if (any(P >= OutputSize)) { return; }
#if STAGE == 2
#if FIELD_TYPE == 0
	const float4 Original = float4(ScalarOriginal.Load(int3(P, 0)), 0, 0, 0);
#else
	const float4 Original = VectorOriginal.Load(int3(P, 0));
#endif
	const float Mass = SourceWeights.Load(int3(P, 0));
	float Weight = Amount;
#if HAS_MASK
	const float Mask = MaskTexture.Load(int3(P, 0));
	Weight *= isfinite(Mask) ? saturate(Mask) : 0.0f;
#endif
#if FIELD_TYPE == 3
	// Preserve the caller's validity texture and invalid destinations exactly.
	const float Valid = FlowValidity.Load(int3(P, 0));
	if (!isfinite(Valid) || Valid <= 0.0f) { Weight = 0.0f; }
#endif
	float4 Result = Original;
	if (Weight > 0.0f && Mass > 0.0f && all(isfinite(Original)))
	{
		const float4 Filtered = VectorSource.Load(int3(P, 0)) / Mass;
#if FIELD_TYPE == 3
		Result.xy = lerp(Original.xy, Filtered.xy, Weight);
#elif FIELD_TYPE == 1
		const float4 Weights = Weight * saturate(ChannelWeights);
		Result = lerp(Original, Filtered, Weights);
		// Keep disabled packed components untouched, including their exact source bits.
		Result = float4(Weights.x > 0.0f ? Result.x : Original.x,
			Weights.y > 0.0f ? Result.y : Original.y,
			Weights.z > 0.0f ? Result.z : Original.z,
			Weights.w > 0.0f ? Result.w : Original.w);
#else
		Result = lerp(Original, Filtered, Weight);
#endif
#if FIELD_TYPE == 2
		const float3 N = Result.xyz * 2.0f - 1.0f;
		const float LengthSquared = dot(N, N);
		Result.xyz = LengthSquared > 0.0f
			? (N * rsqrt(LengthSquared)) * 0.5f + 0.5f : Original.xyz;
#endif
	}
#if FIELD_TYPE == 0
	ScalarOutput[P] = ClampCoverage != 0u ? saturate(Result.x) : Result.x;
#else
	VectorOutput[P] = Result;
#endif
#else
	// Zero-radius axes are identity passes, including their accumulated mass.
	const float Sigma = Radius * 0.5f;
	const int Support = int(ceil(3.0f * Sigma));
	float4 Sum = 0.0f;
	float Mass = 0.0f;
	[loop]
	for (int I = -Support; I <= Support; ++I)
	{
		const float Offset = float(I);
		const float W = I == 0 ? 1.0f : exp(-0.5f * (Offset / Sigma) * (Offset / Sigma));
#if STAGE == 0
		const int2 Q = WrapPixel(P + int2(I, 0));
#if FIELD_TYPE == 0
		const float4 V = float4(ScalarSource.Load(int3(Q, 0)), 0, 0, 0);
#else
		const float4 V = VectorSource.Load(int3(Q, 0));
#endif
		if (!all(isfinite(V))) { continue; }
		float Valid = 1.0f;
#if FIELD_TYPE == 3
		const float SampleValidity = FlowValidity.Load(int3(Q, 0));
		Valid = isfinite(SampleValidity) ? saturate(SampleValidity) : 0.0f;
#endif
		Sum += V * (W * Valid);
		Mass += W * Valid;
#else
		const int2 Q = WrapPixel(P + int2(0, I));
		Sum += VectorSource.Load(int3(Q, 0)) * W;
		Mass += SourceWeights.Load(int3(Q, 0)) * W;
#endif
	}
	VectorOutput[P] = Sum;
	OutputWeights[P] = Mass;
#endif
}
