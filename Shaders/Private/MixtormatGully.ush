#ifndef MATERIAL_LAB_GULLY_USH
#define MATERIAL_LAB_GULLY_USH

// Periodic directional field used by the erosion filter.
//
// The lattice closes on an integer period so the result tiles exactly. Direction comes
// from smearing isotropic periodic noise along a vector rather than rotating the domain:
// rotating a periodic lattice destroys its periodicity, whereas every tap here is a plain
// translation and still lands on the wrapped lattice.

int MixtormatWrapI(int x, int m)
{
	m = max(m, 1);
	x = x % m;
	return x < 0 ? x + m : x;
}

uint MixtormatHashU(uint x)
{
	x ^= x >> 16;
	x *= 0x7feb352du;
	x ^= x >> 15;
	x *= 0x846ca68bu;
	x ^= x >> 16;
	return x;
}

// Unit gradient for a lattice cell, wrapped to the period so the field repeats.
float2 MixtormatCellGradient(int2 c, int Period, uint Seed)
{
	uint hx = (uint)MixtormatWrapI(c.x, Period);
	uint hy = (uint)MixtormatWrapI(c.y, Period);
	uint h = MixtormatHashU(hx * 0x27d4eb2du ^ hy * 0x165667b1u ^ Seed * 0x9e3779b9u);
	float a = (float)(h & 0x00FFFFFFu) * (6.28318530718f / 16777216.0f);
	return float2(cos(a), sin(a));
}

// Periodic gradient noise with analytic derivatives, returned as (value, ddx, ddy).
float3 MixtormatPeriodicNoiseD(float2 p, int Period, uint Seed)
{
	int2 i = (int2)floor(p);
	float2 f = p - (float2)i;

	float2 u = f * f * f * (f * (f * 6.0f - 15.0f) + 10.0f);
	float2 du = 30.0f * f * f * (f * (f - 2.0f) + 1.0f);

	float2 ga = MixtormatCellGradient(i + int2(0, 0), Period, Seed);
	float2 gb = MixtormatCellGradient(i + int2(1, 0), Period, Seed);
	float2 gc = MixtormatCellGradient(i + int2(0, 1), Period, Seed);
	float2 gd = MixtormatCellGradient(i + int2(1, 1), Period, Seed);

	float va = dot(ga, f - float2(0.0f, 0.0f));
	float vb = dot(gb, f - float2(1.0f, 0.0f));
	float vc = dot(gc, f - float2(0.0f, 1.0f));
	float vd = dot(gd, f - float2(1.0f, 1.0f));

	float k = va - vb - vc + vd;
	float value = va + u.x * (vb - va) + u.y * (vc - va) + u.x * u.y * k;

	float2 d = ga
		+ u.x * (gb - ga)
		+ u.y * (gc - ga)
		+ u.x * u.y * (ga - gb - gc + gd)
		+ du * (float2(u.y, u.x) * k + float2(vb, vc) - va);

	return float3(value, d.x, d.y);
}

// Two repeatable random values for a lattice point. The point is wrapped before hashing,
// while its unwrapped position is retained by the caller for continuous seam-relative math.
float2 MixtormatCellOffset(int2 Cell, int Period, uint Seed)
{
	const uint X = (uint)MixtormatWrapI(Cell.x, Period);
	const uint Y = (uint)MixtormatWrapI(Cell.y, Period);
	const uint H0 = MixtormatHashU(X * 0x27d4eb2du ^ Y * 0x165667b1u ^ Seed * 0x9e3779b9u);
	const uint H1 = MixtormatHashU(H0 ^ 0x68bc21ebu);
	return float2(H0 & 0x00ffffffu, H1 & 0x00ffffffu) * (1.0f / 16777216.0f) - 0.5f;
}

// Periodic phase stripes blended from nearby cell pivots. The stripe direction is Along;
// its phase changes across the perpendicular Side vector. Returning cosine and sine together
// lets the erosion driver partially normalize their shared amplitude without destroying phase.
// ZW is dPhase/dP; multiply it by the octave cell count for a UV-space derivative.
float4 MixtormatPeriodicStripeField(
	float2 P,
	float2 Along,
	int Period,
	uint Seed,
	float Normalization)
{
	const float Tau = 6.28318530718f;
	const float2 Side = float2(-Along.y, Along.x) * Tau;
	const int2 BaseCell = (int2)floor(P);
	const float2 Local = P - (float2)BaseCell;

	float2 Phase = 0.0f;
	float WeightSum = 0.0f;

	[unroll]
	for (int Y = -1; Y <= 2; ++Y)
	{
		[unroll]
		for (int X = -1; X <= 2; ++X)
		{
			const int2 CellOffset = int2(X, Y);
			const float2 PivotJitter = MixtormatCellOffset(BaseCell + CellOffset, Period, Seed) * 0.9f;
			const float2 FromPivot = Local - (float2)CellOffset - PivotJitter;
			const float Distance2 = dot(FromPivot, FromPivot);

			// Compact Gaussian support reaches zero before any cell outside this 4x4 window can
			// contribute, avoiding both grid seams and unnecessary dynamic neighbourhoods.
			const float Weight = max(exp(-2.0f * Distance2) - 0.011f, 0.0f);
			const float Wave = dot(FromPivot, Side);
			Phase += float2(cos(Wave), sin(Wave)) * Weight;
			WeightSum += Weight;
		}
	}

	float2 Waves = Phase / max(WeightSum, 1.0e-6f);
	const float Magnitude = length(Waves);
	const float FloorMagnitude = max(1.0f - saturate(Normalization), 1.0e-4f);
	Waves /= max(Magnitude, FloorMagnitude);
	return float4(Waves, Side);
}

#endif
