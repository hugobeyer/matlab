#ifndef MATERIAL_LAB_MASK_OPS_USH
#define MATERIAL_LAB_MASK_OPS_USH

// The tail every mask-producing node shares: shape the signal it generated, then blend it into
// the mask accumulated so far.
//
// Extracted when craquelure moved out of the generated mask into its own node. Both nodes want
// the same blend modes and the same bias / contrast / balance / invert chain, and a second copy
// of it would have drifted -- the balance curve in particular is not something anyone would
// reproduce identically from memory.

float MixtormatApplyMaskOperation(uint BlendMode, float Previous, float Incoming)
{
	if (BlendMode == 0)
	{
		return Incoming;
	}
	if (BlendMode == 1)
	{
		return Previous + Incoming;
	}
	if (BlendMode == 2)
	{
		return Previous - Incoming;
	}
	if (BlendMode == 3)
	{
		return Previous * Incoming;
	}
	if (BlendMode == 4)
	{
		return min(Previous, Incoming);
	}
	if (BlendMode == 5)
	{
		return max(Previous, Incoming);
	}
	if (BlendMode == 6)
	{
		return Previous + (Incoming - 0.5f) * 2.0f;
	}
	if (BlendMode == 7)
	{
		return Previous < 0.5f
			? 2.0f * Previous * Incoming
			: 1.0f - 2.0f * (1.0f - Previous) * (1.0f - Incoming);
	}
	if (BlendMode == 8)
	{
		return abs(Previous - Incoming);
	}
	if (BlendMode == 9)
	{
		// Exclusion: difference's softer relative -- the same endpoints, no hard crease at the match.
		return Previous + Incoming - 2.0f * Previous * Incoming;
	}
	if (BlendMode == 10)
	{
		// Divide: Previous / Incoming, with a small, signed-safe denominator
		const float Denom = abs(Incoming) < 1.0e-6f ? (Incoming >= 0.0f ? 1.0e-6f : -1.0e-6f) : Incoming;
		const float Div = Previous / Denom;
		return isnan(Div) || isinf(Div) ? 0.0f : Div;
	}
	return Incoming;
}

// Controls how blended scalar values are constrained:
// 0: Clamp (0..1)
// 1: Unclamped (preserves negative values and values > 1)
// 2: Mirror (triangle-wave value remap: 1 - abs(2 * frac(Value * MirrorScale / 2) - 1))
float MixtormatApplyMaskOutputRange(float Value, uint OutputRange, float MirrorScale)
{
	if (isnan(Value) || isinf(Value))
	{
		return 0.0f;
	}
	if (OutputRange == 1u)
	{
		return clamp(Value, -65504.0f, 65504.0f);
	}
	if (OutputRange == 2u)
	{
		const float SafeScale = isnan(MirrorScale) || isinf(MirrorScale) ? 1.0f : MirrorScale;
		const float Scaled = clamp(Value * SafeScale * 0.5f, -100000.0f, 100000.0f);
		return 1.0f - abs(2.0f * frac(Scaled) - 1.0f);
	}
	return saturate(Value);
}

// Input levels and the curve provide nonlinear shaping; offset adjusts its
// result, then inversion flips the final normalized coverage.
float MixtormatShapeMask(float Incoming, float Offset, uint Invert)
{
	const float Shaped = saturate(Incoming + Offset);
	return Invert != 0u ? 1.0f - Shaped : Shaped;
}

#endif
