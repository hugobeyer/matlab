#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatHeightNormal.ush"

// One height -> normal reconciliation for every structural effect that authors height:
// erosion, craquelure relief, worn edges, chipping, region relief and the strata carve all
// end on this pass. The relief normal is derived from the height *delta* (before minus
// after) through the shared MixtormatHeightNormal.ush convention -- Sobel scaled by the
// texel count relative to the 1024 reference -- so equivalent height geometry produces
// equivalent normal slope whatever resolution the pass runs at. Erosion in particular runs
// at up to twice the composition resolution, where a raw pixel-space Sobel of the same
// continuous carve read roughly quarter-scale and the relief nearly vanished.
//
// NormalStrength arrives as 8.0 from every caller, so with the helper's Sobel the effective
// gain is the neutral Sobel x (resolution / 1024) x 1: the authored 1K look is unchanged,
// and higher resolutions stop weakening.

Texture2D<float> PreviousHeight;
Texture2D<float> CurrentHeight;
Texture2D<float4> PreviousNormal;
Texture2D<float4> PreviousRAM;
RWTexture2D<float4> OutputNormal;
RWTexture2D<float4> OutputRAM;

int2 OutputSize;
float NormalStrength;
float AOAmount;
uint WriteRAM;

int WrapI(int X, int Size)
{
	X %= max(Size, 1);
	return X < 0 ? X + Size : X;
}

float HeightDeltaAt(int2 P)
{
	P.x = WrapI(P.x, OutputSize.x);
	P.y = WrapI(P.y, OutputSize.y);
	return PreviousHeight.Load(int3(P, 0)) - CurrentHeight.Load(int3(P, 0));
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 P = int2(DispatchThreadId.xy);
	const float Dmm = HeightDeltaAt(P + int2(-1, -1));
	const float D0m = HeightDeltaAt(P + int2( 0, -1));
	const float Dpm = HeightDeltaAt(P + int2( 1, -1));
	const float Dm0 = HeightDeltaAt(P + int2(-1,  0));
	const float D00 = HeightDeltaAt(P);
	const float Dp0 = HeightDeltaAt(P + int2( 1,  0));
	const float Dmp = HeightDeltaAt(P + int2(-1,  1));
	const float D0p = HeightDeltaAt(P + int2( 0,  1));
	const float Dpp = HeightDeltaAt(P + int2( 1,  1));

	const float2 G = MixtormatHeightGradient(
		Dmm, D0m, Dpm,
		Dm0,     Dp0,
		Dmp, D0p, Dpp,
		OutputSize,
		NormalStrength / 8.0f);

	// The helper already carries the height-field sign (-dh/dx, -dh/dy, 1); the previous
	// inline Sobel folded that same negation into the RNM's U term instead. U therefore
	// takes the relief normal directly -- negating again would emboss the relief
	// inside-out.
	const float3 ReliefNormal = MixtormatNormalFromHeightGradient(G);
	const float4 EncodedBase = PreviousNormal.Load(int3(P, 0));
	const float3 BaseNormal = normalize(EncodedBase.xyz * 2.0f - 1.0f);
	const float3 T = BaseNormal + float3(0.0f, 0.0f, 1.0f);
	const float3 U = ReliefNormal;
	const float3 Combined = normalize(T * dot(T, U) / max(T.z, 1.0e-5f) - U);
	OutputNormal[P] = float4(Combined * 0.5f + 0.5f, EncodedBase.w);

	if (WriteRAM != 0)
	{
		const float NeighbourAverage =
			(Dm0 + Dp0 + D0m + D0p) * 0.25f;
		const float Cavity = max(D00 - NeighbourAverage, 0.0f);
		const float Removed = max(D00, 0.0f);
		const float HeightAO = saturate(Cavity * 32.0f + Removed * 2.0f);
		float4 RAM = PreviousRAM.Load(int3(P, 0));
		RAM.g = saturate(RAM.g * (1.0f - saturate(AOAmount) * HeightAO));
		OutputRAM[P] = RAM;
	}
}
