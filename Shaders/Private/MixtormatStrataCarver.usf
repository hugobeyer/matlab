#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGully.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorPlacement.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorWarp.ush"

// Geological strata, not a sawtooth: ordered interfaces enclose hard shelves and softer
// recessed beds. A common fold moves the entire stack; bounded interface variation changes
// thickness without crossing. Extruded Voronoi cells split shelves into chamfered slabs.
// This is a heightfield approximation of implicit rock volumes, not a volumetric solver.
// All randomness wraps in the integer bedding/strike lattice, including neighboring beds.
// Height is a signed field; IDs, bed position and bed random retain their published meanings.

int2 BedWave;
int2 BedPerp;
int BedPeriod;
int2 OutputSize;

// @param Seed
uint Seed;
// @param ThicknessVariation saturates
float ThicknessVariation;
// @param HeightVariation
float HeightVariation;
// @param Verticality saturates
float Verticality;
// @param LedgeWidth saturates
float LedgeWidth;
// @param HardnessContrast saturates
float HardnessContrast;
// @param SoftRecession
float SoftRecession;
// @param Bend
float Bend;
// @param BendScale
int BendScale;
// @param Breakup
float Breakup;
// @param JointScale
int JointScale;
// @param JointWidth
float JointWidth;
// @param HeightFollow
float HeightFollow;
// @param Lamination
float Lamination;
// @param CrossBedding
float CrossBedding;
// @param Depth
float Depth;
// @param MaskInfluence
float MaskInfluence;
// @param IDInfluence
float IDInfluence;
uint HasScopedMask;
uint HasRegionIds;
uint HasHeightPush;
uint HasStructuralWarp;

// Periodic unwrapped displacement in destination tile units, not absolute coordinates.
Texture2D<float2> StructuralDisplacement;
Texture2D<float> HeightPushField;
Texture2D<float> SourceHeight;
Texture2D<float> ResolveMask;
Texture2D<uint> ResolveRegionIds;
SamplerState LinearWrapSampler;

RWTexture2D<float> OutHeight;
RWTexture2D<uint> OutBedIds;
RWTexture2D<float> OutBedPosition;
RWTexture2D<float> OutBedRandom;
RWTexture2D<float2> OutBoundaryField;

float StrataRandom(int Index, int Period, uint Key)
{
	const uint Wrapped = (uint)MixtormatWrapI(Index, Period);
	return (float)(MixtormatHashU(Wrapped * 0x9e3779b1u ^ Seed * 0x85ebca6bu ^ Key) & 0x00ffffffu)
		* (1.0f / 16777216.0f);
}

uint StrataBedKey(int Bed, uint Salt)
{
	return MixtormatHashU((uint)MixtormatWrapI(Bed, BedPeriod) * 0x27d4eb2du ^ Salt);
}

float StrataBedRandom(int Bed, uint Salt)
{
	return StrataRandom(Bed, BedPeriod, Salt);
}

// Value and analytic derivative in lattice units. Cubic interpolation stays within 0..1,
// which is necessary for the ordered-interface bound below.
float2 StrataNoiseD(float X, int Period, uint Key)
{
	const int I = (int)floor(X);
	const float F = X - (float)I;
	const float A = StrataRandom(I, Period, Key);
	const float B = StrataRandom(I + 1, Period, Key);
	return float2(lerp(A, B, F * F * (3.0f - 2.0f * F)), (B - A) * 6.0f * F * (1.0f - F));
}

// Position in bed units and derivative with respect to the primitive strike coordinate.
// Each interface stays within +/-0.44 of its index: adjacent beds remain at least 0.12 wide.
// Both sides evaluate the same interface, so the seam position and depth cannot disagree.
float2 StrataInterface(int Bed, float Strike)
{
	if (ThicknessVariation == 0.0f) { return float2((float)Bed, 0.0f); }
	const int Period = max(BendScale, 1);
	const float2 Lateral = StrataNoiseD(Strike * (float)Period, Period, StrataBedKey(Bed, 0x3b9aca07u));
	const float Offset = 0.65f * (StrataBedRandom(Bed, 0x165667b1u) * 2.0f - 1.0f)
		+ 0.35f * (Lateral.x * 2.0f - 1.0f);
	const float Amplitude = 0.44f * saturate(ThicknessVariation);
	return float2((float)Bed + Amplitude * Offset, Amplitude * 0.7f * Lateral.y * (float)Period);
}

float StrataHardness(int Bed)
{
	return lerp(0.5f, StrataBedRandom(Bed, 0x2545f491u), saturate(HardnessContrast));
}

float StrataSeamHeight(int Boundary)
{
	const float Softness = 1.0f - 0.5f * (StrataHardness(Boundary - 1) + StrataHardness(Boundary));
	return -0.18f - max(SoftRecession, 0.0f) * (0.2f + 0.55f * Softness);
}

float StrataJointBoundary(int Joint, int Period, uint Key)
{
	return (float)Joint + 0.5f * (StrataRandom(Joint, Period, Key) - 0.5f);
}

// Uneven hinge spacing and linear limbs give chevron folds rather than rounded noise waves.
float2 StrataFoldD(float X, int Period, uint Key)
{
	int I = (int)floor(X);
	float Left = StrataJointBoundary(I, Period, Key);
	float Right = StrataJointBoundary(I + 1, Period, Key);
	if (X < Left)
	{
		--I;
		Right = Left;
		Left = StrataJointBoundary(I, Period, Key);
	}
	else if (X >= Right)
	{
		++I;
		Left = Right;
		Right = StrataJointBoundary(I + 1, Period, Key);
	}
	const float A = StrataRandom(I, Period, Key ^ 0x68bc21ebu);
	const float B = StrataRandom(I + 1, Period, Key ^ 0x68bc21ebu);
	return float2(lerp(A, B, (X - Left) / (Right - Left)), (B - A) / (Right - Left));
}

float StrataCellRandom(int2 Cell, int Period, uint Key)
{
	return StrataRandom(Cell.x, Period, MixtormatHashU((uint)Cell.y * 0x27d4eb2du ^ Key));
}

float2 StrataCellSite(int2 Cell, int Period, uint Key)
{
	return float2(Cell) + 0.5f + 0.5f * (float2(
		StrataCellRandom(Cell, Period, Key),
		StrataCellRandom(Cell, Period, Key ^ 0x85ebca6bu)) - 0.5f);
}

// Distances to the two closest cell planes, not F2-F1 (which bows the fracture faces).
// Sites stay within +/-0.25 of their centers: 3x3 finds the owner; 5x5 around it
// includes its possible Voronoi neighbors. Wrapped hashes keep geometry periodic in strike.
float2 StrataCellPlanes(float2 Q, int Period, uint Key,
	out float2 Local, out float Draw, out float2 Tilt)
{
	const int2 Base = int2(floor(Q));
	int2 Owner = Base;
	float Nearest = 1.0e10f;
	[unroll]
	for (int Y = -1; Y <= 1; ++Y)
	{
		[unroll]
		for (int X = -1; X <= 1; ++X)
		{
			const int2 Cell = Base + int2(X, Y);
			const float2 Delta = StrataCellSite(Cell, Period, Key) - Q;
			const float D2 = dot(Delta, Delta);
			if (D2 < Nearest) { Nearest = D2; Owner = Cell; }
		}
	}
	const float2 Site = StrataCellSite(Owner, Period, Key);
	Local = Q - Site;
	Draw = StrataCellRandom(Owner, Period, Key ^ 0xc2b2ae35u);
	Tilt = float2(StrataCellRandom(Owner, Period, Key ^ 0x7feb352du),
		StrataCellRandom(Owner, Period, Key ^ 0x846ca68bu)) * 2.0f - 1.0f;
	float2 Planes = float2(1.0e10f, 1.0e10f);
	[unroll]
	for (int Y = -2; Y <= 2; ++Y)
	{
		[unroll]
		for (int X = -2; X <= 2; ++X)
		{
			if (X == 0 && Y == 0) { continue; }
			const float2 Delta = StrataCellSite(Owner + int2(X, Y), Period, Key) - Site;
			const float D = max(0.0f, dot(0.5f * Delta - Local, normalize(Delta)));
			if (D < Planes.x) { Planes.y = Planes.x; Planes.x = D; }
			else { Planes.y = min(Planes.y, D); }
		}
	}
	return Planes;
}

// Ordered but uneven internal contacts; endpoints remain attached to the parent bed.
float2 StrataLaminaInterface(int Index, int Count, float Strike, int Period, uint Key)
{
	if (Index <= 0) { return float2(0.0f, 0.0f); }
	if (Index >= Count) { return float2((float)Count, 0.0f); }
	const uint ContactKey = MixtormatHashU((uint)Index * 0x9e3779b1u ^ Key);
	const float2 Lateral = StrataFoldD(Strike * (float)Period, Period, ContactKey);
	const float Offset = 0.28f * (StrataRandom(Index, Count, Key) * 2.0f - 1.0f)
		+ 0.12f * (Lateral.x * 2.0f - 1.0f);
	return float2((float)Index + Offset, 0.24f * Lateral.y * (float)Period);
}

float StrataFootprint(float2 DestinationGradient)
{
	return dot(abs(DestinationGradient) / float2(OutputSize), float2(1.0f, 1.0f));
}

void StrataWriteInvalid(int2 P)
{
	OutHeight[P] = 0.0f;
	OutBedIds[P] = MIXTORMAT_INVALID_REGION;
	OutBedPosition[P] = 0.0f;
	OutBedRandom[P] = 0.0f;
	OutBoundaryField[P] = float2(0.0f, 0.0f);
}

[numthreads(8, 8, 1)]
void ResolveCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize))) { return; }

	const int2 P = int2(DispatchThreadId.xy);
	const float2 DestinationUV = (float2(P) + 0.5f) / float2(OutputSize);
	OutBoundaryField[P] = float2(0.0f, 0.0f);
	float2 StructuralUV = DestinationUV;
	float2x2 J = float2x2(1.0f, 0.0f, 0.0f, 1.0f);
	if (HasStructuralWarp != 0u)
	{
		StructuralUV += StructuralDisplacement.Load(int3(P, 0));
		if (!all(isfinite(StructuralUV))) { StrataWriteInvalid(P); return; }

		// Difference D directly: the coordinate helper's Jacobian expects absolute W.
		const float2 X = float2(1.0f, 0.0f) + (
			StructuralDisplacement.Load(int3(MixtormatGeneratorWarpWrap(P + int2(1, 0), OutputSize), 0))
			- StructuralDisplacement.Load(int3(MixtormatGeneratorWarpWrap(P - int2(1, 0), OutputSize), 0)))
			* (0.5f * OutputSize.x);
		const float2 Y = float2(0.0f, 1.0f) + (
			StructuralDisplacement.Load(int3(MixtormatGeneratorWarpWrap(P + int2(0, 1), OutputSize), 0))
			- StructuralDisplacement.Load(int3(MixtormatGeneratorWarpWrap(P - int2(0, 1), OutputSize), 0)))
			* (0.5f * OutputSize.y);
		J = float2x2(X.x, Y.x, X.y, Y.y);
	}
	const float2 UV = MixtormatGeneratorUV(StructuralUV);
	if (!all(isfinite(UV))) { StrataWriteInvalid(P); return; }
	const float2 StrikeVector = float2(BedPerp) / (float)max(BedPeriod, 1);
	float Strike = dot(UV, StrikeVector);
	float2 StrikeGradient = MixtormatGeneratorDestinationGradient(StrikeVector);

	float S = dot(UV, float2(BedWave));
	float2 SGradient = MixtormatGeneratorDestinationGradient(float2(BedWave));
	if (HasStructuralWarp != 0u)
	{
		StrikeGradient = mul(StrikeGradient, J);
		SGradient = mul(SGradient, J);
	}
	// B and its final gradient are destination-space; neither receives J again.
	if (HasHeightPush != 0u)
	{
		const float2 Texel = 1.0f / float2(OutputSize);
		S += HeightPushField.Load(int3(P, 0));
		SGradient += float2(
			HeightPushField.SampleLevel(LinearWrapSampler, DestinationUV + float2(Texel.x, 0.0f), 0.0f)
				- HeightPushField.SampleLevel(LinearWrapSampler, DestinationUV - float2(Texel.x, 0.0f), 0.0f),
			HeightPushField.SampleLevel(LinearWrapSampler, DestinationUV + float2(0.0f, Texel.y), 0.0f)
				- HeightPushField.SampleLevel(LinearWrapSampler, DestinationUV - float2(0.0f, Texel.y), 0.0f)) / (2.0f * Texel);
	}
	if (!isfinite(Strike) || !isfinite(S)) { StrataWriteInvalid(P); return; }
	if (Bend != 0.0f)
	{
		const int Period = max(BendScale, 1) * 2;
		// Compose two shears: younger cross-folds turn the older fold hinges without
		// independently warping each bed or losing the periodic structural frame.
		const float AcrossScale = 2.0f / (float)max(BedPeriod, 1);
		if (!isfinite(S * AcrossScale)) { StrataWriteInvalid(P); return; }
		const float2 Across = StrataFoldD(S * AcrossScale, 2, 0x165667b1u);
		Strike += Bend * 0.6f * (Across.x - 0.5f);
		StrikeGradient += Bend * 0.6f * Across.y * AcrossScale * SGradient;
		if (!isfinite(Strike * (float)Period) || !isfinite(Strike * (float)(Period * 3)))
		{
			StrataWriteInvalid(P); return;
		}
		const float2 Broad = StrataFoldD(Strike * (float)Period, Period, 0x5851f42du);
		const float2 Fine = StrataFoldD(Strike * (float)(Period * 3), Period * 3, 0xad90777du);
		const float Amplitude = Bend * length(float2(BedWave));
		S += Amplitude * ((Broad.x * 2.0f - 1.0f) + 0.15f * (Fine.x * 2.0f - 1.0f));
		SGradient += Amplitude * (2.0f * Broad.y + 0.9f * Fine.y) * (float)Period * StrikeGradient;
	}
	if (HeightFollow != 0.0f)
	{
		const float2 Texel = 1.0f / float2(OutputSize);
		const float Source = SourceHeight.Load(int3(P, 0));
		const float2 SourceGradient = float2(
			SourceHeight.SampleLevel(LinearWrapSampler, DestinationUV + float2(Texel.x, 0.0f), 0.0f)
				- SourceHeight.SampleLevel(LinearWrapSampler, DestinationUV - float2(Texel.x, 0.0f), 0.0f),
			SourceHeight.SampleLevel(LinearWrapSampler, DestinationUV + float2(0.0f, Texel.y), 0.0f)
				- SourceHeight.SampleLevel(LinearWrapSampler, DestinationUV - float2(0.0f, Texel.y), 0.0f)) / (2.0f * Texel);
		S += HeightFollow * (Source - 0.5f);
		SGradient += HeightFollow * SourceGradient;
	}

	// Reject non-finite coordinates before any bedding/noise integer indexing.
	if (!isfinite(S) || !isfinite(Strike * (float)max(BendScale, 1)))
	{
		StrataWriteInvalid(P); return;
	}
	int Bed = (int)floor(S);
	float2 Lower = StrataInterface(Bed, Strike);
	float2 Upper = StrataInterface(Bed + 1, Strike);
	if (S < Lower.x)
	{
		--Bed;
		Upper = Lower;
		Lower = StrataInterface(Bed, Strike);
	}
	else if (S >= Upper.x)
	{
		++Bed;
		Lower = Upper;
		Upper = StrataInterface(Bed + 1, Strike);
	}
	if (HasStructuralWarp != 0u)
	{
		const float FL = S - Lower.x;
		const float FU = Upper.x - S;
		const float2 gL = SGradient - Lower.y * StrikeGradient;
		const float2 gU = Upper.y * StrikeGradient - SGradient;
		const float LengthL = length(gL);
		const float LengthU = length(gU);
		if (all(isfinite(Lower)) && all(isfinite(Upper)) && Upper.x > Lower.x
			&& isfinite(FL) && isfinite(FU) && FL >= 0.0f && FU >= 0.0f
			&& all(isfinite(gL)) && all(isfinite(gU))
			&& isfinite(LengthL) && isfinite(LengthU) && LengthL > 1e-12f && LengthU > 1e-12f)
		{
			// Local negative-inside interface distance in destination UV units.
			const float Distance = -min(FL / LengthL, FU / LengthU);
			if (isfinite(Distance)) { OutBoundaryField[P] = float2(Distance, 1.0f); }
		}
	}
	const float Thickness = max(Upper.x - Lower.x, 1.0e-5f);
	const float T = saturate((S - Lower.x) / Thickness);
	const float2 TGradient = (SGradient - lerp(Lower.y, Upper.y, T) * StrikeGradient) / Thickness;
	const float PixelT = StrataFootprint(TGradient);
	const float Hardness = StrataHardness(Bed);

	// Hard beds stand proud and retain broad planar shelves. Soft beds recede and have wider
	// rounded shoulders. Seam height is shared by the two beds, not a per-bed sawtooth reset.
	const float ShelfHeight = lerp(-0.3f, 0.3f, Hardness)
		- max(SoftRecession, 0.0f) * 0.25f * (1.0f - Hardness)
		+ HeightVariation * 0.3f * (StrataBedRandom(Bed, 0x14057b7eu) - 0.5f);
	const float Shoulder = lerp(0.42f, 0.08f, saturate(LedgeWidth))
		* lerp(1.35f, 0.65f, Hardness) * lerp(1.25f, 0.55f, saturate(Verticality));
	const float EdgeWidth = max(min(Shoulder, 0.49f), max(PixelT, 1.0e-5f));
	const float LowerFace = saturate(T / EdgeWidth);
	const float UpperFace = saturate((1.0f - T) / EdgeWidth);
	const float LowerBlend = lerp(smoothstep(0.0f, 1.0f, LowerFace), LowerFace, saturate(Verticality));
	const float UpperBlend = lerp(smoothstep(0.0f, 1.0f, UpperFace), UpperFace, saturate(Verticality));
	const float Interior = LowerBlend * UpperBlend;
	float Strata = ShelfHeight
		+ (StrataSeamHeight(Bed) - ShelfHeight) * (1.0f - LowerBlend)
		+ (StrataSeamHeight(Bed + 1) - ShelfHeight) * (1.0f - UpperBlend);

	if (Lamination != 0.0f)
	{
		const int Count = 3 + (int)floor(StrataBedRandom(Bed, 0x632be59bu) * 5.0f);
		const int Period = max(BendScale, 1) * 2;
		const uint Key = StrataBedKey(Bed, 0x94d049bbu);
		if (!isfinite(Strike * (float)Period)) { StrataWriteInvalid(P); return; }
		const float2 Cross = StrataFoldD(Strike * (float)Period, Period, Key);
		// A bounded shear fans laminae inside each bed and anchors both contacts.
		// Unlike integer tilt, CrossBedding responds continuously to the slider.
		const float CrossAmount = 0.22f * clamp(CrossBedding, 0.0f, 3.0f);
		const float Envelope = 4.0f * T * (1.0f - T);
		const float Phase = T * (float)Count + CrossAmount * (Cross.x - 0.5f) * Envelope;
		const float2 PhaseGradient = ((float)Count + CrossAmount * (Cross.x - 0.5f)
			* 4.0f * (1.0f - 2.0f * T)) * TGradient
			+ CrossAmount * Cross.y * (float)Period * Envelope * StrikeGradient;
		if (!isfinite(Phase)) { StrataWriteInvalid(P); return; }
		int Lamina = min((int)floor(Phase), Count - 1);
		float2 A = StrataLaminaInterface(Lamina, Count, Strike, Period, Key);
		float2 B = StrataLaminaInterface(Lamina + 1, Count, Strike, Period, Key);
		if (Phase < A.x)
		{
			--Lamina;
			B = A;
			A = StrataLaminaInterface(Lamina, Count, Strike, Period, Key);
		}
		else if (Phase >= B.x && Lamina < Count - 1)
		{
			++Lamina;
			A = B;
			B = StrataLaminaInterface(Lamina + 1, Count, Strike, Period, Key);
		}
		const float Span = max(B.x - A.x, 1.0e-5f);
		const float U = saturate((Phase - A.x) / Span);
		const float2 UGradient = (PhaseGradient - lerp(A.y, B.y, U) * StrikeGradient) / Span;
		const float Footprint = StrataFootprint(UGradient);
		const float Visibility = 1.0f - smoothstep(0.2f, 0.65f, Footprint);
		const float Draw = StrataRandom(Lamina, Count, Key ^ 0x7feb352du);
		// Thin rock plates, not identical incised lines: asymmetric planar shoulders,
		// variable resistance and thickness, with a shared recessed contact level.
		const float Bevel = max(lerp(0.12f, 0.3f, Draw), max(Footprint, 1.0e-5f));
		const float Plate = min(1.0f, min(U / Bevel, (1.0f - U) / (Bevel * 0.55f)));
		const float Relief = -0.055f + Plate * lerp(0.075f, 0.22f, Draw);
		Strata += Lamination * lerp(1.0f, 0.45f, Hardness) * Relief * Visibility * Interior;
	}

	if (Breakup != 0.0f)
	{
		const int JointPeriod = max(JointScale, 1);
		const uint Key = StrataBedKey(Bed, 0x9e3779b1u);
		// Anisotropic cells are long along bedding and have oblique cross joints.
		const float2 Q = float2(Strike * (float)JointPeriod, T * 1.6f)
			+ float2(StrataBedRandom(Bed, 0x68bc21ebu), 0.37f);
		if (!all(isfinite(Q))) { StrataWriteInvalid(P); return; }
		float2 Local;
		float Draw;
		float2 Tilt;
		const float2 Planes = StrataCellPlanes(Q, JointPeriod, Key, Local, Draw, Tilt);
		const float PixelQ = max((float)JointPeriod * StrataFootprint(StrikeGradient), 1.6f * PixelT);
		const float Visibility = 1.0f - smoothstep(0.2f, 0.7f, PixelQ);
		const float RoofOffset = (Draw - 0.5f) * 0.45f + dot(Local, Tilt) * 0.18f;
		// Closing joints must also close per-cell height discontinuities.
		const float ClosedRelief = RoofOffset * saturate(Planes.x / max(0.12f, PixelQ));
		float SlabRelief = ClosedRelief;
		if (JointWidth > 0.0f)
		{
			const float FloorHeight = min(StrataSeamHeight(Bed), StrataSeamHeight(Bed + 1)) - 0.25f;
			const float Roof = Strata + RoofOffset;
			const float Chamfer = max(lerp(0.2f, 0.055f, saturate(Verticality)), PixelQ);
			const float Slope = 1.0f / max(Chamfer, 1.0e-5f);
			// Solve the top/chamfer plane intersection of an extruded cell for height.
			// A second diagonal plane clips corners into chips instead of rounded pits.
			const float Wall = FloorHeight + max(0.0f, Planes.x - JointWidth) * Slope;
			const float Corner = FloorHeight + max(0.0f, Planes.x + Planes.y
				- 2.0f * JointWidth - Chamfer * 0.35f) * Slope * 0.70710678f;
			const float CellHeight = max(FloorHeight, min(Roof, min(Wall, Corner)));
			const float Open = saturate(JointWidth / max(PixelQ, 1.0e-5f));
			SlabRelief = lerp(ClosedRelief, CellHeight - Strata, Open);
		}
		Strata += Breakup * Visibility * Interior * SlabRelief;
	}

	OutBedIds[P] = (uint)MixtormatWrapI(Bed, BedPeriod);
	OutBedPosition[P] = T;
	OutBedRandom[P] = StrataBedRandom(Bed, 0xad90777du);

	float Amount = 1.0f;
	if (MaskInfluence > 0.0f && HasScopedMask != 0u)
	{
		Amount *= lerp(1.0f, ResolveMask.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f), MaskInfluence);
	}
	if (IDInfluence > 0.0f && HasRegionIds != 0u)
	{
		const uint RegionId = ResolveRegionIds.Load(int3(P, 0));
		if (RegionId != MIXTORMAT_INVALID_REGION)
		{
			const uint RegionSeed = MixtormatRegionSeed(RegionId, Seed);
			Amount *= lerp(1.0f, 0.5f + MixtormatRegionRandomSalted(RegionSeed, 0x9e3779b1u), IDInfluence);
		}
	}
	OutHeight[P] = Strata * Depth * Amount;
}
