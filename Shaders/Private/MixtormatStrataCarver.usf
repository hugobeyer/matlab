#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGully.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorPlacement.ush"

// Strata Carver: a stack of beds, each weathered into a ramp and a face.
//
// Tilted strata seen on a surface read as a sawtooth: every bed rises along a dip slope and ends
// in a steeper face where the next bed starts. So the field is built in that order --
//
//     bedding coordinate S    dot(uv, wave) + bend + height follow
//         -> which bed, and how far up it (T, 0..1)
//         -> the bed's ramp from its own base to its crest, then the face down to the next
//            bed's base
//         -> breakup chips bitten out of the crest, and laminae carved into the ramp
//
// The beds are bent by offsetting S, never by warping the domain. A domain warp moves the
// coordinate the beds are sampled at, which pulls beds apart in one place and crushes them in
// another; offsetting S by a low-frequency field bends them as a whole and keeps their thickness.
//
// TILING is the constraint everything is arranged around. The wave vector is an integer lattice
// vector, so S advances by a whole number of beds per tile; every per-bed random is hashed from
// the bed index wrapped by BedPeriod, the number of distinct beds before the column repeats; and
// every noise is periodic on the tile.

#define MIXTORMAT_STRATA_TAU 6.28318530718f

// Salts: independent draws off one bed index, so a thick bed is not also always the tall one.
#define MIXTORMAT_SALT_STRATA_BOUNDARY 0x3b9aca07u
#define MIXTORMAT_SALT_STRATA_BASE     0x5851f42du
#define MIXTORMAT_SALT_STRATA_RISE     0x2545f491u
#define MIXTORMAT_SALT_STRATA_CROSS    0x14057b7eu
#define MIXTORMAT_SALT_STRATA_RANDOM   0xad90777du
#define MIXTORMAT_SALT_STRATA_DEPTH    0x9e3779b1u

// Laminae per bed. The cross-bedding tilt is a whole number of laminae per tile of strike, so
// a bed's laminae meet themselves at the seam; that fixes the ratio of tilt to spacing, and
// this is the spacing.
#define MIXTORMAT_STRATA_LAMINAE 6.0f

// Chips per bed spacing along the strike: long bites out of a crest, not grain.
#define MIXTORMAT_STRATA_BREAKUP_SCALE 4

int2 BedWave;
int2 BedPerp;
int BedPeriod;
int2 OutputSize;

uint Seed;
float ThicknessVariation;
float HeightVariation;
float Verticality;
float RampShape;
float Bend;
int BendScale;
float Breakup;
float HeightFollow;
float Lamination;
float CrossBedding;

float Depth;
float MaskInfluence;
float IDInfluence;
uint HasScopedMask;
uint HasRegionIds;

Texture2D<float> SourceHeight;
Texture2D<float> ResolveMask;
Texture2D<uint> ResolveRegionIds;
SamplerState LinearWrapSampler;

RWTexture2D<float> OutHeight;
RWTexture2D<uint> OutBedIds;
RWTexture2D<float> OutBedPosition;
RWTexture2D<float> OutBedRandom;

float MixtormatStrataBedRandom(int Bed, uint Salt)
{
	const uint Wrapped = (uint)MixtormatWrapI(Bed, BedPeriod);
	return (float)(MixtormatHashU(Wrapped * 0x9e3779b1u ^ Seed * 0x85ebca6bu ^ Salt) & 0x00ffffffu)
		* (1.0f / 16777216.0f);
}

// Where bed K starts, in units of S. Each boundary is jittered by up to half a bed either way, so
// neighbouring boundaries can approach but never cross while ThicknessVariation is at most 1.
float MixtormatStrataBoundary(int Bed)
{
	return (float)Bed
		+ ThicknessVariation * (MixtormatStrataBedRandom(Bed, MIXTORMAT_SALT_STRATA_BOUNDARY) - 0.5f);
}

// The height a bed's ramp starts from. HeightVariation lifts or drops whole beds so they do not
// all bottom out at the same level.
float MixtormatStrataBase(int Bed)
{
	return HeightVariation * (MixtormatStrataBedRandom(Bed, MIXTORMAT_SALT_STRATA_BASE) - 0.5f) * 0.5f;
}

// How far a bed's ramp climbs. 1 for every bed at HeightVariation 0.
float MixtormatStrataRise(int Bed)
{
	return lerp(1.0f, 0.25f + 0.75f * MixtormatStrataBedRandom(Bed, MIXTORMAT_SALT_STRATA_RISE), HeightVariation);
}

// The dip slope. RampShape -1 hollows it, +1 bulges it, 0 is straight. Polynomials rather than
// pow, so X = 0 needs no guard.
float MixtormatStrataRamp(float X)
{
	const float Hollow = X * X;
	const float Bulge = X * (2.0f - X);
	return RampShape >= 0.0f ? lerp(X, Bulge, RampShape) : lerp(X, Hollow, -RampShape);
}

// Chip depth along a bed's crest, 0..1. One-dimensional along the strike, so chips are long bites
// out of the edge rather than isotropic blobs. Q advances by a multiple of BedPeriod per tile, so
// a lattice wrapped at BedPeriod * Scale closes on the tile. Keyed on the bed as well, so
// neighbouring crests do not chip in step.
float MixtormatStrataChip(float Q, int Bed, int Scale)
{
	const int Period = BedPeriod * Scale;
	const float X = Q * (float)Scale;
	const int I = (int)floor(X);
	const float F = X - (float)I;
	const uint BedKey = (uint)MixtormatWrapI(Bed, BedPeriod) * 0x27d4eb2du;
	const float A = (float)(MixtormatHashU((uint)MixtormatWrapI(I, Period) * 0x165667b1u ^ BedKey ^ Seed * 0x85ebca6bu) & 0x00ffffffu)
		* (1.0f / 16777216.0f);
	const float B = (float)(MixtormatHashU((uint)MixtormatWrapI(I + 1, Period) * 0x165667b1u ^ BedKey ^ Seed * 0x85ebca6bu) & 0x00ffffffu)
		* (1.0f / 16777216.0f);
	return lerp(A, B, F * F * (3.0f - 2.0f * F));
}

[numthreads(8, 8, 1)]
void ResolveCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize))) { return; }

	const int2 P = int2(DispatchThreadId.xy);
	const float2 DestinationUV = (float2(P) + 0.5f) / float2(OutputSize);
		const float2 UV = MixtormatGeneratorUV(DestinationUV);
	const float Source = SourceHeight.Load(int3(P, 0));
	const float BedsPerTile = length(float2(BedWave));

	// Bend is authored in tile widths, so the same value bends thick and thin beds by the same
	// distance on the surface. Two octaves: the broad sweep and a softer half-size wobble.
	const int BendPeriod = max(BendScale, 1);
	const float BendField =
		MixtormatPeriodicNoiseD(UV * (float)BendPeriod, BendPeriod, Seed + 7717u).x
		+ 0.5f * MixtormatPeriodicNoiseD(UV * (float)(BendPeriod * 2), BendPeriod * 2, Seed + 8191u).x;

	// Height follow makes the beds terrace the surface instead of lying on it: the same bed sits
	// further along where the source is higher, so the faces trace its contours.
	//
	// Breakup is deliberately not here. Anything added to S moves every pixel of every ramp, which
	// is what turned the soft slopes into blobs; breakup only ever moves the crest edge, below.
	const float S = dot(UV, float2(BedWave))
		+ Bend * BedsPerTile * BendField
		+ HeightFollow * (Source - 0.5f);
	// Position along the strike, for the chips and the cross-bedding.
	const float Q = dot(UV, float2(BedPerp));

	int Bed = (int)floor(S);
	if (S < MixtormatStrataBoundary(Bed))
	{
		Bed -= 1;
	}
	else if (S >= MixtormatStrataBoundary(Bed + 1))
	{
		Bed += 1;
	}

	const float Lower = MixtormatStrataBoundary(Bed);
	const float Thickness = max(MixtormatStrataBoundary(Bed + 1) - Lower, 1.0e-5f);
	const float T = (S - Lower) / Thickness;

	// The face takes this share of the bed: half of it at Verticality 0, which is a symmetric
	// ridge, down to one texel at Verticality 1, a sheer wall. The texel term is what keeps a
	// sheer wall a clean edge rather than a stair. A negative share has no geometry, hence the
	// guard; RampEnd is guarded for the same reason when Verticality is driven far below 0.
	const float PixelBeds = GeneratorLayer != 0u
			? length(MixtormatGeneratorDestinationGradient(float2(BedWave))) : BedsPerTile;
		const float PixelT = PixelBeds / ((float)max(OutputSize.x, 1) * Thickness);
	const float Face = max(0.5f * (1.0f - Verticality), 0.0f) + PixelT;
	const float RampEnd = max(1.0f - Face, 1.0e-5f);

	// Breakup bites back into the crest only. The face starts earlier where a chip is, and the
	// ramp before it is exactly what it is with no breakup. Breakup is a share of the bed.
	const float Chip = 0.65f * MixtormatStrataChip(Q, Bed, MIXTORMAT_STRATA_BREAKUP_SCALE)
		+ 0.35f * MixtormatStrataChip(Q, Bed, MIXTORMAT_STRATA_BREAKUP_SCALE * 2);
	const float FaceStart = RampEnd - Breakup * Chip;

	const float Base = MixtormatStrataBase(Bed);
	const float Crest = Base + MixtormatStrataRise(Bed);
	const float NextBase = MixtormatStrataBase(Bed + 1);
	float Strata;
	if (T < FaceStart)
	{
		Strata = lerp(Base, Crest, MixtormatStrataRamp(T / RampEnd));
	}
	else
	{
		// The face, moved back to the chip. It drops from wherever the ramp had reached down to
		// the next bed's base and stays there -- a chip is a notch, not a smear -- so the surface
		// is still continuous where the next bed starts. A chip deeper than the ramp has no ramp
		// left to start from, hence the guard.
		const float EdgeHeight = lerp(Base, Crest, MixtormatStrataRamp(max(FaceStart, 0.0f) / RampEnd));
		Strata = lerp(EdgeHeight, NextBase, smoothstep(0.0f, 1.0f, (T - FaceStart) / Face));
	}

	// Laminae, carved. Thin grooves cut into the ramp at each lamina line, fading out before the
	// face so the faces stay clean. Each bed draws its own whole-number cross-bedding tilt, so the
	// grooves fan between beds. The groove is never narrower than a texel, or it stair-steps.
	const float CrossDraw = MixtormatStrataBedRandom(Bed, MIXTORMAT_SALT_STRATA_CROSS) * 2.0f - 1.0f;
	const float Cross = round(CrossDraw * CrossBedding);
	const float LaminaPhase = MIXTORMAT_STRATA_LAMINAE * T + Cross * Q;
	const float LineDistance = abs(frac(LaminaPhase + 0.5f) - 0.5f);
	const float GrooveWidth = 0.12f + PixelT * MIXTORMAT_STRATA_LAMINAE;
	const float Groove = 1.0f - smoothstep(0.0f, GrooveWidth, LineDistance);
	const float OnRamp = 1.0f - smoothstep(FaceStart - 2.0f * GrooveWidth / MIXTORMAT_STRATA_LAMINAE, FaceStart, T);
	Strata -= Lamination * 0.15f * Groove * OnRamp;

	OutBedIds[P] = (uint)MixtormatWrapI(Bed, BedPeriod);
	OutBedPosition[P] = T;
	OutBedRandom[P] = MixtormatStrataBedRandom(Bed, MIXTORMAT_SALT_STRATA_RANDOM);

	float Amount = 1.0f;
	if (MaskInfluence > 0.0f && HasScopedMask != 0)
	{
		const float MaskValue = ResolveMask.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f);
		Amount *= lerp(1.0f, MaskValue, MaskInfluence);
	}
	if (IDInfluence > 0.0f && HasRegionIds != 0)
	{
		const uint RegionId = ResolveRegionIds.Load(int3(P, 0));
		if (RegionId != MIXTORMAT_INVALID_REGION)
		{
			const uint RegionSeed = MixtormatRegionSeed(RegionId, Seed);
			const float Draw = MixtormatRegionRandomSalted(RegionSeed, MIXTORMAT_SALT_STRATA_DEPTH);
			Amount *= lerp(1.0f, 0.5f + Draw, IDInfluence);
		}
	}

	// Strata runs about 0..1 from a bed's base to its crest. Relief is the same shape centred on
	// zero, and the layer's height is that relief about the flat midpoint. How it meets the stack
	// below is the layer's Height Op. Mask and ID influence scale the relief itself.
	OutHeight[P] = 0.5f + (Strata - 0.5f) * Depth * Amount;
}
