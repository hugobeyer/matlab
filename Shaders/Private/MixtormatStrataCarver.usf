#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGully.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorPlacement.ush"

// Geological strata, not a sawtooth: ordered interfaces enclose hard shelves and softer
// recessed beds. A common fold moves the entire stack; bounded interface variation changes
// thickness without crossing. Joints split each shelf into planar slabs and chip their rims.
// All randomness wraps in the integer bedding/strike lattice, including neighboring beds.
// Height is a signed field; IDs, bed position and bed random retain their published meanings.

int2 BedWave;
int2 BedPerp;
int BedPeriod;
int2 OutputSize;

// @param Seed
uint Seed;
// @param ThicknessVariation saturates
float ThicknessVariation;
// @param HeightVariation
float HeightVariation;
// @param Verticality saturates
float Verticality;
// @param LedgeWidth saturates
float LedgeWidth;
// @param HardnessContrast saturates
float HardnessContrast;
// @param SoftRecession
float SoftRecession;
// @param Bend
float Bend;
// @param BendScale
int BendScale;
// @param Breakup
float Breakup;
// @param JointScale
int JointScale;
// @param JointWidth
float JointWidth;
// @param HeightFollow
float HeightFollow;
// @param Lamination
float Lamination;
// @param CrossBedding
float CrossBedding;
// @param Depth
float Depth;
// @param MaskInfluence
float MaskInfluence;
// @param IDInfluence
float IDInfluence;
uint HasScopedMask;
uint HasRegionIds;

Texture2D<float> SourceHeight;
Texture2D<float> ResolveMask;
Texture2D<uint> ResolveRegionIds;
SamplerState LinearWrapSampler;

RWTexture2D<float> OutHeight;
RWTexture2D<uint> OutBedIds;
RWTexture2D<float> OutBedPosition;
RWTexture2D<float> OutBedRandom;

float StrataRandom(int Index, int Period, uint Key)
{
	const uint Wrapped = (uint)MixtormatWrapI(Index, Period);
	return (float)(MixtormatHashU(Wrapped * 0x9e3779b1u ^ Seed * 0x85ebca6bu ^ Key) & 0x00ffffffu)
		* (1.0f / 16777216.0f);
}

uint StrataBedKey(int Bed, uint Salt)
{
	return MixtormatHashU((uint)MixtormatWrapI(Bed, BedPeriod) * 0x27d4eb2du ^ Salt);
}

float StrataBedRandom(int Bed, uint Salt)
{
	return StrataRandom(Bed, BedPeriod, Salt);
}

// Value and analytic derivative in lattice units. Cubic interpolation stays within 0..1,
// which is necessary for the ordered-interface bound below.
float2 StrataNoiseD(float X, int Period, uint Key)
{
	const int I = (int)floor(X);
	const float F = X - (float)I;
	const float A = StrataRandom(I, Period, Key);
	const float B = StrataRandom(I + 1, Period, Key);
	return float2(lerp(A, B, F * F * (3.0f - 2.0f * F)), (B - A) * 6.0f * F * (1.0f - F));
}

// Position in bed units and derivative with respect to the primitive strike coordinate.
// Each interface stays within +/-0.44 of its index: adjacent beds remain at least 0.12 wide.
// Both sides evaluate the same interface, so the seam position and depth cannot disagree.
float2 StrataInterface(int Bed, float Strike)
{
	if (ThicknessVariation == 0.0f) { return float2((float)Bed, 0.0f); }
	const int Period = max(BendScale, 1);
	const float2 Lateral = StrataNoiseD(Strike * (float)Period, Period, StrataBedKey(Bed, 0x3b9aca07u));
	const float Offset = 0.65f * (StrataBedRandom(Bed, 0x165667b1u) * 2.0f - 1.0f)
		+ 0.35f * (Lateral.x * 2.0f - 1.0f);
	const float Amplitude = 0.44f * saturate(ThicknessVariation);
	return float2((float)Bed + Amplitude * Offset, Amplitude * 0.7f * Lateral.y * (float)Period);
}

float StrataHardness(int Bed)
{
	return lerp(0.5f, StrataBedRandom(Bed, 0x2545f491u), saturate(HardnessContrast));
}

float StrataSeamHeight(int Boundary)
{
	const float Softness = 1.0f - 0.5f * (StrataHardness(Boundary - 1) + StrataHardness(Boundary));
	return -0.18f - max(SoftRecession, 0.0f) * (0.2f + 0.55f * Softness);
}

float StrataJointBoundary(int Joint, int Period, uint Key)
{
	return (float)Joint + 0.5f * (StrataRandom(Joint, Period, Key) - 0.5f);
}

float StrataFootprint(float2 DestinationGradient)
{
	return dot(abs(DestinationGradient) / float2(OutputSize), float2(1.0f, 1.0f));
}

[numthreads(8, 8, 1)]
void ResolveCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize))) { return; }

	const int2 P = int2(DispatchThreadId.xy);
	const float2 DestinationUV = (float2(P) + 0.5f) / float2(OutputSize);
	const float2 UV = MixtormatGeneratorUV(DestinationUV);
	const float2 StrikeVector = float2(BedPerp) / (float)max(BedPeriod, 1);
	const float Strike = dot(UV, StrikeVector);
	const float2 StrikeGradient = MixtormatGeneratorDestinationGradient(StrikeVector);

	float S = dot(UV, float2(BedWave));
	float2 SGradient = MixtormatGeneratorDestinationGradient(float2(BedWave));
	if (Bend != 0.0f)
	{
		const int Period = max(BendScale, 1);
		const float2 Broad = StrataNoiseD(Strike * (float)Period, Period, 0x5851f42du);
		const float2 Fine = StrataNoiseD(Strike * (float)(Period * 2), Period * 2, 0xad90777du);
		const float Amplitude = Bend * length(float2(BedWave));
		S += Amplitude * ((Broad.x * 2.0f - 1.0f) + 0.25f * (Fine.x * 2.0f - 1.0f));
		SGradient += Amplitude * (2.0f * Broad.y + Fine.y) * (float)Period * StrikeGradient;
	}
	if (HeightFollow != 0.0f)
	{
		const float2 Texel = 1.0f / float2(OutputSize);
		const float Source = SourceHeight.Load(int3(P, 0));
		const float2 SourceGradient = float2(
			SourceHeight.SampleLevel(LinearWrapSampler, DestinationUV + float2(Texel.x, 0.0f), 0.0f)
				- SourceHeight.SampleLevel(LinearWrapSampler, DestinationUV - float2(Texel.x, 0.0f), 0.0f),
			SourceHeight.SampleLevel(LinearWrapSampler, DestinationUV + float2(0.0f, Texel.y), 0.0f)
				- SourceHeight.SampleLevel(LinearWrapSampler, DestinationUV - float2(0.0f, Texel.y), 0.0f)) / (2.0f * Texel);
		S += HeightFollow * (Source - 0.5f);
		SGradient += HeightFollow * SourceGradient;
	}

	int Bed = (int)floor(S);
	float2 Lower = StrataInterface(Bed, Strike);
	float2 Upper = StrataInterface(Bed + 1, Strike);
	if (S < Lower.x)
	{
		--Bed;
		Upper = Lower;
		Lower = StrataInterface(Bed, Strike);
	}
	else if (S >= Upper.x)
	{
		++Bed;
		Lower = Upper;
		Upper = StrataInterface(Bed + 1, Strike);
	}
	const float Thickness = max(Upper.x - Lower.x, 1.0e-5f);
	const float T = saturate((S - Lower.x) / Thickness);
	const float2 TGradient = (SGradient - lerp(Lower.y, Upper.y, T) * StrikeGradient) / Thickness;
	const float PixelT = StrataFootprint(TGradient);
	const float Hardness = StrataHardness(Bed);

	// Hard beds stand proud and retain broad planar shelves. Soft beds recede and have wider
	// rounded shoulders. Seam height is shared by the two beds, not a per-bed sawtooth reset.
	const float ShelfHeight = lerp(-0.1f - 0.25f * max(SoftRecession, 0.0f), 0.55f, Hardness)
		+ HeightVariation * 0.3f * (StrataBedRandom(Bed, 0x14057b7eu) - 0.5f);
	const float Shoulder = lerp(0.42f, 0.08f, saturate(LedgeWidth))
		* lerp(1.35f, 0.65f, Hardness) * lerp(1.25f, 0.55f, saturate(Verticality));
	const float EdgeWidth = max(min(Shoulder, 0.49f), max(PixelT, 1.0e-5f));
	const float LowerFace = saturate(T / EdgeWidth);
	const float UpperFace = saturate((1.0f - T) / EdgeWidth);
	const float LowerBlend = lerp(smoothstep(0.0f, 1.0f, LowerFace), LowerFace, saturate(Verticality));
	const float UpperBlend = lerp(smoothstep(0.0f, 1.0f, UpperFace), UpperFace, saturate(Verticality));
	const float Interior = LowerBlend * UpperBlend;
	float Strata = ShelfHeight
		+ (StrataSeamHeight(Bed) - ShelfHeight) * (1.0f - LowerBlend)
		+ (StrataSeamHeight(Bed + 1) - ShelfHeight) * (1.0f - UpperBlend);

	if (Breakup != 0.0f)
	{
		const int Period = max(JointScale, 1);
		const uint Key = StrataBedKey(Bed, 0x9e3779b1u);
		const float Q = Strike * (float)Period + StrataBedRandom(Bed, 0x68bc21ebu);
		int Slab = (int)floor(Q);
		float Left = StrataJointBoundary(Slab, Period, Key);
		float Right = StrataJointBoundary(Slab + 1, Period, Key);
		if (Q < Left)
		{
			--Slab;
			Right = Left;
			Left = StrataJointBoundary(Slab, Period, Key);
		}
		else if (Q >= Right)
		{
			++Slab;
			Left = Right;
			Right = StrataJointBoundary(Slab + 1, Period, Key);
		}
		const float U = saturate((Q - Left) / (Right - Left));
		const float PixelQ = (float)Period * StrataFootprint(StrikeGradient);
		const float DetailVisibility = 1.0f - smoothstep(0.25f, 0.75f, PixelQ);
		const float SlabDraw = StrataRandom(Slab, Period, Key ^ 0x85ebca6bu);
		const float Tilt = StrataRandom(Slab, Period, Key ^ 0xc2b2ae35u) * 2.0f - 1.0f;
		// Keep slab tilt continuous where a closed joint has no cut to hide a height jump.
		const float SlabInterior = smoothstep(0.0f, 0.15f, min(U, 1.0f - U));
		Strata += Breakup * DetailVisibility * Interior * SlabInterior
			* ((SlabDraw - 0.5f) * 0.35f + Tilt * (U - 0.5f) * 0.2f);

		// Cuts attach to bed seams, with shared random values on either side of each joint.
		// Wedge chips are intersections of bed-edge and joint distances, not fine noise bites.
		if (JointWidth > 0.0f)
		{
			float Cut = 0.0f;
			[unroll]
			for (int Side = 0; Side < 2; ++Side)
			{
				const int Joint = Slab + Side;
				const float D = Side == 0 ? Q - Left : Right - Q;
				const float Draw = StrataRandom(Joint, Period, Key ^ 0x7feb352du);
				const float Along = Draw < 0.5f ? T : 1.0f - T;
				const float Reach = lerp(0.35f, 1.15f, StrataRandom(Joint, Period, Key ^ 0x846ca68bu));
				const float Width = JointWidth * lerp(0.65f, 1.35f, Draw);
				const float FilterWidth = max(Width, max(PixelQ, 1.0e-5f));
				const float JointMask = (1.0f - smoothstep(0.0f, FilterWidth, D)) * Width / FilterWidth;
				const float EndMask = 1.0f - smoothstep(Reach, Reach + 0.12f, Along);
				const float Chip = saturate(1.0f - D / max(FilterWidth * 4.0f, 1.0e-5f) - Along / 0.28f);
				Cut = max(Cut, JointMask * EndMask + Chip * 0.6f);
			}
			Strata -= Breakup * DetailVisibility * Interior * Cut * lerp(0.65f, 1.1f, Hardness);
		}
	}

	if (Lamination != 0.0f)
	{
		const float Count = 4.0f + floor(StrataBedRandom(Bed, 0x632be59bu) * 5.0f);
		const float Cross = round((StrataBedRandom(Bed, 0x94d049bbu) * 2.0f - 1.0f) * CrossBedding);
		const float Phase = T * Count + Cross * Strike;
		const float Footprint = StrataFootprint(TGradient * Count + Cross * StrikeGradient);
		const float Width = max(0.1f, Footprint);
		const float Line = (1.0f - smoothstep(0.0f, Width, abs(frac(Phase + 0.5f) - 0.5f))) * 0.1f / Width;
		const float Visibility = 1.0f - smoothstep(0.25f, 0.5f, Footprint);
		Strata -= Lamination * 0.12f * (1.0f - 0.65f * Hardness) * Line * Visibility * Interior;
	}

	OutBedIds[P] = (uint)MixtormatWrapI(Bed, BedPeriod);
	OutBedPosition[P] = T;
	OutBedRandom[P] = StrataBedRandom(Bed, 0xad90777du);

	float Amount = 1.0f;
	if (MaskInfluence > 0.0f && HasScopedMask != 0u)
	{
		Amount *= lerp(1.0f, ResolveMask.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f), MaskInfluence);
	}
	if (IDInfluence > 0.0f && HasRegionIds != 0u)
	{
		const uint RegionId = ResolveRegionIds.Load(int3(P, 0));
		if (RegionId != MIXTORMAT_INVALID_REGION)
		{
			const uint RegionSeed = MixtormatRegionSeed(RegionId, Seed);
			Amount *= lerp(1.0f, 0.5f + MixtormatRegionRandomSalted(RegionSeed, 0x9e3779b1u), IDInfluence);
		}
	}
	OutHeight[P] = Strata * Depth * Amount;
}
