#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGully.ush"
#include "/Plugin/Mixtormat/Private/MixtormatCurvature.ush"

Texture2D<float4> SurfaceNormal;
Texture2D<float4> SurfaceRAM;
Texture2D<float> SurfaceHeight;
Texture2D<float> ChildMask;
Texture2D<float4> PeelOwnMask;
Texture2D<float2> PreviousArrival;
Texture2D<float> GrowthField;
SamplerState LinearWrapSampler;

RWTexture2D<float2> OutputArrival;
RWTexture2D<float> OutputGrowth;
RWTexture2D<float4> OutputFieldA;
RWTexture2D<float4> OutputFieldB;

int2 OutputSize;
int2 SolveSize;
int Mode;
uint SurfaceValid;
uint FlipNormalY;

uint Seed;
float MaskWeight;
float PeelMaskTiling;
uint PeelMaskInvert;
uint UseOwnMask;
float SeedThreshold;

int CurvatureRadius;
int CurvatureSmoothing;
float CurvatureWeight;
float CurvatureBias;
float AOWeight;
float HeightWeight;
uint NormalizeWeights;
float GrowthStrength;

int MacroPeriod;
int MicroPeriod;
float NoiseWeight;
float SizeVariation;
int FlakeCells;
float ClusterAmount;
int WarpPeriod;
float WarpAmount;
float WarpSource;

int PeelType;
float Front;
float Width;
float MacroWarp;
float MicroWarp;
float MicroMorph;
float Thickness;
float Lift;
float DetailStrength;
float LiftVariation;
float EdgeSharpness;

#define PEEL_FAR 1024.0f

int PeelWrapI(int x, int n)
{
	x %= max(n, 1);
	return x < 0 ? x + n : x;
}

int2 PeelWrapP(int2 p, int2 n)
{
	return int2(
		PeelWrapI(p.x, n.x),
		PeelWrapI(p.y, n.y));
}

float PeelSmooth(float x)
{
	x = saturate(x);
	return x * x * (3.0f - 2.0f * x);
}

uint PeelHashGrid(int2 p, int2 period, uint salt)
{
	p = PeelWrapP(p, period);

	return MixtormatHashU(
		(uint)p.x * 73856093u ^
		(uint)p.y * 19349663u ^
		Seed * 2654435761u ^
		salt);
}

float PeelHash01(int2 p, int2 period, uint salt)
{
	return
		(float)(PeelHashGrid(p, period, salt) & 0x00ffffffu)
		* (1.0f / 16777215.0f);
}

float PeelNoise(float2 uv, int2 period, uint salt)
{
	period = max(period, int2(1, 1));

	float2 p = frac(uv) * float2(period);
	int2 i = int2(floor(p));
	float2 f = frac(p);
	float2 s = f * f * (3.0f - 2.0f * f);

	float a = PeelHash01(i, period, salt);
	float b = PeelHash01(i + int2(1, 0), period, salt);
	float c = PeelHash01(i + int2(0, 1), period, salt);
	float d = PeelHash01(i + int2(1, 1), period, salt);

	return lerp(
		lerp(a, b, s.x),
		lerp(c, d, s.x),
		s.y);
}

float PeelFBM(float2 uv, int period, uint salt)
{
	period = max(period, 1);

	float sum = 0.0f;
	float norm = 0.0f;
	float amp = 0.5f;

	[unroll]
	for (int i = 0; i < 4; ++i)
	{
		int p = min(period << i, 512);

		sum +=
			PeelNoise(
				uv,
				int2(p, p),
				salt + (uint)i * 0x9e3779b9u)
			* amp;

		norm += amp;
		amp *= 0.5f;
	}

	return sum / max(norm, 1.0e-6f);
}

float PeelMask(float2 uv)
{
	if (UseOwnMask != 0)
	{
		float2 muv =
			frac(
				uv * max(
					PeelMaskTiling,
					1.0f));

		float m =
			PeelOwnMask.SampleLevel(
				LinearWrapSampler,
				muv,
				0.0f).r;

		return
			PeelMaskInvert != 0
			? 1.0f - m
			: m;
	}

	return
		ChildMask.SampleLevel(
			LinearWrapSampler,
			uv,
			0.0f);
}

float2 PeelSurfaceFlow(float2 uv, int2 res)
{
	float2 gravity =
		float2(
			0.0f,
			-1.0f);

	if (SurfaceValid == 0)
		return gravity;

	float3 n =
		SurfaceNormal.SampleLevel(
			LinearWrapSampler,
			uv,
			0.0f).xyz
		* 2.0f
		- 1.0f;

	if (FlipNormalY != 0)
		n.y = -n.y;

	float2 texel =
		1.0f / float2(res);

	float hl =
		SurfaceHeight.SampleLevel(
			LinearWrapSampler,
			uv - float2(texel.x, 0.0f),
			0.0f);

	float hr =
		SurfaceHeight.SampleLevel(
			LinearWrapSampler,
			uv + float2(texel.x, 0.0f),
			0.0f);

	float hd =
		SurfaceHeight.SampleLevel(
			LinearWrapSampler,
			uv - float2(0.0f, texel.y),
			0.0f);

	float hu =
		SurfaceHeight.SampleLevel(
			LinearWrapSampler,
			uv + float2(0.0f, texel.y),
			0.0f);

	float2 normalSlope =
		-n.xy;

	float2 heightSlope =
		-float2(
			hr - hl,
			hu - hd);

	float2 flow =
		gravity;

	if (length(normalSlope) > 1.0e-5f)
		flow += normalize(normalSlope) * 0.65f;

	if (length(heightSlope) > 1.0e-5f)
		flow += normalize(heightSlope) * 0.85f;

	return
		length(flow) > 1.0e-5f
		? normalize(flow)
		: gravity;
}

float2 PeelProceduralFlow(float2 uv)
{
	int p =
		max(
			WarpPeriod,
			2);

	float e =
		1.0f
		/ max(
			(float)p * 8.0f,
			64.0f);

	float l =
		PeelNoise(
			uv - float2(e, 0.0f),
			int2(p, p),
			0x1234567u);

	float r =
		PeelNoise(
			uv + float2(e, 0.0f),
			int2(p, p),
			0x1234567u);

	float d =
		PeelNoise(
			uv - float2(0.0f, e),
			int2(p, p),
			0x1234567u);

	float u =
		PeelNoise(
			uv + float2(0.0f, e),
			int2(p, p),
			0x1234567u);

	float2 g =
		float2(
			r - l,
			u - d);

	float2 curl =
		float2(
			g.y,
			-g.x);

	return
		length(curl) > 1.0e-6f
		? normalize(curl)
		: float2(0.0f, -1.0f);
}

float2 PeelFlow(float2 uv, int2 res)
{
	float2 procedural =
		PeelProceduralFlow(uv);

	float2 surface =
		PeelSurfaceFlow(
			uv,
			res);

	float2 flow =
		lerp(
			procedural,
			surface,
			saturate(WarpSource));

	flow +=
		float2(
			0.0f,
			-1.0f)
		* 0.35f;

	return
		length(flow) > 1.0e-5f
		? normalize(flow)
		: float2(0.0f, -1.0f);
}

float PeelSurfaceDamage(float2 uv, int2 res)
{
	if (SurfaceValid == 0)
		return 0.0f;

	float raw = 0.0f;
	float total = 0.0f;

	if (abs(CurvatureWeight) > 1.0e-6f)
	{
		float curvature;
		float cavity;
		float convex;

		MixtormatEvaluateCurvature(
			SurfaceNormal,
			LinearWrapSampler,
			uv,
			res,
			max(CurvatureRadius, 1),
			max(CurvatureSmoothing, 1),
			1.0f,
			1.0f,
			FlipNormalY,
			curvature,
			cavity,
			convex);

		raw +=
			CurvatureWeight
			* lerp(
				cavity,
				convex,
				saturate(
					CurvatureBias));

		total +=
			abs(
				CurvatureWeight);
	}

	if (abs(AOWeight) > 1.0e-6f)
	{
		float ao =
			SurfaceRAM.SampleLevel(
				LinearWrapSampler,
				uv,
				0.0f).g;

		raw +=
			AOWeight
			* (1.0f - ao);

		total +=
			abs(
				AOWeight);
	}

	if (abs(HeightWeight) > 1.0e-6f)
	{
		float h =
			SurfaceHeight.SampleLevel(
				LinearWrapSampler,
				uv,
				0.0f);

		raw +=
			HeightWeight
			* (h * 2.0f - 1.0f);

		total +=
			abs(
				HeightWeight);
	}

	if (
		NormalizeWeights != 0
		&& total > 1.0e-6f)
	{
		raw /= total;
	}

	return
		clamp(
			raw,
			-1.0f,
			1.0f);
}

float PeelFiberNoise(float2 uv)
{
	int macroP =
		max(
			MacroPeriod,
			2);

	int microP =
		max(
			MicroPeriod,
			2);

	bool swapAxis =
		(Seed & 1u) != 0u;

	int2 p0 =
		swapAxis
		? int2(
			max(2, macroP / 2),
			microP)
		: int2(
			microP,
			max(2, macroP / 2));

	int2 p1 =
		swapAxis
		? int2(
			microP,
			max(2, macroP / 2))
		: int2(
			max(2, macroP / 2),
			microP);

	float a =
		PeelNoise(
			uv,
			p0,
			0x517cc1b7u);

	float b =
		PeelNoise(
			frac(
				uv
				+ float2(
					0.317f,
					0.173f)),
			p1,
			0x6c8e9cf5u);

	return
		lerp(
			a,
			max(a, b),
			saturate(SizeVariation) * 0.45f);
}

float PeelDamage(
	float2 uv,
	int2 res,
	out float adhesion)
{
	float2 flow =
		PeelFlow(
			uv,
			res);

	float2 warpedUV =
		frac(
			uv
			+ flow
				* WarpAmount
				* 0.05f);

	float macro =
		PeelFBM(
			warpedUV,
			max(MacroPeriod, 2),
			0x811c9dc5u);

	float micro =
		PeelFBM(
			warpedUV,
			max(MicroPeriod, 2),
			0xb5297a4du);

	float fiber =
		PeelFiberNoise(
			warpedUV);

	int clusterP =
		max(
			FlakeCells,
			2);

	float cluster =
		PeelNoise(
			warpedUV,
			int2(
				clusterP,
				clusterP),
			0x68e31da4u);

	float baseDamage =
		macro * 0.48f
		+ fiber * 0.32f
		+ micro * 0.20f;

	float broadDamage =
		max(
			macro,
			fiber * 0.82f
				+ macro * 0.18f);

	baseDamage =
		lerp(
			baseDamage,
			broadDamage,
			saturate(SizeVariation));

	baseDamage =
		0.5f
		+ (baseDamage - 0.5f)
			* max(
				NoiseWeight,
				0.0f);

	baseDamage +=
		(macro - 0.5f)
		* MacroWarp
		* 4.0f;

	baseDamage +=
		(micro - 0.5f)
		* MicroWarp
		* 8.0f;

	float clusterShape =
		PeelSmooth(
			saturate(
				(cluster - 0.22f)
				/ 0.58f));

	float clusterMultiplier =
		lerp(
			1.0f,
			lerp(
				0.40f,
				1.45f,
				clusterShape),
			saturate(
				ClusterAmount));

	float surfaceDamage =
		PeelSurfaceDamage(
			uv,
			res);

	float mask =
		saturate(
			PeelMask(uv));

	float damage =
		baseDamage
		* clusterMultiplier;

	damage +=
		surfaceDamage
		* 0.35f;

	damage +=
		(mask - 0.5f)
		* MaskWeight
		* 0.25f;

	damage =
		saturate(
			damage);

	damage *=
		mask;

	adhesion =
		saturate(
			1.0f - damage);

	return damage;
}

float PeelPhi(
	float2 uv,
	int2 res,
	out float adhesion)
{
	float damage =
		PeelDamage(
			uv,
			res,
			adhesion);

	return
		saturate(SeedThreshold)
		- damage;
}

float PeelBoundaryDistance(
	float center,
	float neighbour,
	float spacing)
{
	if (
		center == 0.0f
		|| center * neighbour <= 0.0f)
	{
		float denom =
			abs(center)
			+ abs(neighbour);

		return
			denom > 1.0e-6f
			? spacing
				* abs(center)
				/ denom
			: 0.0f;
	}

	return PEEL_FAR;
}

float PeelStepCost(
	float2 direction,
	float2 flow,
	float adhesion)
{
	float strength =
		max(
			GrowthStrength,
			0.0f);

	float resistance =
		exp2(
			(adhesion * 2.0f - 1.0f)
			* strength);

	float align =
		dot(
			normalize(direction),
			normalize(flow));

	float directionalAmount =
		saturate(
			strength * 0.35f);

	float directional =
		lerp(
			1.0f,
			lerp(
				1.55f,
				0.62f,
				align * 0.5f + 0.5f),
			directionalAmount);

	return
		resistance
		* directional;
}

float PeelSolve(
	float self,
	float l,
	float r,
	float d,
	float u,
	float nw,
	float ne,
	float sw,
	float se,
	float2 flow,
	float adhesion,
	float2 texel)
{
	float sx =
		texel.x;

	float sy =
		texel.y;

	float sd =
		length(
			texel);

	float t =
		self;

	t = min(
		t,
		l
		+ sx
		* PeelStepCost(
			float2(-1.0f, 0.0f),
			flow,
			adhesion));

	t = min(
		t,
		r
		+ sx
		* PeelStepCost(
			float2(1.0f, 0.0f),
			flow,
			adhesion));

	t = min(
		t,
		d
		+ sy
		* PeelStepCost(
			float2(0.0f, -1.0f),
			flow,
			adhesion));

	t = min(
		t,
		u
		+ sy
		* PeelStepCost(
			float2(0.0f, 1.0f),
			flow,
			adhesion));

	t = min(
		t,
		nw
		+ sd
		* PeelStepCost(
			float2(-1.0f, 1.0f),
			flow,
			adhesion));

	t = min(
		t,
		ne
		+ sd
		* PeelStepCost(
			float2(1.0f, 1.0f),
			flow,
			adhesion));

	t = min(
		t,
		sw
		+ sd
		* PeelStepCost(
			float2(-1.0f, -1.0f),
			flow,
			adhesion));

	t = min(
		t,
		se
		+ sd
		* PeelStepCost(
			float2(1.0f, -1.0f),
			flow,
			adhesion));

	return t;
}

float PeelLiftVariationField(float2 uv)
{
	int p =
		max(
			FlakeCells,
			2);

	float v =
		PeelNoise(
			uv,
			int2(p, p),
			0x9e3779b9u);

	return
		lerp(
			1.0f,
			lerp(
				0.45f,
				1.40f,
				v),
			saturate(
				LiftVariation));
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 res =
		Mode == 2
		? OutputSize
		: SolveSize;

	if (any(
		DispatchThreadId.xy
		>= uint2(res)))
	{
		return;
	}

	int2 pixel =
		int2(
			DispatchThreadId.xy);

	float2 rf =
		float2(res);

	float2 uv =
		(float2(pixel) + 0.5f)
		/ rf;

	if (Mode == 0)
	{
		float adhesion;

		float phi =
			PeelPhi(
				uv,
				res,
				adhesion);

		OutputGrowth[pixel] =
			adhesion;

		float2 texel =
			1.0f / rf;

		float dummy;

		float l =
			PeelPhi(
				frac(
					uv
					- float2(
						texel.x,
						0.0f)),
				res,
				dummy);

		float r =
			PeelPhi(
				frac(
					uv
					+ float2(
						texel.x,
						0.0f)),
				res,
				dummy);

		float d =
			PeelPhi(
				frac(
					uv
					- float2(
						0.0f,
						texel.y)),
				res,
				dummy);

		float u =
			PeelPhi(
				frac(
					uv
					+ float2(
						0.0f,
						texel.y)),
				res,
				dummy);

		float boundary =
			PEEL_FAR;

		boundary =
			min(
				boundary,
				PeelBoundaryDistance(
					phi,
					l,
					texel.x));

		boundary =
			min(
				boundary,
				PeelBoundaryDistance(
					phi,
					r,
					texel.x));

		boundary =
			min(
				boundary,
				PeelBoundaryDistance(
					phi,
					d,
					texel.y));

		boundary =
			min(
				boundary,
				PeelBoundaryDistance(
					phi,
					u,
					texel.y));

		OutputArrival[pixel] =
			float2(
				boundary,
				phi < 0.0f
				? -1.0f
				: 1.0f);

		return;
	}

	if (Mode == 1)
	{
		float2 self =
			PreviousArrival.Load(
				int3(
					pixel,
					0));

		int xm =
			PeelWrapI(
				pixel.x - 1,
				res.x);

		int xp =
			PeelWrapI(
				pixel.x + 1,
				res.x);

		int ym =
			PeelWrapI(
				pixel.y - 1,
				res.y);

		int yp =
			PeelWrapI(
				pixel.y + 1,
				res.y);

		float l =
			PreviousArrival.Load(
				int3(
					xm,
					pixel.y,
					0)).x;

		float r =
			PreviousArrival.Load(
				int3(
					xp,
					pixel.y,
					0)).x;

		float d =
			PreviousArrival.Load(
				int3(
					pixel.x,
					ym,
					0)).x;

		float u =
			PreviousArrival.Load(
				int3(
					pixel.x,
					yp,
					0)).x;

		float nw =
			PreviousArrival.Load(
				int3(
					xm,
					yp,
					0)).x;

		float ne =
			PreviousArrival.Load(
				int3(
					xp,
					yp,
					0)).x;

		float sw =
			PreviousArrival.Load(
				int3(
					xm,
					ym,
					0)).x;

		float se =
			PreviousArrival.Load(
				int3(
					xp,
					ym,
					0)).x;

		float adhesion =
			GrowthField.Load(
				int3(
					pixel,
					0));

		float2 flow =
			PeelFlow(
				uv,
				res);

		float solved =
			PeelSolve(
				self.x,
				l,
				r,
				d,
				u,
				nw,
				ne,
				sw,
				se,
				flow,
				adhesion,
				1.0f / rf);

		OutputArrival[pixel] =
			float2(
				solved,
				self.y);

		return;
	}

	float2 arrivalData =
		PreviousArrival.SampleLevel(
			LinearWrapSampler,
			uv,
			0.0f);

	float arrival =
		min(
			arrivalData.x,
			PEEL_FAR);

	float sdf =
		arrival
		* (
			arrivalData.y < 0.0f
			? -1.0f
			: 1.0f);

	float finalSDF =
		sdf - Front;

	float width =
		max(
			Width,
			1.0e-6f);

	float x =
		finalSDF
		/ width;

	float peelCoverage =
		1.0f
		- PeelSmooth(
			x * 0.5f
			+ 0.5f);

	float edge =
		pow(
			exp(
				-2.0f
				* x
				* x),
			max(
				EdgeSharpness,
				0.01f));

	float maxRes =
		max(
			(float)max(
				OutputSize.x,
				OutputSize.y),
			1.0f);

	float pixelSize =
		1.0f
		/ maxRes;

	float geometricAA =
		max(
			pixelSize * 1.25f,
			1.0e-6f);

	float peeledPlateau =
		1.0f
		- PeelSmooth(
			saturate(
				finalSDF
				/ (
					geometricAA
					* 2.0f)
				+ 0.5f));

	// Curl is intentionally evaluated on the ATTACHED side.
	// finalSDF < 0 = exposed/peeled.
	// finalSDF > 0 = remaining wallpaper.
	float attachedDistance =
		max(
			finalSDF,
			0.0f);

	float curlLength =
		max(
			width
			* lerp(
				3.0f,
				14.0f,
				saturate(
					MicroMorph)),
			pixelSize * 4.0f);

	float curlT =
		attachedDistance
		/ curlLength;

	// Starts at zero exactly on the tear, rises immediately
	// into the remaining sheet, then relaxes to the flat film.
	float curl =
		curlT < 10.0f
		? curlT
			* exp(
				1.0f - curlT)
		: 0.0f;

	curl =
		saturate(
			curl);

	float foldT =
		(curlT - 1.75f)
		/ 0.70f;

	float fold =
		exp(
			-2.0f
			* foldT
			* foldT);

	float liftVariation =
		PeelLiftVariationField(
			uv);

	float localLift =
		Lift
		* liftVariation;

	float fine =
		PeelFBM(
			uv,
			max(
				MicroPeriod,
				2),
			0x27d4eb2du)
		* 2.0f
		- 1.0f;

	float detailHeight =
		fine
		* DetailStrength
		* saturate(
			edge + curl);

	// Exposed wall/substrate is exactly Thickness lower.
	// Attached wallpaper remains at zero height delta.
	float heightDelta =
		-peeledPlateau
		* Thickness;

	if (PeelType == 0)
	{
		heightDelta +=
			edge
			* localLift
			* 0.20f;

		heightDelta +=
			detailHeight
			* 0.45f;
	}
	else
	{
		// Heightfield approximation of a curling sheet:
		// lift the still-attached paper beside the tear instead
		// of placing the ridge on the exposed substrate.
		heightDelta +=
			curl
			* localLift;

		heightDelta -=
			fold
			* localLift
			* 0.12f;

		heightDelta +=
			edge
			* localLift
			* 0.18f;

		heightDelta +=
			detailHeight;
	}

	float adhesion =
		GrowthField.SampleLevel(
			LinearWrapSampler,
			uv,
			0.0f);

	OutputFieldA[pixel] =
		float4(
			sdf,
			adhesion,
			1.0f - adhesion,
			finalSDF);

	OutputFieldB[pixel] =
		float4(
			saturate(
				peelCoverage),
			saturate(
				edge),
			saturate(
				curl),
			heightDelta);
}