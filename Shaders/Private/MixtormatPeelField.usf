#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGully.ush"
#include "/Plugin/Mixtormat/Private/MixtormatCurvature.ush"

Texture2D<float4> SurfaceNormal;
Texture2D<float4> SurfaceRAM;
Texture2D<float> SurfaceHeight;
Texture2D<float> ChildMask;
Texture2D<float4> PeelOwnMask;
Texture2D<float2> PreviousArrival;
Texture2D<float> GrowthField;
SamplerState LinearWrapSampler;

RWTexture2D<float2> OutputArrival;
RWTexture2D<float> OutputGrowth;
RWTexture2D<float4> OutputFieldA;
RWTexture2D<float4> OutputFieldB;

int2 OutputSize;
int2 SolveSize;
int Mode;
uint SurfaceValid;
uint FlipNormalY;

uint Seed;
float MaskWeight;
float PeelMaskTiling;
uint PeelMaskInvert;
uint UseOwnMask;
float SeedThreshold;

int CurvatureRadius;
int CurvatureSmoothing;
float CurvatureWeight;
float CurvatureBias;
float AOWeight;
float HeightWeight;
uint NormalizeWeights;
float GrowthStrength;

int MacroPeriod;
int MicroPeriod;
float NoiseWeight;
float SizeVariation;
int FlakeCells;
float ClusterAmount;
int WarpPeriod;
float WarpAmount;
float WarpSource;

int PeelType;
float Front;
float Width;
float MacroWarp;
float MicroWarp;
float MicroMorph;
float Thickness;
float Lift;
float DetailStrength;
float LiftVariation;
float CornerLift;
float CornerRadius;

// Whatever ID map was published above this peel in the layer's chain -- a cluster filter, a
// pattern, random IDs, colour IDs. Always bound, a 1x1 dummy when the layer has none, because
// RDG validates a binding whether the branch reading it runs or not.
Texture2D<uint> RegionIds;
uint HasRegionIds;
float IDInfluence;
float EdgeSharpness;

#define PEEL_FAR 1024.0f

int PeelWrapI(int x, int n)
{
	x %= max(n, 1);
	return x < 0 ? x + n : x;
}

int2 PeelWrapP(int2 p, int2 n)
{
	return int2(
		PeelWrapI(p.x, n.x),
		PeelWrapI(p.y, n.y));
}

float PeelSmooth(float x)
{
	x = saturate(x);
	return x * x * (3.0f - 2.0f * x);
}

uint PeelHashGrid(int2 p, int2 period, uint salt)
{
	p = PeelWrapP(p, period);

	return MixtormatHashU(
		(uint)p.x * 73856093u ^
		(uint)p.y * 19349663u ^
		Seed * 2654435761u ^
		salt);
}

float PeelHash01(int2 p, int2 period, uint salt)
{
	return
		(float)(PeelHashGrid(p, period, salt) & 0x00ffffffu)
		* (1.0f / 16777215.0f);
}

float PeelNoise(float2 uv, int2 period, uint salt)
{
	period = max(period, int2(1, 1));

	float2 p = frac(uv) * float2(period);
	int2 i = int2(floor(p));
	float2 f = frac(p);
	float2 s = f * f * (3.0f - 2.0f * f);

	float a = PeelHash01(i, period, salt);
	float b = PeelHash01(i + int2(1, 0), period, salt);
	float c = PeelHash01(i + int2(0, 1), period, salt);
	float d = PeelHash01(i + int2(1, 1), period, salt);

	return lerp(
		lerp(a, b, s.x),
		lerp(c, d, s.x),
		s.y);
}

float PeelFBM(float2 uv, int period, uint salt)
{
	period = max(period, 1);

	float sum = 0.0f;
	float norm = 0.0f;
	float amp = 0.5f;

	[unroll]
	for (int i = 0; i < 4; ++i)
	{
		int p = min(period << i, 512);

		sum +=
			PeelNoise(
				uv,
				int2(p, p),
				salt + (uint)i * 0x9e3779b9u)
			* amp;

		norm += amp;
		amp *= 0.5f;
	}

	return sum / max(norm, 1.0e-6f);
}

float PeelMask(float2 uv)
{
	if (UseOwnMask != 0)
	{
		float2 muv =
			frac(
				uv * max(
					PeelMaskTiling,
					1.0f));

		float m =
			PeelOwnMask.SampleLevel(
				LinearWrapSampler,
				muv,
				0.0f).r;

		return
			PeelMaskInvert != 0
			? 1.0f - m
			: m;
	}

	return
		ChildMask.SampleLevel(
			LinearWrapSampler,
			uv,
			0.0f);
}

float2 PeelSurfaceFlow(float2 uv, int2 res)
{
	float2 gravity =
		float2(
			0.0f,
			-1.0f);

	if (SurfaceValid == 0)
		return gravity;

	float3 n =
		SurfaceNormal.SampleLevel(
			LinearWrapSampler,
			uv,
			0.0f).xyz
		* 2.0f
		- 1.0f;

	if (FlipNormalY != 0)
		n.y = -n.y;

	float2 texel =
		1.0f / float2(res);

	float hl =
		SurfaceHeight.SampleLevel(
			LinearWrapSampler,
			uv - float2(texel.x, 0.0f),
			0.0f);

	float hr =
		SurfaceHeight.SampleLevel(
			LinearWrapSampler,
			uv + float2(texel.x, 0.0f),
			0.0f);

	float hd =
		SurfaceHeight.SampleLevel(
			LinearWrapSampler,
			uv - float2(0.0f, texel.y),
			0.0f);

	float hu =
		SurfaceHeight.SampleLevel(
			LinearWrapSampler,
			uv + float2(0.0f, texel.y),
			0.0f);

	float2 normalSlope =
		-n.xy;

	float2 heightSlope =
		-float2(
			hr - hl,
			hu - hd);

	float2 flow =
		gravity;

	if (length(normalSlope) > 1.0e-5f)
		flow += normalize(normalSlope) * 0.65f;

	if (length(heightSlope) > 1.0e-5f)
		flow += normalize(heightSlope) * 0.85f;

	return
		length(flow) > 1.0e-5f
		? normalize(flow)
		: gravity;
}

float2 PeelProceduralFlow(float2 uv)
{
	int p =
		max(
			WarpPeriod,
			2);

	float e =
		1.0f
		/ max(
			(float)p * 8.0f,
			64.0f);

	float l =
		PeelNoise(
			uv - float2(e, 0.0f),
			int2(p, p),
			0x1234567u);

	float r =
		PeelNoise(
			uv + float2(e, 0.0f),
			int2(p, p),
			0x1234567u);

	float d =
		PeelNoise(
			uv - float2(0.0f, e),
			int2(p, p),
			0x1234567u);

	float u =
		PeelNoise(
			uv + float2(0.0f, e),
			int2(p, p),
			0x1234567u);

	float2 g =
		float2(
			r - l,
			u - d);

	float2 curl =
		float2(
			g.y,
			-g.x);

	return
		length(curl) > 1.0e-6f
		? normalize(curl)
		: float2(0.0f, -1.0f);
}

float2 PeelFlow(float2 uv, int2 res)
{
	float2 procedural =
		PeelProceduralFlow(uv);

	float2 surface =
		PeelSurfaceFlow(
			uv,
			res);

	float2 flow =
		lerp(
			procedural,
			surface,
			saturate(WarpSource));

	flow +=
		float2(
			0.0f,
			-1.0f)
		* 0.35f;

	return
		length(flow) > 1.0e-5f
		? normalize(flow)
		: float2(0.0f, -1.0f);
}

float PeelSurfaceDamage(float2 uv, int2 res)
{
	if (SurfaceValid == 0)
		return 0.0f;

	float raw = 0.0f;
	float total = 0.0f;

	if (abs(CurvatureWeight) > 1.0e-6f)
	{
		float curvature;
		float cavity;
		float convex;

		MixtormatEvaluateCurvature(
			SurfaceNormal,
			LinearWrapSampler,
			uv,
			res,
			max(CurvatureRadius, 1),
			max(CurvatureSmoothing, 1),
			1.0f,
			1.0f,
			FlipNormalY,
			curvature,
			cavity,
			convex);

		raw +=
			CurvatureWeight
			* lerp(
				cavity,
				convex,
				saturate(
					CurvatureBias));

		total +=
			abs(
				CurvatureWeight);
	}

	if (abs(AOWeight) > 1.0e-6f)
	{
		float ao =
			SurfaceRAM.SampleLevel(
				LinearWrapSampler,
				uv,
				0.0f).g;

		raw +=
			AOWeight
			* (1.0f - ao);

		total +=
			abs(
				AOWeight);
	}

	if (abs(HeightWeight) > 1.0e-6f)
	{
		float h =
			SurfaceHeight.SampleLevel(
				LinearWrapSampler,
				uv,
				0.0f);

		raw +=
			HeightWeight
			* (h * 2.0f - 1.0f);

		total +=
			abs(
				HeightWeight);
	}

	if (
		NormalizeWeights != 0
		&& total > 1.0e-6f)
	{
		raw /= total;
	}

	return
		clamp(
			raw,
			-1.0f,
			1.0f);
}

float PeelFiberNoise(float2 uv)
{
	int macroP =
		max(
			MacroPeriod,
			2);

	int microP =
		max(
			MicroPeriod,
			2);

	bool swapAxis =
		(Seed & 1u) != 0u;

	int2 p0 =
		swapAxis
		? int2(
			max(2, macroP / 2),
			microP)
		: int2(
			microP,
			max(2, macroP / 2));

	int2 p1 =
		swapAxis
		? int2(
			microP,
			max(2, macroP / 2))
		: int2(
			max(2, macroP / 2),
			microP);

	float a =
		PeelNoise(
			uv,
			p0,
			0x517cc1b7u);

	float b =
		PeelNoise(
			frac(
				uv
				+ float2(
					0.317f,
					0.173f)),
			p1,
			0x6c8e9cf5u);

	return
		lerp(
			a,
			max(a, b),
			saturate(SizeVariation) * 0.45f);
}

// Boundaries of the ID map above this peel, as a weight on where the sheet lets go first.
//
// Wallpaper does not start peeling in the middle of a strip; it lets go at the seams, and a tiled
// surface lets go at the joints. Whatever produced the IDs -- a cluster filter, a pattern, random
// or colour IDs -- its boundaries are where those seams already are, so the peel can follow them
// instead of the artist painting a mask that traces a pattern the layer already knows.
//
// A weight and not a gate, which is the difference from Worn Edges. There the ID boundary is the
// subject and the effect lives on it; here it only biases the damage field, so at a low influence
// the peel merely prefers seams and at a high one it is effectively confined to them. At 0 the ID
// map is not read at all and the peel is exactly what it was.
float PeelIdEdge(float2 uv, int2 res)
{
	if (HasRegionIds == 0 || IDInfluence <= 0.0f)
	{
		return 0.0f;
	}

	// IDs are authored in output space while the seed and solve run at SolveSize, so the
	// comparison steps by however many output texels one solve texel spans. Comparing adjacent
	// output texels from a coarser pass would find boundaries that pass cannot resolve and alias
	// them into the front.
	int2 stride =
		max(
			OutputSize / max(res, int2(1, 1)),
			int2(1, 1));

	int2 centrePixel =
		int2(
			frac(uv + 1.0f)
			* float2(OutputSize));

	uint centre =
		RegionIds.Load(
			int3(centrePixel, 0));

	if (centre == MIXTORMAT_INVALID_REGION)
	{
		return 0.0f;
	}

	float boundary = 0.0f;

	[unroll]
	for (int oy = -1; oy <= 1; ++oy)
	{
		[unroll]
		for (int ox = -1; ox <= 1; ++ox)
		{
			if (ox == 0 && oy == 0)
			{
				continue;
			}

			int2 q =
				centrePixel
				+ int2(ox, oy) * stride;

			q.x = (q.x % OutputSize.x + OutputSize.x) % OutputSize.x;
			q.y = (q.y % OutputSize.y + OutputSize.y) % OutputSize.y;

			uint other =
				RegionIds.Load(
					int3(q, 0));

			boundary =
				max(
					boundary,
					other != centre ? 1.0f : 0.0f);
		}
	}

	return boundary;
}

float PeelDamage(
	float2 uv,
	int2 res,
	out float adhesion)
{
	float2 flow =
		PeelFlow(
			uv,
			res);

	float2 warpedUV =
		frac(
			uv
			+ flow
				* WarpAmount
				* 0.05f);

	float macro =
		PeelFBM(
			warpedUV,
			max(MacroPeriod, 2),
			0x811c9dc5u);

	float micro =
		PeelFBM(
			warpedUV,
			max(MicroPeriod, 2),
			0xb5297a4du);

	float fiber =
		PeelFiberNoise(
			warpedUV);

	int clusterP =
		max(
			FlakeCells,
			2);

	float cluster =
		PeelNoise(
			warpedUV,
			int2(
				clusterP,
				clusterP),
			0x68e31da4u);

	float baseDamage =
		macro * 0.48f
		+ fiber * 0.32f
		+ micro * 0.20f;

	float broadDamage =
		max(
			macro,
			fiber * 0.82f
				+ macro * 0.18f);

	baseDamage =
		lerp(
			baseDamage,
			broadDamage,
			saturate(SizeVariation));

	baseDamage =
		0.5f
		+ (baseDamage - 0.5f)
			* max(
				NoiseWeight,
				0.0f);

	baseDamage +=
		(macro - 0.5f)
		* MacroWarp
		* 4.0f;

	baseDamage +=
		(micro - 0.5f)
		* MicroWarp
		* 8.0f;

	float clusterShape =
		PeelSmooth(
			saturate(
				(cluster - 0.22f)
				/ 0.58f));

	float clusterMultiplier =
		lerp(
			1.0f,
			lerp(
				0.40f,
				1.45f,
				clusterShape),
			saturate(
				ClusterAmount));

	float surfaceDamage =
		PeelSurfaceDamage(
			uv,
			res);

	float mask =
		saturate(
			PeelMask(uv));

	float damage =
		baseDamage
		* clusterMultiplier;

	damage +=
		surfaceDamage
		* 0.35f;

	damage +=
		(mask - 0.5f)
		* MaskWeight
		* 0.25f;

	// Added before the saturate and before the mask multiply below, so a seam still only peels
	// where the layer's own mask allows it.
	damage +=
		PeelIdEdge(uv, res)
		* saturate(IDInfluence);

	damage =
		saturate(
			damage);

	damage *=
		mask;

	adhesion =
		saturate(
			1.0f - damage);

	return damage;
}

float PeelPhi(
	float2 uv,
	int2 res,
	out float adhesion)
{
	float damage =
		PeelDamage(
			uv,
			res,
			adhesion);

	return
		saturate(SeedThreshold)
		- damage;
}

float PeelBoundaryDistance(
	float center,
	float neighbour,
	float spacing)
{
	if (
		center == 0.0f
		|| center * neighbour <= 0.0f)
	{
		float denom =
			abs(center)
			+ abs(neighbour);

		return
			denom > 1.0e-6f
			? spacing
				* abs(center)
				/ denom
			: 0.0f;
	}

	return PEEL_FAR;
}

float PeelStepCost(
	float2 direction,
	float2 flow,
	float adhesion)
{
	float strength =
		max(
			GrowthStrength,
			0.0f);

	float resistance =
		exp2(
			(adhesion * 2.0f - 1.0f)
			* strength);

	float align =
		dot(
			normalize(direction),
			normalize(flow));

	float directionalAmount =
		saturate(
			strength * 0.35f);

	float directional =
		lerp(
			1.0f,
			lerp(
				1.55f,
				0.62f,
				align * 0.5f + 0.5f),
			directionalAmount);

	return
		resistance
		* directional;
}

float PeelSolve(
	float self,
	float l,
	float r,
	float d,
	float u,
	float nw,
	float ne,
	float sw,
	float se,
	float2 flow,
	float adhesion,
	float2 texel)
{
	float sx =
		texel.x;

	float sy =
		texel.y;

	float sd =
		length(
			texel);

	float t =
		self;

	t = min(
		t,
		l
		+ sx
		* PeelStepCost(
			float2(-1.0f, 0.0f),
			flow,
			adhesion));

	t = min(
		t,
		r
		+ sx
		* PeelStepCost(
			float2(1.0f, 0.0f),
			flow,
			adhesion));

	t = min(
		t,
		d
		+ sy
		* PeelStepCost(
			float2(0.0f, -1.0f),
			flow,
			adhesion));

	t = min(
		t,
		u
		+ sy
		* PeelStepCost(
			float2(0.0f, 1.0f),
			flow,
			adhesion));

	t = min(
		t,
		nw
		+ sd
		* PeelStepCost(
			float2(-1.0f, 1.0f),
			flow,
			adhesion));

	t = min(
		t,
		ne
		+ sd
		* PeelStepCost(
			float2(1.0f, 1.0f),
			flow,
			adhesion));

	t = min(
		t,
		sw
		+ sd
		* PeelStepCost(
			float2(-1.0f, -1.0f),
			flow,
			adhesion));

	t = min(
		t,
		se
		+ sd
		* PeelStepCost(
			float2(1.0f, -1.0f),
			flow,
			adhesion));

	return t;
}

// The peel front as a signed distance, reconstructed at an arbitrary UV.
//
// Same reconstruction the resolve pass does for its own texel: arrival time, signed by the side
// flag, less the Front offset. Pulled out as a function so the corner field below can look around
// a point rather than only at it.
float PeelFrontAt(float2 uv)
{
	float2 a =
		PreviousArrival.SampleLevel(
			LinearWrapSampler,
			uv,
			0.0f);

	float s =
		min(
			a.x,
			PEEL_FAR)
		* (
			a.y < 0.0f
			? -1.0f
			: 1.0f);

	return s - Front;
}

// Central difference of the peel front, at a spacing chosen by the caller.
float2 PeelFrontGradient(float2 uv, float h)
{
	float sx =
		PeelFrontAt(uv + float2(h, 0.0f))
		- PeelFrontAt(uv - float2(h, 0.0f));

	float sy =
		PeelFrontAt(uv + float2(0.0f, h))
		- PeelFrontAt(uv - float2(0.0f, h));

	return float2(sx, sy) / (2.0f * h);
}

// Cornerness of the peel front, from the structure tensor of its gradient.
//
// Curl otherwise depends only on distance from the tear, so every point the same distance in
// lifts identically whatever shape the front has. Paper does not behave that way: a straight edge
// is held along its whole length and barely rises, a corner is held on fewer sides and peels up
// far further. A sheet fails at its corners first, and a peel that ignores this reads as a
// uniform rolled hem rather than as something torn.
//
// This replaces a Laplacian of the same field. The Laplacian measures curvature, which is real
// but answers the wrong question -- a long gentle arc has curvature everywhere and no corners
// anywhere, so it lifted whole curved edges as though they were points. The structure tensor asks
// instead whether the gradient direction *varies* inside the window, which is what a corner is:
//
//     M = sum over window of [ dx*dx  dx*dy ]
//                            [ dx*dy  dy*dy ]
//
// A straight front has every gradient pointing the same way, so M is rank one, det is zero and
// the response vanishes however curved the edge is. A corner or a tongue fans its gradients out,
// both eigenvalues grow, and det climbs.
//
// Noble's 2*det/trace rather than Harris's det - k*trace^2, because it needs no tuned k and is
// bounded: the front is a distance field, so every gradient is near unit length and the trace is
// near the sample count, which makes the response land in 0..1 after the normalisation below
// without a magic constant that would have to be re-found whenever the window changed.
//
// The window is sized off the curl length and scaled by Corner Radius. A wider window responds to
// broader features and over a larger area, which is the knob for "corners lift more, and further
// back from the tip".
float PeelCornerField(float2 uv, float radiusUV)
{
	float spacing =
		max(radiusUV, 1.0e-5f);

	float h =
		max(spacing * 0.5f, 1.0e-5f);

	float m00 = 0.0f;
	float m01 = 0.0f;
	float m11 = 0.0f;
	const float Samples = 9.0f;

	[unroll]
	for (int j = -1; j <= 1; ++j)
	{
		[unroll]
		for (int i = -1; i <= 1; ++i)
		{
			float2 g =
				PeelFrontGradient(
					uv
					+ float2((float)i, (float)j) * spacing * 0.5f,
					h);

			m00 += g.x * g.x;
			m01 += g.x * g.y;
			m11 += g.y * g.y;
		}
	}

	float trace = m00 + m11;
	float det = m00 * m11 - m01 * m01;

	// Peak response is Samples/2, when both eigenvalues are equal -- a perfectly isotropic corner.
	// Dividing by it puts a clean 0..1 on the output whatever the window size.
	return saturate(
		(2.0f * det / max(trace, 1.0e-6f))
		/ (Samples * 0.5f));
}

// How much this part of the sheet lifts, relative to the layer's Lift.
//
// Centred on 1 and symmetric, which the previous form was not. It interpolated between two
// absolute bounds, 0.45 and 1.40, so the field averaged 0.925 rather than 1: turning Lift
// Variation up quietly lowered the mean lift of the whole peel by about eight percent, and the
// spread it bought was lopsided -- 0.55 down against 0.40 up. Raising a variation control should
// redistribute an amount between places, never change how much of it there is in total.
//
// Signed noise makes that exact. At variation 0 every point returns 1 and Lift means precisely
// what it says; at 1 the multiplier spans 0..2 about the same mean. The max() keeps a flake from
// lifting through the substrate at the bottom of the range.
//
// The field is smooth rather than constant per flake, and that is a known limitation rather than
// a choice: the peel front is one continuous SDF, not a set of flood-filled flakes, so there is
// no per-flake identity here to key a hash to. A cell-constant multiplier would give crisper
// per-piece variation but would also step the height at every cell boundary the tear crosses,
// and a step in a height field is a vertical wall to everything downstream that differentiates
// it. Flake-coherent lift needs a flake ID field first.
float PeelLiftVariationField(float2 uv)
{
	int p =
		max(
			FlakeCells,
			2);

	float v =
		PeelNoise(
			uv,
			int2(p, p),
			0x9e3779b9u)
		* 2.0f
		- 1.0f;

	return
		max(
			1.0f
				+ v
				* saturate(
					LiftVariation),
			0.0f);
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 res =
		Mode == 2
		? OutputSize
		: SolveSize;

	if (any(
		DispatchThreadId.xy
		>= uint2(res)))
	{
		return;
	}

	int2 pixel =
		int2(
			DispatchThreadId.xy);

	float2 rf =
		float2(res);

	float2 uv =
		(float2(pixel) + 0.5f)
		/ rf;

	if (Mode == 0)
	{
		float adhesion;

		float phi =
			PeelPhi(
				uv,
				res,
				adhesion);

		OutputGrowth[pixel] =
			adhesion;

		float2 texel =
			1.0f / rf;

		float dummy;

		float l =
			PeelPhi(
				frac(
					uv
					- float2(
						texel.x,
						0.0f)),
				res,
				dummy);

		float r =
			PeelPhi(
				frac(
					uv
					+ float2(
						texel.x,
						0.0f)),
				res,
				dummy);

		float d =
			PeelPhi(
				frac(
					uv
					- float2(
						0.0f,
						texel.y)),
				res,
				dummy);

		float u =
			PeelPhi(
				frac(
					uv
					+ float2(
						0.0f,
						texel.y)),
				res,
				dummy);

		float boundary =
			PEEL_FAR;

		boundary =
			min(
				boundary,
				PeelBoundaryDistance(
					phi,
					l,
					texel.x));

		boundary =
			min(
				boundary,
				PeelBoundaryDistance(
					phi,
					r,
					texel.x));

		boundary =
			min(
				boundary,
				PeelBoundaryDistance(
					phi,
					d,
					texel.y));

		boundary =
			min(
				boundary,
				PeelBoundaryDistance(
					phi,
					u,
					texel.y));

		OutputArrival[pixel] =
			float2(
				boundary,
				phi < 0.0f
				? -1.0f
				: 1.0f);

		return;
	}

	if (Mode == 1)
	{
		float2 self =
			PreviousArrival.Load(
				int3(
					pixel,
					0));

		int xm =
			PeelWrapI(
				pixel.x - 1,
				res.x);

		int xp =
			PeelWrapI(
				pixel.x + 1,
				res.x);

		int ym =
			PeelWrapI(
				pixel.y - 1,
				res.y);

		int yp =
			PeelWrapI(
				pixel.y + 1,
				res.y);

		float l =
			PreviousArrival.Load(
				int3(
					xm,
					pixel.y,
					0)).x;

		float r =
			PreviousArrival.Load(
				int3(
					xp,
					pixel.y,
					0)).x;

		float d =
			PreviousArrival.Load(
				int3(
					pixel.x,
					ym,
					0)).x;

		float u =
			PreviousArrival.Load(
				int3(
					pixel.x,
					yp,
					0)).x;

		float nw =
			PreviousArrival.Load(
				int3(
					xm,
					yp,
					0)).x;

		float ne =
			PreviousArrival.Load(
				int3(
					xp,
					yp,
					0)).x;

		float sw =
			PreviousArrival.Load(
				int3(
					xm,
					ym,
					0)).x;

		float se =
			PreviousArrival.Load(
				int3(
					xp,
					ym,
					0)).x;

		float adhesion =
			GrowthField.Load(
				int3(
					pixel,
					0));

		float2 flow =
			PeelFlow(
				uv,
				res);

		float solved =
			PeelSolve(
				self.x,
				l,
				r,
				d,
				u,
				nw,
				ne,
				sw,
				se,
				flow,
				adhesion,
				1.0f / rf);

		OutputArrival[pixel] =
			float2(
				solved,
				self.y);

		return;
	}

	float2 arrivalData =
		PreviousArrival.SampleLevel(
			LinearWrapSampler,
			uv,
			0.0f);

	float arrival =
		min(
			arrivalData.x,
			PEEL_FAR);

	float sdf =
		arrival
		* (
			arrivalData.y < 0.0f
			? -1.0f
			: 1.0f);

	float finalSDF =
		sdf - Front;

	float width =
		max(
			Width,
			1.0e-6f);

	float x =
		finalSDF
		/ width;

	float peelCoverage =
		1.0f
		- PeelSmooth(
			x * 0.5f
			+ 0.5f);

	float edge =
		pow(
			exp(
				-2.0f
				* x
				* x),
			max(
				EdgeSharpness,
				0.01f));

	float maxRes =
		max(
			(float)max(
				OutputSize.x,
				OutputSize.y),
			1.0f);

	float pixelSize =
		1.0f
		/ maxRes;

	float geometricAA =
		max(
			pixelSize * 1.25f,
			1.0e-6f);

	float peeledPlateau =
		1.0f
		- PeelSmooth(
			saturate(
				finalSDF
				/ (
					geometricAA
					* 2.0f)
				+ 0.5f));

	// Curl is intentionally evaluated on the ATTACHED side.
	// finalSDF < 0 = exposed/peeled.
	// finalSDF > 0 = remaining wallpaper.
	float attachedDistance =
		max(
			finalSDF,
			0.0f);

	// How far the lift is spread back into the attached sheet.
	//
	// This used to run to 14x Width -- 0.21 UV, about 430 texels at 2K -- so the whole of Lift was
	// distributed over a fifth of the tile. A rise of 0.04 across 430 texels is a slope of
	// 0.0001, which is flat to any honest derivative; the only reason the curl ever read was the
	// peel's own normal pass exaggerating its gradient by three orders of magnitude. With that
	// pass on the shared convention the ramp has to be real geometry instead.
	//
	// A few millimetres of rise over a few centimetres of sheet is what wallpaper actually does,
	// which on a one-metre tile at 2K is roughly 40-60 texels. That is what this range gives at
	// the default Width, and Lift's default moved with it.
	float curlLength =
		max(
			width
			* lerp(
				1.0f,
				2.0f,
				saturate(
					MicroMorph)),
			pixelSize * 4.0f);

	float curlT =
		attachedDistance
		/ curlLength;

	// Starts at zero on the tear, rolls up into the remaining sheet, then relaxes to the flat
	// film. t^2 * e^(2 - 2t) rather than t * e^(1 - t): both peak at exactly 1 where the curl
	// length says they should, but the old one left the tear at a slope of e and so stood the
	// sheet up in the first texel, which is the abruptness. This leaves with zero slope, arrives
	// at the peak with zero slope, and only then falls away -- a roll instead of a step.
	float curl =
		curlT < 10.0f
		? curlT
			* curlT
			* exp(
				2.0f - 2.0f * curlT)
		: 0.0f;

	curl =
		saturate(
			curl);

	float foldT =
		(curlT - 1.75f)
		/ 0.70f;

	float fold =
		exp(
			-2.0f
			* foldT
			* foldT);

	float liftVariation =
		PeelLiftVariationField(
			uv);

	// Corners lift further than edges. The window is the curl length scaled by Corner Radius, so
	// widening it both catches broader features and spreads the boost further back from the tip.
	float cornerBoost =
		1.0f
		+ saturate(
			CornerLift)
		* PeelCornerField(
			uv,
			curlLength
			* max(CornerRadius, 0.05f));

	// Fine variation along the tear, so a single edge does not rise to one even height for its
	// whole length. The cell noise above says how much this flake lifts; this says how unevenly
	// it lifts across itself, which is the difference between a rolled hem and torn paper.
	// Centred on 1 like the cell term, and scaled by the same control, so neither changes the
	// average lift.
	float liftDetail =
		1.0f
		+ (PeelFBM(
			uv,
			max(MicroPeriod, 2),
			0x6c078965u)
			* 2.0f
			- 1.0f)
		* 0.45f
		* saturate(LiftVariation);

	// The layer's own mask, so a peel fades out where it was painted out rather than ending on a
	// full-height ridge at the mask boundary.
	float liftMask =
		saturate(
			PeelMask(uv));

	float localLift =
		Lift
		* liftVariation
		* max(liftDetail, 0.0f)
		* liftMask
		* cornerBoost;

	float fine =
		PeelFBM(
			uv,
			max(
				MicroPeriod,
				2),
			0x27d4eb2du)
		* 2.0f
		- 1.0f;

	float detailHeight =
		fine
		* DetailStrength
		* saturate(
			edge + curl);

	// Exposed wall/substrate is exactly Thickness lower.
	// Attached wallpaper remains at zero height delta.
	float heightDelta =
		-peeledPlateau
		* Thickness;

	if (PeelType == 0)
	{
		heightDelta +=
			edge
			* localLift
			* 0.20f;

		heightDelta +=
			detailHeight
			* 0.45f;
	}
	else
	{
		// Heightfield approximation of a curling sheet:
		// lift the still-attached paper beside the tear instead
		// of placing the ridge on the exposed substrate.
		heightDelta +=
			curl
			* localLift;

		heightDelta -=
			fold
			* localLift
			* 0.12f;

		heightDelta +=
			edge
			* localLift
			* 0.18f;

		heightDelta +=
			detailHeight;
	}

	float adhesion =
		GrowthField.SampleLevel(
			LinearWrapSampler,
			uv,
			0.0f);

	OutputFieldA[pixel] =
		float4(
			sdf,
			adhesion,
			1.0f - adhesion,
			finalSDF);

	OutputFieldB[pixel] =
		float4(
			saturate(
				peelCoverage),
			saturate(
				edge),
			saturate(
				curl),
			heightDelta);
}