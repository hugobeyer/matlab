// Copyright 2026 Hugo Beyer. All Rights Reserved.

// Root Network: space-colonization growth (Runions et al. 2007) on the unit torus, swept into a
// variable-radius implicit field. Everything is GPU resident and bounded:
//
//   ROOT_STAGE 0  init      trunks + stratified attractors, state, pull accumulators
//   ROOT_STAGE 1  assign    one thread per attractor; incremental frontier nearest-node search,
//                           fixed-point atomic pull accumulation (order-independent, deterministic)
//   ROOT_STAGE 2  extend    one group; ordered prefix-sum compaction of new child nodes
//   ROOT_STAGE 3  segments  O(N) pipe-model radii, tangent-continuous sweeps, toroidal bin counts
//   ROOT_STAGE 4  scan      4096-cell exclusive prefix sum (CSR offsets)
//   ROOT_STAGE 5  scatter   CSR scatter + per-cell sort by branch/segment (deterministic order)
//   ROOT_STAGE 6  field     per-pixel swept SDF over the pixel's bin only
//
// Stages 2..5 run as a single 64-thread group with strided loops over the bounded arrays.
// Stage 6 output is native (unscaled) height; the shared signed-height contract applies
// Normalize/HeightScale downstream, so those settings never invalidate the cached field.

#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorPlacement.ush"
#include "/Plugin/Mixtormat/Private/MixtormatNoise.ush"

#ifndef ROOT_STAGE
#define ROOT_STAGE 0
#endif

// Must match the C++ constants in MixtormatGpuGeneratorPasses.cpp.
#define ROOT_MAX_NODES 2048u
#define ROOT_MAX_SEGMENTS 2048u
#define ROOT_MAX_ATTRACTORS 4096u
#define ROOT_BIN_RES 64u
#define ROOT_BIN_COUNT 4096u
#define ROOT_MAX_BIN_ENTRIES 524288u
#define ROOT_FIXED_SCALE 65536.0f
#define ROOT_NO_DISTANCE 1.0e9f

struct FRootNode
{
	float2 Pos;          // Wrapped canonical UV in [0, 1)^2
	float2 Dir;          // Unit growth tangent
	uint ParentIndex;    // 0xFFFFFFFFu for trunk roots; always < own index otherwise
	uint BranchId;       // 1-based root/branch family ID
	float Radius;        // Solved pipe-model radius in UV units
	float ArcLength;     // Cumulative arc length from trunk origin
	uint Generation;     // Branch order (0 = trunk, 1+ = lateral)
	uint ChildCount;     // Number of children spawned from this node
};

struct FRootSegment
{
	float2 P0;           // Start point in [0, 1)^2
	float2 P1;           // Cubic start handle; end handle is P2 - (P2 - P0) / 3
	float2 P2;           // End point in P0's local unwrapped chart
	float R0;            // Start radius
	float R1;            // End radius
	float Arc0;          // Start arc length
	float Arc1;          // End arc length
	uint BranchId;       // 1-based ID
	uint Generation;     // Branch hierarchy depth
};

struct FRootAttractor
{
	float2 Pos;          // Wrapped canonical UV in [0, 1)^2
	uint Active;         // 1 = active, 0 = killed
	uint NearestNode;    // Cached nearest node index from prior growth steps
	float NearestDist;   // Cached toroidal distance to NearestNode
	uint Pad0;
	uint Pad1;
	uint Pad2;
};

int2 OutputSize;
uint Seed;
uint Trunks;
uint Attractors;
uint StepIndex;

float StepLength;
float InfluenceRadius;
float KillDistance;
float BranchSpread;
float DirectionInertia;
float CurlStrength;
uint CurlScale;
float BaseRadius;
float TipTaper;
float JunctionSmooth;
float ProfileFlatness;
float WeaveAmount;
float KinkStrength;
float BurialDepth;

// Growth (stages 0..5)
RWStructuredBuffer<FRootNode> RWNodeBuffer;
RWStructuredBuffer<FRootSegment> RWSegmentBuffer;
RWStructuredBuffer<FRootAttractor> RWAttractorBuffer;
// [0] NodeCount  [1] FrontierStart  [2] FrontierEnd  [3] SegmentCount
// [4] StoredBinEntries  [5] RequestedBinEntries (> [4] means the CSR capacity was exceeded)
RWBuffer<uint> RWStateBuffer;
// Growth: [PullX_Q16, PullY_Q16, PullCount, unused].
// Stage 3 reuses this storage as [StepsToTip, TrunkTipCount, unused, PipeTipCount].
RWBuffer<int> RWNodePullBuffer;
RWBuffer<uint> RWBinCounts;
RWBuffer<uint> RWBinOffsets;
RWBuffer<uint> RWBinWriteHeads;
RWBuffer<uint> RWBinEntries;

// Field (stage 6)
StructuredBuffer<FRootSegment> SegmentBuffer;
Buffer<uint> BinCounts;
Buffer<uint> BinOffsets;
Buffer<uint> BinEntries;

RWTexture2D<float> OutRootHeight;
RWTexture2D<float> OutRootCoverage;
RWTexture2D<float> OutRootEdgeDistance;
RWTexture2D<float> OutRootArcLength;
RWTexture2D<float> OutRootAcross;
RWTexture2D<float2> OutRootUV;
RWTexture2D<uint> OutRootIds;

float RootHash01(uint A, uint B, uint InSeed)
{
	uint h = MixtormatHashU(A * 0x27d4eb2du ^ B * 0x165667b1u ^ InSeed * 0x9e3779b9u);
	return (float)(h & 0x00FFFFFFu) * (1.0f / 16777215.0f);
}

// Shortest displacement on the unit torus.
float2 RootToroidalDelta(float2 From, float2 To)
{
	float2 d = To - From;
	return d - floor(d + 0.5f);
}

float2 RootSafeNormalize(float2 V, float2 Fallback)
{
	float lenSq = dot(V, V);
	return (lenSq > 1e-10f) ? (V * rsqrt(lenSq)) : Fallback;
}

// Divergence-free, integer-period guidance: the rotated gradient of periodic FBM.
float2 RootPeriodicCurl(float2 P, uint Scale, uint InSeed)
{
	float value = 0.0f;
	float2 grad = float2(0.0f, 0.0f);
	MixtormatNoiseFbm(P, (float)max(Scale, 1u), 2, 0.5f, 2.0f, InSeed ^ 0x517cc1b7u, value, grad);
	return RootSafeNormalize(float2(grad.y, -grad.x), float2(0.0f, 0.0f));
}

// Conservative bin footprint pad: radius + smooth-union reach + AA margin. Stages 3 and 5 must agree.
float RootSegmentPad(FRootSegment Seg)
{
	return max(Seg.R0, Seg.R1) + JunctionSmooth * BaseRadius * 0.85f + 0.004f;
}

void RootSegmentCells(FRootSegment Seg, out int MinX, out int MaxX, out int MinY, out int MaxY)
{
	float pad = RootSegmentPad(Seg);
	float2 bMin = min(Seg.P0, min(Seg.P1, Seg.P2)) - pad;
	float2 bMax = max(Seg.P0, max(Seg.P1, Seg.P2)) + pad;
	MinX = (int)floor(bMin.x * (float)ROOT_BIN_RES);
	MinY = (int)floor(bMin.y * (float)ROOT_BIN_RES);
	MaxX = min((int)floor(bMax.x * (float)ROOT_BIN_RES), MinX + (int)ROOT_BIN_RES - 1);
	MaxY = min((int)floor(bMax.y * (float)ROOT_BIN_RES), MinY + (int)ROOT_BIN_RES - 1);
}

uint RootWrapCell(int C)
{
	return (uint)((C % (int)ROOT_BIN_RES + (int)ROOT_BIN_RES) % (int)ROOT_BIN_RES);
}

#if ROOT_STAGE == 0

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint idx = DispatchThreadId.x;
	uint trunkCount = clamp(Trunks, 1u, 32u);
	uint attrCount = clamp(Attractors, 16u, ROOT_MAX_ATTRACTORS);

	if (idx == 0u)
	{
		RWStateBuffer[0] = trunkCount;
		RWStateBuffer[1] = 0u;
		RWStateBuffer[2] = trunkCount;
		RWStateBuffer[3] = 0u;
		RWStateBuffer[4] = 0u;
		RWStateBuffer[5] = 0u;
	}

	if (idx < ROOT_MAX_NODES)
	{
		RWNodePullBuffer[idx * 4u + 0u] = 0;
		RWNodePullBuffer[idx * 4u + 1u] = 0;
		RWNodePullBuffer[idx * 4u + 2u] = 0;
		RWNodePullBuffer[idx * 4u + 3u] = 0;

		FRootNode node = (FRootNode)0;
		node.Dir = float2(1.0f, 0.0f);
		node.ParentIndex = 0xFFFFFFFFu;
		if (idx < trunkCount)
		{
			uint gridX = max(1u, (uint)ceil(sqrt((float)trunkCount)));
			uint gridY = (trunkCount + gridX - 1u) / gridX;
			uint gx = idx % gridX;
			uint gy = idx / gridX;
			float2 jitter = float2(
				RootHash01(idx, 11u, Seed ^ 0x13579bdfu),
				RootHash01(idx, 29u, Seed ^ 0x2468ace0u)) * 0.65f + 0.175f;
			node.Pos = frac((float2(gx, gy) + jitter) / float2(gridX, max(gridY, 1u)));
			float angle = RootHash01(idx, 53u, Seed ^ 0x9e3779b9u) * 6.28318530718f;
			node.Dir = float2(cos(angle), sin(angle));
			node.BranchId = idx + 1u;
			node.Radius = BaseRadius;
		}
		RWNodeBuffer[idx] = node;
	}

	if (idx < attrCount)
	{
		// Stratified jitter on the torus: every cell of a square grid holds one attractor,
		// so density is uniform across the seam by construction.
		uint gridDim = max(1u, (uint)ceil(sqrt((float)attrCount)));
		uint gx = idx % gridDim;
		uint gy = idx / gridDim;
		float2 jitter = float2(
			RootHash01(idx, 71u, Seed ^ 0x6c8e9cf5u),
			RootHash01(idx, 97u, Seed ^ 0xb5297a4du)) * 0.85f + 0.075f;

		FRootAttractor attr = (FRootAttractor)0;
		attr.Pos = frac((float2(gx, gy) + jitter) / (float)gridDim);
		attr.Active = 1u;
		attr.NearestNode = 0xFFFFFFFFu;
		attr.NearestDist = 1e30f;
		RWAttractorBuffer[idx] = attr;
	}
}

#elif ROOT_STAGE == 1

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint attrIdx = DispatchThreadId.x;
	uint attrCount = clamp(Attractors, 16u, ROOT_MAX_ATTRACTORS);
	if (attrIdx >= attrCount)
	{
		return;
	}

	FRootAttractor attr = RWAttractorBuffer[attrIdx];
	if (attr.Active == 0u)
	{
		return;
	}

	uint frontierStart = RWStateBuffer[1];
	uint frontierEnd = min(RWStateBuffer[2], ROOT_MAX_NODES);

	// Skeleton nodes never move, so the cached nearest node stays valid; only the nodes added
	// by the previous step can beat it. Total work is O(attractors x nodes) over the whole
	// growth instead of per step.
	uint bestNode = attr.NearestNode;
	float bestDist = attr.NearestDist;
	for (uint v = frontierStart; v < frontierEnd; ++v)
	{
		float dist = length(RootToroidalDelta(RWNodeBuffer[v].Pos, attr.Pos));
		if (dist < bestDist)
		{
			bestDist = dist;
			bestNode = v;
		}
	}

	attr.NearestNode = bestNode;
	attr.NearestDist = bestDist;
	if (bestDist < KillDistance)
	{
		attr.Active = 0u;
	}
	RWAttractorBuffer[attrIdx] = attr;

	if (attr.Active != 0u && bestNode < ROOT_MAX_NODES && bestDist <= InfluenceRadius)
	{
		float2 pullDir = RootSafeNormalize(
			RootToroidalDelta(RWNodeBuffer[bestNode].Pos, attr.Pos), float2(1.0f, 0.0f));
		// Integer sums are order independent, so the result is bit-identical run to run.
		InterlockedAdd(RWNodePullBuffer[bestNode * 4u + 0u], (int)round(pullDir.x * ROOT_FIXED_SCALE));
		InterlockedAdd(RWNodePullBuffer[bestNode * 4u + 1u], (int)round(pullDir.y * ROOT_FIXED_SCALE));
		InterlockedAdd(RWNodePullBuffer[bestNode * 4u + 2u], 1);
	}
}

#elif ROOT_STAGE == 2

groupshared uint SharedSpawnFlags[64];

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	// One group, ordered 64-wide chunks: child slots are assigned in parent-index order, which
	// keeps ParentIndex < child index and makes the topology deterministic.
	uint tid = DispatchThreadId.x;
	uint oldNodeCount = min(RWStateBuffer[0], ROOT_MAX_NODES);
	uint newNodeCount = oldNodeCount;

	for (uint baseIdx = 0u; baseIdx < oldNodeCount; baseIdx += 64u)
	{
		uint v = baseIdx + tid;
		uint canSpawn = 0u;
		float2 spawnDir = float2(1.0f, 0.0f);
		FRootNode parentNode = (FRootNode)0;

		if (v < oldNodeCount)
		{
			int pullX = RWNodePullBuffer[v * 4u + 0u];
			int pullY = RWNodePullBuffer[v * 4u + 1u];
			int pullCount = RWNodePullBuffer[v * 4u + 2u];
			RWNodePullBuffer[v * 4u + 0u] = 0;
			RWNodePullBuffer[v * 4u + 1u] = 0;
			RWNodePullBuffer[v * 4u + 2u] = 0;

			parentNode = RWNodeBuffer[v];
			// Apical momentum: tip nodes continue growing by inertia if local attractors are depleted,
			// exploring voids rather than halting prematurely.
			bool bHasAttractors = (pullCount > 0);
			bool bCanCoast = (pullCount == 0 && parentNode.ChildCount == 0u && parentNode.Generation <= 2u
				&& RootHash01(v, StepIndex + 73u, Seed ^ 0x5a1f9e2bu) < DirectionInertia * 0.75f);

			if ((bHasAttractors || bCanCoast) && parentNode.ChildCount < 3u)
			{
				float2 avgPull = bHasAttractors
					? RootSafeNormalize(float2((float)pullX, (float)pullY), parentNode.Dir)
					: parentNode.Dir;
				float2 curl = RootPeriodicCurl(parentNode.Pos, CurlScale, Seed);
				float2 blended = lerp(avgPull, parentNode.Dir, saturate(DirectionInertia)) + curl * CurlStrength;

				// A node that already has a child grows a lateral, deflected by Branch Spread.
				if (parentNode.ChildCount > 0u)
				{
					float side = (RootHash01(v, StepIndex + 101u, Seed ^ 0x3c6ef372u) >= 0.5f) ? 1.0f : -1.0f;
					float spreadAngle = BranchSpread * 1.15f * side;
					float cs = cos(spreadAngle);
					float sn = sin(spreadAngle);
					blended = float2(blended.x * cs - blended.y * sn, blended.x * sn + blended.y * cs);
				}

				// Biological circumnutation (continuous wandering zigzag) + sharp obstacle deflection (kink)
				if (KinkStrength > 0.001f)
				{
					float zigzagPhase = parentNode.ArcLength * (24.0f + 14.0f * (float)(parentNode.BranchId % 4u))
						+ (float)parentNode.BranchId * 1.6180339f;
					float kinkAngle = sin(zigzagPhase) * (KinkStrength * 0.65f);

					// Sudden sharp obstacle deflection / dogleg kink
					float crookHash = RootHash01(v, StepIndex + 333u, Seed ^ 0x85ebca6bu);
					if (crookHash < KinkStrength * 0.30f)
					{
						float crookAngle = (RootHash01(v, StepIndex + 777u, Seed ^ 0xc2b2ae35u) - 0.5f) * 1.6f * KinkStrength;
						kinkAngle += crookAngle;
					}

					float ck = cos(kinkAngle);
					float sk = sin(kinkAngle);
					blended = float2(blended.x * ck - blended.y * sk, blended.x * sk + blended.y * ck);
				}

				spawnDir = RootSafeNormalize(blended, parentNode.Dir);
				canSpawn = 1u;
			}
		}

		SharedSpawnFlags[tid] = canSpawn;
		GroupMemoryBarrierWithGroupSync();

		uint prefix = 0u;
		uint chunkTotal = 0u;
		for (uint i = 0u; i < 64u; ++i)
		{
			uint flag = SharedSpawnFlags[i];
			prefix += (i < tid) ? flag : 0u;
			chunkTotal += flag;
		}

		if (canSpawn != 0u)
		{
			uint outIdx = newNodeCount + prefix;
			if (outIdx < ROOT_MAX_NODES)
			{
				uint isLateral = (parentNode.ChildCount > 0u) ? 1u : 0u;
				parentNode.ChildCount += 1u;
				RWNodeBuffer[v] = parentNode;

				FRootNode child;
				child.Pos = frac(parentNode.Pos + spawnDir * StepLength);
				child.Dir = spawnDir;
				child.ParentIndex = v;
				child.BranchId = (isLateral != 0u) ? (outIdx + 1u) : parentNode.BranchId;
				child.Radius = BaseRadius;
				child.ArcLength = parentNode.ArcLength + StepLength;
				child.Generation = parentNode.Generation + isLateral;
				child.ChildCount = 0u;
				RWNodeBuffer[outIdx] = child;
			}
		}

		newNodeCount = min(newNodeCount + chunkTotal, ROOT_MAX_NODES);
		GroupMemoryBarrierWithGroupSync();
	}

	if (tid == 0u)
	{
		RWStateBuffer[0] = newNodeCount;
		RWStateBuffer[1] = oldNodeCount;
		RWStateBuffer[2] = newNodeCount;
	}
}

#elif ROOT_STAGE == 3

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint tid = DispatchThreadId.x;
	uint nodeCount = min(RWStateBuffer[0], ROOT_MAX_NODES);

	for (uint c = tid; c < ROOT_BIN_COUNT; c += 64u)
	{
		RWBinCounts[c] = 0u;
		RWBinWriteHeads[c] = 0u;
	}
	// Growth is finished; reuse the pull storage for subtree size and tip distance.
	for (uint l = tid; l < nodeCount; l += 64u)
	{
		RWNodePullBuffer[l * 4u + 0u] = 0;
		RWNodePullBuffer[l * 4u + 3u] = (RWNodeBuffer[l].ChildCount == 0u) ? 1 : 0;
	}
	AllMemoryBarrierWithGroupSync();

	// Parents precede children, so a reverse sweep accumulates subtree tips in O(N).
	// Serial on purpose: dependent adds without atomics keep the result deterministic.
	if (tid == 0u)
	{
		for (uint r = nodeCount; r > 0u; --r)
		{
			uint v = r - 1u;
			uint parent = RWNodeBuffer[v].ParentIndex;
			if (parent < v)
			{
				RWNodePullBuffer[parent * 4u + 3u] += RWNodePullBuffer[v * 4u + 3u];
				RWNodePullBuffer[parent * 4u + 0u] = max(RWNodePullBuffer[parent * 4u + 0u],
					RWNodePullBuffer[v * 4u + 0u] + 1);
			}
		}
		// Parent-first propagation gives each node its own trunk's reference thickness.
		for (uint v = 0u; v < nodeCount; ++v)
		{
			uint parent = RWNodeBuffer[v].ParentIndex;
			RWNodePullBuffer[v * 4u + 1u] = (parent < v)
				? RWNodePullBuffer[parent * 4u + 1u]
				: RWNodePullBuffer[v * 4u + 3u];
		}
	}
	AllMemoryBarrierWithGroupSync();

	// Subtree ratios preserve thick parents and fine offshoots. Tip distance adds taper
	// along unbranched runs, where leaf count alone would produce a constant-width cable.
	float tipScale = 1.0f - saturate(TipTaper);
	tipScale *= tipScale;
	for (uint n = tid; n < nodeCount; n += 64u)
	{
		FRootNode node = RWNodeBuffer[n];
		float tips = (float)max(RWNodePullBuffer[n * 4u + 3u], 1);
		float trunkTips = (float)max(RWNodePullBuffer[n * 4u + 1u], 1);
		float rawRadius = BaseRadius * pow(saturate(tips / trunkTips), 0.42f);
		float depthFade = exp(-0.08f * (float)node.Generation);
		float remainingLength = (float)RWNodePullBuffer[n * 4u + 0u] * StepLength;
		float tipFade = lerp(tipScale, 1.0f,
			smoothstep(0.0f, max(InfluenceRadius, StepLength), remainingLength));
		node.Radius = max(rawRadius * depthFade * tipFade, 1e-4f);
		RWNodeBuffer[n] = node;
	}
	AllMemoryBarrierWithGroupSync();

	uint trunkCount = min(clamp(Trunks, 1u, 32u), nodeCount);
	uint segCount = nodeCount - trunkCount;
	if (tid == 0u)
	{
		RWStateBuffer[3] = segCount;
	}

	// One segment per non-trunk node, stored in the parent's unwrapped chart so a segment
	// crossing the seam is one continuous curve.
	for (uint v = tid; v < nodeCount; v += 64u)
	{
		if (v >= trunkCount)
		{
			uint segIdx = v - trunkCount;
			FRootNode child = RWNodeBuffer[v];
			FRootNode parent = RWNodeBuffer[child.ParentIndex];

			float2 p0 = parent.Pos;
			float2 delta = RootToroidalDelta(p0, child.Pos);
			float2 p2 = p0 + delta;
			float segLen = length(delta);
			// The start tangent matches the preceding segment's arrival tangent.
							// The end tangent is this growth edge, shared by the next segment's start.
							float2 p1 = p0 + parent.Dir * (segLen / 3.0f);

			FRootSegment seg;
			seg.P0 = p0;
			seg.P1 = p1;
			seg.P2 = p2;
			seg.R0 = parent.Radius;
			seg.R1 = child.Radius;
			seg.Arc0 = parent.ArcLength;
			seg.Arc1 = child.ArcLength;
			seg.BranchId = child.BranchId;
			seg.Generation = child.Generation;
			RWSegmentBuffer[segIdx] = seg;

			int minX, maxX, minY, maxY;
			RootSegmentCells(seg, minX, maxX, minY, maxY);

			for (int cy = minY; cy <= maxY; ++cy)
			{
				uint wy = RootWrapCell(cy);
				for (int cx = minX; cx <= maxX; ++cx)
				{
					InterlockedAdd(RWBinCounts[wy * ROOT_BIN_RES + RootWrapCell(cx)], 1u);
				}
			}
		}
	}
}

#elif ROOT_STAGE == 4

groupshared uint SharedChunkTotals[64];

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	// 64 threads x 64 contiguous cells = 4096 cells. 256 bytes of groupshared.
	uint tid = DispatchThreadId.x;
	uint baseCell = tid * 64u;

	uint localSum = 0u;
	for (uint i = 0u; i < 64u; ++i)
	{
		uint c = baseCell + i;
		uint cnt = RWBinCounts[c];
		RWBinOffsets[c] = localSum;
		localSum += cnt;
	}

	SharedChunkTotals[tid] = localSum;
	GroupMemoryBarrierWithGroupSync();

	uint chunkOffset = 0u;
	for (uint k = 0u; k < tid; ++k)
	{
		chunkOffset += SharedChunkTotals[k];
	}

	for (uint j = 0u; j < 64u; ++j)
	{
		uint c = baseCell + j;
		uint finalOffset = min(RWBinOffsets[c] + chunkOffset, ROOT_MAX_BIN_ENTRIES);
		uint storable = (finalOffset < ROOT_MAX_BIN_ENTRIES)
			? min(RWBinCounts[c], ROOT_MAX_BIN_ENTRIES - finalOffset)
			: 0u;
		RWBinOffsets[c] = finalOffset;
		RWBinCounts[c] = storable;
		RWBinWriteHeads[c] = 0u;
	}

	if (tid == 63u)
	{
		uint requested = chunkOffset + localSum;
		RWStateBuffer[4] = min(requested, ROOT_MAX_BIN_ENTRIES);
		// Recorded, never hidden: [5] > [4] flags a capacity overflow.
		RWStateBuffer[5] = requested;
	}
}

#elif ROOT_STAGE == 5

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint tid = DispatchThreadId.x;
	uint segCount = min(RWStateBuffer[3], ROOT_MAX_SEGMENTS);

	for (uint s = tid; s < segCount; s += 64u)
	{
		FRootSegment seg = RWSegmentBuffer[s];
		int minX, maxX, minY, maxY;
		RootSegmentCells(seg, minX, maxX, minY, maxY);
		for (int cy = minY; cy <= maxY; ++cy)
		{
			uint wy = RootWrapCell(cy);
			for (int cx = minX; cx <= maxX; ++cx)
			{
				uint cellIdx = wy * ROOT_BIN_RES + RootWrapCell(cx);
				uint localSlot = 0u;
				InterlockedAdd(RWBinWriteHeads[cellIdx], 1u, localSlot);
				if (localSlot < RWBinCounts[cellIdx])
				{
					RWBinEntries[RWBinOffsets[cellIdx] + localSlot] = s;
				}
			}
		}
	}

	AllMemoryBarrierWithGroupSync();

	// Sort by branch, then segment index: field evaluation can finish each stem before
	// blending junctions, without a pixel-dependent choice of hard versus smooth union.
	for (uint cellIdx = tid; cellIdx < ROOT_BIN_COUNT; cellIdx += 64u)
	{
		uint offset = RWBinOffsets[cellIdx];
		uint count = RWBinCounts[cellIdx];
		for (uint i = 1u; i < count; ++i)
		{
			uint key = RWBinEntries[offset + i];
			uint keyBranch = RWSegmentBuffer[key].BranchId;
			int j = (int)i - 1;
			while (j >= 0)
			{
				uint previous = RWBinEntries[offset + (uint)j];
				uint previousBranch = RWSegmentBuffer[previous].BranchId;
				if (previousBranch < keyBranch || (previousBranch == keyBranch && previous <= key))
				{
					break;
				}
				RWBinEntries[offset + (uint)(j + 1)] = previous;
				j -= 1;
			}
			RWBinEntries[offset + (uint)(j + 1)] = key;
		}
	}
}

#elif ROOT_STAGE == 6

// Signed distance to a cubic Bezier sweep with linearly varying radius:
// minimise f(t) = |B(t) - u| - r(t). Chord seed + 5-point bracket + 2 damped Newton steps on
// f'(t), explicit endpoint caps, and a taper-slope cosine correction for the cone flank.
void EvaluateTaperedBezierSweep(
	float2 U,
	FRootSegment Seg,
	out float OutSignedDist,
	out float OutParamT,
	out float OutRadiusAtT,
	out float OutLateralCoord)
{
	// The pixel expressed in the segment's own unwrapped chart.
	float2 uLocal = Seg.P0 + RootToroidalDelta(Seg.P0, U);

	float2 chord = Seg.P2 - Seg.P0;
	float chordLenSq = max(dot(chord, chord), 1e-8f);
	float tBest = saturate(dot(uLocal - Seg.P0, chord) / chordLenSq);

	// Growth stores the arriving edge direction in each node, so the end handle can be
	// reconstructed from the chord without changing the shared CPU/GPU segment layout.
	float2 endHandle = Seg.P2 - chord / 3.0f;
	float2 a = -Seg.P0 + 3.0f * Seg.P1 - 3.0f * endHandle + Seg.P2;
	float2 b = 3.0f * (Seg.P0 - 2.0f * Seg.P1 + endHandle);
	float2 c = 3.0f * (Seg.P1 - Seg.P0);
	float dR = Seg.R1 - Seg.R0;

	float2 posB = ((a * tBest + b) * tBest + c) * tBest + Seg.P0;
	float valB = length(posB - uLocal) - lerp(Seg.R0, Seg.R1, tBest);
	[unroll]
	for (uint s = 0u; s <= 4u; ++s)
	{
		float ts = (float)s * 0.25f;
		float2 posS = ((a * ts + b) * ts + c) * ts + Seg.P0;
		float valS = length(posS - uLocal) - lerp(Seg.R0, Seg.R1, ts);
		if (valS < valB)
		{
			valB = valS;
			tBest = ts;
		}
	}

	float t = tBest;
	[unroll]
	for (uint it = 0u; it < 2u; ++it)
	{
		float2 Bt = ((a * t + b) * t + c) * t + Seg.P0;
		float2 dBt = (3.0f * a * t + 2.0f * b) * t + c;
		float2 ddBt = 6.0f * a * t + 2.0f * b;
		float2 diff = Bt - uLocal;
		float dist = max(length(diff), 1e-6f);

		float g = dot(diff, dBt) - dist * dR;
		float dg = dot(dBt, dBt) + dot(diff, ddBt) - (dot(diff, dBt) / dist) * dR;
		float step = g / max(abs(dg), 1e-5f) * (dg >= 0.0f ? 1.0f : -1.0f);
		t = saturate(t - clamp(step, -0.35f, 0.35f));
	}

	float2 BFinal = ((a * t + b) * t + c) * t + Seg.P0;
	// A Newton step can overshoot on a tight bend; retain the best sampled candidate.
	if (length(BFinal - uLocal) - lerp(Seg.R0, Seg.R1, t) > valB)
	{
		t = tBest;
		BFinal = ((a * t + b) * t + c) * t + Seg.P0;
	}
	float rFinal = max(lerp(Seg.R0, Seg.R1, t), 1e-4f);
	float speed = max(length((3.0f * a * t + 2.0f * b) * t + c), 1e-5f);
	float cosAlpha = sqrt(saturate(1.0f - (dR * dR) / (speed * speed)));
	float dFinal = (length(BFinal - uLocal) - rFinal) * max(cosAlpha, 0.5f);

	float d0 = length(Seg.P0 - uLocal) - Seg.R0;
	if (d0 < dFinal)
	{
		dFinal = d0;
		t = 0.0f;
		rFinal = max(Seg.R0, 1e-4f);
	}
	float d1 = length(Seg.P2 - uLocal) - Seg.R1;
	if (d1 < dFinal)
	{
		dFinal = d1;
		t = 1.0f;
		rFinal = max(Seg.R1, 1e-4f);
	}

	OutSignedDist = dFinal;
	OutParamT = t;
	OutRadiusAtT = rFinal;

	float2 dBt = (3.0f * a * t + 2.0f * b) * t + c;
	float2 tangent = RootSafeNormalize(dBt, chord);
	float2 normal = float2(-tangent.y, tangent.x);
	float lateral = dot(uLocal - BFinal, normal);
	OutLateralCoord = clamp(lateral / max(rFinal, 1e-4f), -1.0f, 1.0f);
}

// Cross-section: real-unit cylinder cap corrected by thickness, with soil burial depth.
float RootCrossSectionHeight(float SignedDist, float Radius)
{
	if (SignedDist >= 0.0f)
	{
		return 0.0f;
	}
	float q = saturate(-SignedDist / max(Radius, 1e-4f)); // 0 at the rim, 1 on the axis
	float dome = sqrt(saturate(2.0f * q - q * q));
	float flatTop = smoothstep(0.0f, max(1.0f - ProfileFlatness * 0.7f, 0.15f), dome);
	float profile = lerp(dome, flatTop, saturate(ProfileFlatness));

	// Physical height proportional to thickness: peak height on axis = Radius.
	// Soil burial depth sinks thin roots beneath the soil plane while thick roots break through.
	float burialOffset = BurialDepth * max(BaseRadius, 1e-4f);
	float rawHeight = profile * Radius;
	float exposedHeight = max(0.0f, rawHeight - burialOffset);

	// Normalized by BaseRadius so an unburied trunk peak reaches ~1.0 in generator height space
	return exposedHeight / max(BaseRadius, 1e-4f);
}

// Merge complete branch envelopes, never a union distance with a different stem's radius.
void RootMergeBranchFields(float BranchDistance, float BranchHeight, float SmoothWidth,
	inout float Distance, inout float Height)
{
	float h = saturate(0.5f + 0.5f * (Distance - BranchDistance) / SmoothWidth);
	Distance = lerp(Distance, BranchDistance, h) - SmoothWidth * h * (1.0f - h);

	// Height is normalized by BaseRadius. Limit smoothing to overlapping support so an
	// absent branch (including one omitted by the spatial bin) contributes exactly zero.
	float width = min(SmoothWidth / max(BaseRadius, 1e-4f), 2.0f * min(Height, BranchHeight));
	float blend = saturate(1.0f - abs(Height - BranchHeight) / max(width, 1e-5f));
	Height = max(Height, BranchHeight) + 0.25f * width * blend * blend;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 pix = int2(DispatchThreadId.xy);
	if (pix.x >= OutputSize.x || pix.y >= OutputSize.y)
	{
		return;
	}

	float2 rawUV = (float2(pix) + 0.5f) / float2(OutputSize);
	float2 uv = frac(MixtormatGeneratorUV(rawUV));

	uint cellX = min((uint)floor(uv.x * (float)ROOT_BIN_RES), ROOT_BIN_RES - 1u);
	uint cellY = min((uint)floor(uv.y * (float)ROOT_BIN_RES), ROOT_BIN_RES - 1u);
	uint cellIdx = cellY * ROOT_BIN_RES + cellX;
	uint offset = BinOffsets[cellIdx];
	uint count = BinCounts[cellIdx];

	float kSmooth = max(JunctionSmooth * BaseRadius * 0.85f, 1e-5f);

	float sdAcc = ROOT_NO_DISTANCE;
	float bestRaw = ROOT_NO_DISTANCE;
	float bestArc = 0.0f;
	float bestVnorm = 0.0f;
	uint bestBranchId = 0u;
	float height = 0.0f;
	float branchDistance = ROOT_NO_DISTANCE;
	float branchHeight = 0.0f;
	uint branchId = 0u;

	for (uint i = 0u; i < count; ++i)
	{
		FRootSegment seg = SegmentBuffer[BinEntries[offset + i]];

		float sd;
		float t;
		float rAtT;
		float vNorm;
		EvaluateTaperedBezierSweep(uv, seg, sd, t, rAtT, vNorm);

		// Stage 5 groups each branch contiguously. Hard-union its segment envelopes to
		// avoid beads at every joint, then smooth-union the completed branches.
		if (seg.BranchId != branchId)
		{
			if (branchId != 0u)
			{
				RootMergeBranchFields(branchDistance, branchHeight, kSmooth, sdAcc, height);
			}
			branchId = seg.BranchId;
			branchDistance = ROOT_NO_DISTANCE;
			branchHeight = 0.0f;
		}

		float arc = lerp(seg.Arc0, seg.Arc1, t);
		float weave = sin(arc * 25.1327412f + (float)seg.BranchId * 1.6180339f) * WeaveAmount * 0.25f;
		float segmentHeight = RootCrossSectionHeight(sd, rAtT) * max(1.0f + weave, 0.0f);
		branchDistance = min(branchDistance, sd);
		branchHeight = max(branchHeight, segmentHeight);

		if (sd < bestRaw)
		{
			bestRaw = sd;
			bestBranchId = seg.BranchId;
			bestArc = frac(arc);
			bestVnorm = vNorm;
		}
	}
	if (branchId != 0u)
	{
		RootMergeBranchFields(branchDistance, branchHeight, kSmooth, sdAcc, height);
	}

	bool bInside = sdAcc <= 0.0f;
	float pixelWidthUV = 1.0f / (float)max(OutputSize.x, OutputSize.y);
	float coverage = (count > 0u) ? smoothstep(pixelWidthUV, -pixelWidthUV, sdAcc) : 0.0f;

	// Normalized across-profile coordinate: 0 at center spine, 1 at outer flank
	float acrossValue = bInside ? abs(bestVnorm) : 0.0f;
	// Orthogonal 2D root UVs: U = arc length along branch [0, 1), V = cross profile [0, 1]
	float across01 = 0.5f + 0.5f * bestVnorm;
	float2 rootUV = float2(bestArc, across01);
	// Smoothly blend to raw canvas UV outside roots so downstream noise blankets tile seamlessly
	float2 finalUV = lerp(rawUV, rootUV, coverage);

	OutRootHeight[pix] = height;
	OutRootCoverage[pix] = coverage;
	// Banded signed distance in UV: exact within each segment's bin footprint, sentinel outside.
	OutRootEdgeDistance[pix] = (count > 0u) ? sdAcc : ROOT_NO_DISTANCE;
	OutRootArcLength[pix] = bInside ? bestArc : 0.0f;
	OutRootAcross[pix] = acrossValue;
	OutRootUV[pix] = finalUV;
	OutRootIds[pix] = bInside ? bestBranchId : 0u;
}

#endif
