#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatFractureShape.ush"
#include "/Plugin/Mixtormat/Private/MixtormatFieldSample.ush"
#include "/Plugin/Mixtormat/Private/MixtormatSdfBlend.ush"

int2 OutputSize;
// @param FractureSeed hardmin=0
uint FractureSeed;
// @param FractureScale hardmin=2 hardmax=64
float FractureScale;
// @param FractureAmount hardmin=0 hardmax=1
float FractureAmount;
// Stored Width is 0..1; gather converts it to output pixels.
// @param FractureWidth hardmin=0.001 hardmax=1
float FractureWidthPixels;
// @param FractureDepth hardmin=0
float FractureDepth;
// @param FractureProfile hardmin=0.05
float FractureProfile;
// @param FractureChamfer hardmin=0
float FractureChamfer;
// @param FractureVariation hardmin=0 hardmax=1
float FractureVariation;
Texture2D<uint2> PieceIds;
Texture2D<float2> SourcePosition;
Texture2D<float4> BoundaryRecord;

Texture2D<float> SourceHeight;
Texture2D<float> ShapeField;
SamplerState LinearWrapSampler;
RWTexture2D<float> OutHeight;
RWTexture2D<float> OutFractureMask;
RWTexture2D<float> OutFaceProgress;

// Manual bilinear gather: xy are coverage-weighted field/height, z is owned
// coverage. A gap corner loses only its own weight, not the entire footprint.
float3 FractureSampleFields(float2 Q, uint2 Owner)
{
	const int2 Base = int2(floor(Q));
	const float2 F = frac(Q);
	float3 Sum = 0.0f;
	[unroll]
	for (int Y = 0; Y <= 1; ++Y)
	{
		[unroll]
		for (int X = 0; X <= 1; ++X)
		{
			const int2 Tap = FractureWrap(Base + int2(X, Y), OutputSize);
			const uint2 TapOwner = PieceIds.Load(int3(Tap, 0));
			if (TapOwner.x != MIXTORMAT_INVALID_REGION && all(TapOwner == Owner))
			{
				const float Weight = (X == 0 ? 1.0f - F.x : F.x)
					* (Y == 0 ? 1.0f - F.y : F.y);
				Sum += float3(ShapeField.Load(int3(Tap, 0)),
					SourceHeight.Load(int3(Tap, 0)), 1.0f) * Weight;
			}
		}
	}
	return Sum;
}

// Carry coverage through the tent filter instead of renormalizing a changing
// set of accepted footprints. This avoids hard switches beside one-pixel gaps.
float3 FractureFilteredFields(float2 Q, uint2 Owner, float Radius)
{
	const float3 Center = FractureSampleFields(Q, Owner);
	if (Radius <= 0.0f)
	{
		return Center;
	}
	float3 Sum = Center * 4.0f;
	[unroll]
	for (int Y = -1; Y <= 1; ++Y)
	{
		[unroll]
		for (int X = -1; X <= 1; ++X)
		{
			if (X == 0 && Y == 0)
			{
				continue;
			}
			const float2 Tap = Q + float2(X, Y) * Radius;
			const float Weight = (X == 0 || Y == 0) ? 2.0f : 1.0f;
			Sum += FractureSampleFields(Tap, Owner) * Weight;
		}
	}
	return Sum / 16.0f;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}
	const int2 P = int2(DispatchThreadId.xy);
	const float Original = SourceHeight.Load(int3(P, 0));
	const float4 Record = BoundaryRecord.Load(int3(P, 0));
	OutHeight[P] = Original;
	OutFractureMask[P] = 0.0f;
	OutFaceProgress[P] = PieceIds.Load(int3(P, 0)).x == MIXTORMAT_INVALID_REGION ? 0.0f : 1.0f;
	if (Record.w <= 0.5f)
	{
		return;
	}

	const uint Index = asuint(Record.z);
	const int2 SeedP = int2(Index % uint(OutputSize.x), Index / uint(OutputSize.x));
	const uint2 SeedOwner = PieceIds.Load(int3(SeedP, 0));
	const uint2 Owner = PieceIds.Load(int3(P, 0));
	// Gaps are floor/background, not fracture material. They must never enter
	// the SDF or face solve, even inside the boundary feather.
	if (Owner.x == MIXTORMAT_INVALID_REGION)
	{
		return;
	}
	// Never borrow a neighbouring piece's shoulder to cut the wrong region.
	if (!all(Owner == SeedOwner))
	{
		return;
	}

	const uint Seed = FractureOwnerSeed(SeedOwner, FractureSeed);
	const float2 UV = (float2(P) + 0.5f) / float2(OutputSize);
	const int Period = (int)round(FractureScale);
	const float Variation = FractureVariation;
	const float2 Fields = FractureShapeFields(UV, Period, Seed);
	const float Width = FractureWidthPixels * (1.0f + Variation * (0.65f * Fields.x
		+ 0.2f * (MixtormatRegionRandom(Seed) * 2.0f - 1.0f)));
	// Signed offset: positive erodes, negative dilates. Variation changes the piece contour,
	// independently of the width of the slope raised on that contour.
	const float Offset = FractureWidthPixels * (0.12f + 0.9f * Variation * Fields.y);
	// A is the base field; B is the SAME field sampled through displaced UVs.
	// Blend signed values before shaping height, not a groove mask or two heights.
	const float2 Q = SourcePosition.Load(int3(P, 0));

	// Actual displacement includes Amount, Variation and local warp strength.
	// This is intensity-driven smoothing, not a UV-Jacobian antialiasing solve.
	// A bounded two-texel radius keeps nine bilinear taps from becoming sparse
	// at high intensity. No bound parameter is clamped here.
	const float Displacement = length(Q - float2(P));
	const float FilterRadius = 2.0f * (Displacement / (Displacement + 4.0f));
	const float LocalField = ShapeField.Load(int3(P, 0));
	// The unmodified owner-distance field masks smoothing to ID/gap edges,
	// not fracture-face intensity. Interiors retain ordinary owner-aware bilinear sampling.
	const float EdgeDistancePixels = -LocalField * FractureWidthPixels;
	const float EdgeFilterMask = 1.0f - smoothstep(
		0.5f, 1.5f + FilterRadius, EdgeDistancePixels);
	const float3 Filtered = FractureFilteredFields(Q, Owner, FilterRadius * EdgeFilterMask);
	// Keep the existing local-value policy for missing ownership, but apply it
	// by coverage rather than switching an entire sample on or off.
	const float Coverage = saturate(Filtered.z);
	const float2 SampledFields = Filtered.xy
		+ float2(LocalField, Original) * (1.0f - Coverage);
	const float FieldScale = FractureWidthPixels / Width;
	const float A = LocalField * FieldScale;
	// With zero owned coverage B equals A exactly, including the contour offset.
	const float B = SampledFields.x * FieldScale + (Offset / Width) * Coverage;
	const float Chamfer = FractureChamfer;
	const float CombinedField = MixtormatSdfIntersectChamferCorrelated(A, B, Chamfer);
	const float SignedDistance = -CombinedField * Width;


	const float Depth = FractureDepth
		* (1.0f + Variation * 0.4f * (MixtormatRegionRandom(Seed ^ 0x85ebca6bu) * 2.0f - 1.0f));
	const float Profile = FractureProfile * (1.0f + Variation * 0.35f * Fields.x);
	const float U = saturate(SignedDistance / Width);
	OutFaceProgress[P] = U;
	const float Surface = SampledFields.y;
	// A nearest seed's max shoulder jumps whenever the winning seed changes.
	// Anchor the broad, three-section face to the owner-local surface instead:
	// U=0 removes Depth and U=1 meets Surface exactly, without seed-height peaks.
	const float Shaped = Surface - Depth * (1.0f - FractureFace(U, Profile));
	const float Result = lerp(Original, Shaped, FractureAmount);
	OutHeight[P] = Result;
	const float MaskDepth = FractureDepth == 0.0f ? 1.0e-5f : FractureDepth;
	OutFractureMask[P] = saturate(abs(Result - Original) / MaskDepth);
}
