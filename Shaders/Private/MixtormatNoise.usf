// Noise: a tileable field producer. MainCS produces raw fields; FlowCS reads completed height.
//
// The module publishes what the algorithm genuinely produces and decides nothing about what it
// means. Per pixel it writes:
//
//   OutValue     the family's raw contract value (see the table below)
//   OutHeight    the same field remapped to the shared signed generator contract, zero-centred
//                so zero is the neutral generator height; the compositor's shared signed
//                normalization and Height Scale run on this afterwards
//   OutGradient  the field's gradient, with directional meaning (unit direction for Worley and
//                Bars, the analytic derivative for the lattice families)
//   OutIds       the Worley cell identity; bound only when the family produces cells
//
//   family            Value contract            module height
//   ----------------  ------------------------  -----------------
//   Gradient / Value  signed, zero-centred      the value itself
//   FBM               signed, zero-centred      the value itself
//   Ridged            0..1, crests at 1         Value * 2 - 1
//   Billow            0..1, bumps at 1          Value * 2 - 1
//   Worley F1/F2/F-F  0..1, distance in cells   1 - Value * 2
//   Bars              signed cosine phase       the value itself
//   Phasor            signed local impulses     the value itself
//
// Tiling is by construction, not by wrapping the input: every lattice is wrapped to an integer
// period before it is hashed (see MixtormatNoise.ush), and Bars/Phasor share an integer orientation
// resolved CPU-side. Offset translates the domain, which leaves any periodic field periodic.

#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorPlacement.ush"
#include "/Plugin/Mixtormat/Private/MixtormatNoise.ush"

// Flow and Coverage use the same file without the field-producer permutation domain.
#ifndef MIXTORMAT_NOISE_VALUE_ONLY
#define MIXTORMAT_NOISE_VALUE_ONLY 0
#endif

// EMixtormatNoiseType, mirrored as plain constants -- the USF cannot include runtime headers.
#define NOISE_TYPE_GRADIENT    0
#define NOISE_TYPE_VALUE       1
#define NOISE_TYPE_FBM         2
#define NOISE_TYPE_RIDGED      3
#define NOISE_TYPE_BILLOW      4
#define NOISE_TYPE_WORLEY_F1   5
#define NOISE_TYPE_WORLEY_F2   6
#define NOISE_TYPE_WORLEY_F1F2 7
#define NOISE_TYPE_BARS        8
#define NOISE_TYPE_PHASOR      9

int2 OutputSize;
int NoiseType;
uint Seed;
float Scale;
int Detail;
float Roughness;
float Lacunarity;
float LayerMix;
float2 OffsetUV;
float2 Wave;
float PhaseOffset;
float PhasorFrequency;
float PhasorAnisotropy;
float PhasorPhaseVariation;
float PhasorOrientationVariation;
int PhasorComponents;
float PhasorScale;
float PhasorBias;
int WorleyMetric;
float WorleyJitter;
float WorleyCellDepth;
float DistortionStrength;
float DistortionJaggedness;
int DistortionPeriod;
int DistortionOctaves;
float DistortionRoughness;
float DistortionLacunarity;
float DistortionCurlMix;
float2 DistortionDirectionUV;
uint ProducesIds;

RWTexture2D<float> OutValue;
#if !MIXTORMAT_NOISE_VALUE_ONLY
RWTexture2D<float> OutHeight;
RWTexture2D<float2> OutGradient;
RWTexture2D<uint> OutIds;
#endif

Texture2D<float> CoverageValue;
uint CoverageSigned;
RWTexture2D<float> OutCoverage;

// Never modify the raw/public Value; placement and shaping belong to the mask consumer.
[numthreads(8, 8, 1)]
void CoverageCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 Pixel = int2(DispatchThreadId.xy);
	if (any(Pixel >= OutputSize)) { return; }
	const float Value = CoverageValue.Load(int3(Pixel, 0));
	OutCoverage[Pixel] = isfinite(Value)
		? saturate(CoverageSigned != 0u ? 0.5f * Value + 0.5f : Value) : 0.0f;
}

Texture2D<float> CompletedHeight;
RWTexture2D<float4> OutFlow;
RWTexture2D<float> OutFlowValidity;

// An explicit transport output, independent of the heterogeneous raw Gradient contract.
// Downhill unit direction in destination tile UV; flat/non-finite slopes have no influence.
// Run after all scoped tools and structural remaps so placement is applied exactly once.
[numthreads(8, 8, 1)]
void FlowCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 Pixel = int2(DispatchThreadId.xy);
	if (any(Pixel >= OutputSize)) { return; }
	const int2 XP = (Pixel + int2(1, 0)) % OutputSize;
	const int2 XM = (Pixel + OutputSize - int2(1, 0)) % OutputSize;
	const int2 YP = (Pixel + int2(0, 1)) % OutputSize;
	const int2 YM = (Pixel + OutputSize - int2(0, 1)) % OutputSize;
	const float2 Slope = 0.5f * float2(OutputSize) * float2(
		CompletedHeight.Load(int3(XP, 0)) - CompletedHeight.Load(int3(XM, 0)),
		CompletedHeight.Load(int3(YP, 0)) - CompletedHeight.Load(int3(YM, 0)));
	const float Magnitude = length(Slope);
	const bool Valid = all(isfinite(Slope)) && isfinite(Magnitude) && Magnitude > 1.0e-5f;
	const float2 Direction = Valid ? -Slope / Magnitude : float2(0.0f, 0.0f);
	OutFlow[Pixel] = float4(Direction, 0.0f, Valid ? 1.0f : 0.0f);
	OutFlowValidity[Pixel] = Valid ? 1.0f : 0.0f;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 Pixel = int2(DispatchThreadId.xy);
	if (any(Pixel >= OutputSize))
	{
		return;
	}

	const float2 UV = MixtormatGeneratorUV((float2(Pixel) + 0.5f) / float2(OutputSize));
	// frac keeps a large Offset from walking the lattice coordinates out of float precision;
	// the field has period 1 in tile UV, so the wrap is exact.
	const float2 Domain = frac(UV + OffsetUV);
	// Zero strength is a strict legacy identity: no warp math or extra texture samples.
	float2 SampleDomain = Domain;
	if (DistortionStrength > 0.0f || DistortionJaggedness > 0.0f)
	{
		SampleDomain = frac(MixtormatNoiseV2WarpDomain(Domain, DistortionPeriod,
			DistortionOctaves, DistortionRoughness, DistortionLacunarity,
			Seed ^ 0x68bc21ebu, DistortionStrength, DistortionDirectionUV, DistortionCurlMix,
			DistortionJaggedness));
	}

	float Value = 0.0f;
	float2 Gradient = float2(0.0f, 0.0f);
	uint CellId = MIXTORMAT_INVALID_REGION;

	if (NoiseType == NOISE_TYPE_GRADIENT)
	{
		const int P = max((int)round(max(Scale, 1.0f)), 1);
		const float3 n = MixtormatPeriodicNoiseD(SampleDomain * (float)P, P, Seed);
		Value = n.x * MIXTORMAT_NOISE_SQRT2;
		Gradient = (float)P * MIXTORMAT_NOISE_SQRT2 * n.yz;
	}
	else if (NoiseType == NOISE_TYPE_VALUE)
	{
		const int P = max((int)round(max(Scale, 1.0f)), 1);
		const float3 n = MixtormatNoiseValueD(SampleDomain * (float)P, P, Seed);
		Value = n.x;
		Gradient = (float)P * n.yz;
	}
	else if (NoiseType == NOISE_TYPE_FBM)
	{
		MixtormatNoiseFbm(SampleDomain, Scale, max(Detail, 1), Roughness, Lacunarity, Seed, Value, Gradient);
	}
	else if (NoiseType == NOISE_TYPE_RIDGED)
	{
		MixtormatNoiseRidged(SampleDomain, Scale, max(Detail, 1), Roughness, Lacunarity, Seed, Value, Gradient);
	}
	else if (NoiseType == NOISE_TYPE_BILLOW)
	{
		MixtormatNoiseBillow(SampleDomain, Scale, max(Detail, 1), Roughness, Lacunarity, Seed, Value, Gradient);
	}
	else if (NoiseType == NOISE_TYPE_WORLEY_F1
		|| NoiseType == NOISE_TYPE_WORLEY_F2
		|| NoiseType == NOISE_TYPE_WORLEY_F1F2)
	{
		const FMixtormatNoiseWorley w = MixtormatNoiseV2Worley(SampleDomain,
			max((int)round(max(Scale, 1.0f)), 1), Seed, WorleyJitter, WorleyMetric);
		float Distance = NoiseType == NOISE_TYPE_WORLEY_F1 ? w.F1
			: NoiseType == NOISE_TYPE_WORLEY_F2 ? w.F2 : (w.F2 - w.F1);
		// Distance in cell widths, clamped to the 0..1 contract. Full jitter can push the
		// farthest corners of a cell past one width; the clamp is part of the contract.
		// Worley publishes the derivative of the selected distance, in cell-width units.
		// F2-F1 must subtract both gradients; reusing F1's direction was incorrect.
		Gradient = NoiseType == NOISE_TYPE_WORLEY_F1 ? w.Direction
			: NoiseType == NOISE_TYPE_WORLEY_F2 ? w.SecondDirection
			: (w.SecondDirection - w.Direction);
		MixtormatNoiseV2CellDistanceVariation(SampleDomain,
			max((int)round(max(Scale, 1.0f)), 1), Seed, WorleyCellDepth,
			Distance, Gradient);
		Value = saturate(Distance);
		// Value is saturated above. Its derivative is zero on the flat plateaus;
		// exactly on a clamp boundary the derivative is not unique, so choose zero.
		if (Distance <= 0.0f || Distance >= 1.0f)
		{
			Gradient = float2(0.0f, 0.0f);
		}
		CellId = w.CellId;
	}
	else if (NoiseType == NOISE_TYPE_PHASOR)
	{
		const FMixtormatNoiseV2Sample Phasor = MixtormatNoiseV2Phasor(SampleDomain,
			max((int)round(max(Scale, 1.0f)), 1), Seed, Wave,
			PhasorFrequency, PhasorAnisotropy, PhasorPhaseVariation,
			PhasorOrientationVariation, PhasorComponents);
		Value = Phasor.Value;
		Gradient = Phasor.Gradient;
	}
	else // NOISE_TYPE_BARS, also preserves the previous fallback for unknown values
	{
		MixtormatNoiseBars(SampleDomain, Wave, PhaseOffset, Value, Gradient);
	}


	// Optional finer octaves for families originally authored as a single frequency.
	// Keep the base field and published region IDs unchanged when the mix is zero.
	if (LayerMix > 0.0f && Detail > 1
		&& NoiseType != NOISE_TYPE_FBM && NoiseType != NOISE_TYPE_RIDGED
		&& NoiseType != NOISE_TYPE_BILLOW)
	{
		float WeightedValue = Value;
		float2 WeightedGradient = Gradient;
		float WeightSum = 1.0f;
		float Weight = 1.0f;
		float Period = max(Scale, 1.0f);
		[loop]
		for (int k = 1; k < clamp(Detail, 1, 8); ++k)
		{
			Weight *= saturate(Roughness);
			if (Weight <= 1.0e-6f) { break; }
			Period *= max(Lacunarity, 1.0f);
			const int P = MixtormatNoiseOctavePeriod(Period);
			if (P == 0) { break; }
			float OctaveValue;
			float2 OctaveGradient;
			MixtormatNoiseV2LayerOctave(SampleDomain, NoiseType, P,
				Seed + (uint)k * 0x2545F491u, Wave, PhaseOffset, Scale,
				WorleyMetric, WorleyJitter, WorleyCellDepth,
				PhasorFrequency, PhasorAnisotropy, PhasorPhaseVariation,
				PhasorOrientationVariation, PhasorComponents,
				OctaveValue, OctaveGradient);
			WeightedValue += Weight * OctaveValue;
			WeightedGradient += Weight * OctaveGradient;
			WeightSum += Weight;
		}
		Value = lerp(Value, WeightedValue / WeightSum, saturate(LayerMix));
		Gradient = lerp(Gradient, WeightedGradient / WeightSum, saturate(LayerMix));
	}

	// Exact identity path keeps the original Phasor amplitude unmodified.
	if (NoiseType == NOISE_TYPE_PHASOR && (PhasorScale != 1.0f || PhasorBias != 0.0f))
	{
		const float AdjustedValue = Value * PhasorScale + PhasorBias;
		Gradient *= AdjustedValue > -1.0f && AdjustedValue < 1.0f
			? PhasorScale : 0.0f;
		Value = clamp(AdjustedValue, -1.0f, 1.0f);
	}

#if !MIXTORMAT_NOISE_VALUE_ONLY
	// Gradient is evaluated in the warped source domain. Chain-rule it into the
	// generator domain only for distortion-enabled paths. Use two forward probes
	// of the same periodic warp; the legacy zero path remains bit-for-bit intact.
	if (DistortionStrength > 0.0f || DistortionJaggedness > 0.0f)
	{
		const float Epsilon = max(1.0e-4f, 0.01f / (float)max(DistortionPeriod, 1));
		const float2 WarpAt = MixtormatNoiseV2WarpDomain(Domain, DistortionPeriod,
			DistortionOctaves, DistortionRoughness, DistortionLacunarity,
			Seed ^ 0x68bc21ebu, DistortionStrength, DistortionDirectionUV, DistortionCurlMix,
			DistortionJaggedness);
		const float2 WarpX = MixtormatNoiseV2WarpDomain(Domain + float2(Epsilon, 0.0f),
			DistortionPeriod, DistortionOctaves, DistortionRoughness, DistortionLacunarity,
			Seed ^ 0x68bc21ebu, DistortionStrength, DistortionDirectionUV, DistortionCurlMix,
			DistortionJaggedness);
		const float2 WarpY = MixtormatNoiseV2WarpDomain(Domain + float2(0.0f, Epsilon),
			DistortionPeriod, DistortionOctaves, DistortionRoughness, DistortionLacunarity,
			Seed ^ 0x68bc21ebu, DistortionStrength, DistortionDirectionUV, DistortionCurlMix,
			DistortionJaggedness);
		Gradient = float2(dot(Gradient, (WarpX - WarpAt) / Epsilon),
			dot(Gradient, (WarpY - WarpAt) / Epsilon));
	}
#endif

	OutValue[Pixel] = Value;
#if !MIXTORMAT_NOISE_VALUE_ONLY
	// The shared signed generator contract: zero-centred, so zero is the neutral height.
	float Height = Value;
	if (NoiseType == NOISE_TYPE_RIDGED || NoiseType == NOISE_TYPE_BILLOW)
	{
		Height = Value * 2.0f - 1.0f;
	}
	else if (NoiseType == NOISE_TYPE_WORLEY_F1
		|| NoiseType == NOISE_TYPE_WORLEY_F2
		|| NoiseType == NOISE_TYPE_WORLEY_F1F2)
	{
		Height = 1.0f - Value * 2.0f;
	}

	OutHeight[Pixel] = Height;
	OutGradient[Pixel] = Gradient;
	if (ProducesIds != 0u)
	{
		OutIds[Pixel] = CellId;
	}
#endif
}