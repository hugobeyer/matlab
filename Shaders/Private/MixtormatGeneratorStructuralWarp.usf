#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorWarp.ush"

// Compose destination-to-source state, not completed generator outputs.
int2 OutputSize;
uint HasPreviousDisplacement;
uint HasPreviousShift;
uint HasMask;
Texture2D<float2> WarpCoordinates;
Texture2D<float2> PreviousDisplacement;
Texture2D<float> PreviousShift;
Texture2D<float> ScopedMask;
SamplerState LinearWrapSampler;
RWTexture2D<float2> OutDisplacement;
RWTexture2D<float> OutShift;
RWTexture2D<float2> OutCoordinates;

[numthreads(8, 8, 1)]
void CoordinateCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 Pixel = int2(DispatchThreadId.xy);
	if (any(Pixel >= OutputSize)) { return; }
	const float2 UV = (float2(Pixel) + 0.5f) / float2(OutputSize);
	// Preserve lift/winding and multi-tile travel for completed-bundle sampling.
	OutCoordinates[Pixel] = UV + PreviousDisplacement.Load(int3(Pixel, 0));
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 Pixel = int2(DispatchThreadId.xy);
	if (any(Pixel >= OutputSize)) { return; }
	const float2 X = (float2(Pixel) + 0.5f) / float2(OutputSize);
	const float Mask = HasMask != 0u ? saturate(ScopedMask.Load(int3(Pixel, 0))) : 1.0f;
	// Gate the traced displacement once; the mask does not alter integration velocity.
	const float2 D = Mask == 0.0f ? float2(0.0f, 0.0f)
		: Mask * MixtormatGeneratorWarpSampleCoordinateDisplacement(WarpCoordinates, X, OutputSize);
	const float2 Psi = X + D;
	if (!all(isfinite(Psi)))
	{
		// Preserve an invalid map, never replace it with identity or cast it to texel indices.
		const float Invalid = asfloat(0x7fc00000u);
		OutDisplacement[Pixel] = float2(Invalid, Invalid);
		OutShift[Pixel] = Invalid;
		return;
	}
	OutDisplacement[Pixel] = D + (HasPreviousDisplacement != 0u
		? MixtormatGeneratorWarpSampleDisplacement(PreviousDisplacement, Psi, OutputSize)
		: float2(0.0f, 0.0f));
	OutShift[Pixel] = HasPreviousShift != 0u
		? PreviousShift.SampleLevel(LinearWrapSampler, Psi, 0.0f) : 0.0f;
}
