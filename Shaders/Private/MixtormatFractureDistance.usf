#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatFractureShape.ush"

int2 OutputSize;
int StepSize;

Texture2D<uint2> PieceIds;

Texture2D<float4> PreviousRecord;

RWTexture2D<float4> OutputRecord;


uint2 OwnerAt(int2 P)
{
	return PieceIds.Load(int3(FractureWrap(P, OutputSize), 0));
}


int2 RecordOrigin(float4 Record)
{
	const uint Index = asuint(Record.z);
	return int2(Index % uint(OutputSize.x), Index / uint(OutputSize.x));
}

// Seed actual owned footprints, including valid-to-gap interfaces. The seed lies halfway
// between texels; z carries its owning texel, not a crack-line hash.
[numthreads(8, 8, 1)]
void SeedCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}
	const int2 P = int2(DispatchThreadId.xy);
	const uint2 Owner = OwnerAt(P);
	float4 Record = 0.0f;

	if (Owner.x != MIXTORMAT_INVALID_REGION)
	{
		const int2 Offsets[4] = {int2(1, 0), int2(0, 1), int2(-1, 0), int2(0, -1)};
		[unroll]
		for (int I = 0; I < 4; ++I)
		{
			if (any(OwnerAt(P + Offsets[I]) != Owner))
			{

				Record = float4(float2(P) + float2(Offsets[I]) * 0.5f,
					asfloat(uint(P.y * OutputSize.x + P.x)), 1.0f);

				break;
			}
		}
	}
	OutputRecord[P] = Record;

}

// Approximate Euclidean redistance AFTER directional deformation. JFA is not an exact
// eikonal solver. Full-tile propagation and a final unit step avoid width-limited missing seeds.
[numthreads(8, 8, 1)]
void StepCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}
	const int2 P = int2(DispatchThreadId.xy);
	const uint2 Owner = OwnerAt(P);
	float4 Best = PreviousRecord.Load(int3(P, 0));
	bool BestOwns = Best.w > 0.5f && all(OwnerAt(RecordOrigin(Best)) == Owner);
	float BestD = BestOwns
		? length(FractureDelta(float2(P), Best.xy, OutputSize))
		: 1.0e20f;
	[unroll]
	for (int Y = -1; Y <= 1; ++Y)
	{
		[unroll]
		for (int X = -1; X <= 1; ++X)
		{
			const int2 Q = FractureWrap(P + int2(X, Y) * StepSize, OutputSize);
			const float4 Candidate = PreviousRecord.Load(int3(Q, 0));
			if (Candidate.w <= 0.5f)
			{
				continue;
			}
			const bool Owns = all(OwnerAt(RecordOrigin(Candidate)) == Owner);
			if (!Owns)
			{
				continue;
			}
			const float D = length(FractureDelta(float2(P), Candidate.xy, OutputSize));
			const bool Tie = abs(D - BestD) < 1.0e-5f;
			if (D < BestD - 1.0e-5f || (Tie && asuint(Candidate.z) < asuint(Best.z)))
			{
				Best = Candidate;
				BestD = D;
				BestOwns = true;
			}
		}
	}
	OutputRecord[P] = BestOwns && Owner.x != MIXTORMAT_INVALID_REGION ? Best : 0.0f;
}
