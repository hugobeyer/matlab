﻿#ifndef MATERIAL_LAB_UV_USH
#define MATERIAL_LAB_UV_USH

// Source UV placement, shared by anything that reads an authored texture through a frac().
//
// Every transform here maps the unit square onto itself, which is the whole constraint: the
// compositor wraps each source read in a frac(), so a transform that does not preserve [0,1)
// seams at the repeat. That is why rotation is in 90 degree steps and scale is an integer --
// an arbitrary angle drags the corners of the tile outside the domain, and a fractional scale
// lands mid-cell at the wrap. Offset and flip are safe at any value: translating a periodic
// function leaves it periodic, and a mirror maps the square onto itself exactly.

// The linear part of the source placement, as a 2x2.
//
// This is the same flip-then-rotate the position transform below applies, written as a matrix
// because a tangent-space vector needs it and a coordinate does not. The two agree exactly:
// every transform here is a rigid motion of the unit square about its centre, so
//
//     MixtormatSourceUV's flip+rotate stage  ==  0.5 + mul(M, UV - 0.5)
//
// for the M these functions return. The position path is deliberately *not* re-plumbed through
// the matrix even though it could be: MixtormatColorId.usf point-samples an ID texture through
// MixtormatSourceUV, and 0.5 + M(p - 0.5) is not bit-identical to 1 - p, so a one-ULP drift
// there could flip a region ID on a boundary texel and re-roll that region's colour. The
// definitions sit side by side instead, and the identity above is what keeps them honest.
//
// M is orthonormal by construction -- a signed permutation of the axes -- so its inverse is its
// transpose, which is what the tangent transform below relies on.
float2x2 MixtormatRotation90Matrix(int Steps)
{
	const int S = ((Steps % 4) + 4) % 4;
	if (S == 1)
	{
		return float2x2(0.0f, 1.0f, -1.0f, 0.0f);
	}
	if (S == 2)
	{
		return float2x2(-1.0f, 0.0f, 0.0f, -1.0f);
	}
	if (S == 3)
	{
		return float2x2(0.0f, -1.0f, 1.0f, 0.0f);
	}
	return float2x2(1.0f, 0.0f, 0.0f, 1.0f);
}

float2x2 MixtormatFlipMatrix(uint FlipU, uint FlipV)
{
	return float2x2(
		FlipU != 0 ? -1.0f : 1.0f, 0.0f,
		0.0f, FlipV != 0 ? -1.0f : 1.0f);
}

// Flip first, then rotate -- matching the order MixtormatSourceUV applies them, which as matrix
// composition on a column vector means R sits on the left.
float2x2 MixtormatSourceOrientation(uint FlipU, uint FlipV, int Rotation)
{
	return mul(MixtormatRotation90Matrix(Rotation), MixtormatFlipMatrix(FlipU, FlipV));
}

// Carry a tangent-space vector across a source placement.
//
// Orientation maps a *destination* direction to the *source* direction the sampler walked:
// SourceUV = Orientation * DestUV + c. A normal map stores its XY in the source tangent basis,
// so bringing it into the destination basis is the opposite map.
//
// Which is not the same matrix, and the difference is the whole point. A tangent-space normal is
// a gradient -- N.xy is proportional to -grad(h) -- and a gradient transforms by the inverse
// transpose of the map that moves points. Composing h_dest(p) = h_source(T(p)) and applying the
// chain rule gives grad_dest = transpose(J) * grad_source, so the normal picks up transpose(J)
// where the coordinate picked up J. For the orthonormal matrices this file produces transpose(J)
// is also J's inverse, so one expression covers both readings.
//
// mul(V, M) is HLSL's row-vector form and evaluates to transpose(M) * V, which is exactly that.
//
// Scale is absent on purpose. Tiling and the per-axis integer scale change how often the texture
// repeats, not which way its tangent frame points, and folding a non-uniform scale in here would
// shear the normal's XY and change its slope. The orientation is the rigid part only.
float2 MixtormatTransformTangentVector(float2x2 Orientation, float2 TangentXY)
{
	return mul(TangentXY, Orientation);
}

// 0, 90, 180, 270. Each case is a permutation of the unit square, so the result still tiles.
float2 MixtormatRotateUV90(float2 UV, int Steps)
{
	const int S = ((Steps % 4) + 4) % 4;
	if (S == 1)
	{
		return float2(UV.y, 1.0f - UV.x);
	}
	if (S == 2)
	{
		return float2(1.0f - UV.x, 1.0f - UV.y);
	}
	if (S == 3)
	{
		return float2(1.0f - UV.y, UV.x);
	}
	return UV;
}

// Flip and rotate first, in the unit square, then tile and offset.
//
// The order matters and is not the obvious one. Rotating after the tiling would rotate each
// cell of the lattice rather than the pattern, and with a non-square tiling it would swap
// which axis carries which repeat count. Rotating first means the texture turns and the
// lattice then replicates the turned result, which is what "rotate the mask" means to anyone
// looking at it.
float2 MixtormatSourceUV(
	float2 UV,
	float2 Tiling,
	float2 Offset,
	uint FlipU,
	uint FlipV,
	int Rotation)
{
	float2 P = UV;

	// Mirrored about the centre of the tile rather than about zero. Scaling by -1 and letting
	// frac() wrap is the same picture shifted by a texel, which is a seam on a mask whose
	// edges are supposed to meet.
	P.x = FlipU != 0 ? 1.0f - P.x : P.x;
	P.y = FlipV != 0 ? 1.0f - P.y : P.y;

	P = MixtormatRotateUV90(P, Rotation);

	return frac(P * Tiling + Offset);
}

#endif
