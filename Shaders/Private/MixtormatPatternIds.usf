#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatCellular.ush"
#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"
#include "/Plugin/Mixtormat/Private/MixtormatDebugColor.ush"

// One periodic lattice solve publishes four views of the same regions:
// - sparse pixel-index IDs for the existing region consumers,
// - the feature-point UV for per-region source transforms,
// - a float2 relief field: how far this cell sits off the base, plus its edge feather,
// - signed edge distance in output pixels plus one per-region draw for bevel variation.
RWTexture2D<uint> OutputIds;
RWTexture2D<float2> OutputUV;
RWTexture2D<float2> OutputRamp;
RWTexture2D<float2> OutputEdge;
RWTexture2D<uint> OutputOrientation;
RWTexture2D<float4> OutputDebug;

int2 OutputSize;
uint WriteDebug;
uint WriteOrientation;
uint PatternMode;
uint GridMode;
int Rows;
int Columns;
float RowOffset;
float Jitter;
uint SwapAxes;
float GapPixels;
uint Seed;

// Relief is per-cell elevation, not per-cell slope. A cell is a flat face that sits somewhere
// between -Height and +Height off the base, scaled by how much of that range Height Random uses, and the tilt vocabulary that used to live
// here belongs to Ramp From IDs -- that filter runs a gradient across each region and composites
// over this, which is the division of labour the two nodes are for.
float Feather;
float FeatherRandom;
// Rounds the cell corners by blending the two nearest walls instead of taking a hard minimum.
// In cell units, so it means the same thing on a large lattice and a small one.
float Rounding;

// Which unit the published edge distance is in.
//
//   0  output pixels -- an even visual width everywhere, so a chamfer looks the same on a long
//      brick as on a small tile, but it does not scale with the lattice.
//   1  a fraction of the cell -- 0 at the wall, 1 at the point furthest inside. The chamfer then
//      frames every cell the same way whatever its size or aspect, which is what a bevel that is
//      meant to belong to the cell wants.
uint EdgeRelative;

#define MIXTORMAT_PATTERN_GRID 0u
#define MIXTORMAT_PATTERN_RUNNING_BOND 1u
#define MIXTORMAT_PATTERN_HERRINGBONE 2u
#define MIXTORMAT_PATTERN_BASKETWEAVE 3u
#define MIXTORMAT_PATTERN_HEX 4u
#define MIXTORMAT_PATTERN_OCTAGON_SQUARE 5u
#define MIXTORMAT_PATTERN_FLAGSTONE 6u
#define MIXTORMAT_PATTERN_VORONOI 7u
#define MIXTORMAT_PATTERN_HOPSCOTCH 8u
#define MIXTORMAT_PATTERN_FRENCH_ASHLAR 9u
#define MIXTORMAT_GRID_STRAIGHT 0u
#define MIXTORMAT_GRID_STAGGERED 1u
#define MIXTORMAT_GRID_DIAMOND 2u

struct FMixtormatPatternCell
{
	float2 CentreWorkUV;
	float EdgePixels;
	float EdgeRelative;
	float PixelsPerRelativeUnit;
	float MinCellPixels;
	uint Orientation;
};

float2 PatternWorkUV(float2 UV)
{
	return SwapAxes != 0 ? UV.yx : UV;
}

float2 PatternUnworkUV(float2 UV)
{
	return SwapAxes != 0 ? UV.yx : UV;
}

int PatternEvenPeriod(int Value)
{
	const int SafeValue = max(Value, 2);
	return SafeValue + (SafeValue & 1);
}

FMixtormatPatternCell PatternRectangularCell(
	float2 WorkUV,
	float2 AxisPixels,
	int SafeColumns,
	int SafeRows,
	bool bStaggered)
{
	const float2 P = WorkUV * float2(SafeColumns, SafeRows);
	const int Row = (int)floor(P.y);
	const int WrappedRow = MixtormatWrapI(Row, SafeRows);
	const float Shift = bStaggered && ((WrappedRow & 1) != 0)
		? saturate(RowOffset)
		: 0.0f;
	const float LocalX = P.x - Shift;
	const int Column = (int)floor(LocalX);
	const float2 CellUV = frac(float2(LocalX, P.y));

	const float2 CellPixels = AxisPixels / float2(SafeColumns, SafeRows);
	const float2 EdgePixelsByAxis = min(CellUV, 1.0f - CellUV) * CellPixels;
	const float MinCellPixels = max(min(CellPixels.x, CellPixels.y), 1.0e-4f);
	const float SmoothPixels = 0.5f * max(Rounding, 0.0f) * MinCellPixels;
	const float EdgePixels = max(MixtormatSmoothMin(
		EdgePixelsByAxis.x,
		EdgePixelsByAxis.y,
		SmoothPixels), 0.0f);

	const float2 RelativeByAxis = 2.0f * min(CellUV, 1.0f - CellUV);
	const float EdgeRelative = max(MixtormatSmoothMin(
		RelativeByAxis.x,
		RelativeByAxis.y,
		max(Rounding, 0.0f)), 0.0f);

	const float2 CentreP = float2(
		float(Column) + 0.5f + Shift,
		float(Row) + 0.5f);

	FMixtormatPatternCell Result;
	Result.CentreWorkUV = frac(CentreP / float2(SafeColumns, SafeRows));
	Result.EdgePixels = EdgePixels;
	Result.EdgeRelative = EdgeRelative;
	Result.PixelsPerRelativeUnit = EdgeRelative > 1.0e-5f
		? EdgePixels / EdgeRelative
		: 0.5f * MinCellPixels;
	Result.MinCellPixels = MinCellPixels;
	Result.Orientation = 0u;
	return Result;
}

FMixtormatPatternCell PatternDiamondCell(
	float2 WorkUV,
	float2 AxisPixels,
	int AuthoredColumns,
	int AuthoredRows)
{
	// An even original-space period makes both torus translations integer translations in Q:
	// U + 1 -> Q + (Columns/2, -Columns/2), V + 1 -> Q + (Rows/2, Rows/2).
	const int SafeColumns = PatternEvenPeriod(AuthoredColumns);
	const int SafeRows = PatternEvenPeriod(AuthoredRows);
	const float2 P = WorkUV * float2(SafeColumns, SafeRows);
	const float2 Q = 0.5f * float2(P.x + P.y, P.y - P.x);
	const int2 QCell = (int2)floor(Q);
	const float2 QCellUV = frac(Q);
	const float2 EdgeQByAxis = min(QCellUV, 1.0f - QCellUV);
	const float EdgeQ = max(MixtormatSmoothMin(
		EdgeQByAxis.x,
		EdgeQByAxis.y,
		0.5f * max(Rounding, 0.0f)), 0.0f);

	// Q is deliberately never wrapped per axis. The inverse integer basis identifies the same
	// owner on opposite sides of the original U/V torus, then only the centre is canonicalised.
	const int2 CentreP = int2(
		QCell.x - QCell.y,
		QCell.x + QCell.y + 1);
	const float ColumnsPerPixel = float(SafeColumns) / max(AxisPixels.x, 1.0f);
	const float RowsPerPixel = float(SafeRows) / max(AxisPixels.y, 1.0f);
	const float GradientQ = 0.5f * sqrt(
		ColumnsPerPixel * ColumnsPerPixel + RowsPerPixel * RowsPerPixel);
	const float EdgePixels = EdgeQ / max(GradientQ, 1.0e-6f);
	const float EdgeRelative = 2.0f * EdgeQ;
	const float MinCellPixels = max(min(
		AxisPixels.x / float(SafeColumns),
		AxisPixels.y / float(SafeRows)), 1.0e-4f);

	FMixtormatPatternCell Result;
	Result.CentreWorkUV = frac(float2(CentreP) / float2(SafeColumns, SafeRows));
	Result.EdgePixels = EdgePixels;
	Result.EdgeRelative = EdgeRelative;
	Result.PixelsPerRelativeUnit = 0.5f / max(GradientQ, 1.0e-6f);
	Result.MinCellPixels = MinCellPixels;
	Result.Orientation = 0u;
	return Result;
}

float PatternRunningBoundaryRandom(int Boundary, int WrappedRow, int2 Period)
{
	const int WrappedBoundary = MixtormatWrapI(Boundary, Period.x);
	const uint BoundaryId = MixtormatCellHash(
		int2(WrappedBoundary, WrappedRow),
		Period,
		Seed ^ 0xa511e9b3u);
	return MixtormatCellRandom01(BoundaryId);
}

float PatternRunningBoundary(int Boundary, int WrappedRow, int2 Period)
{
	const int WrappedBoundary = MixtormatWrapI(Boundary, Period.x);
	const int Cycle = (Boundary - WrappedBoundary) / Period.x;
	const float Anchor = PatternRunningBoundaryRandom(0, WrappedRow, Period);
	const float Offset = PatternRunningBoundaryRandom(Boundary, WrappedRow, Period) - Anchor;

	// Boundary 0 and Boundary Columns use the same wrapped draw, so they land exactly at 0 and
	// Columns. Interior widths vary, remain positive, and telescope to the authored row period.
	return float(Cycle * Period.x + WrappedBoundary)
		+ Offset * (0.35f * saturate(Jitter));
}

FMixtormatPatternCell PatternRunningBondCell(
	float2 WorkUV,
	float2 AxisPixels,
	int AuthoredColumns,
	int AuthoredRows)
{
	const int SafeColumns = max(AuthoredColumns, 1);
	const int SafeRows = PatternEvenPeriod(AuthoredRows);
	const int2 Period = int2(SafeColumns, SafeRows);
	const float2 P = WorkUV * float2(Period);
	const int Row = (int)floor(P.y);
	const int WrappedRow = MixtormatWrapI(Row, SafeRows);

	const uint RowId = MixtormatCellHash(
		int2(0, WrappedRow),
		Period,
		Seed ^ 0x63d83595u);
	const float RowJitter = (MixtormatCellRandom01(RowId) - 0.5f) * saturate(Jitter);
	const float BaseShift = (WrappedRow & 1) != 0 ? saturate(RowOffset) : 0.0f;
	const float Shift = BaseShift + RowJitter;
	const float LocalX = frac((P.x - Shift) / float(SafeColumns)) * float(SafeColumns);

	const int ApproxColumn = (int)floor(LocalX);
	int Column = ApproxColumn;
	float Left = PatternRunningBoundary(Column, WrappedRow, Period);
	float Right = PatternRunningBoundary(Column + 1, WrappedRow, Period);
	[unroll]
	for (int CandidateOffset = -1; CandidateOffset <= 1; ++CandidateOffset)
	{
		const int Candidate = ApproxColumn + CandidateOffset;
		const float CandidateLeft = PatternRunningBoundary(Candidate, WrappedRow, Period);
		const float CandidateRight = PatternRunningBoundary(Candidate + 1, WrappedRow, Period);
		if (LocalX >= CandidateLeft && LocalX < CandidateRight)
		{
			Column = Candidate;
			Left = CandidateLeft;
			Right = CandidateRight;
		}
	}

	const float Width = max(Right - Left, 1.0e-4f);
	const float CellX = LocalX - Left;
	const float CellY = frac(P.y);
	const float2 CellPixels = AxisPixels / float2(SafeColumns, SafeRows);
	const float2 EdgePixelsByAxis = float2(
		min(CellX, Width - CellX) * CellPixels.x,
		min(CellY, 1.0f - CellY) * CellPixels.y);
	const float MinCellPixels = max(min(CellPixels.x, CellPixels.y), 1.0e-4f);
	const float EdgePixels = max(MixtormatSmoothMin(
		EdgePixelsByAxis.x,
		EdgePixelsByAxis.y,
		0.5f * max(Rounding, 0.0f) * MinCellPixels), 0.0f);
	const float2 RelativeByAxis = float2(
		2.0f * min(CellX, Width - CellX) / Width,
		2.0f * min(CellY, 1.0f - CellY));
	const float EdgeRelative = max(MixtormatSmoothMin(
		RelativeByAxis.x,
		RelativeByAxis.y,
		max(Rounding, 0.0f)), 0.0f);
	const float2 CentreP = float2(
		0.5f * (Left + Right) + Shift,
		float(Row) + 0.5f);

	FMixtormatPatternCell Result;
	Result.CentreWorkUV = frac(CentreP / float2(Period));
	Result.EdgePixels = EdgePixels;
	Result.EdgeRelative = EdgeRelative;
	Result.PixelsPerRelativeUnit = EdgeRelative > 1.0e-5f
		? EdgePixels / EdgeRelative
		: 0.5f * MinCellPixels;
	Result.MinCellPixels = MinCellPixels;
	Result.Orientation = 0u;
	return Result;
}

int PatternMultipleOfFourPeriod(int Value)
{
	return max(((max(Value, 1) + 3) / 4) * 4, 4);
}

FMixtormatPatternCell PatternBoxCell(
	float2 P,
	float2 AxisPixels,
	int2 Period,
	float2 Lower,
	float2 Size,
	uint Orientation)
{
	const float2 Local = P - Lower;
	const float2 UnitPixels = AxisPixels / float2(Period);
	const float2 EdgePixelsByAxis = min(Local, Size - Local) * UnitPixels;
	const float MinCellPixels = max(min(UnitPixels.x, UnitPixels.y), 1.0e-4f);
	const float EdgePixels = max(MixtormatSmoothMin(
		EdgePixelsByAxis.x,
		EdgePixelsByAxis.y,
		0.5f * max(Rounding, 0.0f) * MinCellPixels), 0.0f);
	const float2 RelativeByAxis = 2.0f * min(Local, Size - Local) / Size;
	const float EdgeRelative = max(MixtormatSmoothMin(
		RelativeByAxis.x,
		RelativeByAxis.y,
		max(Rounding, 0.0f)), 0.0f);

	FMixtormatPatternCell Result;
	Result.CentreWorkUV = frac((Lower + 0.5f * Size) / float2(Period));
	Result.EdgePixels = EdgePixels;
	Result.EdgeRelative = EdgeRelative;
	Result.PixelsPerRelativeUnit = EdgeRelative > 1.0e-5f
		? EdgePixels / EdgeRelative
		: 0.5f * MinCellPixels;
	Result.MinCellPixels = MinCellPixels;
	Result.Orientation = Orientation;
	return Result;
}

FMixtormatPatternCell PatternHerringboneCell(
	float2 WorkUV,
	float2 AxisPixels,
	int AuthoredColumns,
	int AuthoredRows)
{
	const int2 Period = int2(
		PatternMultipleOfFourPeriod(AuthoredColumns),
		PatternMultipleOfFourPeriod(AuthoredRows));
	const float2 P = WorkUV * float2(Period);
	const int2 UnitCell = (int2)floor(P);
	const int Band = MixtormatWrapI(UnitCell.x - UnitCell.y, 4);

	// Four diagonal ownership bands make the interlock. Band 0 owns a horizontal domino and band
	// 1 points back to it; band 3 owns a vertical domino and band 2 points down to it.
	if (Band == 0)
	{
		return PatternBoxCell(P, AxisPixels, Period, float2(UnitCell), float2(2.0f, 1.0f), 0u);
	}
	if (Band == 1)
	{
		return PatternBoxCell(
			P, AxisPixels, Period, float2(UnitCell - int2(1, 0)), float2(2.0f, 1.0f), 0u);
	}
	if (Band == 3)
	{
		return PatternBoxCell(P, AxisPixels, Period, float2(UnitCell), float2(1.0f, 2.0f), 1u);
	}
	return PatternBoxCell(
		P, AxisPixels, Period, float2(UnitCell - int2(0, 1)), float2(1.0f, 2.0f), 1u);
}

FMixtormatPatternCell PatternBasketweaveCell(
	float2 WorkUV,
	float2 AxisPixels,
	int AuthoredColumns,
	int AuthoredRows)
{
	const int2 Period = int2(
		PatternMultipleOfFourPeriod(AuthoredColumns),
		PatternMultipleOfFourPeriod(AuthoredRows));
	const float2 P = WorkUV * float2(Period);
	const int2 MacroCell = (int2)floor(P * 0.5f);
	const float2 MacroLower = float2(MacroCell * 2);
	const float2 MacroLocal = P - MacroLower;
	const bool bVertical = ((MacroCell.x + MacroCell.y) & 1) != 0;

	if (bVertical)
	{
		const float StripX = floor(MacroLocal.x);
		return PatternBoxCell(
			P,
			AxisPixels,
			Period,
			MacroLower + float2(StripX, 0.0f),
			float2(1.0f, 2.0f),
			1u);
	}

	const float StripY = floor(MacroLocal.y);
	return PatternBoxCell(
		P,
		AxisPixels,
		Period,
		MacroLower + float2(0.0f, StripY),
		float2(2.0f, 1.0f),
		0u);
}

void PatternInsertDistance(float Distance, inout float Nearest, inout float Second)
{
	if (Distance < Nearest)
	{
		Second = Nearest;
		Nearest = Distance;
	}
	else if (Distance < Second)
	{
		Second = Distance;
	}
}

FMixtormatPatternCell PatternHexCell(
	float2 WorkUV,
	float2 AxisPixels,
	int AuthoredColumns)
{
	const int SafeColumns = max(AuthoredColumns, 1);
	const float DesiredRows = float(SafeColumns)
		* (AxisPixels.y / max(AxisPixels.x, 1.0f))
		* 1.154700538f;
	const int SafeRows = max(2 * (int)floor(0.5f * DesiredRows + 0.5f), 2);
	const int2 Period = int2(SafeColumns, SafeRows);
	const float2 Pitch = AxisPixels / float2(Period);
	const float2 Query = WorkUV * AxisPixels;

	const int BaseRow = (int)floor(Query.y / Pitch.y - 0.5f);
	float BestSq = 1.0e30f;
	int2 Owner = int2(0, BaseRow);
	float2 OwnerCentre = 0.0f;
	[unroll]
	for (int RowOffset = -1; RowOffset <= 1; ++RowOffset)
	{
		const int Row = BaseRow + RowOffset;
		const float Stagger = (Row & 1) != 0 ? 0.5f : 0.0f;
		const int BaseColumn = (int)floor(Query.x / Pitch.x - 0.5f - Stagger);
		[unroll]
		for (int ColumnOffset = -1; ColumnOffset <= 1; ++ColumnOffset)
		{
			const int Column = BaseColumn + ColumnOffset;
			const float2 Centre = float2(
				(float(Column) + 0.5f + Stagger) * Pitch.x,
				(float(Row) + 0.5f) * Pitch.y);
			const float2 Offset = Centre - Query;
			const float DistanceSq = dot(Offset, Offset);
			if (DistanceSq < BestSq)
			{
				BestSq = DistanceSq;
				Owner = int2(Column, Row);
				OwnerCentre = Centre;
			}
		}
	}

	float NearestEdge = 1.0e30f;
	float SecondEdge = 1.0e30f;
	const float2 OwnerOffset = OwnerCentre - Query;
	[unroll]
	for (int RowOffset = -2; RowOffset <= 2; ++RowOffset)
	{
		const int Row = Owner.y + RowOffset;
		const float Stagger = (Row & 1) != 0 ? 0.5f : 0.0f;
		[unroll]
		for (int ColumnOffset = -2; ColumnOffset <= 2; ++ColumnOffset)
		{
			const int Column = Owner.x + ColumnOffset;
			if (Column == Owner.x && Row == Owner.y)
			{
				continue;
			}
			const float2 Centre = float2(
				(float(Column) + 0.5f + Stagger) * Pitch.x,
				(float(Row) + 0.5f) * Pitch.y);
			const float2 Offset = Centre - Query;
			const float2 Delta = Offset - OwnerOffset;
			const float DeltaSq = dot(Delta, Delta);
			if (DeltaSq > 1.0e-9f)
			{
				const float BoundaryDistance = abs(
					dot(0.5f * (OwnerOffset + Offset), Delta * rsqrt(DeltaSq)));
				PatternInsertDistance(BoundaryDistance, NearestEdge, SecondEdge);
			}
		}
	}

	const float DiagonalSpacing = sqrt(
		0.25f * Pitch.x * Pitch.x + Pitch.y * Pitch.y);
	const float Inradius = 0.5f * min(Pitch.x, DiagonalSpacing);
	const float EdgePixels = max(MixtormatSmoothMin(
		NearestEdge,
		SecondEdge,
		max(Rounding, 0.0f) * Inradius), 0.0f);

	FMixtormatPatternCell Result;
	Result.CentreWorkUV = frac(OwnerCentre / AxisPixels);
	Result.EdgePixels = EdgePixels;
	Result.EdgeRelative = EdgePixels / max(Inradius, 1.0e-4f);
	Result.PixelsPerRelativeUnit = max(Inradius, 1.0e-4f);
	Result.MinCellPixels = max(2.0f * Inradius, 1.0e-4f);
	Result.Orientation = 0u;
	return Result;
}

FMixtormatPatternCell PatternOctagonSquareCell(
	float2 WorkUV,
	float2 AxisPixels,
	int AuthoredColumns,
	int AuthoredRows)
{
	const int2 Period = max(int2(AuthoredColumns, AuthoredRows), int2(1, 1));
	const float2 P = WorkUV * float2(Period);
	const int2 UnitCell = (int2)floor(P);
	const float2 Local = frac(P);
	const float2 FromCentre = Local - 0.5f;
	const float2 AbsCentre = abs(FromCentre);
	const float2 Pitch = AxisPixels / float2(Period);
	const float Cut = 0.2928932188f;
	const float OctagonDiagonal = 1.0f - Cut;
	const float DiagonalGradient = sqrt(
		1.0f / (Pitch.x * Pitch.x) + 1.0f / (Pitch.y * Pitch.y));

	float2 CentreP;
	float NearestEdge = 1.0e30f;
	float SecondEdge = 1.0e30f;
	float Inradius;
	if (AbsCentre.x + AbsCentre.y <= OctagonDiagonal)
	{
		CentreP = float2(UnitCell) + 0.5f;
		PatternInsertDistance((0.5f - AbsCentre.x) * Pitch.x, NearestEdge, SecondEdge);
		PatternInsertDistance((0.5f - AbsCentre.y) * Pitch.y, NearestEdge, SecondEdge);
		PatternInsertDistance(
			(OctagonDiagonal - AbsCentre.x - AbsCentre.y) / DiagonalGradient,
			NearestEdge,
			SecondEdge);
		Inradius = min(
			min(0.5f * Pitch.x, 0.5f * Pitch.y),
			OctagonDiagonal / DiagonalGradient);
	}
	else
	{
		const int2 Vertex = UnitCell + int2(FromCentre.x > 0.0f, FromCentre.y > 0.0f);
		CentreP = float2(Vertex);
		const float2 D = P - CentreP;
		[unroll]
		for (int Sy = -1; Sy <= 1; Sy += 2)
		{
			[unroll]
			for (int Sx = -1; Sx <= 1; Sx += 2)
			{
				PatternInsertDistance(
					(Cut - float(Sx) * D.x - float(Sy) * D.y) / DiagonalGradient,
					NearestEdge,
					SecondEdge);
			}
		}
		Inradius = Cut / DiagonalGradient;
	}

	const float EdgePixels = max(MixtormatSmoothMin(
		NearestEdge,
		SecondEdge,
		max(Rounding, 0.0f) * Inradius), 0.0f);
	FMixtormatPatternCell Result;
	Result.CentreWorkUV = frac(CentreP / float2(Period));
	Result.EdgePixels = EdgePixels;
	Result.EdgeRelative = EdgePixels / max(Inradius, 1.0e-4f);
	Result.PixelsPerRelativeUnit = max(Inradius, 1.0e-4f);
	Result.MinCellPixels = max(2.0f * Inradius, 1.0e-4f);
	Result.Orientation = 0u;
	return Result;
}

FMixtormatPatternCell PatternCellularCell(
	float2 WorkUV,
	float2 AxisPixels,
	int AuthoredColumns,
	int AuthoredRows,
	bool bFlagstone)
{
	const int2 Period = max(int2(AuthoredColumns, AuthoredRows), int2(1, 1));
	const float2 P = WorkUV * float2(Period);
	const float2 CellPixels = AxisPixels / float2(Period);
	const float AuthoredJitter = saturate(Jitter);
	// Flagstone keeps feature points biased toward their authored lattice cells. The non-zero floor
	// breaks the perfect grid, while the capped range stays more laid and structured than Voronoi.
	const float EffectiveJitter = bFlagstone
		? lerp(0.15f, 0.75f, AuthoredJitter)
		: AuthoredJitter;
	const uint EffectiveSeed = bFlagstone ? Seed ^ 0x7f4a7c15u : Seed;
	const FMixtormatCellularResult Cellular = MixtormatCellularMetric(
		P,
		Period,
		EffectiveSeed,
		EffectiveJitter,
		max(Rounding, 0.0f),
		CellPixels);
	const float2 FeatureP = P - Cellular.CellOffset;
	const float MinCellPixels = max(min(CellPixels.x, CellPixels.y), 1.0e-4f);
	const float MaxEdgePixels = MinCellPixels * 0.5f * sqrt(
		1.0f + EffectiveJitter + 0.5f * EffectiveJitter * EffectiveJitter);

	FMixtormatPatternCell Result;
	Result.CentreWorkUV = frac(FeatureP / float2(Period));
	Result.EdgePixels = Cellular.EdgeDistance;
	Result.EdgeRelative = Cellular.EdgeDistance / max(MaxEdgePixels, 1.0e-4f);
	Result.PixelsPerRelativeUnit = max(MaxEdgePixels, 1.0e-4f);
	Result.MinCellPixels = MinCellPixels;
	Result.Orientation = 0u;
	return Result;
}

int PatternModulePeriod(int Value, int ModuleSize)
{
	return max(((max(Value, 1) + ModuleSize - 1) / ModuleSize) * ModuleSize, ModuleSize);
}

FMixtormatPatternCell PatternHopscotchCell(
	float2 WorkUV,
	float2 AxisPixels,
	int AuthoredColumns,
	int AuthoredRows)
{
	const int2 Period = int2(
		PatternModulePeriod(AuthoredColumns, 3),
		PatternModulePeriod(AuthoredRows, 3));
	const float2 P = WorkUV * float2(Period);
	const int2 UnitCell = (int2)floor(P);
	const int2 Module = int2(
		UnitCell.x / 3,
		UnitCell.y / 3);
	const int2 ModuleLower = Module * 3;
	const int2 Local = UnitCell - ModuleLower;

	// One exact 3x3 cover: a 2x2 large tile, a 1x2 vertical, a 2x1 horizontal,
	// and the remaining corner as a 1x1 tile.
	if (Local.x < 2 && Local.y < 2)
	{
		return PatternBoxCell(
			P, AxisPixels, Period, float2(ModuleLower), float2(2.0f, 2.0f), 0u);
	}
	if (Local.x == 2 && Local.y < 2)
	{
		return PatternBoxCell(
			P,
			AxisPixels,
			Period,
			float2(ModuleLower + int2(2, 0)),
			float2(1.0f, 2.0f),
			0u);
	}
	if (Local.x < 2)
	{
		return PatternBoxCell(
			P,
			AxisPixels,
			Period,
			float2(ModuleLower + int2(0, 2)),
			float2(2.0f, 1.0f),
			0u);
	}
	return PatternBoxCell(
		P,
		AxisPixels,
		Period,
		float2(ModuleLower + int2(2, 2)),
		float2(1.0f, 1.0f),
		0u);
}

FMixtormatPatternCell PatternFrenchAshlarCell(
	float2 WorkUV,
	float2 AxisPixels,
	int AuthoredColumns,
	int AuthoredRows)
{
	const int2 Period = int2(
		PatternModulePeriod(AuthoredColumns, 6),
		PatternModulePeriod(AuthoredRows, 6));
	const float2 P = WorkUV * float2(Period);
	const int2 UnitCell = (int2)floor(P);
	const int2 Module = int2(
		UnitCell.x / 6,
		UnitCell.y / 6);
	const int2 ModuleLower = Module * 6;
	const int2 Local = UnitCell - ModuleLower;
	float2 TileLower;
	float2 TileSize;

	// Authored 6x6 cover, rows shown by tile footprint:
	// A A B B C D    A=2x3, B=2x2, C/D=1x2
	// A A B B C D    E/H=3x1, F/I=1x1
	// A A E E E F    G=2x3, J=2x2, K/L=2x1
	// H H H I G G
	// J J K K G G
	// J J L L G G
	if (Local.x < 2 && Local.y < 3)
	{
		TileLower = float2(0.0f, 0.0f);
		TileSize = float2(2.0f, 3.0f);
	}
	else if (Local.x >= 4 && Local.y >= 3)
	{
		TileLower = float2(4.0f, 3.0f);
		TileSize = float2(2.0f, 3.0f);
	}
	else if (Local.x >= 2 && Local.x < 4 && Local.y < 2)
	{
		TileLower = float2(2.0f, 0.0f);
		TileSize = float2(2.0f, 2.0f);
	}
	else if (Local.x < 2 && Local.y >= 4)
	{
		TileLower = float2(0.0f, 4.0f);
		TileSize = float2(2.0f, 2.0f);
	}
	else if (Local.y < 2)
	{
		TileLower = float2(float(Local.x), 0.0f);
		TileSize = float2(1.0f, 2.0f);
	}
	else if (Local.y == 2 && Local.x < 5)
	{
		TileLower = float2(2.0f, 2.0f);
		TileSize = float2(3.0f, 1.0f);
	}
	else if (Local.y == 2)
	{
		TileLower = float2(5.0f, 2.0f);
		TileSize = float2(1.0f, 1.0f);
	}
	else if (Local.y == 3 && Local.x < 3)
	{
		TileLower = float2(0.0f, 3.0f);
		TileSize = float2(3.0f, 1.0f);
	}
	else if (Local.y == 3)
	{
		TileLower = float2(3.0f, 3.0f);
		TileSize = float2(1.0f, 1.0f);
	}
	else
	{
		TileLower = float2(2.0f, float(Local.y));
		TileSize = float2(2.0f, 1.0f);
	}

	return PatternBoxCell(
		P,
		AxisPixels,
		Period,
		float2(ModuleLower) + TileLower,
		TileSize,
		0u);
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint2 Pixel = DispatchThreadId.xy;
	if (any(Pixel >= uint2(OutputSize)))
	{
		return;
	}

	const int SafeRows = max(Rows, 1);
	const int SafeColumns = max(Columns, 1);
	const float2 UV = (float2(Pixel) + 0.5f) / float2(OutputSize);
	const float2 WorkUV = PatternWorkUV(UV);
	const float2 AxisPixels = SwapAxes != 0
		? float2(OutputSize.y, OutputSize.x)
		: float2(OutputSize.x, OutputSize.y);

	FMixtormatPatternCell Cell;
	if (PatternMode == MIXTORMAT_PATTERN_RUNNING_BOND)
	{
		Cell = PatternRunningBondCell(WorkUV, AxisPixels, SafeColumns, SafeRows);
	}
	else if (PatternMode == MIXTORMAT_PATTERN_HERRINGBONE)
	{
		Cell = PatternHerringboneCell(WorkUV, AxisPixels, SafeColumns, SafeRows);
	}
	else if (PatternMode == MIXTORMAT_PATTERN_BASKETWEAVE)
	{
		Cell = PatternBasketweaveCell(WorkUV, AxisPixels, SafeColumns, SafeRows);
	}
	else if (PatternMode == MIXTORMAT_PATTERN_HEX)
	{
		Cell = PatternHexCell(WorkUV, AxisPixels, SafeColumns);
	}
	else if (PatternMode == MIXTORMAT_PATTERN_OCTAGON_SQUARE)
	{
		Cell = PatternOctagonSquareCell(WorkUV, AxisPixels, SafeColumns, SafeRows);
	}
	else if (PatternMode == MIXTORMAT_PATTERN_FLAGSTONE)
	{
		Cell = PatternCellularCell(WorkUV, AxisPixels, SafeColumns, SafeRows, true);
	}
	else if (PatternMode == MIXTORMAT_PATTERN_VORONOI)
	{
		Cell = PatternCellularCell(WorkUV, AxisPixels, SafeColumns, SafeRows, false);
	}
	else if (PatternMode == MIXTORMAT_PATTERN_HOPSCOTCH)
	{
		Cell = PatternHopscotchCell(WorkUV, AxisPixels, SafeColumns, SafeRows);
	}
	else if (PatternMode == MIXTORMAT_PATTERN_FRENCH_ASHLAR)
	{
		Cell = PatternFrenchAshlarCell(WorkUV, AxisPixels, SafeColumns, SafeRows);
	}
	else if (PatternMode == MIXTORMAT_PATTERN_GRID && GridMode == MIXTORMAT_GRID_DIAMOND)
	{
		Cell = PatternDiamondCell(WorkUV, AxisPixels, SafeColumns, SafeRows);
	}
	else
	{
		// Invalid serialized values fall back to the stable straight-grid solve.
		const bool bStaggered = PatternMode == MIXTORMAT_PATTERN_GRID
			&& GridMode == MIXTORMAT_GRID_STAGGERED;
		const int GridRows = bStaggered ? PatternEvenPeriod(SafeRows) : SafeRows;
		Cell = PatternRectangularCell(
			WorkUV,
			AxisPixels,
			SafeColumns,
			GridRows,
			bStaggered);
	}

	const float2 CentreUV = PatternUnworkUV(Cell.CentreWorkUV);
	const int2 CentrePixel = clamp(
		(int2)floor(CentreUV * float2(OutputSize)),
		int2(0, 0),
		OutputSize - int2(1, 1));
	const uint RegionId = uint(CentrePixel.x + CentrePixel.y * OutputSize.x);

	// Ownership always uses the physical pixel distance, keeping Gap Pixels absolute even when
	// consumers request the relative edge field for cell-proportional bevels.
	const float HalfGapPixels = max(GapPixels, 0.0f) * 0.5f;
	const bool bValidRegion = Cell.EdgePixels >= HalfGapPixels;
	const float RawEdge = EdgeRelative != 0 ? Cell.EdgeRelative : Cell.EdgePixels;
	const float HalfGapOutput = EdgeRelative != 0
		? HalfGapPixels / max(Cell.PixelsPerRelativeUnit, 1.0e-4f)
		: HalfGapPixels;

	// Signed in the selected edge unit: negative in grout, zero at its inner wall, positive on the
	// cell face. Consumers that only want the face continue to clamp their read to zero.
	const float EdgeSignedPixels = RawEdge - HalfGapOutput;

	const uint Seeded = MixtormatRegionSeed(RegionId, Seed);
	const float BevelRandom =
		MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_PATTERN_BEVEL);

	OutputIds[Pixel] = bValidRegion ? RegionId : MIXTORMAT_INVALID_REGION;
	OutputUV[Pixel] = CentreUV;
	OutputEdge[Pixel] = float2(EdgeSignedPixels, BevelRandom);
	if (WriteOrientation != 0)
	{
		// Swap Axes turns horizontal work-space strips vertical in the authored UV basis.
		OutputOrientation[Pixel] = Cell.Orientation ^ (SwapAxes != 0 ? 1u : 0u);
	}

	if (!bValidRegion)
	{
		// Grout sits at the base height. 0.5 is the neutral point of the signed encoding below,
		// and a zero feather keeps it there whatever the cell either side is doing.
		OutputRamp[Pixel] = float2(0.5f, 0.0f);
	}
	else
	{
		// One draw per cell, constant across the cell. The face stays flat -- no gradient, no
		// bias, nothing measured off CellOffset -- because a flat face at a random elevation is
		// exactly what a laid cobble or tile is, and a face that also tips is Ramp From IDs
		// composited over the top.
		//
		// Normalised and stored 0..1: the field is a pure "which cell is this" signal, and the
		// range and amount are applied once in the relief pass so the two cannot drift apart.
		const float HeightDraw =
			MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_PATTERN_HEIGHT);

		// Eases the elevation out at the cell's own boundary so neighbouring cells at different
		// heights meet through a ramp rather than a one-texel cliff. Measured from the inner wall
		// of the gap, so the grout is unaffected.
		//
		// Varied per cell on its own draw, multiplicatively: feather is a width, so scaling it is
		// what "vary it" means -- a cell with twice the feather has twice the run-out, and one at
		// zero variation keeps exactly the authored value.
		// One-sided, like the cell height and the chamfer width: the draw only narrows the
		// run-out from the authored value, never stretches it past what was asked for.
		const float FeatherJitter = lerp(
			1.0f - saturate(FeatherRandom),
			1.0f,
			MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_PATTERN_FEATHER));
		const float CellFeather = Feather * FeatherJitter;

		// Feather works off the raw lattice distance, so the gap has to come back into lattice
		// units here rather than reusing HalfGapPixels -- that one is in whatever unit the edge
		// field is published in, which is no longer always pixels.
		const float InteriorEdgeCell =
			max(Cell.EdgePixels - HalfGapPixels, 0.0f) / Cell.MinCellPixels;
		const float FeatherWeight = CellFeather > 0.0f
			? saturate(InteriorEdgeCell / CellFeather)
			: 1.0f;
		OutputRamp[Pixel] = float2(HeightDraw, FeatherWeight);
	}

	if (WriteDebug != 0)
	{
		if (!bValidRegion)
		{
			OutputDebug[Pixel] = float4(MixtormatDebugRamp(0.0f), 1.0f);
		}
		else
		{
			OutputDebug[Pixel] = float4(
				MixtormatDebugColor(float3(
					MixtormatRegionRandom(RegionId * 3u + 1u),
					MixtormatRegionRandom(RegionId * 3u + 2u),
					MixtormatRegionRandom(RegionId * 3u + 3u))), 1.0f);
		}
	}
}
