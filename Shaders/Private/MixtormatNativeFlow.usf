#include "/Engine/Public/Platform.ush"

int2 OutputSize;
Texture2D<float2> BoundaryField;
Texture2D<float> SignedField;
uint HasBoundaryRegions;
Texture2D<uint> BoundaryRegionIds;
uint UseSteering;
uint HasHeight;
uint HasBoundary;
float NativeFlowAmount;
float NativeFlowAngle;
float NativeSlopeWeight;
float NativeBoundaryWeight;
float NativeGravityWeight;
float NativeGravityAngle;
RWTexture2D<float4> OutFlow;
RWTexture2D<float> OutFlowValidity;

// Boundary validity belongs to the source stencil, never to a fabricated height or coverage.
float2 ReadSignedField(int2 Pixel)
{
#if MIXTORMAT_NATIVE_FLOW_PACKED_BOUNDARY
	return BoundaryField.Load(int3(Pixel, 0));
#else
	return float2(SignedField.Load(int3(Pixel, 0)), 1.0f);
#endif
}

// Shared native transport: downhill for signed height, inward for negative-inside boundary.
// Preserve Noise's intrinsic unit-direction semantics; weighted MODE magnitude is separate.
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 Pixel = int2(DispatchThreadId.xy);
	if (any(Pixel >= OutputSize)) { return; }
	const int2 XP = (Pixel + int2(1, 0)) % OutputSize;
	const int2 XM = (Pixel + OutputSize - int2(1, 0)) % OutputSize;
	const int2 YP = (Pixel + int2(0, 1)) % OutputSize;
	const int2 YM = (Pixel + OutputSize - int2(0, 1)) % OutputSize;
	const float2 XPlus = ReadSignedField(XP);
	const float2 XMinus = ReadSignedField(XM);
	const float2 YPlus = ReadSignedField(YP);
	const float2 YMinus = ReadSignedField(YM);
	const float2 Slope = 0.5f * float2(OutputSize) * float2(
		XPlus.x - XMinus.x, YPlus.x - YMinus.x);
	const float Magnitude = length(Slope);
	bool Valid = all(isfinite(Slope)) && isfinite(Magnitude) && Magnitude > 1.0e-5f;
#if MIXTORMAT_NATIVE_FLOW_PACKED_BOUNDARY
	const float2 Center = ReadSignedField(Pixel);
	Valid = Valid && all(isfinite(Center)) && Center.y > 0.5f
		&& all(isfinite(XPlus)) && XPlus.y > 0.5f
		&& all(isfinite(XMinus)) && XMinus.y > 0.5f
		&& all(isfinite(YPlus)) && YPlus.y > 0.5f
		&& all(isfinite(YMinus)) && YMinus.y > 0.5f;
	if (HasBoundaryRegions != 0u)
	{
		// A piece-local metric cannot differentiate through another piece's boundary branch.
		const uint Owner = BoundaryRegionIds.Load(int3(Pixel, 0));
		Valid = Valid && BoundaryRegionIds.Load(int3(XP, 0)) == Owner
			&& BoundaryRegionIds.Load(int3(XM, 0)) == Owner
			&& BoundaryRegionIds.Load(int3(YP, 0)) == Owner
			&& BoundaryRegionIds.Load(int3(YM, 0)) == Owner;
		// Reject sampled cusps/extrema rather than normalizing a mixed branch into movement.
		const float2 Forward = float2(XPlus.x, YPlus.x) - Center.x;
		const float2 Backward = Center.x - float2(XMinus.x, YMinus.x);
		Valid = Valid && all(Forward * Backward >= 0.0f);
	}
#endif
	if (UseSteering != 0u)
	{
		float2 Result = float2(0.0f, 0.0f);
		bool HasGeometry = false;
		float2 HeightDirection = float2(0.0f, 0.0f);
		bool HeightValid = false;
		if (HasHeight != 0u)
		{
			const float HX = SignedField.Load(int3(XP, 0)) - SignedField.Load(int3(XM, 0));
			const float HY = SignedField.Load(int3(YP, 0)) - SignedField.Load(int3(YM, 0));
			const float HC = SignedField.Load(int3(Pixel, 0));
			const float2 HG = 0.5f * float2(OutputSize) * float2(HX, HY);
			const float HM = length(HG);
			HeightValid = isfinite(HC) && all(isfinite(HG)) && isfinite(HM) && HM > 1.0e-5f;
			HeightDirection = HeightValid ? -HG / HM : float2(0.0f, 0.0f);
			HasGeometry = isfinite(HC);
		}
		bool BoundaryValid = false;
		float2 BoundaryDirection = float2(0.0f, 0.0f);
		if (HasBoundary != 0u)
		{
			const float2 Centre = BoundaryField.Load(int3(Pixel, 0));
			const float2 BP = BoundaryField.Load(int3(XP, 0));
			const float2 BM = BoundaryField.Load(int3(XM, 0));
			const float2 BQ = BoundaryField.Load(int3(YP, 0));
			const float2 BN = BoundaryField.Load(int3(YM, 0));
			const float2 BG = 0.5f * float2(OutputSize) * float2(BP.x - BM.x, BQ.x - BN.x);
			const float BMagnitude = length(BG);
			BoundaryValid = all(isfinite(Centre)) && Centre.y > 0.5f
				&& all(isfinite(BP)) && all(isfinite(BM)) && all(isfinite(BQ)) && all(isfinite(BN))
				&& BP.y > 0.5f && BM.y > 0.5f && BQ.y > 0.5f && BN.y > 0.5f
				&& all(isfinite(BG)) && isfinite(BMagnitude) && BMagnitude > 1.0e-5f;
			if (HasBoundaryRegions != 0u)
			{
				const uint Owner = BoundaryRegionIds.Load(int3(Pixel, 0));
				BoundaryValid = BoundaryValid
					&& BoundaryRegionIds.Load(int3(XP, 0)) == Owner
					&& BoundaryRegionIds.Load(int3(XM, 0)) == Owner
					&& BoundaryRegionIds.Load(int3(YP, 0)) == Owner
					&& BoundaryRegionIds.Load(int3(YM, 0)) == Owner;
				const float2 Forward = float2(BP.x, BQ.x) - Centre.x;
				const float2 Backward = Centre.x - float2(BM.x, BN.x);
				BoundaryValid = BoundaryValid && all(Forward * Backward >= 0.0f);
			}
			BoundaryDirection = BoundaryValid ? -BG / BMagnitude : float2(0.0f, 0.0f);
			HasGeometry = HasGeometry || (isfinite(Centre.x) && Centre.y > 0.5f);
		}
		const float BW = max(0.0f, NativeBoundaryWeight);
		const float SW = max(0.0f, NativeSlopeWeight);
		// No boundary (Cliff Strata): use the height gradient for the geometry direction.
		if (HasBoundary == 0u && HeightValid) Result += HeightDirection * max(BW, SW);
		else
		{
			if (BoundaryValid) Result += BoundaryDirection * BW;
			if (HeightValid) Result += HeightDirection * SW;
		}
		if (HasGeometry && NativeGravityWeight > 0.0f)
		{
			const float G = radians(NativeGravityAngle);
			Result += float2(cos(G), sin(G)) * NativeGravityWeight;
		}
		const float RM = length(Result);
		const bool SteerValid = all(isfinite(Result)) && isfinite(RM)
			&& RM > 1.0e-5f && isfinite(NativeFlowAmount) && NativeFlowAmount > 0.0f;
		const float A = radians(NativeFlowAngle);
		const float2 Unit = SteerValid ? Result / RM : float2(0.0f, 0.0f);
		const float2 Direction = float2(
			Unit.x * cos(A) - Unit.y * sin(A),
			Unit.x * sin(A) + Unit.y * cos(A));
		OutFlow[Pixel] = float4(SteerValid ? Direction * NativeFlowAmount : float2(0.0f, 0.0f),
			0.0f, SteerValid ? saturate(NativeFlowAmount) : 0.0f);
		OutFlowValidity[Pixel] = SteerValid ? 1.0f : 0.0f;
		return;
	}
	const float2 Direction = Valid ? -Slope / Magnitude : float2(0.0f, 0.0f);
	OutFlow[Pixel] = float4(Direction, 0.0f, Valid ? 1.0f : 0.0f);
	OutFlowValidity[Pixel] = Valid ? 1.0f : 0.0f;
}
