#include "/Engine/Public/Platform.ush"

int2 OutputSize;
#if MIXTORMAT_NATIVE_FLOW_PACKED_BOUNDARY
Texture2D<float2> BoundaryField;
uint HasBoundaryRegions;
Texture2D<uint> BoundaryRegionIds;
#else
Texture2D<float> SignedField;
#endif
RWTexture2D<float4> OutFlow;
RWTexture2D<float> OutFlowValidity;

// Boundary validity belongs to the source stencil, never to a fabricated height or coverage.
float2 ReadSignedField(int2 Pixel)
{
#if MIXTORMAT_NATIVE_FLOW_PACKED_BOUNDARY
	return BoundaryField.Load(int3(Pixel, 0));
#else
	return float2(SignedField.Load(int3(Pixel, 0)), 1.0f);
#endif
}

// Shared native transport: downhill for signed height, inward for negative-inside boundary.
// Preserve Noise's intrinsic unit-direction semantics; weighted MODE magnitude is separate.
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 Pixel = int2(DispatchThreadId.xy);
	if (any(Pixel >= OutputSize)) { return; }
	const int2 XP = (Pixel + int2(1, 0)) % OutputSize;
	const int2 XM = (Pixel + OutputSize - int2(1, 0)) % OutputSize;
	const int2 YP = (Pixel + int2(0, 1)) % OutputSize;
	const int2 YM = (Pixel + OutputSize - int2(0, 1)) % OutputSize;
	const float2 XPlus = ReadSignedField(XP);
	const float2 XMinus = ReadSignedField(XM);
	const float2 YPlus = ReadSignedField(YP);
	const float2 YMinus = ReadSignedField(YM);
	const float2 Slope = 0.5f * float2(OutputSize) * float2(
		XPlus.x - XMinus.x, YPlus.x - YMinus.x);
	const float Magnitude = length(Slope);
	bool Valid = all(isfinite(Slope)) && isfinite(Magnitude) && Magnitude > 1.0e-5f;
#if MIXTORMAT_NATIVE_FLOW_PACKED_BOUNDARY
	const float2 Center = ReadSignedField(Pixel);
	Valid = Valid && all(isfinite(Center)) && Center.y > 0.5f
		&& all(isfinite(XPlus)) && XPlus.y > 0.5f
		&& all(isfinite(XMinus)) && XMinus.y > 0.5f
		&& all(isfinite(YPlus)) && YPlus.y > 0.5f
		&& all(isfinite(YMinus)) && YMinus.y > 0.5f;
	if (HasBoundaryRegions != 0u)
	{
		// A piece-local metric cannot differentiate through another piece's boundary branch.
		const uint Owner = BoundaryRegionIds.Load(int3(Pixel, 0));
		Valid = Valid && BoundaryRegionIds.Load(int3(XP, 0)) == Owner
			&& BoundaryRegionIds.Load(int3(XM, 0)) == Owner
			&& BoundaryRegionIds.Load(int3(YP, 0)) == Owner
			&& BoundaryRegionIds.Load(int3(YM, 0)) == Owner;
		// Reject sampled cusps/extrema rather than normalizing a mixed branch into movement.
		const float2 Forward = float2(XPlus.x, YPlus.x) - Center.x;
		const float2 Backward = Center.x - float2(XMinus.x, YMinus.x);
		Valid = Valid && all(Forward * Backward >= 0.0f);
	}
#endif
	const float2 Direction = Valid ? -Slope / Magnitude : float2(0.0f, 0.0f);
	OutFlow[Pixel] = float4(Direction, 0.0f, Valid ? 1.0f : 0.0f);
	OutFlowValidity[Pixel] = Valid ? 1.0f : 0.0f;
}
