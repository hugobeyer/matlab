// Quasi-static compressed-film height-field relaxation, not XPBD or a 3D tissue solver.
#include "/Engine/Public/Platform.ush"

// 0 restrict full-resolution rest fields, 1 initialize/prolongate correction, 2 relax.
#ifndef SKIN_SOLVE_STAGE
#define SKIN_SOLVE_STAGE 2
#endif

int2 OutputSize;
float FoldRate;
uint HasPreviousFold;
SamplerState LinearWrapSampler;
// @param Bending
float Bending;
// @param Support
float Support;
// @param GravityHold
float GravityHold;
Texture2D<float4> TissueState;
Texture2D<float4> SeedState;
Texture2D<float> PreviousFold;
#if SKIN_SOLVE_STAGE == 0
RWTexture2D<float4> OutPreparedSeed;
RWTexture2D<float4> OutPreparedTissue;
#else
RWTexture2D<float> OutFold;
#endif

// Length and residual height are both measured in fold wavelengths inside the solve.
// State stores SOLVED MINUS REST in UV relief. Full-resolution analytic rest is retained
// downstream; coarse grids cannot replace its detail. HeightScale/units/Amount belong downstream.
static const float SkinMinRigidity = 0.00002f;
static const float SkinMaxRigidity = 0.0025f;
static const float SkinMinFoundation = 0.5f;
static const float SkinMaxFoundation = 32.0f;
static const float SkinMaxThickness = 2.5f;
static const float SkinCompressionStrain = 0.35f;
static const float SkinTensileStrain = 0.25f;
static const float SkinMaxBendingInvSpacing2 = 1024.0f;
static const float SkinRelaxationSafety = 0.8f;

int2 SkinWrapPixel(int2 P)
{
	return (P % OutputSize + OutputSize) % OutputSize;
}

float4 SkinSeed(int2 P)
{
	return SeedState.Load(int3(SkinWrapPixel(P), 0));
}

#if SKIN_SOLVE_STAGE == 2
float SkinThickness(int2 P)
{
	return clamp(TissueState.Load(int3(SkinWrapPixel(P), 0)).a, 0.6f, SkinMaxThickness);
}

float SkinPrevious(int2 P)
{
	int2 Q = SkinWrapPixel(P);
	return (SeedState.Load(int3(Q, 0)).r + PreviousFold.Load(int3(Q, 0))) * FoldRate;
}

float SkinRigidity(int2 P)
{
	float Thickness = SkinThickness(P);
	// Safety only: keep rigidity finite/positive for any authored Bending.
	return lerp(SkinMinRigidity, SkinMaxRigidity, clamp(Bending, 0.0f, 4.0f))
		* Thickness * Thickness * Thickness;
}

float SkinMoment(int2 P, float2 InvSpacing2)
{
	float C = SkinPrevious(P);
	float Laplacian = InvSpacing2.x * (SkinPrevious(P + int2(1, 0)) + SkinPrevious(P - int2(1, 0)) - 2.0f * C)
		+ InvSpacing2.y * (SkinPrevious(P + int2(0, 1)) + SkinPrevious(P - int2(0, 1)) - 2.0f * C);
	return SkinRigidity(P) * Laplacian;
}

float SkinRestStrain(float4 State, float2 Edge)
{
	float2 Normal = float2(cos(State.a), sin(State.a));
	float Projection = dot(Edge, Normal);
	// Project the director tensor before averaging endpoints: angles have a pi seam.
	return SkinCompressionStrain * max(State.g, 0.0f) * Projection * Projection
		- SkinTensileStrain * max(State.b, 0.0f);
}
#endif

[numthreads(8, 8, 1)]
void MainCS(uint3 DTid : SV_DispatchThreadID)
{
	int2 P = int2(DTid.xy);
	if (any(P >= OutputSize)) { return; }
#if SKIN_SOLVE_STAGE == 0
	float2 UV = (float2(P) + 0.5f) / float2(OutputSize);
	float2 SubTexel = 0.25f / float2(max(OutputSize, int2(1, 1)));
	uint W, H;
	SeedState.GetDimensions(W, H);
	int2 SeedSize = int2(W, H);
	float4 Rest = 0.0f;
	float4 Tissue = 0.0f;
	float2 Director = 0.0f;
	[unroll] for (int SY = -1; SY <= 1; SY += 2)
	{
		[unroll] for (int SX = -1; SX <= 1; SX += 2)
		{
			float2 TapUV = UV + float2(SX, SY) * SubTexel;
			Rest.rgb += 0.25f * SeedState.SampleLevel(LinearWrapSampler, TapUV, 0).rgb;
			Tissue += 0.25f * TissueState.SampleLevel(LinearWrapSampler, TapUV, 0);
			float2 Source = frac(TapUV) * float2(SeedSize) - 0.5f;
			int2 Base = int2(floor(Source));
			float2 Blend = frac(Source);
			[unroll] for (int Y = 0; Y < 2; ++Y)
			{
				[unroll] for (int X = 0; X < 2; ++X)
				{
					int2 Q = ((Base + int2(X, Y)) % SeedSize + SeedSize) % SeedSize;
					float A = SeedState.Load(int3(Q, 0)).a;
					float Weight = 0.25f * (X == 0 ? 1.0f - Blend.x : Blend.x) * (Y == 0 ? 1.0f - Blend.y : Blend.y);
					Director += Weight * float2(cos(2.0f * A), sin(2.0f * A));
				}
			}
		}
	}
	// Interpolate an unoriented director, never wrapped normal angles.
	Rest.a = dot(Director, Director) > 1.0e-8f ? 0.5f * atan2(Director.y, Director.x) : 0.0f;
	OutPreparedSeed[P] = Rest;
	OutPreparedTissue[P] = Tissue;
#elif SKIN_SOLVE_STAGE == 1
	float2 UV = (float2(P) + 0.5f) / float2(OutputSize);
	// A level starts at zero correction or prolongates the previous level's correction.
	OutFold[P] = HasPreviousFold != 0u ? PreviousFold.SampleLevel(LinearWrapSampler, UV, 0) : 0.0f;
#else
	float4 Seed = SkinSeed(P);
	float C = SkinPrevious(P);
	float2 Spacing = FoldRate / float2(OutputSize);
	float2 InvSpacing2 = float2(OutputSize.x > 1 ? 1.0f / (Spacing.x * Spacing.x) : 0.0f,
		OutputSize.y > 1 ? 1.0f / (Spacing.y * Spacing.y) : 0.0f);
	float2 BendingInvSpacing2 = min(InvSpacing2, SkinMaxBendingInvSpacing2.xx);
	float Thickness = SkinThickness(P);
	// Safety only: unclamped authored values cannot destabilize the relaxation.
	float Foundation = lerp(SkinMinFoundation, SkinMaxFoundation, clamp(Support, 0.0f, 4.0f));
	// Gravity hold: thick tissue in low/rest-depressed areas resists the
	// foundation pull, so sag stays pooled instead of relaxing flat.
	float HoldCue = saturate((Thickness - 1.0f) + saturate(-Seed.r * FoldRate));
	Foundation *= 1.0f - clamp(GravityHold, 0.0f, 2.0f) * 0.35f * HoldCue;
	float Force = -Foundation * Thickness * (C - Seed.r * FoldRate);
	float Moment = SkinMoment(P, BendingInvSpacing2);
	// Variable rigidity belongs INSIDE the second Laplacian (gradient of .5*B*(Delta h)^2).
	Force -= BendingInvSpacing2.x * (SkinMoment(P + int2(1, 0), BendingInvSpacing2)
		+ SkinMoment(P - int2(1, 0), BendingInvSpacing2) - 2.0f * Moment)
		+ BendingInvSpacing2.y * (SkinMoment(P + int2(0, 1), BendingInvSpacing2)
		+ SkinMoment(P - int2(0, 1), BendingInvSpacing2) - 2.0f * Moment);

	float Bound = Foundation * Thickness;
	float LocalB = max(max(SkinRigidity(P), max(SkinRigidity(P + int2(1, 0)), SkinRigidity(P - int2(1, 0)))),
		max(SkinRigidity(P + int2(0, 1)), SkinRigidity(P - int2(0, 1))));
	float LaplacianBound = 4.0f * (BendingInvSpacing2.x + BendingInvSpacing2.y);
	Bound += LocalB * LaplacianBound * LaplacianBound;
	[unroll] for (int Y = -1; Y <= 1; ++Y)
	{
		[unroll] for (int X = -1; X <= 1; ++X)
		{
			if ((X == 0 && Y == 0) || (OutputSize.x == 1 && X != 0) || (OutputSize.y == 1 && Y != 0)) { continue; }
			int2 Offset = int2(X, Y);
			float2 Delta = float2(Offset) * Spacing;
			float InvDistance = rsqrt(dot(Delta, Delta));
			float2 Edge = Delta * InvDistance;
			float4 NeighborSeed = SkinSeed(P + Offset);
			float Slope = (SkinPrevious(P + Offset) - C) * InvDistance;
			// Dynamic strain feedback: authored rest strain plus the strain the
			// current solved slope is actually producing, so compression grows
			// where folds deepen and relaxes where the film flattens.
			float Strain = 0.5f * (SkinRestStrain(Seed, Edge) + SkinRestStrain(NeighborSeed, Edge))
				+ clamp(Slope * 0.35f, -0.4f, 0.8f);
			float Weight = (X != 0 && Y != 0) ? 0.25f : 0.5f;
			float Membrane = Weight * 0.5f * (Thickness + SkinThickness(P + Offset));
			// dE/ds for E=.5*s^2-.5*(1+2*e)*log(1+s^2).
			// Near zero this has compressive negative stiffness and stabilizing quartic strain;
			// large slopes retain a bounded Hessian instead of an unstable explicit cubic force.
			float Stress = Slope * (1.0f - (1.0f + 2.0f * Strain) / (1.0f + Slope * Slope));
			Force += Membrane * Stress * InvDistance;
			float EdgeHessianBound = 1.0f + 2.0f * abs(Strain);
			Bound += 2.0f * Membrane * EdgeHessianBound * InvDistance * InvDistance;
		}
	}
	// Global Hessian row-sum bound, including rectangular spacing and maximum tissue rigidity.
	// Every texel reads one immutable previous state; no UAV reads or order-dependent updates.
	float Next = (C + SkinRelaxationSafety * Force / max(Bound, 1.0e-8f)) / FoldRate - Seed.r;
	OutFold[P] = isfinite(Next) ? Next : PreviousFold.Load(int3(P, 0));
#endif
}
