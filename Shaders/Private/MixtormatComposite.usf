Texture2D<float4> PreviousBC;
Texture2D<float4> PreviousN;
Texture2D<float4> PreviousRAM;
Texture2D<float> PreviousHeight;
Texture2D<float> ReferenceHeight;
Texture2D<float4> LayerBC;
Texture2D<float4> LayerN;
Texture2D<float4> LayerRAM;
Texture2D<float> LayerMask;

// The same mask, separably blurred. Bound to the unblurred mask when the layer asks for no
// smoothing, so this is always a valid SRV and the shader needs no branch on whether the passes
// ran.
Texture2D<float> LayerHeightMask;

// The accumulated height beneath this layer, separably blurred -- the same Gaussian the mask
// smoothing uses, run over the height instead. Bound to the unblurred height when the layer asks
// for none, with BorderSmoothValid saying which it is.
Texture2D<float> BorderBaseHeight;
Texture2D<float4> EffectData;
Texture2D<float> EffectHeight;
Texture2D<float> DebugMask;
SamplerState LinearWrapSampler;

// The ID map published by a cluster filter in this layer, and the per-region colour
