// Scalar Drivers. Two slots this step, one per driven scalar: slot 0 modulates RoughnessInfluence,
// slot 1 HeightBlendAmount. Both are bound on every dispatch -- a 1x1 dummy when the layer has no
// Driver -- because RDG validates the binding whether the shader branches on it or not, exactly as
// RegionIds does above.
//
// The two slots hold texture *bindings*, not allocations: several driven scalars naming one source
// bind the same texture, so a layer costs at most one snapshot however many scalars it drives.
float4 DriverParamsA[2];
float4 DriverParamsB[2];
// (IsRegionSource, Seed, RandomMin, RandomMax). A slot reads one of its two source bindings and
// ignores the other; both stay bound because RDG validates a binding whether the branch is taken
// or not, and the unused one is a shared 1x1 dummy.
float4 DriverParamsC[2];
Texture2D<float> DriverSignal0;
Texture2D<float> DriverSignal1;
Texture2D<uint> DriverRegionIds0;
Texture2D<uint> DriverRegionIds1;

// The composite's own texel, which is the space the ID maps are written in. No pattern wrapping
// and no topology of any kind, so a pattern map and a cluster map read identically.
int2 DriverPixel(float2 UV)
{
	return int2(UV * float2(OutputSize));
}

float GetRoughnessInfluence(float2 UV)
{
	const float Signal0 = DriverParamsC[0].x > 0.5f
		? MixtormatDriverRegionSignal(
			DriverRegionIds0.Load(int3(DriverPixel(UV), 0)),
			(uint)DriverParamsC[0].y,
			DriverParamsC[0].z,
			DriverParamsC[0].w)
		: DriverSignal0.SampleLevel(LinearWrapSampler, UV, 0.0f);
	return MixtormatApplyDriver(
		RoughnessInfluence,
		Signal0,
		DriverParamsA[0],
		DriverParamsB[0]);
}

float GetHeightBlendAmount(float2 UV)
{
	const float Signal1 = DriverParamsC[1].x > 0.5f
		? MixtormatDriverRegionSignal(
			DriverRegionIds1.Load(int3(DriverPixel(UV), 0)),
			(uint)DriverParamsC[1].y,
			DriverParamsC[1].z,
			DriverParamsC[1].w)
		: DriverSignal1.SampleLevel(LinearWrapSampler, UV, 0.0f);
	return MixtormatApplyDriver(
		HeightBlendAmount,
		Signal1,
		DriverParamsA[1],
		DriverParamsB[1]);
}
float HeightThreshold;
float HeightRange;
float HeightContrast;
float HeightOffset;
float HeightBias;
float ConstantHeight;
float MaskHeightInfluence;
float HeightContactAOAmount;
float HeightContactAOWidth;
float HeightBorderLift;
float HeightBorderWidth;
float HeightBorderNormalStrength;
float FeatureInfluence;
float FeatureBias;
float HeightFeatureInfluence;
float AOFeatureInfluence;
int CurvatureRadius;
float CurvatureStrength;
float CurvaturePower;
int CurvatureSmoothing;
float4 FillColor;

float3 DecodeNormal(float4 EncodedNormal, float Intensity, uint InvertY)
{
	float2 XY = EncodedNormal.xy * 2.0f - 1.0f;
	XY.y *= InvertY != 0 ? -1.0f : 1.0f;
	XY *= Intensity;
	return normalize(float3(XY, sqrt(saturate(1.0f - dot(XY, XY)))));
}

float3 DecodeEffectNormal(float2 EncodedXY)
{
	float2 XY = EncodedXY * 2.0f - 1.0f;
	return normalize(float3(XY, sqrt(saturate(1.0f - dot(XY, XY)))));
}

float3 EncodeNormal(float3 Normal)
{
	return Normal * 0.5f + 0.5f;
}

float3 BlendReorientedNormals(float3 BaseNormal, float3 DetailNormal)
{
	float3 T = BaseNormal + float3(0.0f, 0.0f, 1.0f);
	float3 U = DetailNormal * float3(-1.0f, -1.0f, 1.0f);
	return normalize(T * dot(T, U) / max(T.z, 1.0e-5f) - U);
}

float3 RGBToHSV(float3 RGB)
{
	float4 K = float4(0.0f, -1.0f / 3.0f, 2.0f / 3.0f, -1.0f);
	float4 P = lerp(float4(RGB.bg, K.wz), float4(RGB.gb, K.xy), step(RGB.b, RGB.g));
	float4 Q = lerp(float4(P.xyw, RGB.r), float4(RGB.r, P.yzx), step(P.x, RGB.r));
	float D = Q.x - min(Q.w, Q.y);
	float Epsilon = 1.0e-6f;
	return float3(
		abs(Q.z + (Q.w - Q.y) / (6.0f * D + Epsilon)),
		D / (Q.x + Epsilon),
		Q.x);
}

float3 HSVToRGB(float3 HSV)
{
	float3 RGB = saturate(abs(frac(HSV.xxx + float3(0.0f, 2.0f / 3.0f, 1.0f / 3.0f)) * 6.0f - 3.0f) - 1.0f);
	return HSV.z * lerp(float3(1.0f, 1.0f, 1.0f), RGB, HSV.y);
}

// Per-region colour variation, from the ID map. Two stages, and the first is the one that
// matters: each region samples a colour out of the authored palette and blends toward it by a
// random amount, then hue/saturation/value jitter goes on top.
//
// The palette is what pure jitter cannot do. Jitter can only wander from wherever the texture
// already sits; a palette lets the variation be aimed somewhere chosen and then jittered around
// that -- brick reds through ochres rather than a random walk away from one red.
//
// Five decorrelated draws come off one region seed with five salts: palette position, tint
// amount, hue, saturation, value. One hash, five constants.
float3 ApplyRegionVariation(float3 RGB, uint2 Pixel)
{
	if (RegionTintEnabled == 0)
	{
		return RGB;
	}

	// A pixel in no region passes through untinted rather than hashing the sentinel into a
	// colour. This is the guard hsv_from_ids.cl is missing.
	const uint RegionId = RegionIds.Load(int3(Pixel, 0));
	if (RegionId == MIXTORMAT_INVALID_REGION)
	{
		return RGB;
	}

	const uint Seeded = MixtormatRegionSeed(RegionId, RegionSeed);
	float3 Tinted = RGB;

	if (RegionPaletteCount > 0)
	{
		// Evenly spaced stops. A single entry is a flat colour rather than a degenerate ramp.
		const float RampT = MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_RAMP);
		const float Position = RampT * float(max(RegionPaletteCount - 1, 0));
		const int Lower = clamp((int)floor(Position), 0, RegionPaletteCount - 1);
		const int Upper = min(Lower + 1, RegionPaletteCount - 1);
		const float3 Sampled = lerp(
			RegionPalette[Lower].rgb, RegionPalette[Upper].rgb, saturate(Position - float(Lower)));

		const float MixT = MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_MIX);
		Tinted = lerp(RGB, Sampled, saturate(RegionMixMin + (RegionMixMax - RegionMixMin) * MixT));
	}

	// Hue added because it is circular, saturation and value multiplied because they are
	// magnitudes. -1..1 spans +/-180 degrees, matching HueShift's own convention above.
	const float HueT = MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_HUE);
	const float SatT = MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_SAT);
	const float ValT = MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_VAL);

	float3 HSV = RGBToHSV(max(Tinted, 0.0f));
	HSV.x = frac(HSV.x + lerp(RegionHueMin, RegionHueMax, HueT) * 0.5f + 1.0f);
	HSV.y = saturate(HSV.y * lerp(RegionSatMin, RegionSatMax, SatT));
	HSV.z = max(0.0f, HSV.z * lerp(RegionValMin, RegionValMax, ValT));
	return saturate(HSVToRGB(HSV));
}

float3 AdjustHSV(float3 RGB)
{
	float3 HSV = RGBToHSV(max(RGB, 0.0f));
	HSV.x = frac(HSV.x + HueShift / 360.0f + 1.0f);
	HSV.y = saturate(HSV.y * Saturation);
	HSV.z = max(0.0f, HSV.z * Value);
	return saturate(HSVToRGB(HSV));
}

float AdjustRoughness(float Roughness)
{
	float SafeBias = clamp(RoughnessBias, 0.01f, 0.99f);
	float Biased = Roughness / ((((1.0f / SafeBias) - 2.0f) * (1.0f - Roughness)) + 1.0f);
	float Contrasted = lerp(0.5f, saturate(Biased), RoughnessContrast);
	return saturate(Contrasted + RoughnessOffset);
}

float SamplePlacementMask(float2 UV)
{
	return HasMask != 0 ? LayerMask.SampleLevel(LinearWrapSampler, UV, 0.0f) : 1.0f;
}

// The mask as the height field should see it.
//
// A placement mask is a step: inside is 1, outside is 0, and the layer's height goes from full to
// nothing across one texel. That is a cliff, and it reads as one -- the layer sits on the surface
// like a decal rather than settling into it. Blurring the mask and taking the height from the
// blurred copy turns that step into a ramp, so the height falls away from the interior toward the
// boundary and the layer meets what is underneath with a fillet.
//
// Wide radii round rather than merely soften: past the point where the two blurred edges of a
// shape start to overlap, the interior itself domes. That is the "smooth fill" case, and it is
// why the radius runs to tens of texels rather than the two or three an anti-aliasing blur wants.
//
// Only the height path calls this. What that means for coverage depends on the comparison mode,
// and the difference is worth knowing:
//
//   DirectHeightComparison != 0   coverage comes from the height field, so smoothing the height
//                                 smooths coverage with it. This is the mode the feature is for,
//                                 and the softened boundary is the point.
//   DirectHeightComparison == 0   coverage is the sharp mask and only the height is rounded, so
//                                 the layer keeps a crisp outline over a filleted profile.
float SamplePlacementHeightMask(float2 UV)
{
	const float Sharp = SamplePlacementMask(UV);
	if (HasMask == 0 || HeightSmoothAmount <= 0.0f)
	{
		return Sharp;
	}
	const float Smoothed = LayerHeightMask.SampleLevel(LinearWrapSampler, UV, 0.0f);
	return lerp(Sharp, Smoothed, saturate(HeightSmoothAmount));
}

// Where the layer's source is read from.
//
// Everything here is chosen to survive the frac(): the repeat has to close on the UV square or
// the surface seams, which is the constraint the whole compositor is written under.
//
//   Scale   integer, per axis, on top of the layer's Tiling. A non-integer factor does not
//           tile -- frac(UV * 2 * 1.3) lands mid-cell at the wrap -- so this is deliberately
//           not a float. Tiling stays the uniform base; these two scale it per axis.
//   Offset  any value. A pure translation of a periodic function is still periodic.
//   Flip    any value. A sign change, and frac() wraps the negative side correctly.
//
// Rotation is absent on purpose. Rotating a tiled UV breaks the repeat at every angle that is
// not a multiple of 90 degrees, and a control that seams at most of its range is worse than no
// control. It needs either a 90-degree snap or stochastic sampling to remove the requirement.
// Shared with the mask node, so the two read a source the same way. The flip in particular
// changed hands here: it used to scale by -1 and let frac() wrap, which is the same picture
// shifted by a texel -- a seam on a surface whose edges are supposed to meet. The helper
// mirrors about the centre of the tile instead.
int PatternWrap(int X, int Size)
{
	const int R = X % max(Size, 1);
	return R < 0 ? R + Size : R;
}

int2 PatternPixel(float2 UV)
{
	const float2 Wrapped = frac(UV + 1.0f);
	return int2(
		PatternWrap((int)floor(Wrapped.x * float(OutputSize.x)), OutputSize.x),
		PatternWrap((int)floor(Wrapped.y * float(OutputSize.y)), OutputSize.y));
}

// The source read for this pixel, and the orientation that read imposes.
//
// Orientation is the rigid part of the same transform -- flips and rotations, no scale and no
// offset -- and it comes out of here rather than being rebuilt at the sample site so that a
// normal can never disagree with the coordinate it was fetched at. Every early return sets it,
// including the two that fall back to the base placement.
//
// The layer's per-axis scale sits between the base rotation and the pattern rotation in the
// coordinate transform, and is dropped from the orientation: it changes the texture's frequency,
// not the direction of its tangent frame. See MixtormatTransformTangentVector.
float2 LayerSourceUVAndOrientation(float2 UV, out float2x2 Orientation)
{
	const float2 Scale = float2(
		max(Tiling, 0.0001f) * (float)max(UVScaleX, 1),
		max(Tiling, 0.0001f) * (float)max(UVScaleY, 1));
	Orientation = MixtormatSourceOrientation(FlipU, FlipV, Rotation);
	const float2 SourceUV = MixtormatSourceUV(UV, Scale, UVOffset, FlipU, FlipV, Rotation);
	if (PatternUVEnabled == 0)
	{
		return SourceUV;
	}

	const int2 Pixel = PatternPixel(UV);
	const uint RegionId = PatternRegionIds.Load(int3(Pixel, 0));
	if (RegionId == MIXTORMAT_INVALID_REGION)
	{
		return SourceUV;
	}

	const float2 CentreUV = PatternUVField.Load(int3(Pixel, 0));
	const float2 CentreSourceUV =
		MixtormatSourceUV(CentreUV, Scale, UVOffset, FlipU, FlipV, Rotation);
	float2 Delta = SourceUV - CentreSourceUV;
	Delta -= floor(Delta + 0.5f);

	const uint Seeded = MixtormatRegionSeed(RegionId, PatternUVSeed);
	float AngleDegrees = 0.0f;
	float UVScale = 1.0f;
	bool bPatternFlipU = false;
	bool bPatternFlipV = false;
	float2 RandomOffset = 0.0f;
	if (PatternUVVariationEnabled != 0)
	{
		AngleDegrees = lerp(
			PatternUVRotationMin,
			PatternUVRotationMax,
			MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_PATTERN_UV_ROT));
		if (PatternUVOrthogonal != 0)
		{
			AngleDegrees = round(AngleDegrees / 90.0f) * 90.0f;
		}
		UVScale = max(lerp(
			PatternUVScaleMin,
			PatternUVScaleMax,
			MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_PATTERN_UV_SCALE)), 1.0e-4f);
		bPatternFlipU = PatternUVFlipU != 0
			&& MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_PATTERN_UV_FLIP_U) < 0.5f;
		bPatternFlipV = PatternUVFlipV != 0
			&& MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_PATTERN_UV_FLIP_V) < 0.5f;
		RandomOffset = (float2(
			MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_PATTERN_UV_OFF_U),
			MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_PATTERN_UV_OFF_V)) - 0.5f)
			* PatternUVOffset;
	}

	float2 P = Delta * UVScale;
	if (PatternIntrinsicOrientationEnabled != 0
		&& PatternOrientationField.Load(int3(Pixel, 0)) != 0)
	{
		const float2x2 IntrinsicRotation = MixtormatRotation90Matrix(1);
		P = mul(IntrinsicRotation, P);
		Orientation = mul(IntrinsicRotation, Orientation);
	}
	if (bPatternFlipU)
	{
		P.x = -P.x;
	}
	if (bPatternFlipV)
	{
		P.y = -P.y;
	}

	const float Angle = radians(AngleDegrees);
	const float CosA = cos(Angle);
	const float SinA = sin(Angle);
	P = float2(P.x * CosA - P.y * SinA, P.x * SinA + P.y * CosA);

	// The region's own flip and rotation, from the draws that just placed P -- the same seeded
	// randoms and the same post-orthogonal-snap Angle, not a second roll -- composed onto the
	// base orientation in the order the coordinate saw them: flip, then rotate, on the left of
	// what the base placement already did.
	const float2x2 PatternFlip = MixtormatFlipMatrix(
		bPatternFlipU ? 1u : 0u,
		bPatternFlipV ? 1u : 0u);
	const float2x2 PatternRotation = float2x2(CosA, -SinA, SinA, CosA);
	Orientation = mul(mul(PatternRotation, PatternFlip), Orientation);
	return frac(CentreSourceUV + P + RandomOffset + 1.0f);
}

float2 LayerSourceUV(float2 UV)
{
	float2x2 Orientation;
	return LayerSourceUVAndOrientation(UV, Orientation);
}

float SampleIncomingHeight(float2 UV)
{
	float2 SampleLayerUV = LayerSourceUV(UV);
	float PlacementMask = SamplePlacementHeightMask(UV);
	float SourceHeight = DirectHeightComparison != 0
		? (HasPackedHeight != 0
			? LayerRAM.SampleLevel(LinearWrapSampler, SampleLayerUV, 0.0f).a
			: ConstantHeight)
		: (HeightSource == 0
			? LayerRAM.SampleLevel(LinearWrapSampler, SampleLayerUV, 0.0f).a
			: (HeightSource == 1 ? PlacementMask : ConstantHeight));
	if (DirectHeightComparison == 0 && InvertHeight != 0)
	{
		SourceHeight = 1.0f - SourceHeight;
	}

	// Signed about the midpoint, and here rather than further down so every reader of this
	// layer's height sees the same boosted value -- the displacement, the blend comparison and
	// the normals derived from it. Height is stored centred on 0.5, so scaling the deviation
	// deepens pits exactly as much as it raises peaks and leaves the average level alone.
	SourceHeight = saturate((SourceHeight - 0.5f) * HeightBoost + 0.5f);
	if (DirectHeightComparison != 0)
	{
		return SourceHeight;
	}

	float ShapedHeight = saturate(
		((SourceHeight - HeightThreshold) * max(HeightContrast, 0.01f))
		+ 0.5f
		+ HeightOffset);
	return lerp(
		ShapedHeight,
		ShapedHeight * PlacementMask,
		saturate(MaskHeightInfluence));
}

float CalculateHeightDifference(float IncomingHeight, float ComparisonHeight)
{
	return IncomingHeight - ComparisonHeight + HeightBias;
}

// SmoothBase selects the blurred height, and only the contact and border fields pass it.
//
// That is the masking. Both fields are flat outside the band -- the contact field is
// 4*M*(1-M), which is zero once M has saturated, and the border height is a constant Lift times
// the same saturated field -- so a smoother base changes nothing outside the width and everything
// inside it. Coverage, the height the layer composites, and the blend weight all keep reading the
// sharp height, so nothing beyond these two effects moves.
float SampleHeightBlendFieldEx(float2 UV, float Softness, uint SmoothBase)
{
	const bool bSmooth = SmoothBase != 0 && BorderSmoothValid != 0;
	float BaseHeight = bSmooth
		? BorderBaseHeight.SampleLevel(LinearWrapSampler, UV, 0.0f)
		: (DirectHeightComparison != 0
			? PreviousHeight.SampleLevel(LinearWrapSampler, UV, 0.0f)
			: ReferenceHeight.SampleLevel(LinearWrapSampler, UV, 0.0f));
	if (DirectHeightComparison != 0 && InvertHeight != 0)
	{
		BaseHeight = 1.0f - BaseHeight;
	}
	float BlendHeight = SampleIncomingHeight(UV);
	float SafeSoftness = max(Softness, 1.0e-6f);
	if (DirectHeightComparison != 0)
	{
		// One height-derived mask must drive every composited surface channel.
		float A = BaseHeight + HeightBias;
		float B = BlendHeight + HeightOffset;
		float M = saturate(SamplePlacementHeightMask(UV) * GetHeightBlendAmount(UV));
		return smoothstep(
			HeightThreshold - SafeSoftness,
			HeightThreshold + SafeSoftness,
			M + B - A);
	}

	float Difference = CalculateHeightDifference(BlendHeight, BaseHeight);
	return smoothstep(-SafeSoftness, SafeSoftness, Difference);
}

float SampleHeightBlendField(float2 UV, float Softness)
{
	return SampleHeightBlendFieldEx(UV, Softness, 0);
}

float SampleContactField(float2 UV)
{
	float BlendMask = SampleHeightBlendFieldEx(UV, HeightContactAOWidth, 1);
	return 4.0f * BlendMask * (1.0f - BlendMask);
}

float SampleBorderHeight(float2 UV)
{
	return HeightBorderLift * SampleHeightBlendFieldEx(UV, HeightBorderWidth, 1);
}

float SampleBorderField(float2 UV, uint Contact)
{
	return Contact != 0 ? SampleContactField(UV) : SampleBorderHeight(UV);
}

// Plain central difference, one texel, exactly as it always was.
//
// This was briefly a Sobel measured across a radius, on the theory that differentiating over a
// wider baseline would low-pass the field. It does not: a derivative taken further apart reaches
// further into the noise rather than averaging it away, so widening it made the stipple coarser
// and more visible instead of removing it. The field has to be smooth *before* it is
// differentiated, which is what BorderBaseHeight is for.
float2 SampleBorderGradient(float2 UV, uint Contact)
{
	const float2 Texel = 1.0f / float2(OutputSize);
	const float L = SampleBorderField(UV - float2(Texel.x, 0.0f), Contact);
	const float Rt = SampleBorderField(UV + float2(Texel.x, 0.0f), Contact);
	const float D = SampleBorderField(UV - float2(0.0f, Texel.y), Contact);
	const float U = SampleBorderField(UV + float2(0.0f, Texel.y), Contact);
	return float2(Rt - L, U - D) * float2(OutputSize) * 0.5f;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	float2 UV = (float2(DispatchThreadId.xy) + 0.5f) / float2(OutputSize);
	float2x2 LayerOrientation;
	float2 LayerUV = LayerSourceUVAndOrientation(UV, LayerOrientation);

	// Read unconditionally. These used to fall back to inline constants when Initialize was
	// set, which is how the bottom layer seeded the stack; the compositor now clears the
	// substrate into these buffers before the first layer runs, so there is always something
	// real beneath and every layer reads it the same way.
	float4 PreviousBaseColor = PreviousBC.SampleLevel(LinearWrapSampler, UV, 0.0f);
	float3 PreviousNormal =
		DecodeNormal(PreviousN.SampleLevel(LinearWrapSampler, UV, 0.0f), 1.0f, 0);
	float4 PreviousPacked = PreviousRAM.SampleLevel(LinearWrapSampler, UV, 0.0f);
	float PreviousHeightValue = PreviousHeight.SampleLevel(LinearWrapSampler, UV, 0.0f);

	float4 SampledBaseColor = HasSurface != 0
		? LayerBC.SampleLevel(LinearWrapSampler, LayerUV, 0.0f)
		: float4(1.0f, 1.0f, 1.0f, 1.0f);
	float4 SampledRAM = HasSurface != 0
		? LayerRAM.SampleLevel(LinearWrapSampler, LayerUV, 0.0f)
		: float4(0.5f, 1.0f, 0.0f, 0.04f);
	float3 SampledNormal = HasNormal != 0
		? DecodeNormal(
			LayerN.SampleLevel(LinearWrapSampler, LayerUV, 0.0f),
			NormalIntensity,
			FlipNormalY)
		: float3(0.0f, 0.0f, 1.0f);

	// The decode leaves the normal in the *source* tangent basis; everything downstream -- the
	// reoriented blend, the effect normal, the border gradient -- works in the destination basis.
	// Rotating the sampling coordinate without rotating this vector is what left a bump pointing
	// the same way no matter how the layer was turned.
	//
	// After the decode so FlipNormalY keeps its meaning: that flag is the source map's green
	// convention and belongs in source space, ahead of the basis change. Before any blending so
	// BlendReorientedNormals sees two normals in one basis. A mirrored region needs no extra sign
	// here -- det(LayerOrientation) is already -1 and the transpose carries the mirror through.
	//
	// Z is untouched and the length of XY is preserved: LayerOrientation is orthonormal, so this
	// cannot change the normal's slope, only where it points.
	SampledNormal.xy = MixtormatTransformTangentVector(LayerOrientation, SampledNormal.xy);

	// Region variation before the layer grade, not after: the jitter says how this brick
	// differs from that one, the grade says what the whole layer is. Reversing them makes
	// the global grade fight per-region offsets it cannot see.
	float3 LayerBaseColor = AdjustHSV(ApplyRegionVariation(
		lerp(SampledBaseColor.rgb, FillColor.rgb, OverrideBaseColor), DispatchThreadId.xy));
	float LayerRoughness = lerp(AdjustRoughness(SampledRAM.r), FillRoughness, OverrideRoughness);
	float LayerAO = lerp(SampledRAM.g, 1.0f, IsFill);
	float LayerMetallic = lerp(SampledRAM.b, FillMetallic, OverrideMetallic);
	SampledNormal = lerp(SampledNormal, float3(0.0f, 0.0f, 1.0f), IsFill);

	float EffectKeep = 1.0f;
	float3 EffectNormal = float3(0.0f, 0.0f, 1.0f);
	float EffectAO = 1.0f;
	if (HasEffects != 0)
	{
		float4 SampledEffect = EffectData.SampleLevel(LinearWrapSampler, UV, 0.0f);
		EffectKeep = SampledEffect.r;
		EffectNormal = DecodeEffectNormal(SampledEffect.gb);
		EffectAO = SampledEffect.a;
	}

	float PlacementMask = SamplePlacementMask(UV);
	float IncomingHeight = SampleIncomingHeight(UV);

	float GeneratedFeatureMask = 1.0f;
	float FeatureWeight = 1.0f;
	if (FeatureInfluence > 0.0f || (WriteDebug != 0 && DebugMode == 1))
	{
		float Curvature;
		float Cavity;
		float Convex;
		MixtormatEvaluateCurvature(
			PreviousN,
			LinearWrapSampler,
			UV,
			OutputSize,
			CurvatureRadius,
			CurvatureSmoothing,
			CurvatureStrength,
			CurvaturePower,
			FlipNormalY,
			Curvature,
			Cavity,
			Convex);
		GeneratedFeatureMask = lerp(Cavity, Convex, FeatureBias);
		GeneratedFeatureMask = InvertFeature != 0
			? 1.0f - GeneratedFeatureMask
			: GeneratedFeatureMask;
		FeatureWeight = lerp(1.0f, GeneratedFeatureMask, saturate(FeatureInfluence));
	}

	float UnderlyingHeightMask = InvertHeightFeature != 0
		? 1.0f - PreviousHeightValue
		: PreviousHeightValue;
	float UnderlyingAOMask = InvertAOFeature != 0
		? 1.0f - PreviousPacked.g
		: PreviousPacked.g;
	float SurfaceMaskWeight = FeatureWeight
		* lerp(1.0f, saturate(UnderlyingHeightMask), saturate(HeightFeatureInfluence))
		* lerp(1.0f, saturate(UnderlyingAOMask), saturate(AOFeatureInfluence));
	uint UseHeightBlendMask = HeightBlendEnabled != 0
		&& DirectHeightComparison != 0
		&& NormalOnly == 0;
	float PlacementCoverage = UseHeightBlendMask != 0 ? 1.0f : PlacementMask;
	float ExistingCoverage = Enabled != 0
		? saturate(Opacity * PlacementCoverage * SurfaceMaskWeight * EffectKeep)
		: 0.0f;
	float HeightWeight = 1.0f;
	if ((HeightBlendEnabled != 0 || (WriteDebug != 0 && DebugMode == 2))
		&& NormalOnly == 0)
	{
		HeightWeight = SampleHeightBlendField(UV, HeightRange);
	}
	float HeightCoverage = DirectHeightComparison != 0
		? HeightWeight
		: lerp(1.0f, HeightWeight, saturate(GetHeightBlendAmount(UV)));
	float Alpha = saturate(ExistingCoverage * HeightCoverage);
	float Coat = CompositionMode != 0 ? 1.0f : 0.0f;
	float ReplaceWeight = Alpha * (1.0f - Coat);
	// Base colour is the one channel a coat only tints: the film is thin, so what is under it
	// still reads through. Every other channel comes across at full Alpha, coat or not -- a
	// coat layer is a surface sitting on top, and it brings its own metallic, AO, roughness and
	// F0 with it. Metallic in particular is not the film's property to deny: a clear coat over
	// metal is car paint, and MSM_ClearCoat carries the substrate and the film separately.
	float ColorWeight = saturate(ReplaceWeight + Alpha * Coat * 0.35f);
	float NormalWeight = Alpha * saturate(NormalInfluence);

	// The blend mode first, then coverage on top of it. The mode decides what colour this layer
	// *is* against what is under it; ColorWeight and BaseColorInfluence decide how much of that
	// lands, which is a different question and already has three controls answering it.
	//
	// At Normal the blend returns Incoming unchanged, so BlendAmount has nothing to fade between
	// and this line is bit-identical to what it was before the mode existed. That is what makes
	// the default safe on every material already saved.
	float3 BlendedBaseColor = MixtormatBlendColor(
		BaseColorBlendMode, PreviousBaseColor.rgb, LayerBaseColor);
	float3 IncomingBaseColor = saturate(
		lerp(LayerBaseColor, BlendedBaseColor, saturate(BaseColorBlendAmount)));

	float3 ResultBaseColor = NormalOnly != 0
		? PreviousBaseColor.rgb
		: lerp(PreviousBaseColor.rgb, IncomingBaseColor, ColorWeight * saturate(BaseColorInfluence));
	float ResultRoughness = NormalOnly != 0
		? PreviousPacked.r
		: lerp(PreviousPacked.r, LayerRoughness, Alpha * saturate(GetRoughnessInfluence(UV)));
	float ResultAO = NormalOnly != 0
		? PreviousPacked.g
		: lerp(PreviousPacked.g, LayerAO, Alpha * saturate(AOInfluence));
	float ResultMetallic = NormalOnly != 0
		? PreviousPacked.b
		: lerp(PreviousPacked.b, LayerMetallic, Alpha * saturate(MetallicInfluence));
	float ResultF0 = NormalOnly != 0
		? PreviousPacked.a
		: lerp(PreviousPacked.a, LayerF0, Alpha * saturate(F0Influence));
	float3 WeightedDetail = normalize(float3(
		SampledNormal.xy * NormalWeight,
		lerp(1.0f, SampledNormal.z, NormalWeight)));
	float3 CombinedNormal = BlendReorientedNormals(PreviousNormal, WeightedDetail);
	float3 OverriddenNormal = normalize(lerp(PreviousNormal, SampledNormal, NormalWeight));
	float3 LayerResultNormal = OverrideNormal != 0 ? OverriddenNormal : CombinedNormal;
	float HeightVisibility = DirectHeightComparison != 0
		? HeightWeight
		: lerp(1.0f, HeightWeight, saturate(GetHeightBlendAmount(UV)));
	float EffectVisibility = Enabled != 0 && HasEffects != 0
		? saturate(Opacity * FeatureWeight * HeightVisibility)
		: 0.0f;
	float EffectNormalVisibility = EffectVisibility * saturate(NormalInfluence);
	float3 WeightedEffectNormal = normalize(float3(
		EffectNormal.xy * EffectNormalVisibility,
		lerp(1.0f, EffectNormal.z, EffectNormalVisibility)));
	float3 ResultNormal = BlendReorientedNormals(LayerResultNormal, WeightedEffectNormal);
	ResultAO *= lerp(1.0f, EffectAO, EffectVisibility * saturate(AOInfluence));

	float HeightDetailVisibility = HeightBlendEnabled != 0
		&& NormalOnly == 0
		&& Enabled != 0
		? saturate(Opacity * SurfaceMaskWeight * HeightInfluence)
		: 0.0f;
	float ContactAOVisibility = HeightDetailVisibility * saturate(AOInfluence);
	float BorderNormalVisibility = HeightDetailVisibility * saturate(NormalInfluence);
	if (ContactAOVisibility > 0.0f && HeightContactAOAmount > 0.0f)
	{
		float ContactCenter = SampleContactField(UV);
		float2 ContactGradient = SampleBorderGradient(UV, 1);
		float Contact = saturate(max(
			ContactCenter,
			length(ContactGradient) * max(HeightContactAOWidth, 1.0e-4f)));
		float GeneratedAO = 1.0f - saturate(HeightContactAOAmount) * Contact;
		ResultAO *= lerp(1.0f, GeneratedAO, ContactAOVisibility);
	}
	if (BorderNormalVisibility > 0.0f
		&& abs(HeightBorderLift) > 1.0e-4f
		&& HeightBorderNormalStrength > 0.0f)
	{
		float2 BorderGradient = SampleBorderGradient(UV, 0);
		float3 BorderNormal = normalize(float3(
			-BorderGradient * HeightBorderNormalStrength,
			1.0f));
		float3 WeightedBorderNormal = normalize(float3(
			BorderNormal.xy * BorderNormalVisibility,
			lerp(1.0f, BorderNormal.z, BorderNormalVisibility)));
		ResultNormal = BlendReorientedNormals(ResultNormal, WeightedBorderNormal);
	}

	float ResultHeight = PreviousHeightValue;
	if (Enabled != 0 && NormalOnly == 0)
	{
		float LayerResultHeight = PreviousHeightValue;
		if (UseHeightBlendMask != 0)
		{
			float BaseHeight = InvertHeight != 0
				? 1.0f - PreviousHeightValue
				: PreviousHeightValue;
			float A = BaseHeight + HeightBias;
			float B = IncomingHeight + HeightOffset;
			LayerResultHeight = lerp(A, B, Alpha);
		}
		else
		{
			LayerResultHeight = lerp(PreviousHeightValue, IncomingHeight, Alpha);
		}
		ResultHeight = lerp(PreviousHeightValue, LayerResultHeight, saturate(HeightInfluence));
	}

	if (WriteDebug != 0)
	{
		float DebugValue = 0.0f;
		if (DebugMode == 1)
		{
			DebugValue = GeneratedFeatureMask;
		}
		else if (DebugMode == 2)
		{
			DebugValue = HeightWeight;
		}
		else if (DebugMode == 3)
		{
			DebugValue = SampleContactField(UV);
		}
		else if (DebugMode == 4)
		{
			const float2 BorderGradient = SampleBorderGradient(UV, 0);
			DebugValue = saturate(length(BorderGradient) * max(HeightBorderWidth, 1.0e-4f));
		}
		else if (DebugMode == 5)
		{
			DebugValue = DebugMask.SampleLevel(LinearWrapSampler, UV, 0.0f);
		}
		OutputDebug[DispatchThreadId.xy] = float4(MixtormatDebugRamp(DebugValue), 1.0f);
	}

	OutputBC[DispatchThreadId.xy] = float4(ResultBaseColor, 1.0f);
	OutputN[DispatchThreadId.xy] = float4(EncodeNormal(ResultNormal), 1.0f);
	OutputRAM[DispatchThreadId.xy] = float4(ResultRoughness, ResultAO, ResultMetallic, ResultF0);
	// Peel relief rides on top of the layer's own height so the lip and the coverage
	// boundary are derived from the same field, rather than the peel changing coverage
	// while the height silently reverted to whatever sat underneath.
	if (HasEffects != 0)
	{
		ResultHeight += EffectHeight.SampleLevel(LinearWrapSampler, UV, 0.0f) * EffectVisibility;
	}

	OutputHeight[DispatchThreadId.xy] = saturate(ResultHeight);
}
