#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGully.ush"

// One flow field, three isolated targets. SurfaceCS warps an owning layer's resolved input,
// MaskCS warps one mask before it joins the mask chain, and EffectCS warps one generated effect
// contribution before that contribution merges with earlier effects.

Texture2D<float4> SourceBC;
Texture2D<float4> SourceN;
Texture2D<float4> SourceRAM;
Texture2D<float> SourceHeight;
Texture2D<float> LayerMask;
Texture2D<float> SourceMask;
Texture2D<float4> SourceEffectData;
Texture2D<float4> PreviousEffectData;
Texture2D<float> PreviousEffectHeight;
SamplerState LinearWrapSampler;

RWTexture2D<float4> OutputBC;
RWTexture2D<float4> OutputN;
RWTexture2D<float4> OutputRAM;
RWTexture2D<float> OutputHeight;
RWTexture2D<float> OutputMask;
RWTexture2D<float4> OutputEffectData;

int2 OutputSize;
uint HasMask;
uint Initialize;
float Amount;
float EffectWeight;
// @param FlowWarpScale hardmin=1 hardmax=128
int Scale;
float Direction;
// @param FlowWarpSeed hardmin=0
uint Seed;
// @param FlowWarpMaskSlopeInfluence hardmin=0
float MaskSlopeInfluence;
// @param FlowWarpHeightSlopeInfluence hardmin=0
float HeightSlopeInfluence;
// @param FlowWarpDerivativeKernelX hardmin=1 hardmax=64
// @param FlowWarpDerivativeKernelY hardmin=1 hardmax=64
float2 DerivativeKernel;
uint BlendMode;

float2 RotateFlow(float2 Value)
{
	const float Radians = Direction * 0.017453292519943295f;
	float S;
	float C;
	sincos(Radians, S, C);
	return float2(C * Value.x - S * Value.y, S * Value.x + C * Value.y);
}

float SampleSlopeSource(float2 UV, uint Source)
{
	return Source == 0
		? LayerMask.SampleLevel(LinearWrapSampler, UV, 0.0f)
		: SourceHeight.SampleLevel(LinearWrapSampler, UV, 0.0f);
}

float2 DownhillSlope(float2 UV, uint Source)
{
	const float2 Radius = max(DerivativeKernel, 1.0f) / float2(OutputSize);
	const float2 X = float2(Radius.x, 0.0f);
	const float2 Y = float2(0.0f, Radius.y);
	const float Right = (
		SampleSlopeSource(UV + X - Y, Source)
		+ 2.0f * SampleSlopeSource(UV + X, Source)
		+ SampleSlopeSource(UV + X + Y, Source)) * 0.25f;
	const float Left = (
		SampleSlopeSource(UV - X - Y, Source)
		+ 2.0f * SampleSlopeSource(UV - X, Source)
		+ SampleSlopeSource(UV - X + Y, Source)) * 0.25f;
	const float Up = (
		SampleSlopeSource(UV - X + Y, Source)
		+ 2.0f * SampleSlopeSource(UV + Y, Source)
		+ SampleSlopeSource(UV + X + Y, Source)) * 0.25f;
	const float Down = (
		SampleSlopeSource(UV - X - Y, Source)
		+ 2.0f * SampleSlopeSource(UV - Y, Source)
		+ SampleSlopeSource(UV + X - Y, Source)) * 0.25f;
	const float2 Gradient = float2(Right - Left, Up - Down);
	const float GradientLength = length(Gradient);
	return GradientLength > 1.0e-5f ? -Gradient / GradientLength : 0.0f;
}

float2 WarpedCoordinate(float2 UV)
{
	const int Period = max(Scale, 1);
	float2 Flow = RotateFlow(MixtormatPeriodicCurlField(UV, Period, Seed));
	if (HasMask != 0 && MaskSlopeInfluence > 0.0f)
	{
		Flow += DownhillSlope(UV, 0) * MaskSlopeInfluence;
	}
	if (HeightSlopeInfluence > 0.0f)
	{
		Flow += DownhillSlope(UV, 1) * HeightSlopeInfluence;
	}
	Flow /= max(1.0f, length(Flow));
	return UV + Flow * Amount * (0.5f / (float)Period);
}

float WarpWeight(float2 UV)
{
	const float MaskWeight = HasMask != 0
		? saturate(LayerMask.SampleLevel(LinearWrapSampler, UV, 0.0f))
		: 1.0f;
	return MaskWeight * saturate(EffectWeight);
}

bool SelectWarped(float OriginalHeight, float WarpedHeight)
{
	if (BlendMode == 1)
	{
		return WarpedHeight < OriginalHeight;
	}
	if (BlendMode == 2)
	{
		return WarpedHeight > OriginalHeight;
	}
	return true;
}

float3 DecodeSurfaceNormal(float4 Encoded)
{
	return normalize(Encoded.xyz * 2.0f - 1.0f);
}

float3 DecodeEffectNormal(float4 EffectData)
{
	const float2 XY = EffectData.gb * 2.0f - 1.0f;
	return normalize(float3(XY, sqrt(saturate(1.0f - dot(XY, XY)))));
}

float3 TransformWarpedNormal(float2 UV, float3 SourceNormal)
{
	const float2 Texel = 1.0f / float2(OutputSize);
	const float2 Dx = float2(Texel.x, 0.0f);
	const float2 Dy = float2(0.0f, Texel.y);
	const float2 JWrtX =
		(WarpedCoordinate(UV + Dx) - WarpedCoordinate(UV - Dx)) / (2.0f * Texel.x);
	const float2 JWrtY =
		(WarpedCoordinate(UV + Dy) - WarpedCoordinate(UV - Dy)) / (2.0f * Texel.y);
	const float2 SourceSlope = -SourceNormal.xy / max(SourceNormal.z, 1.0e-4f);
	const float2 OutputSlope = float2(dot(SourceSlope, JWrtX), dot(SourceSlope, JWrtY));
	return normalize(float3(-OutputSlope, 1.0f));
}

float3 CombineEffectNormals(float3 BaseNormal, float3 DetailNormal)
{
	const float3 T = BaseNormal + float3(0.0f, 0.0f, 1.0f);
	const float3 U = DetailNormal * float3(-1.0f, -1.0f, 1.0f);
	return normalize(T * dot(T, U) / max(T.z, 1.0e-5f) - U);
}

[numthreads(8, 8, 1)]
void SurfaceCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 Pixel = int2(DispatchThreadId.xy);
	const float2 UV = (float2(Pixel) + 0.5f) / float2(OutputSize);
	const float2 WarpedUV = WarpedCoordinate(UV);
	const float Weight = WarpWeight(UV);
	const float4 OriginalBC = SourceBC.Load(int3(Pixel, 0));
	const float4 OriginalN = SourceN.Load(int3(Pixel, 0));
	const float4 OriginalRAM = SourceRAM.Load(int3(Pixel, 0));
	const float OriginalHeight = SourceHeight.Load(int3(Pixel, 0));
	const float4 WarpedBC = SourceBC.SampleLevel(LinearWrapSampler, WarpedUV, 0.0f);
	const float4 WarpedN = SourceN.SampleLevel(LinearWrapSampler, WarpedUV, 0.0f);
	const float4 WarpedRAM = SourceRAM.SampleLevel(LinearWrapSampler, WarpedUV, 0.0f);
	const float WarpedHeight = SourceHeight.SampleLevel(LinearWrapSampler, WarpedUV, 0.0f);
	const bool UseWarped = SelectWarped(OriginalHeight, WarpedHeight);
	const float3 OriginalNormal = DecodeSurfaceNormal(OriginalN);
	const float3 SelectedNormal = UseWarped
		? TransformWarpedNormal(UV, DecodeSurfaceNormal(WarpedN))
		: OriginalNormal;
	const float4 SelectedN = UseWarped ? WarpedN : OriginalN;

	OutputBC[Pixel] = lerp(OriginalBC, UseWarped ? WarpedBC : OriginalBC, Weight);
	OutputN[Pixel] = float4(
		normalize(lerp(OriginalNormal, SelectedNormal, Weight)) * 0.5f + 0.5f,
		lerp(OriginalN.a, SelectedN.a, Weight));
	OutputRAM[Pixel] = lerp(OriginalRAM, UseWarped ? WarpedRAM : OriginalRAM, Weight);
	OutputHeight[Pixel] = lerp(
		OriginalHeight, UseWarped ? WarpedHeight : OriginalHeight, Weight);
}

[numthreads(8, 8, 1)]
void MaskCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 Pixel = int2(DispatchThreadId.xy);
	const float2 UV = (float2(Pixel) + 0.5f) / float2(OutputSize);
	const float Original = SourceMask.Load(int3(Pixel, 0));
	const float Warped = SourceMask.SampleLevel(
		LinearWrapSampler, WarpedCoordinate(UV), 0.0f);
	const bool UseWarped = SelectWarped(Original, Warped);
	OutputMask[Pixel] = lerp(Original, UseWarped ? Warped : Original, WarpWeight(UV));
}

[numthreads(8, 8, 1)]
void EffectCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 Pixel = int2(DispatchThreadId.xy);
	const float2 UV = (float2(Pixel) + 0.5f) / float2(OutputSize);
	const float2 WarpedUV = WarpedCoordinate(UV);
	const float Weight = WarpWeight(UV);
	const float4 Original = SourceEffectData.Load(int3(Pixel, 0));
	const float OriginalHeight = SourceHeight.Load(int3(Pixel, 0));
	const float4 Warped = SourceEffectData.SampleLevel(
		LinearWrapSampler, WarpedUV, 0.0f);
	const float WarpedHeight = SourceHeight.SampleLevel(
		LinearWrapSampler, WarpedUV, 0.0f);
	const bool UseWarped = SelectWarped(OriginalHeight, WarpedHeight);
	const float3 OriginalNormal = DecodeEffectNormal(Original);
	const float3 SelectedNormal = UseWarped
		? TransformWarpedNormal(UV, DecodeEffectNormal(Warped))
		: OriginalNormal;
	const float4 Selected = UseWarped ? Warped : Original;
	const float3 ResultNormal = normalize(lerp(OriginalNormal, SelectedNormal, Weight));

	OutputEffectData[Pixel] = float4(
		lerp(Original.r, Selected.r, Weight),
		ResultNormal.xy * 0.5f + 0.5f,
		lerp(Original.a, Selected.a, Weight));
	OutputHeight[Pixel] = lerp(
		OriginalHeight, UseWarped ? WarpedHeight : OriginalHeight, Weight);
}

[numthreads(8, 8, 1)]
void EffectMergeCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 Pixel = int2(DispatchThreadId.xy);
	const float4 Local = SourceEffectData.Load(int3(Pixel, 0));
	const float LocalHeight = SourceHeight.Load(int3(Pixel, 0));
	const float4 Previous = Initialize != 0
		? float4(1.0f, 0.5f, 0.5f, 1.0f)
		: PreviousEffectData.Load(int3(Pixel, 0));
	const float PreviousHeight = Initialize != 0
		? 0.0f
		: PreviousEffectHeight.Load(int3(Pixel, 0));
	const float3 CombinedNormal = CombineEffectNormals(
		DecodeEffectNormal(Previous), DecodeEffectNormal(Local));

	OutputEffectData[Pixel] = float4(
		saturate(Previous.r * Local.r),
		CombinedNormal.xy * 0.5f + 0.5f,
		saturate(Previous.a * Local.a));
	OutputHeight[Pixel] = PreviousHeight + LocalHeight;
}
