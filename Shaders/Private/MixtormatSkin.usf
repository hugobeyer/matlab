float SkinFinite(float V) { return isfinite(V) ? V : 0.0f; }
float3 SkinFiniteRGB(float3 V)
{
	return max(float3(SkinFinite(V.x), SkinFinite(V.y), SkinFinite(V.z)), 0.0f);
}

float2 SkinPlacedUV(float2 UV)
{
	float2 P = MixtormatGeneratorUV(UV);
	// SurfaceTiling is a whole repeat, shared by tissue, drift, folds and material detail.
	// Keep coordinates lifted: frac here would corrupt finite-difference footprints.
	return ((0.5f + mul(MixtormatSourceOrientation(GeneratorUVFlipU, GeneratorUVFlipV,
		GeneratorUVRotation), P - 0.5f)) * GeneratorUVScale + GeneratorUVOffset) * SurfaceTiling;
}

float SkinFootprint(float2 DX, float2 DY)
{
	// Conservative major-axis bound of the pixel parallelogram, not width-only resolution.
	return max(length(DX + DY), length(DX - DY));
}

float SkinBandWeight(float Period, float Footprint)
{
	return 1.0f - smoothstep(0.35f, 0.9f, Period * Footprint);
}

// Integer frequencies come from cell counts/repeats. Guard float's exact-integer range before
// conversion; do not inherit Noise FBM's fixed 4096 octave cap as a Skin artist range.
int SkinLatticePeriod(float Frequency)
{
	if (!isfinite(Frequency) || Frequency < 1.0f || Frequency >= 16777216.0f) { return 0; }
	return int(Frequency);
}

float SkinNoise(float2 UV, float Frequency, uint Salt, float Footprint)
{
	int P = SkinLatticePeriod(Frequency);
	if (P == 0) { return 0.0f; }
	float AA = SkinBandWeight(float(P), Footprint);
	if (AA <= 0.0f) { return 0.0f; }
	return MixtormatNoiseValueD(frac(UV) * float(P), P, Seed + Salt).x * AA;
}

// Reference patch spans 3.4 units. Keep its relief-to-width proportions in the unit UV tile;
// HeightScale remains the artist's gain, not an implicit normalization to full displacement.
static const float SkinReferencePatchWidth = 3.4f;
static const float SkinTissueRelief = 0.065f / SkinReferencePatchWidth;
static const float SkinFoldRelief = 0.027f / SkinReferencePatchWidth;
static const float SkinWrinkleRelief = 0.007f / SkinReferencePatchWidth;
static const float SkinFineRelief = 0.0017f / SkinReferencePatchWidth;
static const float SkinPoreRelief = 0.001f / SkinReferencePatchWidth;
static const float SkinGrainRelief = 0.00032f / SkinReferencePatchWidth;
static const float SkinFineFrequencyRatio = 240.0f / 96.0f;


static const float SkinPigmentBasePeriod = 22.0f;
static const int SkinDriftSteps = 5;
static const float SkinDriftTravel = 0.34f;

float SkinPigmentMottling(float2 UV, float Footprint)
{
	// Independent gradient-noise bands, not the tissue lattice or a painted cavity shadow.
	// Integer periods preserve tiling; unresolved bands fade to the neutral midpoint.
	float Mottling = 0.0f;
	const float3 Weights = float3(0.2f, 0.5f, 0.3f);
	[unroll] for (int Band = 0; Band < 3; ++Band)
	{
		int Period = int(SkinPigmentBasePeriod) * (1 << Band);
		float AA = SkinBandWeight(float(Period), Footprint);
		if (AA > 0.0f)
		{
			float2 Q = frac(UV + float2(0.37f, 0.61f) * float(Band));
			float N = MixtormatPeriodicNoiseD(Q * float(Period), Period,
				Seed + 719u + uint(Band) * 101u).x * MIXTORMAT_NOISE_SQRT2;
			Mottling += Weights[Band] * N * AA;
		}
	}
	return clamp(Mottling, -1.0f, 1.0f);
}

float2 SkinAxis(float2 V)
{
	float L = dot(V, V);
	return L > 1.0e-12f && isfinite(L) ? V * rsqrt(L) : float2(1, 0);
}

float2 SkinAuthoredAxis()
{
	float A = Direction * (MIXTORMAT_NOISE_TAU / 360.0f);
	return float2(cos(A), sin(A));
}

// Derivatives are in placed UV units, not lattice units. AA is locally constant here.
float3 SkinNoiseD(float2 UV, float Frequency, uint Salt, float Footprint)
{
	int P = SkinLatticePeriod(round(Frequency));
	if (P == 0) { return 0.0f; }
	float AA = SkinBandWeight(float(P), Footprint);
	if (AA <= 0.0f) { return 0.0f; }
	return MixtormatNoiseValueD(frac(UV) * float(P), P, Seed + Salt)
		* float3(1.0f, float(P), float(P)) * AA;
}

float2 SkinDriftVelocity(float2 Q, float Frequency, uint Salt, float FP)
{
	float N = SkinNoise(Q, Frequency, Salt, FP);
	float M = SkinNoise(Q, Frequency * 2.0f, Salt + 31u, FP);
	float A = Direction * (MIXTORMAT_NOISE_TAU / 360.0f)
		+ DirectionVariation * (0.74f * N + 0.26f * M);
	float2 Along = float2(cos(A), sin(A));
	float2 Across = float2(-Along.y, Along.x);
	// Rotate VELOCITIES, never the periodic sampling lattice. Retain speed variation.
	return Along * (0.74f * N + 0.26f * M)
		+ Across * SkinNoise(Q, Frequency, Salt + 67u, FP) / sqrt(max(Elongation, 1.0f));
}

float2 SkinAdvect(float2 P, float FP)
{
	float2 Q = P;
	float Frequency = max(1.0f, round(float(TissueCells) * 0.43f * WarpScale));
	int Layers = max(WarpLayers, 0);
	float WeightSum = max(2.0f * (1.0f - exp2(-float(Layers))), 1.0f);
	[loop] for (int Layer = 0; Layer < Layers; ++Layer)
	{
		if (SkinLatticePeriod(Frequency) == 0 || SkinBandWeight(Frequency, FP) <= 0.0f) { break; }
		uint Salt = 811u + uint(Layer) * 137u;
		// Amount is travel in noise-cell spacings, not travel PER RK2 step/octave.
		// Normalized octave weights keep extra layers from multiplying the total budget.
		float LayerWeight = exp2(-float(Layer)) / WeightSum;
		float StepSize = SkinDriftTravel * MarbleDrift * LayerWeight / (float(SkinDriftSteps) * Frequency);
		[unroll] for (int Step = 0; Step < SkinDriftSteps; ++Step)
		{
			float2 V = SkinDriftVelocity(Q, Frequency, Salt, FP);
			Q += StepSize * SkinDriftVelocity(Q + 0.5f * StepSize * V, Frequency, Salt, FP);
		}
		Frequency *= 2.0f;
	}
	return Q;
}

// Compact ellipses: maximum radius < 1 and jitter <= .7 keep the 3x3 support complete.
// Cell-local rotations are safe; rotating the whole periodic coordinate lattice is not.
float SkinFat(float2 UV, float Frequency, float Footprint, uint Salt)
{
	int P = SkinLatticePeriod(Frequency);
	if (P == 0) { return 0.0f; }
	float AA = SkinBandWeight(float(P), Footprint);
	if (AA <= 0.0f) { return 0.0f; }
	float2 Q = frac(UV) * float(P);
	int2 Base = int2(floor(Q));
	float Radius = lerp(0.52f, 0.94f, saturate(Softness));
	float Sum = 0.0f;
	[unroll] for (int Y = -1; Y <= 1; ++Y)
	{
		[unroll] for (int X = -1; X <= 1; ++X)
		{
			int2 Cell = Base + int2(X, Y);
			uint H = MixtormatCellHash(Cell, P, Seed + Salt);
			float R = MixtormatCellRandom01(H);
			float R2 = MixtormatCellRandom01(MixtormatHashU(H));
			float R3 = MixtormatCellRandom01(MixtormatHashU(H + 71u));
			float A = MIXTORMAT_NOISE_TAU * R2;
			float2 Axis = float2(cos(A), sin(A));
			float2 D = Q - MixtormatCellPoint(Cell, P, Seed + Salt, 0.7f);
			float2 E = float2(dot(D, Axis), dot(D, float2(-Axis.y, Axis.x)))
				/ (Radius * float2(1.0f, lerp(0.55f, 0.85f, R3)));
			float Kernel = saturate(1.0f - dot(E, E));
			Sum += Kernel * Kernel * Kernel * lerp(0.7f, 1.3f, R);
		}
	}
	// Ensemble mean only; this is not a per-tile mean reduction.
	return (Sum - 0.785398163f * Radius * Radius * 0.7f) * AA;
}

// Use the coarser dispatch/final footprint, retaining each axis' spacing.
// Tissue, analytic seed and microdetail dispatch at full output resolution.
float2 SkinDispatchTexel()
{
	return max(1.0f / float2(max(OutputSize, int2(1, 1))),
		1.0f / float2(max(FinalOutputSize, int2(1, 1))));
}

float2 SkinAdvectedUV(float2 UV)
{
	// Offsets wrap normally. Lifted absolute coordinates would interpolate across a false seam.
	return SkinPlacedUV(UV) + TissueState.SampleLevel(LinearWrapSampler, UV, 0).gb;
}

struct FSkinFrame
{
	float2 Q;
	float2 DX;
	float2 DY;
	float2 JX;
	float2 JY;
	float FP;
};

FSkinFrame SkinFrame(float2 UV)
{
	FSkinFrame F;
	float2 E = SkinDispatchTexel();
	F.Q = SkinAdvectedUV(UV);
	float2 XP = SkinAdvectedUV(UV + float2(E.x, 0)) - F.Q;
	float2 XM = F.Q - SkinAdvectedUV(UV - float2(E.x, 0));
	float2 YP = SkinAdvectedUV(UV + float2(0, E.y)) - F.Q;
	float2 YM = F.Q - SkinAdvectedUV(UV - float2(0, E.y));
	F.DX = dot(XP, XP) > dot(XM, XM) ? XP : XM;
	F.DY = dot(YP, YP) > dot(YM, YM) ? YP : YM;
	F.JX = 0.5f * (XP + XM) / E.x;
	F.JY = 0.5f * (YP + YM) / E.y;
	F.FP = SkinFootprint(F.DX, F.DY);
	return F;
}

// Integer wavevectors close on the unit torus for EVERY direction setting.
// Angular quantization at low frequencies is intentional, unlike rotation followed by frac.
float2 SkinWavevector(float2 Axis, float Frequency)
{
	float2 K = round(Axis * max(Frequency, 1.0f));
	if (dot(K, K) < 0.5f)
	{
		K = abs(Axis.x) >= abs(Axis.y) ? float2(Axis.x >= 0.0f ? 1.0f : -1.0f, 0)
			: float2(0, Axis.y >= 0.0f ? 1.0f : -1.0f);
	}
	return K;
}

float SkinMarblePhase(float2 Q, float Frequency, float2 Axis, uint Salt, float FP, out float2 Gradient)
{
	float Stretch = sqrt(max(Elongation, 1.0f));
	float2 K = SkinWavevector(float2(-Axis.y, Axis.x), Frequency / Stretch);
	float2 Along = SkinWavevector(Axis, Frequency / (3.0f * Stretch * Stretch));
	float3 Low = SkinNoiseD(Q, max(1.0f, round(Frequency * 0.13f * WarpScale / Stretch)), Salt, FP);
	float3 High = SkinNoiseD(Q, max(1.0f, round(Frequency * 0.39f * WarpScale / Stretch)), Salt + 43u, FP);
	float PhaseOffset = MixtormatCellRandom01(MixtormatHashU(Seed + Salt));
	float WalkPhase = MIXTORMAT_NOISE_TAU * (dot(Along, frac(Q)) + PhaseOffset);
	float Walk = 0.14f * DirectionVariation;
	// Domain advection owns travel. Direct phase noise adds bounded irregularity,
	// rather than applying the full drift amount a second time in every fold family.
	float PhaseWander = SkinDriftTravel * max(MarbleDrift, 0.0f) / (1.0f + 0.25f * max(MarbleDrift, 0.0f));
	Gradient = K + PhaseWander * (0.84f * Low.yz + 0.16f * High.yz)
		+ Walk * MIXTORMAT_NOISE_TAU * cos(WalkPhase) * Along;
	return dot(K, frac(Q)) + PhaseOffset + PhaseWander * (0.84f * Low.x + 0.16f * High.x)
		+ Walk * sin(WalkPhase);
}

// Signed valley plus lifted shoulders. Gaussian width/area compensation approximates
// pixel integration; core and shoulder are filtered separately, never clamped to a mask.
float2 SkinCreaseSection(float Distance, float Width, float Variance)
{
	float W = max(Width, 1.0e-6f);
	float CoreW = sqrt(W * W + Variance);
	float OuterW = sqrt(4.84f * W * W + Variance);
	float Core = exp(-0.5f * (Distance / CoreW) * (Distance / CoreW)) * W / CoreW;
	float Outer = exp(-0.5f * (Distance / OuterW) * (Distance / OuterW)) * (2.2f * W / OuterW);
	return float2(-Core + 0.75f * max(Fullness, 0.0f) * max(Outer - Core, 0.0f), Core);
}

// Bounded, area-preserving local metrics steer the periodic cell network without
// rotating absolute UVs or quantizing a spatially varying wavevector.
static const float SkinMicroAnisotropy = 0.5f;
static const float SkinPoreAlignment = 0.35f;
static const float SkinPoreStrainStretch = 0.25f;

float2 SkinCellNetwork(float2 UV, float Frequency, float Width, float2 DX, float2 DY,
	float2 Tangent, float Stretch, uint Salt, out float2 Gradient)
{
	Gradient = 0.0f;
	int P = SkinLatticePeriod(Frequency);
	if (P == 0 || Width <= 0.0f) { return 0.0f; }
	float2 Across = float2(-Tangent.y, Tangent.x);
	float2 MetricDX = float2(dot(DX, Tangent) / Stretch, dot(DX, Across) * Stretch);
	float2 MetricDY = float2(dot(DY, Tangent) / Stretch, dot(DY, Across) * Stretch);
	float FP = SkinFootprint(MetricDX, MetricDY) * float(P);
	float AA = SkinBandWeight(1.0f, FP);
	if (AA <= 0.0f) { return 0.0f; }
	float2 Q = frac(UV) * float(P);
	int2 Base = int2(floor(Q));
	float First = 1.0e10f, Second = 1.0e10f;
	float2 D1 = 0.0f, D2 = 0.0f;
	// F2 joins at triple junctions. The extra ring covers the bounded strained metric.
	int Reach = Stretch > 1.0f ? 3 : 2;
	[loop] for (int Y = -Reach; Y <= Reach; ++Y)
	{
		[loop] for (int X = -Reach; X <= Reach; ++X)
		{
			float2 Offset = Q - MixtormatCellPoint(Base + int2(X, Y), P, Seed + Salt, 0.7f);
			float2 D = float2(dot(Offset, Tangent) / Stretch, dot(Offset, Across) * Stretch);
			float R = dot(D, D);
			if (R < First) { Second = First; D2 = D1; First = R; D1 = D; }
			else if (R < Second) { Second = R; D2 = D; }
		}
	}
	float F1 = sqrt(First), F2 = sqrt(Second);
	float2 MetricGradient = D2 / max(F2, 1.0e-6f) - D1 / max(F1, 1.0e-6f);
	Gradient = float(P) * (Tangent * MetricGradient.x / Stretch + Across * MetricGradient.y * Stretch);
	float2 Projected = float2(dot(Gradient, DX), dot(Gradient, DY));
	return SkinCreaseSection(max(F2 - F1, 0.0f), Width, dot(Projected, Projected) / 12.0f) * AA;
}

float2 SkinCellBranches(float2 UV, float Frequency, float Width, float2 DX, float2 DY,
	uint Salt, out float2 Gradient)
{
	return SkinCellNetwork(UV, Frequency, Width, DX, DY, float2(1, 0), 1.0f, Salt, Gradient);
}

float2 SkinFoldFamily(float2 UV, float Frequency, float2 Axis, float Width,
	float2 DX, float2 DY, uint Salt, out float2 Gradient)
{
	Gradient = float2(-Axis.y, Axis.x);
	int P = SkinLatticePeriod(round(Frequency));
	if (P == 0 || Width <= 0.0f) { return 0.0f; }
	float FP = SkinFootprint(DX, DY);
	float Phase = SkinMarblePhase(UV, float(P), Axis, Salt, FP, Gradient);
	float2 PhasePixel = float2(dot(Gradient, DX), dot(Gradient, DY));
	float AA = SkinBandWeight(1.0f, length(PhasePixel));
	float Taper = 0.5f + 0.5f * SkinNoise(UV, max(1.0f, round(float(P) * 0.17f)), Salt + 79u, FP);
	float W = Width * lerp(0.58f, 1.32f, Taper);
	// The squared chord is smooth and periodic even at the far side of a crease.
	// Positive taper never terminates a path in a cell-sized stamp.
	float Distance = sin(0.5f * MIXTORMAT_NOISE_TAU * (frac(Phase) - 0.5f))
		/ (0.5f * MIXTORMAT_NOISE_TAU);
	float2 Marble = SkinCreaseSection(Distance, W, dot(PhasePixel, PhasePixel) / 12.0f)
		* lerp(0.16f, 1.0f, smoothstep(0.18f, 0.73f, Taper)) * AA;
	if (Cellular > 0.0f)
	{
		float2 CellGradient;
		float2 Branch = SkinCellBranches(UV, float(P), Width, DX, DY, Salt + 103u, CellGradient);
		// Blend normal DIRECTORS, not signed vectors, including at cellular junctions.
		float2 A = SkinAxis(Gradient), B = SkinAxis(CellGradient);
		if (dot(A, B) < 0.0f) { B = -B; }
		Gradient = SkinAxis(lerp(A, B, saturate(Cellular))) * max(length(Gradient), 1.0f);
		Marble = lerp(Marble, Branch, saturate(Cellular));
	}
	return Marble;
}

float SkinCreases(float2 UV, float Frequency, float2 Axis, float Width,
	float2 DX, float2 DY, uint Salt)
{
	float2 Gradient;
	return SkinFoldFamily(UV, Frequency, Axis, Width, DX, DY, Salt, Gradient).x;
}

// Retain the helper signature; only constant family axes may determine integer wavevectors.
// Spatially varying substrate directors steer strain in SeedCS, not a quantized local lattice.
float SkinAlignedCreases(float2 UV, float Frequency, float2 Authored, float2 Measured,
	float Confidence, float Width, float2 DX, float2 DY, uint Salt)
{
	return lerp(SkinCreases(UV, Frequency, Authored, Width, DX, DY, Salt),
		SkinCreases(UV, Frequency, Measured, Width, DX, DY, Salt), saturate(Confidence));
}

static const float SkinPoreRadius = 0.12f;
static const float SkinPoreOuterVariance = 2.5f;
static const float SkinPoreSupport = 3.0f;

float SkinPoreGaussian(float2 E, float2 Radii2, float3 PixelCovariance)
{
	float2 Diagonal = Radii2 + PixelCovariance.xy;
	float OffDiagonal = PixelCovariance.z;
	float Determinant = max(Diagonal.x * Diagonal.y - OffDiagonal * OffDiagonal, 1.0e-12f);
	float Distance2 = max((Diagonal.y * E.x * E.x + Diagonal.x * E.y * E.y
		- 2.0f * OffDiagonal * E.x * E.y) / Determinant, 0.0f);
	// Convolve the ellipse with the pixel covariance, preserving its integrated area.
	// The conservative major-axis footprint is for lattice AA, NOT variance on both axes.
	float Area = sqrt(Radii2.x * Radii2.y / Determinant);
	float Envelope = 1.0f - smoothstep(6.25f, SkinPoreSupport * SkinPoreSupport, Distance2);
	return exp(-0.5f * Distance2) * Area * Envelope;
}

float2 SkinPores(float2 UV, float Frequency, float2 DX, float2 DY,
	float2 StrainTangent, float Load, float TensionStrain)
{
	int P = SkinLatticePeriod(Frequency);
	if (P == 0) { return 0.0f; }
	DX *= float(P);
	DY *= float(P);
	float AA = SkinBandWeight(1.0f, SkinFootprint(DX, DY));
	if (AA <= 0.0f) { return 0.0f; }
	float2 Q = frac(UV) * float(P);
	int2 Base = int2(floor(Q));
	float2 Sum = 0.0f;
	float Variation = max(PoreVariation, 0.0f);
	float Stretch = sqrt(1.0f + SkinPoreStrainStretch * max(TensionStrain, 0.0f));
	float Alignment = saturate(SkinPoreAlignment * max(max(Load, TensionStrain), 0.0f));
	float2 StrainDirector = float2(StrainTangent.x * StrainTangent.x - StrainTangent.y * StrainTangent.y,
		2.0f * StrainTangent.x * StrainTangent.y);
	float MaxRadius = SkinPoreRadius * PoreSize * max(0.1f, lerp(1.0f, 1.65f, Variation)) * Stretch;
	float PixelVariance = (dot(DX, DX) + dot(DY, DY)) / 12.0f;
	// Size changes support, never cell density. Include the complete filtered ellipse
	// and jittered neighbouring centres, bounded for GPU loop safety.
	int Reach = clamp(int(floor(SkinPoreSupport * sqrt(MaxRadius * MaxRadius * SkinPoreOuterVariance
		+ PixelVariance) + 0.85f)), 1, 6);
	[loop] for (int Y = -Reach; Y <= Reach; ++Y)
	{
		[loop] for (int X = -Reach; X <= Reach; ++X)
		{
			int2 Cell = Base + int2(X, Y);
			uint H = MixtormatCellHash(Cell, P, Seed + 503u);
			float R = MixtormatCellRandom01(H);
			float R2 = MixtormatCellRandom01(MixtormatHashU(H));
			float A = MIXTORMAT_NOISE_TAU * R2;
			// Bias unoriented axes, retaining cell randomness without a signed-angle seam.
			float2 Director = lerp(float2(cos(2.0f * A), sin(2.0f * A)), StrainDirector, Alignment);
			A = 0.5f * atan2(Director.y, Director.x);
			float2 Axis = float2(cos(A), sin(A));
			float2 Across = float2(-Axis.y, Axis.x);
			float2 D = Q - MixtormatCellPoint(Cell, P, Seed + 503u, 0.7f);
			float2 E = float2(dot(D, Axis), dot(D, Across));
			float Radius = SkinPoreRadius * PoreSize * max(0.1f, lerp(1.0f, lerp(0.55f, 1.65f, R), Variation));
			float2 Radii = Radius * float2(Stretch, max(0.2f, lerp(1.0f, 0.6f + 0.35f * R2, Variation)) / Stretch);
			float2 LocalDX = float2(dot(DX, Axis), dot(DX, Across));
			float2 LocalDY = float2(dot(DY, Axis), dot(DY, Across));
			float3 Covariance = float3(LocalDX.x * LocalDX.x + LocalDY.x * LocalDY.x,
				LocalDX.y * LocalDX.y + LocalDY.y * LocalDY.y,
				LocalDX.x * LocalDX.y + LocalDY.x * LocalDY.y) / 12.0f;
			float2 Core2 = Radii * Radii;
			float Core = SkinPoreGaussian(E, Core2, Covariance);
			float Outer = SkinPoreGaussian(E, Core2 * SkinPoreOuterVariance, Covariance);
			float Depth = max(0.0f, lerp(1.0f, lerp(0.5f, 1.35f, R), Variation));
			Sum += float2(Core, max(Outer - Core, 0.0f)) * Depth;
		}
	}
	return Sum * AA;
}

#if SKIN_STAGE == 0
[numthreads(8, 8, 1)]
void TissueCS(uint3 DTid : SV_DispatchThreadID)
{
	int2 Pixel = int2(DTid.xy);
	if (any(Pixel >= OutputSize)) { return; }
	float2 UV = (float2(Pixel) + 0.5f) / float2(OutputSize);
	float2 E = SkinDispatchTexel();
	float2 P = SkinPlacedUV(UV);
	float2 PX = SkinPlacedUV(UV + float2(E.x, 0)), MX = SkinPlacedUV(UV - float2(E.x, 0));
	float2 PY = SkinPlacedUV(UV + float2(0, E.y)), MY = SkinPlacedUV(UV - float2(0, E.y));
	float2 DX = length(PX - P) > length(P - MX) ? PX - P : P - MX;
	float2 DY = length(PY - P) > length(P - MY) ? PY - P : P - MY;
	float FP = SkinFootprint(DX, DY);
	float2 Q = SkinAdvect(P, FP);
	float2 XP = SkinAdvect(PX, FP) - Q, XM = Q - SkinAdvect(MX, FP);
	float2 YP = SkinAdvect(PY, FP) - Q, YM = Q - SkinAdvect(MY, FP);
	DX = dot(XP, XP) > dot(XM, XM) ? XP : XM;
	DY = dot(YP, YP) > dot(YM, YM) ? YP : YM;
	FP = SkinFootprint(DX, DY);
	// Gravity stretch: elongate the fat domain along gravity before sampling,
	// so lobes become long strokes instead of round bumps.
	float2 GravDir = float2(cos(radians(GravityAngle)), sin(radians(GravityAngle)));
	float GravStretch = 1.0f + max(GravityBulge, 0.0f) * 1.5f + max(Elongation - 1.0f, 0.0f) * 0.15f;
	float2 QFat = Q - GravDir * (dot(Q - 0.5f, GravDir) * (1.0f - 1.0f / GravStretch));
	// Multi-scale fat: large strokes (half frequency) carry the silhouette,
	// primary cells add body, fine cells only modulate.
	float Fat = 0.42f * SkinFat(QFat, max(1.0f, round(float(TissueCells) * 0.5f)), FP, 89u)
		+ 0.40f * SkinFat(QFat, float(TissueCells), FP, 101u)
		+ 0.18f * SkinFat(QFat, max(1.0f, round(float(TissueCells) * 1.83f)), FP, 137u);
	// Upstream composite drives tissue: curved substrate thickens and raises
	// fat locally instead of the tissue ignoring the height below.
	float4 Substrate = SubstrateAnalysis.SampleLevel(LinearWrapSampler, UV, 0);
	float SubstrateCue = saturate(length(Substrate.xyz) * 0.5f) * saturate(Substrate.w)
		* max(CurvatureStrength, 0.0f) * max(TissueCoupling, 0.0f);
	float Thickness = max(0.2f, 1.0f + 0.4f * max(ThicknessVariation, 0.0f)
		* SkinNoise(Q, max(1.0f, round(float(TissueCells) * 0.61f)), 173u, FP));
	Thickness *= 1.0f + 0.6f * SubstrateCue;
	Fat *= 0.8f + 0.45f * SubstrateCue;
	float Height = SkinTissueRelief * max(Fullness, 0.0f) * max(0.1f, lerp(0.55f, 1.0f, Softness)) * Fat * Thickness;
	// Gravity bulge: tissue transported downslope thickens where it pools.
	if (GravityBulge > 0.001f)
	{
		float Sag = GravityBulge * 0.15f / max(float(TissueCells), 1.0f);
		float FatDown = 0.42f * SkinFat(QFat + GravDir * Sag, max(1.0f, round(float(TissueCells) * 0.5f)), FP, 89u)
			+ 0.40f * SkinFat(QFat + GravDir * Sag, float(TissueCells), FP, 101u)
			+ 0.18f * SkinFat(QFat + GravDir * Sag, max(1.0f, round(float(TissueCells) * 1.83f)), FP, 137u);
		float Pooling = saturate(FatDown - Fat);
		Height += SkinTissueRelief * max(Fullness, 0.0f) * Pooling * GravityBulge * 0.8f * Thickness;
		Thickness *= 1.0f + GravityBulge * 0.45f * Pooling;
	}
	// R: unit destination-UV relief. GB: PERIODIC displacement relative to SkinPlacedUV.
	// A: positive, neutral-at-one thickness factor. Never HeightScale or Amount here.
	OutTissue[Pixel] = float4(SkinFinite(Height), Q - P, Thickness);
}

#elif SKIN_STAGE == 1
float3 SkinTissueHessian(float2 UV, FSkinFrame F)
{
	uint W, H;
	TissueState.GetDimensions(W, H);
	float2 Rate = max(float(TissueCells) * float2(length(F.JX), length(F.JY)), 1.0f);
	float2 E = max(1.0f / float2(W, H), 0.045f / Rate);
	float C = TissueState.SampleLevel(LinearWrapSampler, UV, 0).r;
	float L = TissueState.SampleLevel(LinearWrapSampler, UV - float2(E.x, 0), 0).r;
	float R = TissueState.SampleLevel(LinearWrapSampler, UV + float2(E.x, 0), 0).r;
	float B = TissueState.SampleLevel(LinearWrapSampler, UV - float2(0, E.y), 0).r;
	float T = TissueState.SampleLevel(LinearWrapSampler, UV + float2(0, E.y), 0).r;
	float LB = TissueState.SampleLevel(LinearWrapSampler, UV - E, 0).r;
	float RT = TissueState.SampleLevel(LinearWrapSampler, UV + E, 0).r;
	float LT = TissueState.SampleLevel(LinearWrapSampler, UV + float2(-E.x, E.y), 0).r;
	float RB = TissueState.SampleLevel(LinearWrapSampler, UV + float2(E.x, -E.y), 0).r;
	float3 K = float3((R - C) + (L - C), (T - C) + (B - C), 0.25f * ((RT - LT) - (RB - LB)))
		/ float3(E.x * E.x, E.y * E.y, E.x * E.y);
	// ONE scalar normalization preserves destination-space Hessian eigendirections.
	K /= max(SkinTissueRelief * 0.5f * dot(Rate, Rate), 1.0e-6f);
	return all(isfinite(K)) ? K : 0.0f;
}

[numthreads(8, 8, 1)]
void SeedCS(uint3 DTid : SV_DispatchThreadID)
{
	int2 Pixel = int2(DTid.xy);
	if (any(Pixel >= OutputSize)) { return; }
	float2 UV = (float2(Pixel) + 0.5f) / float2(OutputSize);
	FSkinFrame F = SkinFrame(UV);
	float4 Tissue = TissueState.SampleLevel(LinearWrapSampler, UV, 0);
	// Substrate analysis is canonical-height geometry; tissue/seed relief stays in UV units.
	float4 Analysis = SubstrateAnalysis.SampleLevel(LinearWrapSampler, UV, 0);
	if (!all(isfinite(Analysis))) { Analysis = 0.0f; }
	float Coupling = max(TissueCoupling, 0.0f);
	float3 K = SkinTissueHessian(UV, F) * Coupling
		+ Analysis.xyz * saturate(Analysis.w) * max(CurvatureStrength, 0.0f);
	float2 Deviator = float2(K.x - K.y, 2.0f * K.z);
	float Anisotropy = length(Deviator);
	float Largest = 0.5f * (K.x + K.y + Anisotropy);
	float Gathered = smoothstep(0.12f, 2.8f, Largest);
	float Crown = smoothstep(0.1f, 2.0f, -Largest);
	float AuthoredCompression = max(Compression, 0.0f);
	float AuthoredTension = max(Tension, 0.0f);
	float Load = max(0.0f, AuthoredCompression + Gathered * max(1.0f - AuthoredCompression, 0.0f) - Crown * AuthoredTension);
	float Stretch = max(0.0f, AuthoredTension + Crown * max(1.0f - AuthoredTension, 0.0f));
	float2 Axis = SkinAuthoredAxis();
	float2 BroadGradient, CrossGradient;
	float2 Broad = SkinFoldFamily(F.Q, float(FoldCells), Axis, FoldWidth, F.DX, F.DY, 211u, BroadGradient);
	float2 Cross = 0.0f;
	if (Crossing > 0.0f)
	{
		Cross = SkinFoldFamily(F.Q, float(FoldCells), float2(-Axis.y, Axis.x),
			FoldWidth * 0.65f, F.DX, F.DY, 293u, CrossGradient);
	}
	float CrownRelax = 1.0f / (1.0f + 2.5f * Stretch);
	// Medium detail belongs exclusively to MicroCS, not the broad/cross-fold solver rest.
	float Residual = Tissue.a * Load * CrownRelax * SkinFoldRelief * FoldDepth
		* (Broad.x + max(Crossing, 0.0f) * Cross.x);
	// A fold normal is a covector: destination normal = J^T * authored/warped normal.
	// The Jacobian includes placement, lifted PreUV and sampled periodic drift; no inverse.
	float2 Normal = SkinAxis(float2(dot(BroadGradient, F.JX), dot(BroadGradient, F.JY)));
	float2 Director = float2(Normal.x * Normal.x - Normal.y * Normal.y, 2.0f * Normal.x * Normal.y);
	float Confidence = Anisotropy / (abs(K.x + K.y) + Anisotropy + 1.0e-6f)
		* smoothstep(0.002f, 0.04f, Anisotropy);
	float2 MeasuredDirector = Deviator / max(Anisotropy, 1.0e-6f);
	float CurvatureCoupling = saturate(Analysis.w) * max(CurvatureStrength, 0.0f);
	float2 Blended = lerp(Director, MeasuredDirector, saturate(Confidence * max(Coupling, CurvatureCoupling)));
	// At isotropy or opposing directors retain the authored normal, never atan2(0,0).
	if (dot(Blended, Blended) < 1.0e-8f) { Blended = Director; }
	float NormalAngle = 0.5f * atan2(Blended.y, Blended.x);
	OutSeed[Pixel] = float4(SkinFinite(Residual), Load, Stretch, NormalAngle);
}

#elif SKIN_STAGE == 3
float2 SkinStrainNormal(float2 UV);

// Evaluated once per full-resolution texel, never from the final filtering stencil.
// The cached residual includes medium folds, which are strained but NOT solver-simulated.
float4 SkinFineResidual(float2 UV)
{
	FSkinFrame F = SkinFrame(UV);
	float4 Strain = SeedState.SampleLevel(LinearWrapSampler, UV, 0);
	float Thickness = TissueState.SampleLevel(LinearWrapSampler, UV, 0).a;
	float DetailPeriod = float(DetailCells) * float(DetailTiling);
	float PorePeriod = float(PoreCells) * float(DetailTiling);
	float2 Axis = SkinAuthoredAxis();
	float2 Normal = SkinStrainNormal(UV);
	float2 DestinationTangent = float2(-Normal.y, Normal.x);
	// Seed directors live in destination UV. Push the tangent into the advected domain.
	float2 Tangent = SkinAxis(F.JX * DestinationTangent.x + F.JY * DestinationTangent.y);
	float NetworkStretch = sqrt(1.0f + SkinMicroAnisotropy * max(Strain.g, 0.0f) / (1.0f + max(Strain.b, 0.0f)));
	float2 NetworkGradient;
	float Medium = SkinCellNetwork(F.Q, DetailPeriod, FoldWidth * 0.72f, F.DX, F.DY,
		Tangent, NetworkStretch, 379u, NetworkGradient).x;
	float Coupling = max(TissueCoupling, 0.0f);
	float BroadCue = 0.0f;
	if (Coupling > 0.0f)
	{
		float2 BroadGradient;
		// Broad is an amplitude cue only; its height belongs to SeedState + solver correction.
		BroadCue = SkinFoldFamily(F.Q, float(FoldCells), Axis, FoldWidth,
			F.DX, F.DY, 211u, BroadGradient).y;
	}
	// The full-resolution seed exposes compression, not the pre-load Gathered proxy.
	// Use that shared strain state to drive the relocated medium band's amplitude.
	float MediumGain = max(0.0f, lerp(1.0f, 0.3f + 1.35f * Strain.g + 0.55f * BroadCue, Coupling));
	float CrownRelax = 1.0f / (1.0f + 2.5f * max(Strain.b, 0.0f));
	Medium *= max(Strain.g, 0.0f) * CrownRelax * MediumGain;
	float Fine = 0.0f;
	if (Cellular > 0.01f)
	{
		Fine = SkinCellNetwork(F.Q, round(DetailPeriod * SkinFineFrequencyRatio),
			FoldWidth * 0.5f, F.DX, F.DY, Tangent, NetworkStretch, 431u, NetworkGradient).x
			* max(Strain.g, 0.0f) * CrownRelax
			* max(0.0f, 0.5f + 0.5f * max(Crossing, 0.0f)) * saturate(Cellular * 2.0f);
	}
	// Periodic pore-domain distortion, with its Jacobian included in the footprint.
	float DistortPeriod = max(1.0f, round(PorePeriod * 0.23f));
	float3 NX = SkinNoiseD(F.Q, DistortPeriod, 547u, F.FP);
	float3 NY = SkinNoiseD(F.Q, DistortPeriod, 571u, F.FP);
	float Gain = 0.35f * max(PoreVariation, 0.0f) / max(PorePeriod, 1.0f);
	float2 PoreUV = F.Q + Gain * float2(NX.x, NY.x);
	float2 PDX = F.DX + Gain * float2(dot(NX.yz, F.DX), dot(NY.yz, F.DX));
	float2 PDY = F.DY + Gain * float2(dot(NX.yz, F.DY), dot(NY.yz, F.DY));
	float2 PoreTangent = SkinAxis(Tangent + Gain * float2(dot(NX.yz, Tangent), dot(NY.yz, Tangent)));
	float2 Pore = SkinPores(PoreUV, PorePeriod, PDX, PDY, PoreTangent, Strain.g, Strain.b);
	float MicroGrain = SkinNoise(F.Q, DetailPeriod * 2.0f, 607u, F.FP)
		+ 0.5f * SkinNoise(F.Q, DetailPeriod * 4.0f, 659u, F.FP);
	// Octaves are energy-normalized (1 + 0.5 would stack to 1.5x at full res).
	float Height = (SkinWrinkleRelief * Medium + SkinFineRelief * Fine) * Thickness
		+ SkinGrainRelief * Grain * MicroGrain * 0.667f;
	// Pore relief is already footprint-filtered and strain-adjusted. Resolve must not
	// run it through the directional wrinkle filter or apply a second relief scaling.
	float PoreHeight = SkinPoreRelief * PoreDepth * (0.25f * Pore.y - Pore.x)
		/ (1.0f + 0.5f * max(Strain.b, 0.0f));
	return float4(Height, Pore.x, PoreHeight, 0.0f);
}

[numthreads(8, 8, 1)]
void MicroCS(uint3 DTid : SV_DispatchThreadID)
{
	int2 Pixel = int2(DTid.xy);
	if (any(Pixel >= OutputSize)) { return; }
	// Both sizes are the full target here, so SkinFrame uses output-pixel AA, not solve-grid AA.
	float2 UV = (float2(Pixel) + 0.5f) / float2(OutputSize);
	float4 Residual = SkinFineResidual(UV);
	OutMicro[Pixel] = float4(SkinFinite(Residual.r), saturate(SkinFinite(Residual.g)),
		SkinFinite(Residual.b), 0.0f);
}

#endif

#if SKIN_STAGE == 2 || SKIN_STAGE == 3 || SKIN_STAGE == 4
// Bilinear interpolation of angles themselves fails at the +/-pi/2 director seam.
// Read texel centres with normalized UVs and interpolate double-angle directors instead.
float2 SkinStrainNormal(float2 UV)
{
	uint W, H;
	SeedState.GetDimensions(W, H);
	float2 Size = float2(W, H);
	float2 P = UV * Size - 0.5f;
	float2 Base = floor(P), Blend = frac(P);
	float2 Director = 0.0f;
	[unroll] for (int Y = 0; Y < 2; ++Y)
	{
		[unroll] for (int X = 0; X < 2; ++X)
		{
			float A = SeedState.SampleLevel(LinearWrapSampler, (Base + float2(X, Y) + 0.5f) / Size, 0).a;
			float Weight = (X == 0 ? 1.0f - Blend.x : Blend.x) * (Y == 0 ? 1.0f - Blend.y : Blend.y);
			Director += Weight * float2(cos(2.0f * A), sin(2.0f * A));
		}
	}
	if (dot(Director, Director) < 1.0e-8f) { return float2(1, 0); }
	float Angle = 0.5f * atan2(Director.y, Director.x);
	return float2(cos(Angle), sin(Angle));
}

#endif

#if SKIN_STAGE == 2 || SKIN_STAGE == 4
#if SKIN_STAGE == 4
float4 SkinCorrectionWeights(float T)
{
	float T2 = T * T, T3 = T2 * T;
	float S = 1.0f - T;
	return float4(S * S * S, 3.0f * T3 - 6.0f * T2 + 4.0f,
		-3.0f * T3 + 3.0f * T2 + 3.0f * T + 1.0f, T3) / 6.0f;
}

float SkinFoldCorrection(float2 UV)
{
	uint W, H;
	FoldState.GetDimensions(W, H);
	float2 Size = float2(W, H);
	float2 P = UV * Size - 0.5f;
	float2 Base = floor(P);
	float4 WX = SkinCorrectionWeights(frac(P.x));
	float4 WY = SkinCorrectionWeights(frac(P.y));
	float2 GX = float2(WX.x + WX.y, WX.z + WX.w);
	float2 GY = float2(WY.x + WY.y, WY.z + WY.w);
	float2 X = (Base.x + float2(-1.0f, 1.0f) + float2(WX.y, WX.w) / GX + 0.5f) / Size.x;
	float2 Y = (Base.y + float2(-1.0f, 1.0f) + float2(WY.y, WY.w) / GY + 0.5f) / Size.y;
	// Periodic cubic B-spline, evaluated with four bilinear taps. Positive weights
	// prevent overshoot/grid imprints; only the correction is smoothed, never analytic seed detail.
	return GY.x * (GX.x * FoldState.SampleLevel(LinearWrapSampler, float2(X.x, Y.x), 0)
		+ GX.y * FoldState.SampleLevel(LinearWrapSampler, float2(X.y, Y.x), 0))
		+ GY.y * (GX.x * FoldState.SampleLevel(LinearWrapSampler, float2(X.x, Y.y), 0)
		+ GX.y * FoldState.SampleLevel(LinearWrapSampler, float2(X.y, Y.y), 0));
}

[numthreads(8, 8, 1)]
void ResolveCS(uint3 DTid : SV_DispatchThreadID)
{
	int2 Pixel = int2(DTid.xy);
	if (any(Pixel >= OutputSize)) { return; }
	float2 UV = (float2(Pixel) + 0.5f) / float2(OutputSize);
	float4 Strain = SeedState.SampleLevel(LinearWrapSampler, UV, 0);
	float2 Normal = SkinStrainNormal(UV);
	float2 Tangent = float2(-Normal.y, Normal.x);
	float2 Size = float2(max(FinalOutputSize, int2(1, 1)));
	float2 Along = Tangent / max(length(Tangent * Size), 1.0f);
	float2 Across = Normal / max(length(Normal * Size), 1.0f);
	float4 Micro = MicroState.SampleLevel(LinearWrapSampler, UV, 0);
	float Fine = Micro.r;
	float Blur = Fine;
	float Weight = 1.0f;
	[unroll] for (int Tap = 1; Tap <= 3; ++Tap)
	{
		float W = exp(-float(Tap * Tap) / 3.0f);
		float Pair = MicroState.SampleLevel(LinearWrapSampler, UV + Along * float(Tap), 0).r
			+ MicroState.SampleLevel(LinearWrapSampler, UV - Along * float(Tap), 0).r;
		Blur += W * Pair;
		Weight += 2.0f * W;
	}
	float AcrossPair = MicroState.SampleLevel(LinearWrapSampler, UV + 1.5f * Across, 0).r
		+ MicroState.SampleLevel(LinearWrapSampler, UV - 1.5f * Across, 0).r;
	float Low = 0.5f * Fine + 0.25f * AcrossPair;
	float FineHeight = lerp(Fine, Blur / Weight, saturate(Strain.b))
		+ 0.35f * saturate(Strain.g) * (Fine - Low);
	float Base = TissueState.SampleLevel(LinearWrapSampler, UV, 0).r
		+ Strain.r + SkinFoldCorrection(UV);
	// Band budget: micro bands share one capped budget instead of stacking at
	// full amplitude on top of tissue+folds. Soft saturation keeps large
	// authored pore/fine gains from turning into uniform bump at 2048.
	float MicroTotal = FineHeight * 0.55f + Micro.b * 0.75f;
	float MicroCap = max(SkinWrinkleRelief * 2.0f, 1e-6f);
	MicroTotal = MicroTotal / (1.0f + abs(MicroTotal) / MicroCap);
	// Convert UV relief to canonical height ONCE, after adding the unblurred pores.
	// The solver and all cached analytic relief remain in UV units, without 0-1 normalization.
	OutHeight[Pixel] = SkinFinite((Base + MicroTotal) * HeightScale * SkinUVToHeight);
}
#else
static const int SkinAODirections = 8;
static const int SkinAOSteps = 5;

float SkinSolvedHeight(float2 UV)
{
	return ResolvedHeight.SampleLevel(LinearWrapSampler, UV, 0);
}

float SkinHorizonOcclusion(float2 UV, float Center, float2 Gradient, float Radius)
{
	float Occlusion = 0.0f;
	float2 Size = float2(max(OutputSize, int2(1, 1)));
	[unroll] for (int Ray = 0; Ray < SkinAODirections; ++Ray)
	{
		float Angle = MIXTORMAT_NOISE_TAU * float(Ray) / float(SkinAODirections);
		float2 Axis = float2(cos(Angle), sin(Angle));
		float Near = 1.0f / max(length(Axis * Size), 1.0f);
		float Far = max(Near, Radius);
		float Horizon = 0.0f;
		[unroll] for (int Step = 0; Step < SkinAOSteps; ++Step)
		{
			float Distance = Near * pow(Far / Near, float(Step) / float(SkinAOSteps - 1));
			float Rise = (SkinSolvedHeight(UV + Axis * Distance) - Center) * SkinHeightToUV;
			// Measure obstruction above the local tangent, not slope or second derivative.
			// A planar ramp has zero occlusion; negative relief reverses geometry naturally.
			Horizon = max(Horizon, Rise / Distance - dot(Gradient, Axis));
		}
		// Cosine-weighted blocked fraction of a horizontal hemisphere is sin(elevation)^2.
		// The tangent-plane correction is a local height-field approximation on tilted surfaces.
		Occlusion += Horizon * Horizon / (1.0f + Horizon * Horizon);
	}
	return saturate(Occlusion / float(SkinAODirections));
}

float2 SkinGeometry(float2 UV, float Center, float2 E, out float2 Slope)
{
	float L = SkinSolvedHeight(UV - float2(E.x, 0));
	float R = SkinSolvedHeight(UV + float2(E.x, 0));
	float B = SkinSolvedHeight(UV - float2(0, E.y));
	float T = SkinSolvedHeight(UV + float2(0, E.y));
	Slope = SkinHeightToUV * float2(R - L, T - B) / (2.0f * E);
	float2 K = SkinHeightToUV * float2((R - Center) + (L - Center), (T - Center) + (B - Center)) / (E * E);
	// Curvature times probe radius is a dimensionless slope change, with graph attenuation.
	float Bend = 0.5f * dot(K, E) * rsqrt(1.0f + dot(Slope, Slope));
	return float2(max(Bend, 0.0f), max(-Bend, 0.0f)) / (0.08f + abs(Bend));
}

static const float SkinVesselCoreWidthBase = 0.014f;
static const float SkinVesselDiffusionWidthBase = 0.025f;
static const float SkinVesselContrast = 0.35f;

float SkinVesselRandom(uint Hash, uint Salt)
{
	return MixtormatCellRandom01(MixtormatHashU(Hash ^ Salt));
}

// Finite bent/tapered branch in CELL units. No scalar-noise threshold or contour lattice.
float SkinVesselBranch(float2 P, float2 Start, float2 End, float Bend, float Width,
	float Thickness, float2 DX, float2 DY)
{
	float2 Delta = End - Start;
	float Length = max(length(Delta), 1.0e-6f);
	float2 Axis = Delta / Length;
	float2 Normal = float2(-Axis.y, Axis.x);
	float U = dot(P - Start, Axis);
	float T = saturate(U / Length);
	float Offset = 4.0f * Bend * T * (1.0f - T);
	float CurveSlope = 4.0f * Bend * (1.0f - 2.0f * T) / Length;
	float2 Gradient = (Normal - Axis * CurveSlope) * rsqrt(1.0f + CurveSlope * CurveSlope);
	float Distance = (dot(P - Start, Normal) - Offset) * rsqrt(1.0f + CurveSlope * CurveSlope);
	float Core = Width * lerp(1.0f, 0.35f, T);
	// Approximate subdermal diffusion and pixel integration separately; preserve line area.
	float Diffusion = SkinVesselDiffusionWidthBase * max(VascularScale, 0.1f) * Thickness;
	float2 Footprint = float2(dot(Gradient, DX), dot(Gradient, DY));
	float Variance = Core * Core + Diffusion * Diffusion + dot(Footprint, Footprint) / 12.0f;
	float Profile = exp(-0.5f * Distance * Distance / Variance) * Core * rsqrt(Variance);
	float Envelope = smoothstep(-Width, Width, U) * (1.0f - smoothstep(0.8f * Length, Length, U));
	return Profile * Envelope;
}

float SkinVascular(FSkinFrame F, float Thickness, float CompressionResponse, float Stretch)
{
	if (VascularAmount <= 0.0f) { return 0.0f; }
	int Period = SkinLatticePeriod(max(1.0f, round(float(TissueCells) * 2.0f)));
	if (Period == 0) { return 0.0f; }
	float Rate = float(Period);
	float AA = SkinBandWeight(Rate, F.FP);
	float2 Q = frac(F.Q) * Rate;
	int2 Base = int2(floor(Q));
	float2 DX = F.DX * Rate, DY = F.DY * Rate;
	float Vessels = 0.0f;
	// Each tree fits inside .95 cell of its jittered root; 3x3 includes complete seam support.
	[unroll] for (int Y = -1; Y <= 1; ++Y)
	{
		[unroll] for (int X = -1; X <= 1; ++X)
		{
			int2 Cell = Base + int2(X, Y);
			uint Hash = MixtormatCellHash(Cell, Period, Seed + 947u);
			if (SkinVesselRandom(Hash, 13u) > saturate(VascularDensity)) { continue; }
			float2 P = Q - MixtormatCellPoint(Cell, Period, Seed + 947u, 0.7f);
			float Support = 1.0f - smoothstep(0.8f, 0.95f, length(P));
			if (Support <= 0.0f) { continue; }
			float Angle = MIXTORMAT_NOISE_TAU * SkinVesselRandom(Hash, 31u);
			float2 Axis = float2(cos(Angle), sin(Angle));
			float2 Across = float2(-Axis.y, Axis.x);
			float2 Root = -Axis * lerp(0.18f, 0.29f, SkinVesselRandom(Hash, 47u));
			float2 Fork = Axis * lerp(0.08f, 0.18f, SkinVesselRandom(Hash, 59u));
			float Width = SkinVesselCoreWidthBase * max(VascularScale, 0.1f) * lerp(0.65f, 1.35f, SkinVesselRandom(Hash, 71u));
			float TrunkBend = 0.04f * (2.0f * SkinVesselRandom(Hash, 83u) - 1.0f);
			float Tree = SkinVesselBranch(P, Root, Fork, TrunkBend, Width, Thickness, DX, DY);
			[unroll] for (int Branch = 0; Branch < 2; ++Branch)
			{
				uint Salt = 101u + uint(Branch) * 139u;
				float Side = Branch == 0 ? -1.0f : 1.0f;
				float Turn = Side * lerp(0.4f, 1.15f, SkinVesselRandom(Hash, Salt));
				float2 BranchAxis = Axis * cos(Turn) + Across * sin(Turn);
				float2 Tip = Fork + BranchAxis * lerp(0.2f, 0.38f, SkinVesselRandom(Hash, Salt + 17u));
				float Bend = Side * lerp(0.015f, 0.065f, SkinVesselRandom(Hash, Salt + 29u));
				Tree += SkinVesselBranch(P, Fork, Tip, Bend, Width * 0.65f, Thickness, DX, DY);
				// A thinner side twig attaches to the actual bent branch centreline.
				float JunctionT = lerp(0.35f, 0.6f, SkinVesselRandom(Hash, Salt + 41u));
				float2 BranchNormal = float2(-BranchAxis.y, BranchAxis.x);
				float2 Junction = lerp(Fork, Tip, JunctionT)
					+ BranchNormal * (4.0f * Bend * JunctionT * (1.0f - JunctionT));
				float2 TwigAxis = SkinAxis(BranchAxis + Side * BranchNormal);
				float2 TwigTip = Junction + TwigAxis * lerp(0.12f, 0.2f, SkinVesselRandom(Hash, Salt + 53u));
				Tree += SkinVesselBranch(P, Junction, TwigTip, -0.02f * Side,
					Width * 0.35f, Thickness, DX, DY);
			}
			Vessels += Tree * Support * lerp(0.4f, 1.0f, SkinVesselRandom(Hash, 367u));
		}
	}
	// Broad perfusion is a soft concentration field, not a traced contour of value noise.
	float PerfusionNoise = SkinPigmentMottling(F.Q + float2(0.173f, 0.419f), F.FP);
	float Background = 0.12f * saturate(0.5f + 0.5f * PerfusionNoise);
	float Vessel = (1.0f - exp(-Vessels)) * AA * SkinVesselContrast;
	float Perfusion = max(0.0f, 0.65f + 0.2f * CompressionResponse - 0.25f * Stretch);
	return max(VascularAmount, 0.0f) * (Background + Vessel) * Perfusion / max(Thickness, 0.2f);
}

[numthreads(8, 8, 1)]
void FieldCS(uint3 DTid : SV_DispatchThreadID)
{
	int2 Pixel = int2(DTid.xy);
	if (any(Pixel >= OutputSize)) { return; }
	float2 UV = (float2(Pixel) + 0.5f) / float2(OutputSize);
	FSkinFrame F = SkinFrame(UV);
	float4 Tissue = TissueState.SampleLevel(LinearWrapSampler, UV, 0);
	float4 Strain = SeedState.SampleLevel(LinearWrapSampler, UV, 0);
	float2 Normal = SkinStrainNormal(UV);
	float2 Tangent = float2(-Normal.y, Normal.x);
	float2 Size = float2(max(FinalOutputSize, int2(1, 1)));
	// One pixel of arc length along a DESTINATION UV direction, also on rectangular maps.
	float2 Along = Tangent / max(length(Tangent * Size), 1.0f);
	float2 Across = Normal / max(length(Normal * Size), 1.0f);
	float4 Fine = MicroState.SampleLevel(LinearWrapSampler, UV, 0);
	// Raw residual curvature is only a material cavity cue, never ambient visibility.
	float2 AlongPair = MicroState.SampleLevel(LinearWrapSampler, UV + Along, 0).rb
		+ MicroState.SampleLevel(LinearWrapSampler, UV - Along, 0).rb;
	float2 AcrossPair = MicroState.SampleLevel(LinearWrapSampler, UV + 1.5f * Across, 0).rb
		+ MicroState.SampleLevel(LinearWrapSampler, UV - 1.5f * Across, 0).rb;
	float Base = SkinSolvedHeight(UV);

	float2 FoldGradient;
	SkinMarblePhase(F.Q, max(float(FoldCells), 1.0f), SkinAuthoredAxis(), 211u, F.FP, FoldGradient);
	float DestinationRate = length(float2(dot(FoldGradient, F.JX), dot(FoldGradient, F.JY)));
	float2 Probe = max(1.0f / float2(OutputSize), 0.35f / max(DestinationRate, 1.0f));
	float2 Slope, CoarseSlope;
	float2 Geometry = SkinGeometry(UV, Base, Probe, Slope);
	float2 Coarse = SkinGeometry(UV, Base, min(3.0f * Probe, 0.5f), CoarseSlope);
	// Both cached relief channels are already in UV units, unlike ResolvedHeight.
	// Only wrinkle curvature gets the directional-filter approximation; pore relief
	// already contains its strain response. The pore mask is publication-only here.
	float2 MicroBend = 0.25f * ((AlongPair - 2.0f * Fine.rb) / max(length(Along), 1.0e-6f)
		+ (AcrossPair - 2.0f * Fine.rb) / max(1.5f * length(Across), 1.0e-6f));
	float FineBend = HeightScale * dot(MicroBend, float2(1.0f - 0.75f * saturate(Strain.b), 1.0f));
	float FineCavity = max(FineBend, 0.0f) / (0.025f + abs(FineBend));
	float Cavity = saturate(1.0f - (1.0f - Geometry.x) * (1.0f - 0.45f * Coarse.x) * (1.0f - FineCavity));
	float Convex = saturate(Geometry.y + 0.25f * Coarse.y);
	float2 Texel = 1.0f / float2(OutputSize);
	float2 AOGradient = SkinHeightToUV * float2(
		SkinSolvedHeight(UV + float2(Texel.x, 0)) - SkinSolvedHeight(UV - float2(Texel.x, 0)),
		SkinSolvedHeight(UV + float2(0, Texel.y)) - SkinSolvedHeight(UV - float2(0, Texel.y))) / (2.0f * Texel);
	float AORadius = min(0.25f, max(4.0f * min(Texel.x, Texel.y), 0.5f / max(DestinationRate, 1.0f)));
	float Occlusion = CavityAO > 0.0f ? SkinHorizonOcclusion(UV, Base, AOGradient, AORadius) : 0.0f;

	float Mottling = SkinPigmentMottling(F.Q, F.FP);
	float Pigment = max(PigmentVariation, 0.0f);
	float Thickness = max(Tissue.a, 0.2f);
	float Blood = SkinVascular(F, Thickness, Strain.g, Strain.b);
	float3 MidColor = MixtormatEvalColorRamp(0.5f, AlbedoCount, AlbedoInterpolation,
		AlbedoPositions, AlbedoColors).rgb;
	float RampX = saturate(0.5f + 0.5f * Mottling + 0.15f * (Thickness - 1.0f));
	float3 VariedColor = MixtormatEvalColorRamp(RampX, AlbedoCount, AlbedoInterpolation,
		AlbedoPositions, AlbedoColors).rgb;
	// Shared chromophore fields link albedo and attenuation distances, not lighting.
	// No Cavity, AO, convexity, slope or height is painted into the albedo ramp.
	float3 BloodAbsorption = Blood * float3(0.12f, 0.65f, 0.38f);
	float3 PigmentAbsorption = Pigment * (0.5f + 0.5f * Mottling) * float3(0.18f, 0.28f, 0.42f);
	float3 Albedo = max(0.0f, lerp(MidColor, VariedColor, Pigment)) * exp(-BloodAbsorption);
	float3 LocalMFP = SkinFiniteRGB(MeanFreePath) * Thickness / (1.0f + PigmentAbsorption + BloodAbsorption);
	// TissueState remains UV relief: do not apply the resolved-height conversion to this ratio.
	float Fat = Tissue.r / SkinTissueRelief;
	float Roughness = MixtormatEvalSignedScalarRamp(saturate(0.5f + Fat), RoughnessCount,
		RoughnessInterpolation, RoughnessPoints) + CavityRoughness * (Cavity - 0.35f * Convex)
		+ 0.045f * max(TissueCoupling, 0.0f) * (Strain.g - Strain.b)
		+ 0.025f * saturate(length(Slope));
	float Reflectance = 1.0f - 2.0f / (max(IOR, 1.0f) + 1.0f);
	float F0 = saturate(Reflectance * Reflectance);
	float Fuzz = saturate(max(FuzzAmount, 0.0f) * (1.0f - Cavity) * max(0.75f + Fat, 0.0f));
	float Scattering = saturate(max(SSSAmount, 0.0f) * max(1.0f - 0.25f * Blood, 0.0f) / sqrt(Thickness));

	OutColor[Pixel] = float4(SkinFiniteRGB(Albedo), 1.0f);
	OutRAM[Pixel] = float4(saturate(SkinFinite(Roughness)), saturate(1.0f - max(CavityAO, 0.0f) * Occlusion), 0.0f, F0);
	OutOptics[Pixel] = float4(F0, Fuzz, saturate(FuzzRoughness), Scattering);
	OutFuzzColor[Pixel] = float4(SkinFiniteRGB(FuzzColor), 1.0f);
	// Preserve the helper contract: RGB are untone-mapped distances, independent of SSSAmount.
	OutSubsurface[Pixel] = float4(SkinFiniteRGB(LocalMFP), 0.0f);
	// Detail normal from cached micro relief only (not the resolved height).
	float3 DetailN = normalize(float3(-MicroBend * max(NormalStrength, 0.0f) * 8.0f, 1.0f));
	OutDetailNormal[Pixel] = float4(DetailN * 0.5f + 0.5f, 1.0f);
	OutPores[Pixel] = Fine.g;
	OutCompression[Pixel] = saturate(Strain.g);
}
#endif // resolve / material fields
#endif // SKIN_STAGE
#endif // SKIN_ANALYSIS
