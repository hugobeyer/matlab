// Stages: 0 tissue; 1 seed/strain; 2 material fields; 3 micro; 4 resolved relief.
// Dispatch: TissueCS -> SeedCS -> external fold solver -> MicroCS -> ResolveCS -> FieldCS.
// Only broad/cross folds are simulated. ResolveCS strains the cached micro residual once;
// FieldCS measures occlusion from that exact completed relief, not a curvature mask.
#ifndef SKIN_STAGE
#define SKIN_STAGE 2
#endif
#if SKIN_STAGE < 0 || SKIN_STAGE >= 5
#error Invalid SKIN_STAGE
#endif

int2 FinalOutputSize;
Texture2D<float4> SubstrateAnalysis;
Texture2D<float4> TissueState;
Texture2D<float4> SeedState;
// Final solver grid: solved fold relief MINUS the same sampled SeedState.r, in UV units.
Texture2D<float> FoldState;
// R: wrinkle/grain UV residual, G: pore mask, B: pore UV relief, A: unused.
Texture2D<float4> MicroState;
Texture2D<float> ResolvedHeight;
SamplerState LinearWrapSampler;
