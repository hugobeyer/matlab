// Generator-layer Height Color Ramp sublayer: maps a resolved signed height or generator output
// through a reusable colour ramp and publishes the result as a colour field. Signed height becomes
// a 0..1 color coordinate before scale/offset, inline Flow/UV/ID modulation, and optional mirrored repetition.

#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorHeightModules.ush"
#include "/Plugin/Mixtormat/Private/MixtormatColorOps.ush"
#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"

#ifndef MIXTORMAT_NO_REGION_ID
#define MIXTORMAT_NO_REGION_ID MIXTORMAT_INVALID_REGION
#endif

float MixtormatRegionUnitFloat(uint RegionId, uint Seed, uint Salt)
{
	return MixtormatRegionRandomSalted(MixtormatRegionSeed(RegionId, Seed), Salt);
}

int2 OutputSize;
uint StopCount;
uint Interpolation;
float Weight;
float InputScale;
float InputOffset;
uint MirrorRepeat;
float4 Positions[MIXTORMAT_COLOR_RAMP_MAX_STOPS];
float4 Colors[MIXTORMAT_COLOR_RAMP_MAX_STOPS];
uint MapOnly;
uint HasGate;
uint HasPreviousColor;
uint OverrideBaseColor;
float4 FillColor;
uint SourceMode;
uint BlendMode;
float FlowModulation;
uint SignedFlowModulation;
float2 FlowModulationDir;
float UVModulation;
float2 UVModulationDir;
float IdVariation;
uint IdVariationSeed;
uint HasModFlow;
uint HasModUV;
uint HasModIds;
Texture2D<float> SourceHeight;
Texture2D<float4> SourceFlow;
Texture2D<float2> SourceUV;
Texture2D<uint> SourceIds;
Texture2D<float> Gate;
Texture2D<float4> PreviousColor;
Texture2D<float4> MappedColor;
RWTexture2D<float4> OutColor;

void CompositeRampColor(int2 Pixel, float4 RampColor)
{
	const float GateValue = HasGate != 0 ? saturate(Gate.Load(int3(Pixel, 0))) : 1.0f;
	const float Alpha = saturate(Weight * GateValue * RampColor.a);
	const float3 BaseColor = OverrideBaseColor != 0
		? FillColor.rgb
		: (HasPreviousColor != 0
			? PreviousColor.Load(int3(Pixel, 0)).rgb
			: RampColor.rgb);
	const float3 BlendedRgb = HasPreviousColor != 0
		? MixtormatBlendColor(BlendMode, BaseColor, RampColor.rgb)
		: RampColor.rgb;
	const float3 OutRgb = HasPreviousColor != 0
		? lerp(BaseColor, BlendedRgb, Alpha)
		: RampColor.rgb;
	OutColor[Pixel] = float4(OutRgb, Alpha);
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 Pixel = int2(DispatchThreadId.xy);
	if (any(Pixel >= OutputSize)) { return; }

	float UnitScalar = 0.5f;
	if (SourceMode == 4u)
	{
		const uint RegionId = SourceIds.Load(int3(Pixel, 0));
		UnitScalar = (RegionId != MIXTORMAT_NO_REGION_ID)
			? MixtormatRegionUnitFloat(RegionId, IdVariationSeed, 0x52474E31u)
			: 0.0f;
	}
	else if (SourceMode == 2u)
	{
		const float2 FlowVec = SourceFlow.Load(int3(Pixel, 0)).xy;
		UnitScalar = length(FlowVec);
	}
	else if (SourceMode == 3u)
	{
		const float2 FlowVec = SourceFlow.Load(int3(Pixel, 0)).xy;
		UnitScalar = any(abs(FlowVec) > 1.0e-6f)
			? (atan2(FlowVec.y, FlowVec.x) * (0.5f / 3.14159265f) + 0.5f)
			: 0.5f;
	}
	else if (SourceMode == 1u)
	{
		UnitScalar = SourceHeight.Load(int3(Pixel, 0));
	}
	else
	{
		const float H = SourceHeight.Load(int3(Pixel, 0));
		UnitScalar = H * 0.5f + 0.5f;
	}

	float Coordinate = UnitScalar * InputScale + InputOffset;

	if (HasModFlow != 0u && abs(FlowModulation) > 1.0e-5f)
	{
		const float2 FV = SourceFlow.Load(int3(Pixel, 0)).xy;
		const float FlowTerm = SignedFlowModulation != 0u
			? dot(FV, FlowModulationDir)
			: length(FV) * (0.5f + 0.5f * dot(normalize(FV + 1.0e-6f), FlowModulationDir));
		Coordinate += FlowTerm * FlowModulation;
	}
	if (HasModUV != 0u && abs(UVModulation) > 1.0e-5f)
	{
		const float2 UVVal = SourceUV.Load(int3(Pixel, 0)).xy;
		Coordinate += dot(UVVal, UVModulationDir) * UVModulation;
	}
	if (HasModIds != 0u && IdVariation > 1.0e-5f)
	{
		const uint Rid = SourceIds.Load(int3(Pixel, 0));
		if (Rid != MIXTORMAT_NO_REGION_ID)
		{
			Coordinate += (MixtormatRegionUnitFloat(Rid, IdVariationSeed, 0x49445652u) * 2.0f - 1.0f) * IdVariation;
		}
	}

	if (MirrorRepeat != 0u)
	{
		// Triangle wave: 0,1,2 map to 0,1,0; frac also handles negative coordinates.
		Coordinate = 1.0f - abs(frac(Coordinate * 0.5f) * 2.0f - 1.0f);
	}

	const float4 RampColor = MixtormatEvalColorRamp(Coordinate, StopCount, Interpolation, Positions, Colors);
	if (MapOnly != 0u)
	{
		OutColor[Pixel] = RampColor;
		return;
	}
	CompositeRampColor(Pixel, RampColor);
}

[numthreads(8, 8, 1)]
void BlendCS(uint3 ID : SV_DispatchThreadID)
{
	const int2 Pixel = int2(ID.xy);
	if (any(Pixel >= OutputSize)) { return; }
	CompositeRampColor(Pixel, MappedColor.Load(int3(Pixel, 0)));
}
