#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorWarp.ush"

// Completed-field flow companions only; apply owns Height/Coverage. Not structural generation.
// 0 continuous attribute, 1 IDs, 2 valid UV boundary, 3 lifted coordinate map,
// 4 declared source-frame vector data, 5/6 legacy local centre/orientation,
// 7 valid UV scalar distance, 9 height combine, 10 region attribute,
// 12 automatic footprint-filtered signed height for post-generation Warp.
int2 OutputSize;
float InvalidDistance;


Texture2D<float2> WarpedUV;
Texture2D<float> ScalarField;
Texture2D<uint> IdField;
Texture2D<float2> VectorField;
Texture2D<float2> BoundaryField;
Texture2D<float> RunningHeight;
Texture2D<float> ModuleHeight;

SamplerState LinearWrapSampler;
RWTexture2D<float> OutScalar;
RWTexture2D<uint> OutIds;
RWTexture2D<float2> OutVector;

int2 BundleWrap(int2 P) { return MixtormatGeneratorWarpWrap(P, OutputSize); }
float2 BundleTorus(float2 D) { return D - round(D); }

float2 BundleDestinationVector(float2 V, float2 X, float2 Y)
{
	// Legacy affine-local inverse approximation, not an exact shared centre solve.
	// Retain legacy singular handling; new inverse-dependent producers remain gated.
	const float Det = X.x * Y.y - X.y * Y.x;
	return Det != 0.0f ? float2(Y.y * V.x - Y.x * V.y, -X.y * V.x + X.x * V.y) / Det : 0.0f;
}


#if BUNDLE_STAGE == 2 || BUNDLE_STAGE == 7
bool BundleValidBoundary(float2 UV, out float Distance)
{
	int2 Base;
	float4 Weights;
	MixtormatGeneratorWarpBilinear(UV, OutputSize, Base, Weights);
	float Sum = 0.0f;
	float Weight = 0.0f;
	[unroll]
	for (int Tap = 0; Tap < 4; ++Tap)
	{
		const float2 B = BoundaryField.Load(int3(BundleWrap(Base + int2(Tap & 1, Tap >> 1)), 0));
		// Decode no-hit validity before arithmetic, not after filtering a sentinel.
		if (Weights[Tap] > 0.0f && B.y > 0.5f && all(isfinite(B)))
		{
			Sum += Weights[Tap] * B.x;
			Weight += Weights[Tap];
		}
	}
	Distance = Weight > 0.0f ? Sum / Weight : 0.0f;
	return Weight > 0.0f && isfinite(Distance);
}

bool BundleDistanceScale(float XP, float XM, float YP, float YM,
	float2 X, float2 Y, out float Scale)
{
	Scale = 0.0f;
	if (!all(isfinite(X)) || !all(isfinite(Y))) { return false; }
	const float2 T = 1.0f / float2(OutputSize);
	const float2 G = float2(XP - XM, YP - YM) / (2.0f * T);
	const float SourceLength = length(G);
	const float DestinationLength = length(float2(dot(G, X), dot(G, Y)));
	if (!isfinite(SourceLength) || !isfinite(DestinationLength)
		|| SourceLength <= 1e-12f || DestinationLength <= 1e-12f) { return false; }
	// Keep the numerator: existing local distances are not exact unit-gradient SDFs.
	// A positive ratio retains negative-inside sign; there is no second structural metric.
	Scale = SourceLength / DestinationLength;
	return isfinite(Scale) && Scale > 0.0f;
}
#endif

#if BUNDLE_STAGE == 7
bool BundleValidScalarDistance(float2 UV, out float Distance)
{
	int2 Base;
	float4 Weights;
	MixtormatGeneratorWarpBilinear(UV, OutputSize, Base, Weights);
	float Sum = 0.0f;
	float Weight = 0.0f;
	[unroll]
	for (int Tap = 0; Tap < 4; ++Tap)
	{
		const int2 P = BundleWrap(Base + int2(Tap & 1, Tap >> 1));
		const float2 B = BoundaryField.Load(int3(P, 0));
		if (Weights[Tap] > 0.0f && B.y > 0.5f && all(isfinite(B)))
		{
			const float D = ScalarField.Load(int3(P, 0));
			if (isfinite(D))
			{
				Sum += Weights[Tap] * D;
				Weight += Weights[Tap];
			}
		}
	}
	Distance = Weight > 0.0f ? Sum / Weight : InvalidDistance;
	return Weight > 0.0f && isfinite(Distance);
}
#endif

#if BUNDLE_STAGE == 2 || BUNDLE_STAGE == 7
bool BundleDistanceMetric(float2 UV, float2 X, float2 Y, out float Distance, out float Scale)
{
	const float2 T = 1.0f / float2(OutputSize);
	float XP, XM, YP, YM;
#if BUNDLE_STAGE == 7
	// A named distance uses its own gradient; the boundary pair supplies validity only.
	// In particular, never differentiate a public no-hit sentinel as a real distance.
	const bool CValid = BundleValidScalarDistance(UV, Distance);
	const bool XPValid = BundleValidScalarDistance(UV + float2(T.x, 0.0f), XP);
	const bool XMValid = BundleValidScalarDistance(UV - float2(T.x, 0.0f), XM);
	const bool YPValid = BundleValidScalarDistance(UV + float2(0.0f, T.y), YP);
	const bool YMValid = BundleValidScalarDistance(UV - float2(0.0f, T.y), YM);
#else
	const bool CValid = BundleValidBoundary(UV, Distance);
	const bool XPValid = BundleValidBoundary(UV + float2(T.x, 0.0f), XP);
	const bool XMValid = BundleValidBoundary(UV - float2(T.x, 0.0f), XM);
	const bool YPValid = BundleValidBoundary(UV + float2(0.0f, T.y), YP);
	const bool YMValid = BundleValidBoundary(UV - float2(0.0f, T.y), YM);
#endif
	Scale = 0.0f;
	if (!CValid || !XPValid || !XMValid || !YPValid || !YMValid) { return false; }
	return BundleDistanceScale(XP, XM, YP, YM, X, Y, Scale);
}
#endif

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 Pixel = int2(DispatchThreadId.xy);
	if (any(Pixel >= OutputSize)) { return; }
#if BUNDLE_STAGE == 9
	const float Running = RunningHeight.Load(int3(Pixel, 0));
	const float Module = ModuleHeight.Load(int3(Pixel, 0));
	OutScalar[Pixel] = Running + Module;

#else
	const float2 UV = WarpedUV.Load(int3(Pixel, 0));
	int2 Anchor;
	if (!MixtormatGeneratorWarpAnchor(UV, OutputSize, Anchor))
	{
#if BUNDLE_STAGE == 1
		OutIds[Pixel] = MIXTORMAT_INVALID_REGION;
#elif BUNDLE_STAGE == 2 || BUNDLE_STAGE == 4 || BUNDLE_STAGE == 5
		OutVector[Pixel] = 0.0f;
#elif BUNDLE_STAGE == 3
		OutVector[Pixel] = UV; // Invalid map remains invalid, never an identity substitute.
#elif BUNDLE_STAGE == 7
		OutScalar[Pixel] = InvalidDistance;
#else
		OutScalar[Pixel] = 0.0f;
#endif
		return;
	}
#if BUNDLE_STAGE == 0 || BUNDLE_STAGE == 12
	const float Height = ScalarField.SampleLevel(LinearWrapSampler, UV, 0.0f);
#if BUNDLE_STAGE == 12
	// The previous AA sampled only one source texel along displacement.
	// That cannot filter a many-texel stretched warp and often looked identical
	// to the unfiltered image. Use the local UV Jacobian: an output pixel covers
	// a parallelogram in source UV space. Nine Gaussian-weighted taps integrate
	// that footprint, capped to eight source texels per axis.
	float2 Dx, Dy;
	MixtormatGeneratorWarpJacobian(WarpedUV, Pixel, OutputSize, Dx, Dy);
	float2 AxisX = Dx / (float)OutputSize.x;
	float2 AxisY = Dy / (float)OutputSize.y;
	const float LenX = length(AxisX * float2(OutputSize));
	const float LenY = length(AxisY * float2(OutputSize));

	float AntiAliased = Height;
	// Bilinear sampling handles an identity-sized footprint. Add filtering only
	// when Warp makes an output pixel cover more than one source texel.
	const float FilterWeight = saturate(max(LenX, LenY) - 1.0f);
	if (all(isfinite(float4(AxisX, AxisY))) && isfinite(LenX) && isfinite(LenY)
		&& FilterWeight > 0.0f)
	{
		AxisX *= clamp(LenX, 1.0f, 8.0f) / max(LenX, 1.0e-5f);
		AxisY *= clamp(LenY, 1.0f, 8.0f) / max(LenY, 1.0e-5f);
		float Weighted = 4.0f * Height;
		bool Valid = isfinite(Height);
		[unroll]
		for (int J = -1; J <= 1; ++J)
		{
			[unroll]
			for (int I = -1; I <= 1; ++I)
			{
				if (I == 0 && J == 0) { continue; }
				const float2 TapUV = UV + 0.5f * (float(I) * AxisX + float(J) * AxisY);
				const float Tap = ScalarField.SampleLevel(LinearWrapSampler, TapUV, 0.0f);
				Valid = Valid && isfinite(Tap);
				Weighted += (I == 0 || J == 0 ? 2.0f : 1.0f) * Tap;
			}
		}
		if (Valid) { AntiAliased = lerp(Height, Weighted / 16.0f, FilterWeight); }
	}
	OutScalar[Pixel] = AntiAliased;
#else
	OutScalar[Pixel] = Height;
#endif
#elif BUNDLE_STAGE == 1
	OutIds[Pixel] = IdField.Load(int3(Anchor, 0));
#elif BUNDLE_STAGE == 3
	OutVector[Pixel] = MixtormatGeneratorWarpSampleCoordinate(VectorField, UV, OutputSize);
#elif BUNDLE_STAGE == 4
	// Declared producer-frame vectors are transported data. Do not apply a covector or
	// inverse-direction transform unless the producer explicitly changes its public contract.
	OutVector[Pixel] = VectorField.SampleLevel(LinearWrapSampler, UV, 0.0f);
#elif BUNDLE_STAGE == 10
	// Copy the producer random/default at exactly the output ID's wrapped anchor.
	OutScalar[Pixel] = ScalarField.Load(int3(Anchor, 0));

#else
	float2 X, Y;
	MixtormatGeneratorWarpJacobian(WarpedUV, Pixel, OutputSize, X, Y);
#if BUNDLE_STAGE == 2
	float Distance, Scale;
	const bool Valid = BundleDistanceMetric(UV, X, Y, Distance, Scale);
	const float MovedDistance = Distance * Scale;
	OutVector[Pixel] = Valid && isfinite(MovedDistance) ? float2(MovedDistance, 1.0f) : float2(0.0f, 0.0f);
#elif BUNDLE_STAGE == 5
	const float2 Centre = VectorField.Load(int3(Anchor, 0));
	const float2 DestinationUV = (float2(Pixel) + 0.5f) / float2(OutputSize);
	OutVector[Pixel] = frac(DestinationUV + BundleDestinationVector(BundleTorus(Centre - UV), X, Y));
#elif BUNDLE_STAGE == 6
	const float A = ScalarField.Load(int3(Anchor, 0));
	const float2 V = BundleDestinationVector(float2(cos(A), -sin(A)), X, Y);
	OutScalar[Pixel] = dot(V, V) != 0.0f ? atan2(-V.y, V.x) : 0.0f;
#elif BUNDLE_STAGE == 7
	float Distance, Scale;
	const bool Valid = BundleDistanceMetric(UV, X, Y, Distance, Scale);
	const float MovedDistance = Distance * Scale;
	OutScalar[Pixel] = Valid && isfinite(MovedDistance) ? MovedDistance : InvalidDistance;
#endif
#endif
#endif
}
