#include "/Engine/Public/Platform.ush"

Texture2D<float4> PreviousEffectData;
Texture2D<float> ChildMask;
Texture2D<float4> PeelFieldA;
Texture2D<float4> PeelFieldB;
Texture2D<float> PreviousEffectHeight;
SamplerState LinearWrapSampler;
SamplerState PointWrapSampler;

RWTexture2D<float4> OutputEffectData;
RWTexture2D<float> OutputEffectHeight;

int2 OutputSize;
uint Initialize;

float Tiling;
float Strength;
float Front;
float Width;
float MacroWarp;
float MicroWarp;
float MicroMorph;
float Thickness;
float Lift;
float DetailStrength;

float ProceduralAOStrength;
float HeightAmount;
float HeightInvert;

int PeelWrapI(int x, int n)
{
	x %= max(n, 1);
	return x < 0 ? x + n : x;
}

int2 PeelWrapP(int2 p)
{
	return int2(
		PeelWrapI(p.x, OutputSize.x),
		PeelWrapI(p.y, OutputSize.y));
}

float3 PeelDecodeNormal(float2 xy)
{
	xy = xy * 2.0f - 1.0f;

	return normalize(
		float3(
			xy,
			sqrt(
				saturate(
					1.0f
					- dot(xy, xy)))));
}

float2 PeelEncodeNormal(float3 n)
{
	return n.xy * 0.5f + 0.5f;
}

float3 PeelRNM(float3 baseNormal, float3 detailNormal)
{
	float3 t =
		baseNormal
		+ float3(
			0.0f,
			0.0f,
			1.0f);

	float3 u =
		detailNormal
		* float3(
			-1.0f,
			-1.0f,
			1.0f);

	return normalize(
		t
			* dot(t, u)
			/ max(t.z, 1.0e-5f)
			- u);
}

float PeelRawHeight(int2 p)
{
	p = PeelWrapP(p);
	return PeelFieldB.Load(int3(p, 0)).a;
}

float PeelScaledHeight(int2 p)
{
	float sign =
		HeightInvert > 0.5f
		? -1.0f
		: 1.0f;

	return PeelRawHeight(p)
		* HeightAmount
		* sign;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
		return;

	int2 p =
		int2(
			DispatchThreadId.xy);

	float2 uv =
		(float2(p) + 0.5f)
		/ float2(OutputSize);

	float4 field =
		PeelFieldB.Load(
			int3(p, 0));

	float coverage =
		saturate(field.r);

	float strength =
		saturate(Strength);

	float enabled =
		strength > 1.0e-6f
		? 1.0f
		: 0.0f;

	float peel =
		coverage
		* strength;

	float keep =
		1.0f - peel;

	float previousKeep = 1.0f;
	float3 previousNormal = float3(0.0f, 0.0f, 1.0f);
	float previousAO = 1.0f;

	if (Initialize == 0)
	{
		float4 previous =
			PreviousEffectData.SampleLevel(
				LinearWrapSampler,
				uv,
				0.0f);

		previousKeep =
			previous.r;

		previousNormal =
			PeelDecodeNormal(
				previous.gb);

		previousAO =
			previous.a;
	}

	float hmm =
		PeelScaledHeight(
			p + int2(-1, -1));

	float h0m =
		PeelScaledHeight(
			p + int2(0, -1));

	float hpm =
		PeelScaledHeight(
			p + int2(1, -1));

	float hm0 =
		PeelScaledHeight(
			p + int2(-1, 0));

	float h00 =
		PeelScaledHeight(p);

	float hp0 =
		PeelScaledHeight(
			p + int2(1, 0));

	float hmp =
		PeelScaledHeight(
			p + int2(-1, 1));

	float h0p =
		PeelScaledHeight(
			p + int2(0, 1));

	float hpp =
		PeelScaledHeight(
			p + int2(1, 1));

	// Sobel derivative in UV space.
	// The previous version missed the OutputSize scaling here,
	// which made the generated normal almost flat.
	float gx =
		(
			hpm
			+ 2.0f * hp0
			+ hpp
			- hmm
			- 2.0f * hm0
			- hmp)
		* ((float)OutputSize.x / 8.0f);

	float gy =
		(
			hmp
			+ 2.0f * h0p
			+ hpp
			- hmm
			- 2.0f * h0m
			- hpm)
		* ((float)OutputSize.y / 8.0f);

	float3 reliefNormal =
		enabled > 0.0f
		? normalize(
			float3(
				-gx,
				-gy,
				1.0f))
		: float3(
			0.0f,
			0.0f,
			1.0f);

	float3 combinedNormal =
		PeelRNM(
			previousNormal,
			reliefNormal);

	// Height-driven contact AO.
	// h is a delta: negative means the peel exposed a lower substrate.
	float neighbourAverage =
		(hm0 + hp0 + h0m + h0p)
		* 0.25f;

	float cavity =
		max(
			neighbourAverage - h00,
			0.0f);

	float removed =
		max(
			-h00,
			0.0f);

	float heightAO =
		saturate(
			cavity * 32.0f
			+ removed * 2.0f);

	float localAO =
		enabled > 0.0f
		? 1.0f
			- saturate(ProceduralAOStrength)
			* heightAO
		: 1.0f;

	float previousHeight =
		Initialize == 0
		? PreviousEffectHeight.Load(
			int3(p, 0))
		: 0.0f;

	// Strength controls how much wallpaper is removed visually.
	// It does NOT multiply the physical Thickness.
	OutputEffectHeight[p] =
		previousHeight
		+ h00 * enabled;

	OutputEffectData[p] =
		float4(
			saturate(
				previousKeep
				* keep),
			PeelEncodeNormal(
				combinedNormal),
			saturate(
				previousAO
				* localAO));
}