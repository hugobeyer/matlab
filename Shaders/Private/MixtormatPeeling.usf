#include "/Engine/Public/Platform.ush"

Texture2D<float4> PreviousEffectData;
Texture2D<float> ChildMask;
// Procedural source. Same channel meanings as the authored maps, generated by
// MixtormatPeelField.usf into transient float targets instead of imported textures.
Texture2D<float4> PeelFieldA;
Texture2D<float4> PeelFieldB;
SamplerState LinearWrapSampler;
SamplerState PointWrapSampler;
RWTexture2D<float4> OutputEffectData;
// Peel relief. Kept in its own target because the effect data's four channels are already
// spent on keep, normal xy and AO; without this the height was computed, used once for the
// edge normal, and then dropped before it could reach the composited height.
RWTexture2D<float> OutputEffectHeight;
Texture2D<float> PreviousEffectHeight;

int2 OutputSize;
uint Initialize;
float ProceduralAOStrength;
float HeightAmount;
float HeightInvert;
float Tiling;
float Strength;
float Front;
float Width;
float MacroWarp;
float MicroWarp;
float MicroMorph;
float Thickness;
float Lift;
float DetailStrength;

float Smooth01(float Value)
{
	Value = saturate(Value);
	return Value * Value * (3.0f - 2.0f * Value);
}

float3 DecodeNormalXY(float2 EncodedXY)
{
	float2 XY = EncodedXY * 2.0f - 1.0f;
	return normalize(float3(XY, sqrt(saturate(1.0f - dot(XY, XY)))));
}

float3 EncodeNormal(float3 Normal)
{
	return Normal * 0.5f + 0.5f;
}

float3 BlendReorientedNormals(float3 BaseNormal, float3 DetailNormal)
{
	float3 T = BaseNormal + float3(0.0f, 0.0f, 1.0f);
	float3 U = DetailNormal * float3(-1.0f, -1.0f, 1.0f);
	return normalize(T * dot(T, U) / max(T.z, 1.0e-5f) - U);
}

void EvaluatePeeling(
	float2 UV,
	out float Coverage,
	out float Edge,
	out float SDFOcclusion,
	out float DynamicHeight)
{
	// The field arrives already shaped and in linear float, so front, coverage and height are
	// read rather than recomputed, and no decode range applies. The ordered child mask seeded
	// the field upstream; multiplying coverage by it again here would apply the same mask twice.
	//
	// This used to be one of two branches. The other decoded an authored map set -- a PDM
	// carrying arrival and warp in RGB, plus a coverage/edge/detail mask, a height map and an
	// SDF -- and it is gone along with the assets that fed it, taking Tiling's frac() with it.
	//
	// Sampled at UV rather than through Tiling: the field is generated once across the whole
	// composition at full resolution, and squeezing it into each tile threw away Tiling-times
	// the detail, which is what made generated peels read coarser than the material around them.
	float4 FieldA = PeelFieldA.SampleLevel(LinearWrapSampler, UV, 0.0f);
	float4 FieldB = PeelFieldB.SampleLevel(LinearWrapSampler, UV, 0.0f);

	float NormalizedDistance = FieldA.w / max(Width, 1.0e-6f);
	Coverage = FieldB.r;
	SDFOcclusion = saturate(exp(-abs(FieldA.w) / max(Width, 1.0e-6f)) * FieldB.g);
	Edge = saturate(max(exp(-2.0f * NormalizedDistance * NormalizedDistance), SDFOcclusion));
	DynamicHeight = FieldB.a;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	float2 UV = (float2(DispatchThreadId.xy) + 0.5f) / float2(OutputSize);
	float Coverage;
	float Edge;
	float SDFOcclusion;
	float CenterHeight;
	EvaluatePeeling(UV, Coverage, Edge, SDFOcclusion, CenterHeight);

	float2 Texel = 1.0f / float2(OutputSize);
	float SampleCoverage;
	float SampleEdge;
	float SampleSDFOcclusion;
	float HeightLeft;
	float HeightRight;
	float HeightDown;
	float HeightUp;
	EvaluatePeeling(
		UV - float2(Texel.x, 0.0f),
		SampleCoverage,
		SampleEdge,
		SampleSDFOcclusion,
		HeightLeft);
	EvaluatePeeling(
		UV + float2(Texel.x, 0.0f),
		SampleCoverage,
		SampleEdge,
		SampleSDFOcclusion,
		HeightRight);
	EvaluatePeeling(
		UV - float2(0.0f, Texel.y),
		SampleCoverage,
		SampleEdge,
		SampleSDFOcclusion,
		HeightDown);
	EvaluatePeeling(
		UV + float2(0.0f, Texel.y),
		SampleCoverage,
		SampleEdge,
		SampleSDFOcclusion,
		HeightUp);

	float2 HeightGradient = float2(HeightRight - HeightLeft, HeightUp - HeightDown)
		* float2(OutputSize) * 0.5f;
	float3 DynamicNormal = normalize(float3(-HeightGradient, 1.0f));

	float PeelAmount = saturate(Coverage * Strength);
	float KeepAmount = 1.0f - PeelAmount;
	float TransitionWeight = saturate(4.0f * PeelAmount * KeepAmount);
	float NormalWeight = saturate(max(TransitionWeight, Edge * Strength));
	float3 WeightedNormal = normalize(float3(
		DynamicNormal.xy * NormalWeight,
		lerp(1.0f, DynamicNormal.z, NormalWeight)));

	// An explicit strength rather than a ratio. The authored path scaled occlusion by how far
	// the lip stood out relative to its map's encoded height range; a generated field carries no
	// such range -- it is already in linear units -- so that ratio collapsed to near zero and
	// left the peel with no contact shadow at all.
	float LiftScale = ProceduralAOStrength;
	float PeelAO = lerp(1.0f, 0.35f, saturate(SDFOcclusion * Strength * LiftScale));

	float PreviousKeep = 1.0f;
	float3 PreviousNormal = float3(0.0f, 0.0f, 1.0f);
	float PreviousAO = 1.0f;
	if (Initialize == 0)
	{
		float4 Previous = PreviousEffectData.SampleLevel(LinearWrapSampler, UV, 0.0f);
		PreviousKeep = Previous.r;
		PreviousNormal = DecodeNormalXY(Previous.gb);
		PreviousAO = Previous.a;
	}

	float PreviousHeightOffset = Initialize == 0
		? PreviousEffectHeight.Load(int3(DispatchThreadId.xy, 0))
		: 0.0f;
	// Signed offset around zero, so stacked peels add and a disabled one contributes
	// nothing. Invert flips whether the film stands proud or bites into the substrate.
	float HeightOffset = CenterHeight * HeightAmount * lerp(1.0f, -1.0f, saturate(HeightInvert));
	OutputEffectHeight[DispatchThreadId.xy] = PreviousHeightOffset + HeightOffset;

	float CombinedKeep = saturate(PreviousKeep * KeepAmount);
	float3 CombinedNormal = BlendReorientedNormals(PreviousNormal, WeightedNormal);
	float CombinedAO = saturate(PreviousAO * PeelAO);
	OutputEffectData[DispatchThreadId.xy] = float4(
		CombinedKeep,
		EncodeNormal(CombinedNormal).xy,
		CombinedAO);
}
