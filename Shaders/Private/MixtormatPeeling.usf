#include "/Engine/Public/Platform.ush"

Texture2D<float4> PreviousEffectData;
Texture2D<float> ChildMask;
Texture2D<float4> PeelData;
Texture2D<float4> PeelMask;
Texture2D<float4> PeelHeight;
Texture2D<float4> PeelSDF;
// Procedural source. Same channel meanings as the authored maps, generated by
// MixtormatPeelField.usf into transient float targets instead of imported textures.
Texture2D<float4> PeelFieldA;
Texture2D<float4> PeelFieldB;
SamplerState LinearWrapSampler;
SamplerState PointWrapSampler;
RWTexture2D<float4> OutputEffectData;
// Peel relief. Kept in its own target because the effect data's four channels are already
// spent on keep, normal xy and AO; without this the height was computed, used once for the
// edge normal, and then dropped before it could reach the composited height.
RWTexture2D<float> OutputEffectHeight;
Texture2D<float> PreviousEffectHeight;

int2 OutputSize;
uint Initialize;
uint ProceduralSource;
float ProceduralAOStrength;
float HeightAmount;
float HeightInvert;
float Tiling;
float Strength;
float Front;
float Width;
float MacroWarp;
float MicroWarp;
float MicroMorph;
float Thickness;
float Lift;
float DetailStrength;
float DistanceRange;
float SDFRange;
float HeightRange;

float Smooth01(float Value)
{
	Value = saturate(Value);
	return Value * Value * (3.0f - 2.0f * Value);
}

float3 DecodeNormalXY(float2 EncodedXY)
{
	float2 XY = EncodedXY * 2.0f - 1.0f;
	return normalize(float3(XY, sqrt(saturate(1.0f - dot(XY, XY)))));
}

float3 EncodeNormal(float3 Normal)
{
	return Normal * 0.5f + 0.5f;
}

float3 BlendReorientedNormals(float3 BaseNormal, float3 DetailNormal)
{
	float3 T = BaseNormal + float3(0.0f, 0.0f, 1.0f);
	float3 U = DetailNormal * float3(-1.0f, -1.0f, 1.0f);
	return normalize(T * dot(T, U) / max(T.z, 1.0e-5f) - U);
}

void EvaluatePeeling(
	float2 UV,
	out float Coverage,
	out float Edge,
	out float SDFOcclusion,
	out float DynamicHeight)
{
	float2 EffectUV = frac(UV * max(Tiling, 0.0001f));

	// Procedural peels arrive already shaped and in linear float, so the front, coverage
	// and height terms are read rather than recomputed, and none of the decode ranges
	// apply. The ordered child mask seeded the field upstream; multiplying coverage by it
	// again here would apply the same mask twice.
	if (ProceduralSource != 0)
	{
		// Sampled at UV, not EffectUV. The authored maps are a small tile repeated by
		// Tiling, but the procedural field is generated once across the whole composition
		// at full resolution -- sampling it through frac(UV * Tiling) squeezes the entire
		// field into each tile and throws away Tiling-times the detail, which is what made
		// generated peels look far coarser than the material around them.
		float4 FieldA = PeelFieldA.SampleLevel(LinearWrapSampler, UV, 0.0f);
		float4 FieldB = PeelFieldB.SampleLevel(LinearWrapSampler, UV, 0.0f);

		float NormalizedDistanceP = FieldA.w / max(Width, 1.0e-6f);
		Coverage = FieldB.r;
		SDFOcclusion = saturate(exp(-abs(FieldA.w) / max(Width, 1.0e-6f)) * FieldB.g);
		Edge = saturate(max(exp(-2.0f * NormalizedDistanceP * NormalizedDistanceP), SDFOcclusion));
		DynamicHeight = FieldB.a;
		return;
	}

	float3 Data = PeelData.SampleLevel(LinearWrapSampler, EffectUV, 0.0f).rgb;
	float3 Mask = PeelMask.SampleLevel(LinearWrapSampler, EffectUV, 0.0f).rgb;
	float CoverageMask = PeelMask.SampleLevel(PointWrapSampler, EffectUV, 0.0f).r;
	float EncodedHeight = PeelHeight.SampleLevel(LinearWrapSampler, EffectUV, 0.0f).r;
	float EncodedSDF = PeelSDF.SampleLevel(LinearWrapSampler, EffectUV, 0.0f).r;

	float Arrival = Data.r * DistanceRange;
	float MacroField = Data.g * 2.0f - 1.0f;
	float MicroField = Data.b * 2.0f - 1.0f;
	float Distance = Arrival
		+ MacroField * MacroWarp
		+ MicroField * MicroWarp * MicroMorph
		- Front;
	float NormalizedDistance = Distance / max(Width, 1.0e-6f);
	Coverage = (1.0f - Smooth01(NormalizedDistance * 0.5f + 0.5f)) * CoverageMask;
	Coverage *= ChildMask.SampleLevel(LinearWrapSampler, UV, 0.0f);

	float SignedDistance = (EncodedSDF * 2.0f - 1.0f) * SDFRange;
	float TravelEdge = exp(-2.0f * NormalizedDistance * NormalizedDistance);
	float SDFEdge = exp(-abs(SignedDistance) / max(Width, 1.0e-6f));
	SDFOcclusion = saturate(SDFEdge * Mask.g);
	Edge = saturate(max(TravelEdge, SDFEdge) * Mask.g);

	float BaseHeight = EncodedHeight * HeightRange;
	float Relief = Mask.b * DetailStrength;
	float PeeledCoverage = Coverage;
	DynamicHeight = (BaseHeight + Relief) * PeeledCoverage
		+ Edge * (Thickness * Mask.g + Lift);
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	float2 UV = (float2(DispatchThreadId.xy) + 0.5f) / float2(OutputSize);
	float Coverage;
	float Edge;
	float SDFOcclusion;
	float CenterHeight;
	EvaluatePeeling(UV, Coverage, Edge, SDFOcclusion, CenterHeight);

	float2 Texel = 1.0f / float2(OutputSize);
	float SampleCoverage;
	float SampleEdge;
	float SampleSDFOcclusion;
	float HeightLeft;
	float HeightRight;
	float HeightDown;
	float HeightUp;
	EvaluatePeeling(
		UV - float2(Texel.x, 0.0f),
		SampleCoverage,
		SampleEdge,
		SampleSDFOcclusion,
		HeightLeft);
	EvaluatePeeling(
		UV + float2(Texel.x, 0.0f),
		SampleCoverage,
		SampleEdge,
		SampleSDFOcclusion,
		HeightRight);
	EvaluatePeeling(
		UV - float2(0.0f, Texel.y),
		SampleCoverage,
		SampleEdge,
		SampleSDFOcclusion,
		HeightDown);
	EvaluatePeeling(
		UV + float2(0.0f, Texel.y),
		SampleCoverage,
		SampleEdge,
		SampleSDFOcclusion,
		HeightUp);

	float2 HeightGradient = float2(HeightRight - HeightLeft, HeightUp - HeightDown)
		* float2(OutputSize) * 0.5f;
	float3 DynamicNormal = normalize(float3(-HeightGradient, 1.0f));

	float PeelAmount = saturate(Coverage * Strength);
	float KeepAmount = 1.0f - PeelAmount;
	float TransitionWeight = saturate(4.0f * PeelAmount * KeepAmount);
	float NormalWeight = saturate(max(TransitionWeight, Edge * Strength));
	float3 WeightedNormal = normalize(float3(
		DynamicNormal.xy * NormalWeight,
		lerp(1.0f, DynamicNormal.z, NormalWeight)));

	// Authored peels scale occlusion by how far the lip stands out relative to the map's
	// encoded height range. A procedural field carries no such range -- it is already in
	// linear units -- so that ratio collapses to near zero and the peel reads with no
	// contact shadow at all. Procedural mode uses an explicit strength instead.
	float LiftScale = ProceduralSource != 0
		? ProceduralAOStrength
		: saturate((Thickness + Lift) / max(HeightRange, 1.0e-4f));
	float PeelAO = lerp(1.0f, 0.35f, saturate(SDFOcclusion * Strength * LiftScale));

	float PreviousKeep = 1.0f;
	float3 PreviousNormal = float3(0.0f, 0.0f, 1.0f);
	float PreviousAO = 1.0f;
	if (Initialize == 0)
	{
		float4 Previous = PreviousEffectData.SampleLevel(LinearWrapSampler, UV, 0.0f);
		PreviousKeep = Previous.r;
		PreviousNormal = DecodeNormalXY(Previous.gb);
		PreviousAO = Previous.a;
	}

	float PreviousHeightOffset = Initialize == 0
		? PreviousEffectHeight.Load(int3(DispatchThreadId.xy, 0))
		: 0.0f;
	// Signed offset around zero, so stacked peels add and a disabled one contributes
	// nothing. Invert flips whether the film stands proud or bites into the substrate.
	float HeightOffset = CenterHeight * HeightAmount * lerp(1.0f, -1.0f, saturate(HeightInvert));
	OutputEffectHeight[DispatchThreadId.xy] = PreviousHeightOffset + HeightOffset;

	float CombinedKeep = saturate(PreviousKeep * KeepAmount);
	float3 CombinedNormal = BlendReorientedNormals(PreviousNormal, WeightedNormal);
	float CombinedAO = saturate(PreviousAO * PeelAO);
	OutputEffectData[DispatchThreadId.xy] = float4(
		CombinedKeep,
		EncodeNormal(CombinedNormal).xy,
		CombinedAO);
}
