#include "/Engine/Public/Platform.ush"
#include "/Plugin/MaterialLab/Private/MixtormatUV.ush"
#include "/Plugin/MaterialLab/Private/MixtormatMaskOps.ush"

Texture2D<float> PreviousMask;
Texture2D<float4> IncomingMask;
SamplerState LinearWrapSampler;
RWTexture2D<float> OutputMask;

int2 OutputSize;
uint Initialize;
uint BlendMode;
uint Invert;
float Weight;
float Balance;
float Contrast;
float Offset;

// Source placement. Offset is in UV and unrelated to the Offset above, which lifts the mask
// value rather than moving where it is read from.
float2 Tiling;
float2 UVOffset;
uint FlipU;
uint FlipV;
int Rotation;

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	float2 UV = (float2(DispatchThreadId.xy) + 0.5f) / float2(OutputSize);
	float Previous = Initialize != 0
		? 0.0f
		: PreviousMask.SampleLevel(LinearWrapSampler, UV, 0.0f);
	const float2 SourceUV = MixtormatSourceUV(UV, Tiling, UVOffset, FlipU, FlipV, Rotation);
	float Incoming = IncomingMask.SampleLevel(LinearWrapSampler, SourceUV, 0.0f).r;

	Incoming = MixtormatShapeMask(Incoming, Contrast, Offset, Balance, Invert);

	const float OperationResult = MixtormatApplyMaskOperation(BlendMode, Previous, Incoming);
	OutputMask[DispatchThreadId.xy] = saturate(lerp(Previous, OperationResult, Weight));
}
