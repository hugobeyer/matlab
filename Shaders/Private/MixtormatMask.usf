#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatUV.ush"
#include "/Plugin/Mixtormat/Private/MixtormatMaskOps.ush"

Texture2D<float> PreviousMask;
Texture2D<float4> IncomingMask;
// A mask this node has already sampled, placed and shaped in output space, and which something
// has done further work on since -- currently the Blur child. Read straight through when
// UsePreShaped is set: placing or shaping it twice would be wrong, and sampling it with the
// source transform would undo the very thing that made it worth a second pass.
Texture2D<float> PreShapedMask;
SamplerState LinearWrapSampler;
RWTexture2D<float> OutputMask;

int2 OutputSize;
uint UsePreShaped;
uint Initialize;
uint BlendMode;
uint Invert;
// Which scalar to take out of the four-channel source. EMixtormatLayerValueChannel by value, and
// 1 -- plain red -- for an authored texture, which is what this shader always read.
uint SourceChannel;
float Weight;
float Balance;
float Contrast;
float Offset;

// Source placement. Offset is in UV and unrelated to the Offset above, which lifts the mask
// value rather than moving where it is read from.
float2 Tiling;
float2 UVOffset;
uint FlipU;
uint FlipV;
int Rotation;

// One scalar out of a four-channel source.
//
// Luminance is Rec. 709 relative luminance over *linear* RGB, and no conversion is applied on the
// way in. That is not an oversight: base colour imports sRGB-flagged, so the hardware linearises
// it at the sample, fill colours are authored as FLinearColor, and every compositor target is a
// float format holding linear data. Decoding again here would darken the midtones of every mask.
float SelectMaskChannel(float4 Value)
{
	if (SourceChannel == 1)
	{
		return Value.r;
	}
	if (SourceChannel == 2)
	{
		return Value.g;
	}
	if (SourceChannel == 3)
	{
		return Value.b;
	}
	if (SourceChannel == 4)
	{
		// The layer's resolved roughness on a Layer Values source; the source map's alpha on an
		// authored one. Both are the fourth channel of what was bound, which is the only thing
		// this shader can know about it.
		return Value.a;
	}
	return dot(Value.rgb, float3(0.2126f, 0.7152f, 0.0722f));
}

float SampleIncomingMask(float2 UV)
{
	if (UsePreShaped != 0)
	{
		return PreShapedMask.SampleLevel(LinearWrapSampler, UV, 0.0f);
	}
	const float2 SourceUV = MixtormatSourceUV(UV, Tiling, UVOffset, FlipU, FlipV, Rotation);
	const float Incoming =
		SelectMaskChannel(IncomingMask.SampleLevel(LinearWrapSampler, SourceUV, 0.0f));
	return MixtormatShapeMask(Incoming, Contrast, Offset, Balance, Invert);
}

[numthreads(8, 8, 1)]
void ResolveCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}
	const float2 UV = (float2(DispatchThreadId.xy) + 0.5f) / float2(OutputSize);
	OutputMask[DispatchThreadId.xy] = SampleIncomingMask(UV);
}

[numthreads(8, 8, 1)]
void MergeCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}
	const float2 UV = (float2(DispatchThreadId.xy) + 0.5f) / float2(OutputSize);
	const float Previous = Initialize != 0
		? 0.0f
		: PreviousMask.SampleLevel(LinearWrapSampler, UV, 0.0f);
	const float Incoming = PreShapedMask.SampleLevel(LinearWrapSampler, UV, 0.0f);
	const float Result = MixtormatApplyMaskOperation(BlendMode, Previous, Incoming);
	OutputMask[DispatchThreadId.xy] = saturate(lerp(Previous, Result, Weight));
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const float2 UV = (float2(DispatchThreadId.xy) + 0.5f) / float2(OutputSize);
	const float Previous = Initialize != 0
		? 0.0f
		: PreviousMask.SampleLevel(LinearWrapSampler, UV, 0.0f);
	const float Incoming = SampleIncomingMask(UV);
	const float Result = MixtormatApplyMaskOperation(BlendMode, Previous, Incoming);
	OutputMask[DispatchThreadId.xy] = saturate(lerp(Previous, Result, Weight));
}
