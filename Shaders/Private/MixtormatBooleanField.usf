// Heightfield Boolean, Round and Bevel; signed heights are NOT metric SDFs.
#include "/Engine/Public/Platform.ush"

int2 OutputSize;
int Mode;
int FieldOperation;
uint HasSource;
uint HasScopedMask;
float FieldWidth;
float FieldBias;
float FieldSourceScale;
float FieldAmount;
Texture2D<float> RunningHeight;
Texture2D<float> BelowHeight;
Texture2D<float> SourceHeight;
Texture2D<float> ScopedMask;
RWTexture2D<float> OutHeightDelta;
RWTexture2D<float> OutFieldMask;
RWTexture2D<float> OutFieldBoundary;
RWTexture2D<float> OutFieldDifference;
RWTexture2D<float> OutFieldContribution;

float field_smax(float a, float b, float k)
{
    if (k <= 0.0f) return max(a, b);
    float h = saturate(0.5f + 0.5f * (a - b) / k);
    return lerp(b, a, h) + k * h * (1.0f - h);
}
float field_smin(float a, float b, float k)
{
    return -field_smax(-a, -b, k);
}
float field_bmax(float a, float b, float k)
{
    return max(max(a, b), 0.5f * (a + b + k));
}
float field_bmin(float a, float b, float k)
{
    return min(min(a, b), 0.5f * (a + b - k));
}

// Positive signed relief is a one-sided subtractive heightfield cutter.
// Both shaped modes must converge to exact max(d,0) outside the join width.
float field_cut_depth(float d, float k, int mode)
{
    if (d <= 0.0f) return 0.0f;
    if (k <= 0.0f || d >= k || mode == 1) return d;
    if (mode == 2)
    {
        float t = saturate(d / k);
        float fade = t * t * (3.0f - 2.0f * t);
        return d * fade; // C1 shoulder: identity beyond width
    }
    // Two straight relief slopes with sharp breakpoints: a heightfield bevel.
    return max(0.0f, 2.0f * d - k);
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    int2 pixel = int2(DispatchThreadId.xy);
    if (any(pixel >= OutputSize)) return;
    float a = BelowHeight.Load(int3(pixel, 0)) + RunningHeight.Load(int3(pixel, 0));
    float delta = 0.0f;
    float difference = 0.0f;
    float boundary = 0.0f;
    float area = 0.0f;
    if (HasSource != 0 && isfinite(a))
    {
        float source = SourceHeight.Load(int3(pixel, 0));
        float below = BelowHeight.Load(int3(pixel, 0));
        if (isfinite(source) && isfinite(below))
        {
            // Modules publish signed deltas; reconstruct surfaces over one base.
            float shapedSource = source * FieldSourceScale + FieldBias;
            float b = below + shapedSource;
            float k = max(0.0f, FieldWidth);
            float target = a;
            difference = a - b;
            if (FieldOperation == 0)
            {
                target = Mode == 2 ? field_smax(a, b, k)
                    : Mode == 3 ? field_bmax(a, b, k) : max(a, b);
            }
            else if (FieldOperation == 1)
            {
                target = Mode == 2 ? field_smin(a, b, k)
                    : Mode == 3 ? field_bmin(a, b, k) : min(a, b);
            }
            else
            {
                // Single-valued relief subtraction, not true 3D solid subtraction.
                float d = shapedSource;
                target = a - field_cut_depth(d, k, Mode);
                difference = Mode == 3 && k > 0.0f ? d - 0.5f * k : d;
            }
            float weight = HasScopedMask != 0 ? ScopedMask.Load(int3(pixel, 0)) : 1.0f;
            weight = isfinite(weight) ? saturate(weight) : 0.0f;
            float influence = saturate(FieldAmount) * weight;
            delta = (target - a) * influence;
            // Hard joins have a sharp seam; the hidden Round/Bevel width
            // must never influence a Boolean-mode preview.
            float effectiveWidth = Mode == 1 ? 0.0f : k;
            if (effectiveWidth > 0.0f)
            {
                boundary = 1.0f - saturate(abs(difference) / effectiveWidth);
            }
            else
            {
                // Detect sign crossings at adjacent wrapped pixels. Comparing to
                // a tiny constant misses nearly all hard Boolean boundaries.
                int2 px = int2((pixel.x + 1) % OutputSize.x, pixel.y);
                int2 py = int2(pixel.x, (pixel.y + 1) % OutputSize.y);
                float sx = SourceHeight.Load(int3(px, 0)) * FieldSourceScale + FieldBias;
                float sy = SourceHeight.Load(int3(py, 0)) * FieldSourceScale + FieldBias;
                float dx = FieldOperation == 2 ? sx
                    : RunningHeight.Load(int3(px, 0)) - sx;
                float dy = FieldOperation == 2 ? sy
                    : RunningHeight.Load(int3(py, 0)) - sy;
                boundary = (difference == 0.0f
                    || (difference < 0.0f && (dx > 0.0f || dy > 0.0f))
                    || (difference > 0.0f && (dx < 0.0f || dy < 0.0f))) ? 1.0f : 0.0f;
            }
            boundary *= influence;
            area = abs(target - a) > 0.000001f ? influence : 0.0f;
            if (!isfinite(delta)) delta = 0.0f;
        }
    }
    OutHeightDelta[pixel] = delta;
    OutFieldMask[pixel] = area;
    OutFieldBoundary[pixel] = boundary;
    OutFieldDifference[pixel] = difference;
    OutFieldContribution[pixel] = delta;
}
