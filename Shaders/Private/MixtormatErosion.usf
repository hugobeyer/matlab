#include "/Engine/Public/Platform.ush"

// Directional wear erosion for material height fields -- brick, stone, plaster. A curvature
// and slope solve run as ping-pong iterations with a jump schedule:
//
//     dx, dy      central differences of the working height at the pass span
//     Laplacian   4-neighbour curvature at the same span -- convex (peaks) erodes,
//                 concave (pits) receives deposit
//     Momentum    the flow direction is a damped memory of the slope field (Smoothing),
//                 so per-texel noise cannot steer the wear
//     Relax       a one-sided Jacobi term shaves protrusions toward their neighbours,
//                 eating iteration dither without ever filling detail back in
//     Variation   seeded fractal lattice noise varies wear strength in material patches
//
// Every derivative reads the height at one span, so the pass costs a fixed handful of taps
// whatever the radius or stride -- wide passes measure broad structure, stride-1 passes
// measure fine, and both cost the same. Verticality protects cross-gravity structure,
// deposition gains a gravity-catching component, and placement gates apply to the final
// delta so a hard mask edge cannot feed the solver. The carve pair goes to the shared
// height-derived normal pass; the convexity response goes to the generated-mask ridge.

Texture2D<float> PreviousHeight;
Texture2D<float> SourceHeight;
Texture2D<float4> PreviousVelocity;
Texture2D<float4> PreviousNormal;
Texture2D<float> LayerMask;
Texture2D<float4> PlacementMaskTexture;
Texture2D<float> PreviousRidge;
SamplerState LinearWrapSampler;
RWTexture2D<float> OutputHeight;
RWTexture2D<float> OutputRidge;
RWTexture2D<float4> OutputVelocity;
// Resample-only. The wear pass never writes normals -- the shared height-derived pass owns
// them -- so iterations bind a 1x1 dummy here instead of paying a full-screen copy.
RWTexture2D<float4> OutputNormal;

int2 OutputSize;
int ResamplePass;
int ResampleRidge;
uint WriteRidge;
float Amount;
float Depth;
int Radius;
int Iterations;
int Stride;
float GravityAngle;
float Verticality;
float SlopePower;
float Deposit;
float PreserveFlats;
float Smoothing;
float Variation;
uint Seed;
uint UsePlacementMask;
float PlacementMaskTiling;
uint InvertMask;

// Internal constants. RidgeScale shapes the crest signal consumed by the generated-mask
// drainage path; DepositDirectionScale how strongly upward-facing ledges catch deposit;
// VariationScale the swing of the seeded wear-strength noise; FlowBiasScale the mild
// gravity bias the flow direction keeps now that Verticality's primary meaning is tangent
// protection; RelaxOmega the per-iteration strength of the protrusion shave; RadiusBound
// the cheap analysis-span ceiling. The step clamp is derived from Depth, Amount, Deposit
// and the iteration count -- a safety mechanism, not an artistic limiter.
static const float ErosionRidgeScale = 2.0;
static const float ErosionDepositDirectionScale = 1.25;
static const float ErosionVariationScale = 0.75;
static const float ErosionFlowBiasScale = 0.35;
static const float ErosionRelaxOmega = 0.25;
static const int ErosionRadiusBound = 4;

// Tileable lattice hash for the variation field. The cell wraps on a 32-period lattice so
// the noise tiles with the texture; the hash is the same family the rest of the plugin's
// procedural noise uses.
float ErosionHashCell(int2 Cell, uint Seed)
{
	const int Period = 32;
	int2 C = int2(Cell.x % Period, Cell.y % Period);
	C = (C + Period) % Period;
	uint H = (uint)C.x * 0x27d4eb2du ^ (uint)C.y * 0x165667b1u ^ Seed * 0x9e3779b9u;
	H ^= H >> 16;
	H *= 0x7feb352du;
	H ^= H >> 15;
	H *= 0x846ca68bu;
	H ^= H >> 16;
	return (float)(H & 0x00FFFFFFu) * (1.0f / 16777216.0f);
}

// Fractal value noise over that lattice: three bilinear octaves, so the variation reads as
// material patches at two scales rather than per-pixel speckle.
float ErosionVariationField(float2 UV, uint Seed)
{
	float Field = 0.0f;
	float Total = 0.0f;
	float Amplitude = 0.5f;

	[unroll]
	for (int Octave = 0; Octave < 3; ++Octave)
	{
		const float Period = 16.0f * (float)(1 << Octave);
		const float2 P = UV * Period;
		const int2 I = (int2)floor(P);
		const float2 F = P - (float2)I;
		const float2 S = F * F * (3.0f - 2.0f * F);
		const uint OctaveSeed = Seed + (uint)Octave * 977u;
		const float A = ErosionHashCell(I, OctaveSeed);
		const float B = ErosionHashCell(I + int2(1, 0), OctaveSeed);
		const float C = ErosionHashCell(I + int2(0, 1), OctaveSeed);
		const float D = ErosionHashCell(I + int2(1, 1), OctaveSeed);
		Field += Amplitude * lerp(lerp(A, B, S.x), lerp(C, D, S.x), S.y);
		Total += Amplitude;
		Amplitude *= 0.5f;
	}

	return Field / Total;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 Pixel = int2(DispatchThreadId.xy);
	const float2 Resolution = float2(OutputSize);
	const float2 UV = (float2(Pixel) + 0.5f) / Resolution;

	if (ResamplePass != 0)
	{
		OutputHeight[Pixel] = PreviousHeight.SampleLevel(LinearWrapSampler, UV, 0.0f);
		const float4 EncodedNormal = PreviousNormal.SampleLevel(LinearWrapSampler, UV, 0.0f);
		const float3 Normal = normalize(EncodedNormal.xyz * 2.0f - 1.0f);
		OutputNormal[Pixel] = float4(Normal * 0.5f + 0.5f, EncodedNormal.w);
		if (ResampleRidge != 0)
		{
			OutputRidge[Pixel] = PreviousRidge.SampleLevel(LinearWrapSampler, UV, 0.0f);
		}
		return;
	}

	const float Height = PreviousHeight.Load(int3(Pixel, 0));
	const float Source = SourceHeight.Load(int3(Pixel, 0));

	float Mask = UsePlacementMask != 0
		? PlacementMaskTexture.SampleLevel(
			LinearWrapSampler, frac(UV * max(PlacementMaskTiling, 1.0f)), 0.0f).r
		: LayerMask.SampleLevel(LinearWrapSampler, UV, 0.0f);
	Mask = InvertMask != 0 ? 1.0f - Mask : Mask;
	const float Gate = saturate(Mask);

	// Momentum state for this pixel. Gated-out pixels pass it through untouched so the
	// ping-pong stays aligned even where the mask fades the effect out entirely.
	const float2 Velocity = PreviousVelocity.Load(int3(Pixel, 0)).xy;

	if (Gate <= 0.0f)
	{
		OutputHeight[Pixel] = Height;
		OutputVelocity[Pixel] = float4(Velocity, 0.0f, 0.0f);
		if (WriteRidge != 0u)
		{
			OutputRidge[Pixel] = 0.0f;
		}
		return;
	}

	// Gravity frame. The angle is degrees in UV space: 0 = +U, 90 = +V, 180 = -U, 270 = -V.
	const float AngleRadians = radians(GravityAngle);
	const float2 GravityDir = float2(cos(AngleRadians), sin(AngleRadians));
	const float2 GravityPerp = float2(-GravityDir.y, GravityDir.x);

	// Resolution normalization: slopes and curvature are expressed per a fixed fraction of
	// the tile -- height change per 1/256 UV -- so the response, the wear scale and the
	// Preserve Flats threshold keep their meaning across 1K/2K/4K.
	const float SlopeNorm = max(max(Resolution.x, Resolution.y), 1.0f) / 256.0f;

	// Derivatives at the pass span. The span is the analysis radius scaled by this pass's
	// jump stride: wide passes read broad structure and carry wear across the tile, stride-1
	// passes read fine and accumulate it. Four taps serve the gradient and the Laplacian
	// both -- the cost is fixed whatever the span.
	const int Span = clamp((int)Radius, 1, ErosionRadiusBound) * max(Stride, 1);
	const float2 SpanStep = (float)Span / Resolution;
	const float HL = PreviousHeight.SampleLevel(LinearWrapSampler, UV + float2(-SpanStep.x, 0.0f), 0.0f);
	const float HR = PreviousHeight.SampleLevel(LinearWrapSampler, UV + float2(SpanStep.x, 0.0f), 0.0f);
	const float HD = PreviousHeight.SampleLevel(LinearWrapSampler, UV + float2(0.0f, -SpanStep.y), 0.0f);
	const float HU = PreviousHeight.SampleLevel(LinearWrapSampler, UV + float2(0.0f, SpanStep.y), 0.0f);

	// Slope in per-texel units, then momentum: the flow memory is a damped lerp toward the
	// measured slope, so noise that would re-steer every pass averages out over iterations
	// instead. Smoothing is that memory -- 0 reacts to every texel, 1 barely moves.
	const float2 SpanSlope = 0.5f * float2(HR - HL, HU - HD) / (float)Span;
	const float UpdateRate = 1.0f - saturate(Smoothing);
	const float2 VelocityNew = lerp(Velocity, SpanSlope, UpdateRate);
	OutputVelocity[Pixel] = float4(VelocityNew, 0.0f, 0.0f);

	const float VelocityLength = length(VelocityNew);
	const float SlopeMeasure = VelocityLength * SlopeNorm;

	// Direction decomposition on the momentum, not the instantaneous slope, so tangent
	// protection is stable while the carve develops. Verticality's primary meaning: how much
	// cross-gravity structure survives. The flow direction keeps a mild gravity bias; the
	// align step keeps that blend away from zero length.
	float2 VDir = VelocityLength > 1.0e-6f
		? VelocityNew / VelocityLength
		: GravityDir;
	if (dot(VDir, GravityDir) < 0.0f)
	{
		VDir = -VDir;
	}
	const float Across = abs(dot(VDir, GravityPerp));
	const float TangentProtection = 1.0f - Verticality * Across;

	const float2 Blended = lerp(VDir, GravityDir, Verticality * ErosionFlowBiasScale);
	const float BlendLength = length(Blended);
	const float2 FlowDir = BlendLength > 1.0e-6f ? Blended / BlendLength : GravityDir;

	// Curvature in the same normalized space. A discrete Laplacian at span k is k-squared
	// the per-texel curvature, so dividing the span back out and scaling by the normalized
	// distance makes the reading identical at every span and resolution: broad swells and
	// single-texel spikes of the same height read the same.
	const float MeanSpan = 0.25f * (HL + HR + HU + HD);
	const float CurvatureNorm =
		(MeanSpan - Height) * (SlopeNorm * SlopeNorm) / ((float)Span * (float)Span);
	const float Convexity = saturate(-CurvatureNorm);
	const float Concavity = saturate(CurvatureNorm);

	// Slope response: harsh slopes respond at full strength, smooth ones proportionally,
	// and flats below the threshold are protected entirely.
	const float SlopeResponse = pow(
		max(SlopeMeasure - max(PreserveFlats, 0.0f), 0.0f),
		max(SlopePower, 0.01f));

	// Seeded wear-strength variation: fractal lattice noise, so the carve breaks up like
	// material hardness patches instead of eroding uniformly. Zero Variation is an exact
	// no-op.
	const float StrengthJitter = 1.0f
		+ saturate(Variation)
			* (ErosionVariationField(UV, Seed) * 2.0f - 1.0f)
			* ErosionVariationScale;

	// Amount and Depth are the artistic controls and are applied at face value. Tangent
	// protection scales how much cross-gravity relief the wear is allowed to take.
	const float ErosionDelta =
		Convexity
		* SlopeResponse
		* max(Amount, 0.0f)
		* TangentProtection
		* StrengthJitter;

	float DepositDelta = Concavity * SlopeResponse * max(Deposit, 0.0f);

	// Directional deposition. As Verticality rises, material increasingly collects on
	// surfaces that face upward against gravity -- ledges and backslopes that catch the
	// flow. A gain, not a mask: ordinary valley refill continues everywhere.
	const float2 UphillDir = length(SpanSlope) > 1.0e-6f
		? SpanSlope / length(SpanSlope)
		: -GravityDir;
	const float UpFacing = saturate(dot(UphillDir, -GravityDir));
	DepositDelta *= 1.0f + Verticality * UpFacing * ErosionDepositDirectionScale;

	// Deposit stability: one iteration's refill cannot outrun the relief the same pass says
	// is movable, so repeated iterations -- and the directional gain -- cannot pump valleys
	// upward without bound.
	DepositDelta = min(DepositDelta, max(ErosionDelta * 2.0f, 0.01f));

	// The step clamp is numerical stability only, sized from the effect's own scale spread
	// over the iteration count.
	const float MaxStep = max(
		0.01f,
		max(Depth, 0.0f) * max(max(Amount, Deposit), 0.0f) / max((float)Iterations, 1.0f));

	float Delta = (DepositDelta - ErosionDelta) * max(Depth, 0.0f) * Gate;
	Delta = clamp(Delta, -MaxStep, MaxStep);

	// One-sided Jacobi relax at single-texel span: protrusions are shaved toward their
	// neighbours, which is where iteration dither and stray spikes die. Pits are untouched,
	// so the term can never fill detail back in or blur the surface.
	const float MeanNeighbour = 0.25f * (
		PreviousHeight.SampleLevel(LinearWrapSampler, UV + float2(-1.0f, 0.0f) / Resolution, 0.0f)
		+ PreviousHeight.SampleLevel(LinearWrapSampler, UV + float2(1.0f, 0.0f) / Resolution, 0.0f)
		+ PreviousHeight.SampleLevel(LinearWrapSampler, UV + float2(0.0f, -1.0f) / Resolution, 0.0f)
		+ PreviousHeight.SampleLevel(LinearWrapSampler, UV + float2(0.0f, 1.0f) / Resolution, 0.0f));
	const float Relax = ErosionRelaxOmega * min(MeanNeighbour - Height, 0.0f);

	// A material filter never creates new volume: deposition may only refill toward what
	// the layer actually composited, never above it.
	float NewHeight = Height + Delta + Relax * Gate;
	NewHeight = min(NewHeight, max(Source, Height));
	OutputHeight[Pixel] = max(NewHeight, 0.0f);

	// Crest/exposed response for the generated-mask drainage signal, gated like the carve.
	if (WriteRidge != 0u)
	{
		OutputRidge[Pixel] = saturate(Convexity * SlopeResponse * ErosionRidgeScale) * Gate;
	}
}