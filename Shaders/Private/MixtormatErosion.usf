#include "/Engine/Public/Platform.ush"
#include "/Plugin/MaterialLab/Private/MixtormatGully.ush"

// Tileable stacked-gully erosion for material height fields. The filter is evaluated once per
// pixel: the source slope chooses the first direction, and analytical stripe derivatives steer
// every finer octave. Placement gates are applied only to the final result so a hard mask edge
// cannot bend gullies or feed itself back into the slope.

Texture2D<float> PreviousHeight;
Texture2D<float> SourceHeight;
Texture2D<float4> PreviousNormal;
Texture2D<float> GuideHeight;
Texture2D<float> LayerMask;
Texture2D<float> PreviousRidge;
SamplerState LinearWrapSampler;
RWTexture2D<float> OutputHeight;
RWTexture2D<float> OutputRidge;
RWTexture2D<float4> OutputNormal;

int2 OutputSize;
int NormalPass;
int BlurPass;
int BlurAxis;
int ResamplePass;
int ResampleRidge;
float BlurRadius;
float NormalStrength;
float Amount;
float Strength;
int Octaves;
int Period;
float Gain;
float Detail;
float GullyWeight;
float Normalization;
float RidgeRounding;
float CreaseRounding;
float SlopeOnset;
float FeatureOnset;
float AssumedSlope;
float AssumedSlopeAmount;
int SlopeRadius;
int CurvatureMode;
float CavityInfluence;
float CavityOffset;
float CavityRemapMin;
float CavityRemapMax;
float HeightInfluence;
float HeightScale;
uint InvertMask;
uint Seed;

int WrapI(int X, int Size)
{
	X = X % max(Size, 1);
	return X < 0 ? X + Size : X;
}

float RemapSmooth(float Lo, float Hi, float Value)
{
	const float Range = Hi - Lo;
	const float T = abs(Range) > 1.0e-6f
		? saturate((Value - Lo) / Range)
		: (Value >= Lo ? 1.0f : 0.0f);
	return T * T * (3.0f - 2.0f * T);
}

float EaseOut(float Value)
{
	const float Inverse = 1.0f - saturate(Value);
	return 1.0f - Inverse * Inverse;
}

float PowInverse(float Value, float Power)
{
	return 1.0f - pow(1.0f - saturate(Value), max(Power, 1.0e-4f));
}

float SmoothStart(float Value, float Radius)
{
	if (Radius <= 1.0e-6f || Value >= Radius)
	{
		return Value - 0.5f * Radius;
	}
	return 0.5f * Value * Value / Radius;
}

float2 SafeNormalize(float2 Value, float2 Fallback)
{
	const float Length2 = dot(Value, Value);
	return Length2 > 1.0e-12f ? Value * rsqrt(Length2) : Fallback;
}

// Samples sixteen rays and returns the single steepest downhill direction and its slope.
// A Sobel average is useful on smooth terrain but weakens thin mortar joints and bevels by
// combining unrelated neighbours. The directional maximum keeps those material boundaries.
float3 MaximumDirectionalSlope(float2 UV, float CenterHeight)
{
	const float2 Resolution = float2(OutputSize);
	const float Radius = max((float)SlopeRadius, 1.0f);
	float BestSlope = 0.0f;
	float2 BestDirection = float2(0.0f, 1.0f);

	[unroll(16)]
	for (int DirectionIndex = 0; DirectionIndex < 16; ++DirectionIndex)
	{
		const float Angle = (6.28318530718f / 16.0f) * (float)DirectionIndex;
		const float2 PixelDirection = float2(cos(Angle), sin(Angle));
		const float2 DeltaUV = PixelDirection * Radius / Resolution;
		const float DistanceUV = max(length(DeltaUV), 1.0e-6f);
		const float NeighbourHeight = GuideHeight.SampleLevel(
			LinearWrapSampler, UV + DeltaUV, 0.0f);
		const float Candidate = (CenterHeight - NeighbourHeight) / DistanceUV;
		if (Candidate > BestSlope)
		{
			BestSlope = Candidate;
			BestDirection = SafeNormalize(DeltaUV, BestDirection);
		}
	}

	return float3(BestDirection, BestSlope);
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 Pixel = int2(DispatchThreadId.xy);
	const float2 Resolution = float2(OutputSize);
	const float2 UV = (float2(Pixel) + 0.5f) / Resolution;

	if (ResamplePass != 0)
	{
		OutputHeight[Pixel] = PreviousHeight.SampleLevel(LinearWrapSampler, UV, 0.0f);
		const float4 EncodedNormal = PreviousNormal.SampleLevel(LinearWrapSampler, UV, 0.0f);
		const float3 Normal = normalize(EncodedNormal.xyz * 2.0f - 1.0f);
		OutputNormal[Pixel] = float4(Normal * 0.5f + 0.5f, EncodedNormal.w);
		if (ResampleRidge != 0)
		{
			OutputRidge[Pixel] = PreviousRidge.SampleLevel(LinearWrapSampler, UV, 0.0f);
		}
		return;
	}

	const float Source = SourceHeight.Load(int3(Pixel, 0));
	const float Height = PreviousHeight.Load(int3(Pixel, 0));

	if (BlurPass != 0)
	{
		const float2 Axis = BlurAxis == 0 ? float2(1.0f, 0.0f) : float2(0.0f, 1.0f);
		const float2 Texel = Axis / Resolution;
		const float Sigma = max(BlurRadius * 0.5f, 1.0e-4f);
		const int Taps = clamp((int)ceil(BlurRadius), 1, 16);
		float Sum = PreviousHeight.SampleLevel(LinearWrapSampler, UV, 0.0f);
		float WeightSum = 1.0f;

		[unroll(16)]
		for (int Tap = 1; Tap <= Taps; ++Tap)
		{
			const float NormalizedDistance = (float)Tap / Sigma;
			const float Weight = exp(-0.5f * NormalizedDistance * NormalizedDistance);
			const float2 Offset = Texel * (float)Tap;
			Sum += PreviousHeight.SampleLevel(LinearWrapSampler, UV + Offset, 0.0f) * Weight;
			Sum += PreviousHeight.SampleLevel(LinearWrapSampler, UV - Offset, 0.0f) * Weight;
			WeightSum += 2.0f * Weight;
		}

		OutputHeight[Pixel] = Sum / WeightSum;
		return;
	}

	if (NormalPass != 0)
	{
		const int XMinus = WrapI(Pixel.x - 1, OutputSize.x);
		const int XPlus = WrapI(Pixel.x + 1, OutputSize.x);
		const int YMinus = WrapI(Pixel.y - 1, OutputSize.y);
		const int YPlus = WrapI(Pixel.y + 1, OutputSize.y);

		#define ML_CARVE(PX, PY) (SourceHeight.Load(int3(PX, PY, 0)) - PreviousHeight.Load(int3(PX, PY, 0)))
		const float Dmm = ML_CARVE(XMinus, YMinus);
		const float D0m = ML_CARVE(Pixel.x, YMinus);
		const float Dpm = ML_CARVE(XPlus, YMinus);
		const float Dm0 = ML_CARVE(XMinus, Pixel.y);
		const float Dp0 = ML_CARVE(XPlus, Pixel.y);
		const float Dmp = ML_CARVE(XMinus, YPlus);
		const float D0p = ML_CARVE(Pixel.x, YPlus);
		const float Dpp = ML_CARVE(XPlus, YPlus);
		#undef ML_CARVE

		const float2 CarveGradient = float2(
			(Dpm + 2.0f * Dp0 + Dpp) - (Dmm + 2.0f * Dm0 + Dmp),
			(Dmp + 2.0f * D0p + Dpp) - (Dmm + 2.0f * D0m + Dpm))
			* (NormalStrength / 8.0f);
		const float3 CarveNormal = normalize(float3(CarveGradient, 1.0f));
		const float3 BaseNormal = normalize(
			PreviousNormal.Load(int3(Pixel, 0)).xyz * 2.0f - 1.0f);
		const float3 T = BaseNormal + float3(0.0f, 0.0f, 1.0f);
		const float3 U = CarveNormal * float3(-1.0f, -1.0f, 1.0f);
		const float3 Combined = normalize(T * dot(T, U) / max(T.z, 1.0e-5f) - U);

		OutputNormal[Pixel] = float4(Combined * 0.5f + 0.5f, 1.0f);
		OutputHeight[Pixel] = Height;
		return;
	}

	const int Radius = max(SlopeRadius, 1);
	const int XMinus = WrapI(Pixel.x - Radius, OutputSize.x);
	const int XPlus = WrapI(Pixel.x + Radius, OutputSize.x);
	const int YMinus = WrapI(Pixel.y - Radius, OutputSize.y);
	const int YPlus = WrapI(Pixel.y + Radius, OutputSize.y);

	const float Hmm = GuideHeight.Load(int3(XMinus, YMinus, 0));
	const float H0m = GuideHeight.Load(int3(Pixel.x, YMinus, 0));
	const float Hpm = GuideHeight.Load(int3(XPlus, YMinus, 0));
	const float Hm0 = GuideHeight.Load(int3(XMinus, Pixel.y, 0));
	const float Hp0 = GuideHeight.Load(int3(XPlus, Pixel.y, 0));
	const float Hmp = GuideHeight.Load(int3(XMinus, YPlus, 0));
	const float H0p = GuideHeight.Load(int3(Pixel.x, YPlus, 0));
	const float Hpp = GuideHeight.Load(int3(XPlus, YPlus, 0));
	const float GuideCenter = GuideHeight.Load(int3(Pixel, 0));

	const float2 StepUV = (float)Radius / Resolution;
	const float Hxx = (Hp0 - 2.0f * GuideCenter + Hm0) / (StepUV.x * StepUV.x);
	const float Hyy = (H0p - 2.0f * GuideCenter + H0m) / (StepUV.y * StepUV.y);
	const float Hxy = (Hpp - Hpm - Hmp + Hmm) / (4.0f * StepUV.x * StepUV.y);
	const float HalfTrace = 0.5f * (Hxx + Hyy);
	const float Spread = 0.5f * (Hxx - Hyy);
	const float Discriminant = sqrt(max(Spread * Spread + Hxy * Hxy, 0.0f));
	float Curvature = CurvatureMode == 1
		? HalfTrace + Discriminant
		: (CurvatureMode == 2 ? -(HalfTrace - Discriminant) : HalfTrace);
	Curvature *= 0.5f * (StepUV.x + StepUV.y);

	const float CavityWeight = RemapSmooth(
		CavityRemapMin, CavityRemapMax, Curvature + CavityOffset);
	const float CavityGate = saturate(lerp(1.0f, CavityWeight, CavityInfluence));

	const float HeightWeight = RemapSmooth(
		-1.0f, 1.0f, (Height - 0.5f) * HeightScale * 2.0f);
	const float HeightGate = saturate(lerp(1.0f, HeightWeight, HeightInfluence));

	float PlacementMask = LayerMask.SampleLevel(LinearWrapSampler, UV, 0.0f);
	PlacementMask = InvertMask != 0 ? 1.0f - PlacementMask : PlacementMask;
	const float Placement = saturate(Amount) * saturate(PlacementMask) * CavityGate * HeightGate;

	const float3 InitialSlope = MaximumDirectionalSlope(UV, GuideCenter);
	const float2 Downhill = InitialSlope.xy;
	const float MeasuredSlope = InitialSlope.z;
	const float SteeringMagnitude = lerp(
		MeasuredSlope, max(AssumedSlope, 0.0f), saturate(AssumedSlopeAmount));
	float2 WorkingGradient = -Downhill * SteeringMagnitude;

	float FadeTarget = saturate((Height - 0.5f) * HeightScale + 0.5f) * 2.0f - 1.0f;
	const float InputRounding = lerp(
		CreaseRounding, RidgeRounding, saturate(FadeTarget * 0.5f + 0.5f));
	float CombinedMask = EaseOut(SmoothStart(
		MeasuredSlope * SlopeOnset, InputRounding * SlopeOnset));
	float RidgeCombinedMask = EaseOut(MeasuredSlope * SlopeOnset);
	float RidgeTarget = FadeTarget;
	float HeightDelta = 0.0f;
	float MaximumMagnitude = 0.0f;
	float Amplitude = max(Strength, 0.0f);
	float RoundingScale = 1.0f;
	int Cells = max(Period, 1);
	const int OctaveCount = clamp(Octaves, 1, 12);

	[loop]
	for (int Octave = 0; Octave < 12; ++Octave)
	{
		if (Octave >= OctaveCount || Cells > max(OutputSize.x, OutputSize.y))
		{
			break;
		}

		const float2 GullyDirection = SafeNormalize(-WorkingGradient, Downhill);
		const float4 Stripe = MixtormatPeriodicStripeField(
			UV * (float)Cells,
			GullyDirection,
			Cells,
			Seed + (uint)Octave * 977u,
			Normalization);
		const float2 PhaseGradient = Stripe.zw * (float)Cells;

		// Constant-magnitude feedback treats each cosine band as a triangle only while steering.
		// The visible height remains smooth, while finer bands branch cleanly at crests and troughs.
		const float SineSign = Stripe.y >= 0.0f ? 1.0f : -1.0f;
		WorkingGradient += -SineSign * PhaseGradient * Amplitude * GullyWeight;

		const float RawGully = Stripe.x * GullyWeight;
		const float FadedGully = lerp(FadeTarget, RawGully, CombinedMask);
		HeightDelta += FadedGully * Amplitude;
		MaximumMagnitude += Amplitude * max(1.0f, abs(GullyWeight));
		FadeTarget = FadedGully;

		const float Rounding = lerp(
			CreaseRounding, RidgeRounding, saturate(Stripe.x * 0.5f + 0.5f))
			* RoundingScale;
		const float FeatureMask = EaseOut(SmoothStart(
			abs(Stripe.y) * FeatureOnset, Rounding * FeatureOnset));
		CombinedMask = PowInverse(CombinedMask, Detail) * FeatureMask;

		RidgeTarget = lerp(RidgeTarget, Stripe.x, RidgeCombinedMask);
		RidgeCombinedMask *= EaseOut(abs(Stripe.y) * FeatureOnset);

		Amplitude *= saturate(Gain);
		RoundingScale *= 2.0f;
		Cells *= 2;
	}

	// Shift the signed stacked field down by its maximum positive excursion. The relative
	// ridge/crease structure remains intact, but a material filter never creates new volume.
	const float CarveDelta = min(0.5f * (HeightDelta - MaximumMagnitude), 0.0f);
	OutputHeight[Pixel] = Height + CarveDelta * Placement;
	OutputRidge[Pixel] = saturate(abs(RidgeTarget) * (1.0f - RidgeCombinedMask)) * Placement;
	OutputNormal[Pixel] = PreviousNormal.Load(int3(Pixel, 0));
}
