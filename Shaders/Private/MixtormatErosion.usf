#include "/Engine/Public/Platform.ush"
#include "/Plugin/MaterialLab/Private/MixtormatGully.ush"
#include "/Plugin/MaterialLab/Private/MixtormatFlow.ush"

// Erosion filter. One dispatch is one carving pass; the compositor runs several, each
// re-differentiating the height the previous pass wrote so channels propagate and merge
// rather than each pixel evolving a private estimate of the slope.
//
// Subtractive by construction: the result is a smooth minimum against the incoming
// height, so the filter only ever removes material.

Texture2D<float> PreviousHeight;
Texture2D<float> SourceHeight;
Texture2D<float4> PreviousNormal;
Texture2D<float> GuideHeight;
Texture2D<float2> FlowField;
Texture2D<float> PreviousRidge;
SamplerState LinearWrapSampler;
RWTexture2D<float> OutputHeight;
RWTexture2D<float> OutputRidge;
RWTexture2D<float4> OutputNormal;

int2 OutputSize;
int Pass;
int NormalPass;
int BlurPass;
int BlurAxis;
int ResamplePass;
int ResampleRidge;
float BlurRadius;
float NormalStrength;
float Amount;
float Strength;
int Period;
float GullyLength;
int LicSteps;
float Repose;
float ReposeSoftness;
int CurvatureMode;
float CavityInfluence;
float CavityOffset;
float CavityRemapMin;
float CavityRemapMax;
float HeightInfluence;
float HeightScale;
float GullyWeight;
float BlendSoftness;
float Gain;
float DerivScale;
int DerivMin;
int DirectionMode;
float DirectionAngle;
float DirectionAmount;
uint Seed;

// Neighbour taps wrap so a tiling surface erodes seamlessly across the repeat.
int WrapI(int x, int m)
{
	x = x % m;
	return x < 0 ? x + m : x;
}

float SmoothStepF(float a, float b, float x)
{
	float t = saturate((x - a) / max(b - a, 1.0e-6f));
	return t * t * (3.0f - 2.0f * t);
}

// An input window mapped to 0..1 and eased. Unlike SmoothStepF this accepts a descending
// window: Lo > Hi inverts the result, which is how the cavity gate is aimed at ridges
// instead of channels without a second sign control. SmoothStepF cannot express that,
// because its max(b - a, eps) collapses a descending window to a step at a.
float RemapSmooth(float Lo, float Hi, float x)
{
	const float Range = Hi - Lo;
	const float t = abs(Range) > 1.0e-6f
		? saturate((x - Lo) / Range)
		: (x >= Lo ? 1.0f : 0.0f);
	return t * t * (3.0f - 2.0f * t);
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 Pixel = int2(DispatchThreadId.xy);
	const float2 Resf = float2(OutputSize);
	const float2 UV = (float2(Pixel) + 0.5f) / Resf;

	// Resample. Moves height and normal between the composition resolution and the higher
	// internal erosion resolution, in either direction. A bilinear tap at the destination
	// texel centre lands on the 2x2 centroid at 2:1, so the downsample is an exact
	// four-texel average rather than a point-sampled decimation.
	//
	// Runs before the Load()s below because source and destination differ in size here,
	// which is exactly the case those unclamped loads do not handle.
	if (ResamplePass != 0)
	{
		OutputHeight[Pixel] = PreviousHeight.SampleLevel(LinearWrapSampler, UV, 0.0f);

		// Averaging encoded normals and renormalising the encoded value would aim at the
		// corner of the unit cube, not the surface. Decode, renormalise, re-encode.
		const float4 N = PreviousNormal.SampleLevel(LinearWrapSampler, UV, 0.0f);
		const float3 Decoded = normalize(N.xyz * 2.0f - 1.0f);
		OutputNormal[Pixel] = float4(Decoded * 0.5f + 0.5f, N.w);

		// The ridge rides the downsample so it reaches composition resolution in the same
		// dispatch as the height and normal. Gated rather than always written: the upsample
		// runs at erosion resolution against the 1x1 dummy, and writing there would put
		// thousands of threads out of bounds.
		if (ResampleRidge != 0)
		{
			OutputRidge[Pixel] = PreviousRidge.SampleLevel(LinearWrapSampler, UV, 0.0f);
		}
		return;
	}

	const float H0 = SourceHeight.Load(int3(Pixel, 0));
	const float H = PreviousHeight.Load(int3(Pixel, 0));

	// Guidance pre-pass. Separable Gaussian, one axis per dispatch.
	//
	// This was a fixed nine-tap kernel whose taps sat at exactly +/-BlurRadius texels, and
	// that is where the dithering came from. Widening the radius moved the taps apart without
	// adding any, so past one texel a pixel and its neighbour sampled disjoint sets: at the
	// default radius of 2, pixel x read {x-2, x, x+2} and pixel x+1 read {x-1, x+1, x+3},
	// sharing nothing. The output then decomposed into independent interleaved lattices --
	// a gridded field, not a blurred one. Raising the slider made it worse rather than
	// better, which is why no blur amount helped.
	//
	// Integer radii are the worst case, because bilinear pickup gives neighbours partial
	// overlap at fractional ones. The old comment claimed fractional radii were the point
	// while the default sat exactly on an integer.
	//
	// The fix is that the tap count scales with the radius, not only the spacing. Taps are
	// one texel apart regardless of radius, so neighbouring pixels always share all but two
	// of them. Separable because a 2D kernel this wide is 33x33 at the slider maximum.
	//
	// Three things downstream read this, which is why one gridded guide reads so strongly:
	// the repose gate multiplies the whole carve, the flow direction steers the gully LIC so
	// each pixel integrates along a different line, and the Hessian divides by StepUV squared.
	if (BlurPass != 0)
	{
		const float2 Texel = (BlurAxis == 0 ? float2(1.0f, 0.0f) : float2(0.0f, 1.0f)) / Resf;

		// Radius is the extent, sigma half of it, so two sigma lands on the authored radius.
		const float Sigma = max(BlurRadius, 1.0e-4f) * 0.5f;
		const int Taps = clamp((int)ceil(BlurRadius), 1, 16);

		float Sum = PreviousHeight.SampleLevel(LinearWrapSampler, UV, 0.0f);
		float WeightSum = 1.0f;

		[unroll(16)]
		for (int k = 1; k <= Taps; ++k)
		{
			const float t = (float)k / Sigma;
			const float w = exp(-0.5f * t * t);
			const float2 Offset = Texel * (float)k;
			Sum += w * PreviousHeight.SampleLevel(LinearWrapSampler, UV + Offset, 0.0f);
			Sum += w * PreviousHeight.SampleLevel(LinearWrapSampler, UV - Offset, 0.0f);
			WeightSum += 2.0f * w;
		}

		// No normal write. It used to copy PreviousNormal straight through, which was dead:
		// the final normal pass writes every pixel of the same target before anything reads
		// it. With two blur dispatches it would also have run twice.
		OutputHeight[Pixel] = Sum / WeightSum;
		return;
	}


	// Final pass: turn the accumulated carve into a normal perturbation. Height alone
	// leaves shading flat over a carved surface, so the gradient of what was removed is
	// converted to a tangent normal and combined with the layer normal by RNM, the same
	// way border lift does.
	if (NormalPass != 0)
	{
		const int ax = WrapI(Pixel.x - 1, OutputSize.x);
		const int bx = WrapI(Pixel.x + 1, OutputSize.x);
		const int ay = WrapI(Pixel.y - 1, OutputSize.y);
		const int by = WrapI(Pixel.y + 1, OutputSize.y);

		// D is what erosion removed, always >= 0.
		#define ML_CARVE(px, py) (SourceHeight.Load(int3(px, py, 0)) - PreviousHeight.Load(int3(px, py, 0)))
		const float d_mm = ML_CARVE(ax, ay);
		const float d_0m = ML_CARVE(Pixel.x, ay);
		const float d_pm = ML_CARVE(bx, ay);
		const float d_m0 = ML_CARVE(ax, Pixel.y);
		const float d_p0 = ML_CARVE(bx, Pixel.y);
		const float d_mp = ML_CARVE(ax, by);
		const float d_0p = ML_CARVE(Pixel.x, by);
		const float d_pp = ML_CARVE(bx, by);
		#undef ML_CARVE

		// Sobel, matching the slope stencil above. A four-tap central difference is the
		// noisiest estimator available and is axis-biased, which is the same reason
		// MixtormatCurvature.ush moved off one; here it mattered more, because the carve
		// depth is a difference of two nearly equal heights and NormalStrength then
		// multiplies whatever noise survives.
		//
		// The 1/8 keeps the scale a central difference had, so NormalStrength means what it
		// meant before: on a linear ramp both estimators return the per-pixel slope.
		//
		// Height per pixel times a plain gain. Multiplying by resolution here made any
		// visible carve read as a near-vertical normal.
		const float2 dD = float2(
			(d_pm + 2.0f * d_p0 + d_pp) - (d_mm + 2.0f * d_m0 + d_mp),
			(d_mp + 2.0f * d_0p + d_pp) - (d_mm + 2.0f * d_0m + d_pm)) * (NormalStrength / 8.0f);
		const float3 CarveN = normalize(float3(dD.x, dD.y, 1.0f));

		float3 BaseN = PreviousNormal.Load(int3(Pixel, 0)).xyz * 2.0f - 1.0f;
		BaseN = normalize(BaseN);

		// Reoriented normal mapping.
		const float3 T = BaseN + float3(0.0f, 0.0f, 1.0f);
		const float3 U = CarveN * float3(-1.0f, -1.0f, 1.0f);
		const float3 Combined = normalize(T * dot(T, U) / max(T.z, 1.0e-5f) - U);

		OutputNormal[Pixel] = float4(Combined * 0.5f + 0.5f, 1.0f);
		OutputHeight[Pixel] = H;
		return;
	}


	// Hold the octave at the finest useful band. Past about two pixels per cell there is no
	// detail left to add, only aliasing, so later passes keep relaxing at that band.
	int MaxOctave = 0;
	{
		float Cells = (float)max(Period, 1);
		[loop]
		while (Cells * 2.0f <= Resf.x * 0.5f && MaxOctave < 20)
		{
			Cells *= 2.0f;
			MaxOctave++;
		}
	}
	const int Octave = min(Pass, MaxOctave);
	const float Freq = (float)max(Period, 1) * exp2((float)Octave);
	const int Per = max(Period, 1) << min(Octave, 20);
	const float Amp = Strength * pow(max(Gain, 0.0f), (float)Octave);

	// Slope is measured locally, at a fixed small radius, never scaled to the octave cell.
	// Scaling it to the cell makes the Sobel taps hundreds of pixels apart, so the measured
	// slope is piecewise constant over large blocks; the gate and the flow direction then
	// hold constant across each block and the carve comes out as axis-aligned rectangles.
	const int R = max(DerivMin, 1);

	const int xm = WrapI(Pixel.x - R, OutputSize.x);
	const int xp = WrapI(Pixel.x + R, OutputSize.x);
	const int ym = WrapI(Pixel.y - R, OutputSize.y);
	const int yp = WrapI(Pixel.y + R, OutputSize.y);

	const float h_mm = GuideHeight.Load(int3(xm, ym, 0));
	const float h_0m = GuideHeight.Load(int3(Pixel.x, ym, 0));
	const float h_pm = GuideHeight.Load(int3(xp, ym, 0));
	const float h_m0 = GuideHeight.Load(int3(xm, Pixel.y, 0));
	const float h_p0 = GuideHeight.Load(int3(xp, Pixel.y, 0));
	const float h_mp = GuideHeight.Load(int3(xm, yp, 0));
	const float h_0p = GuideHeight.Load(int3(Pixel.x, yp, 0));
	const float h_pp = GuideHeight.Load(int3(xp, yp, 0));

	// Sobel. Both partials use the same forward-minus-backward convention in index space.
	const float Inv = 1.0f / (8.0f * (float)R);
	const float2 Slope = float2(
		((h_pm + 2.0f * h_p0 + h_pp) - (h_mm + 2.0f * h_m0 + h_mp)) * Inv * Resf.x,
		((h_mp + 2.0f * h_0p + h_pp) - (h_mm + 2.0f * h_0m + h_pm)) * Inv * Resf.y);

	const float SLen = length(Slope);
	const float2 SlopeDir = SLen > 1.0e-6f ? -Slope / SLen : float2(0.0f, 1.0f);

	// Authored direction blended against downhill. Weight adds it to the raw slope vector
	// so it competes with steepness; Lerp blends the directions evenly.
	//
	// Flow replaces the downhill term with the coherent tangent of the surface below,
	// oriented downhill. A gully then runs along whatever channel already exists rather
	// than straight down the local gradient, and crosses a noisy patch without wandering,
	// because the direction was agreed over a neighbourhood rather than measured at a
	// pixel. Coherency does the falling back on its own: where the field has no dominant
	// orientation it decays to 0 and this returns plain downhill, so flat and isotropic
	// ground behaves exactly as it did before.
	const float Rad = DirectionAngle * (3.14159265358979f / 180.0f);
	const float2 FixedDir = float2(cos(Rad), sin(Rad));

	float2 Downhill = SlopeDir;
	if (DirectionMode == 2)
	{
		float Coherency;
		const float2 Tangent = MixtormatFlowTangent(
			FlowField.SampleLevel(LinearWrapSampler, UV, 0.0f), Coherency);
		Downhill = normalize(lerp(SlopeDir, MixtormatOrientAlong(Tangent, SlopeDir), Coherency));
	}

	const float2 V = DirectionMode == 0
		? (-Slope + FixedDir * DirectionAmount)
		: lerp(Downhill, FixedDir, DirectionAmount);
	const float VLen = length(V);
	const float2 Dir = VLen > 1.0e-6f ? V / VLen : FixedDir;

	// Angle of repose. Nothing moves until the slope passes the critical angle; past it,
	// carving scales with the excess.
	const float SlopeGate = SmoothStepF(Repose, Repose + max(ReposeSoftness, 1.0e-4f), SLen);

	// Curvature restriction. Material collects in channels and creases rather than spreading
	// evenly over every steep face.
	//
	// The full Hessian, not just its trace. The eight taps above are exactly the stencil a
	// mixed second derivative needs, so the principal curvatures cost no extra fetches, and
	// the trace is the wrong measure for a channel: an elongated one has Hxx = k, Hyy = 0,
	// so the trace reports half its depth, and on a saddle Hxx = -Hyy cancels it outright.
	// Saddles are exactly where drainage starts. The larger principal curvature reads both
	// at full strength, and a channel crossing a broad convex form -- the common case on a
	// composited height -- survives it where the trace nearly cancels.
	//
	// Signs are the raw height-field convention: a channel is concave up, so its second
	// derivative is positive, and positive is the named feature in every mode.
	// MixtormatCurvature.ush negates because it differentiates the normal, which already
	// points against the gradient. That negation was carried here in error and is gone:
	// Cavity Influence used to suppress carving in channels and promote it on bumps, the
	// opposite of what it is named for.
	const float h_00 = GuideHeight.Load(int3(Pixel, 0));
	const float2 StepUV = (float)R / Resf;

	const float Hxx = (h_p0 - 2.0f * h_00 + h_m0) / (StepUV.x * StepUV.x);
	const float Hyy = (h_0p - 2.0f * h_00 + h_0m) / (StepUV.y * StepUV.y);
	const float Hxy = (h_pp - h_pm - h_mp + h_mm) / (4.0f * StepUV.x * StepUV.y);

	// Closed-form eigenvalues of the symmetric 2x2.
	const float HalfTrace = 0.5f * (Hxx + Hyy);
	const float Spread = 0.5f * (Hxx - Hyy);
	const float Disc = sqrt(max(Spread * Spread + Hxy * Hxy, 0.0f));

	//   0 Mean    half the trace: the average of the two principal curvatures.
	//   1 Valley  the larger principal curvature: how concave the most concave direction is.
	//   2 Ridge   the negated smaller one: how convex the most convex direction is.
	float Curvature = CurvatureMode == 1
		? HalfTrace + Disc
		: (CurvatureMode == 2 ? -(HalfTrace - Disc) : HalfTrace);

	// Into the units Repose is authored in. The Hessian above is height per UV squared;
	// multiplying by one stencil length gives height per UV, the same quantity the slope
	// gate thresholds. Without this the remap window would have to be scrubbed in the
	// thousands, and it would move by a factor of four every time the internal resolution
	// doubled -- the half-normalisation the plan recorded as a known consequence.
	Curvature *= 0.5f * (StepUV.x + StepUV.y);

	const float CavityWeight = RemapSmooth(CavityRemapMin, CavityRemapMax, Curvature + CavityOffset);
	const float CavityGate = lerp(1.0f, CavityWeight, CavityInfluence);

	// Height restriction. Raised ground is exposed and weathers first, so positive
	// influence concentrates carving where the composited height is high. Negative
	// inverts it onto low ground. Same shape as the cavity pair: the signal is centred
	// so flat mid height sits at 0.5, and influence past 1 expands contrast.
	const float HeightSignal = (H - 0.5f) * HeightScale * 2.0f;
	const float HeightWeight = SmoothStepF(-1.0f, 1.0f, HeightSignal);
	const float HeightGate = lerp(1.0f, HeightWeight, HeightInfluence);

	const float Gate = SlopeGate * CavityGate * HeightGate;

	const float3 G = MixtormatGullyField(
		UV * Freq,
		Dir,
		Per,
		Seed + (uint)Octave * 977u,
		LicSteps,
		GullyLength);

	const float Carved = H + G.x * Amp * Gate * GullyWeight;

	// Height blend rather than a hard min: same subtractive behaviour, but the crossover
	// is rounded so the carve does not stamp a crease into the derived normals.
	const float NewH = MixtormatSoftSubtract(H, Carved, BlendSoftness);

	OutputHeight[Pixel] = lerp(H0, NewH, Amount);
	OutputNormal[Pixel] = PreviousNormal.Load(int3(Pixel, 0));

	// Ridges are where successive passes keep agreeing on a crest.
	const float PrevRidge = OutputRidge[Pixel];
	OutputRidge[Pixel] = max(PrevRidge, saturate(abs(G.x)) * Gate);
}
