#include "/Engine/Public/Platform.ush"

// Directional material-texture erosion. Horizon exposure seeds a carve-depth field from the
// immutable input; min-plus eikonal relaxation propagates that offset at UnitDistance, keeping
// the source shape as a fixed obstacle. The tangent XYZ vector sets horizon direction/elevation.

Texture2D<float> PreviousHeight;
Texture2D<float> SourceHeight;
Texture2D<float> SeedCarve;
Texture2D<float> PreviousCarve;
Texture2D<float4> PreviousNormal;
Texture2D<float> LayerMask;
Texture2D<float4> PlacementMaskTexture;
Texture2D<float> PreviousRidge;
SamplerState LinearWrapSampler;
RWTexture2D<float> OutputHeight;
RWTexture2D<float> OutputRidge;
RWTexture2D<float> OutputCarve;
// Resample-only. The wear pass never writes normals -- the shared height-derived pass owns
// them -- so iterations bind a 1x1 dummy here instead of paying a full-screen copy.
RWTexture2D<float4> OutputNormal;

int2 OutputSize;
int ResamplePass;
int ResampleRidge;
int SmearPass;
int ResolvePass;
int SeedPass;
uint WriteRidge;
float Amount;
float Depth;
float UnitDistance;
float3 Direction;
// @param ErosionRadius
int Radius;
int Stride;
// @param ErosionGravityForce
float GravityForce;
// @param ErosionSlopePower
float SlopePower;
float Deposit;
float PreserveFlats;
float Smoothing;
float SecondaryAmount;
float Variation;
// @param ErosionSeed
uint Seed;
uint UsePlacementMask;
// @param ErosionMaskTiling
float PlacementMaskTiling;
uint InvertMask;

// Internal response scales; horizon reach is eight analysis spans, while Voronoi depth
// supplies chipped hardness regions without adding shader bindings.
static const float ErosionVariationScale = 0.35;
static const float ErosionSmearLength = 8.0;
static const int ErosionRadiusBound = 4;
static const int ErosionHorizonSteps = 8;
static const int ErosionVoronoiCells = 12;

// Tileable lattice hash for the variation field. The cell wraps on a 32-period lattice so
// the noise tiles with the texture; the hash is the same family the rest of the plugin's
// procedural noise uses.
float ErosionHashCell(int2 Cell, uint Seed)
{
	const int Period = 32;
	int2 C = int2(Cell.x % Period, Cell.y % Period);
	C = (C + Period) % Period;
	uint H = (uint)C.x * 0x27d4eb2du ^ (uint)C.y * 0x165667b1u ^ Seed * 0x9e3779b9u;
	H ^= H >> 16;
	H *= 0x7feb352du;
	H ^= H >> 15;
	H *= 0x846ca68bu;
	H ^= H >> 16;
	return (float)(H & 0x00FFFFFFu) * (1.0f / 16777216.0f);
}

// Fractal value noise over that lattice: two bilinear octaves at large periods, so the
// variation reads as broad material-hardness patches rather than per-pixel dither.
float ErosionVariationField(float2 UV, uint Seed)
{
	float Field = 0.0f;
	float Total = 0.0f;
	float Amplitude = 0.5f;

	[unroll]
	for (int Octave = 0; Octave < 2; ++Octave)
	{
		const int LatticePeriod = 8 * (1 << Octave);
		const float2 P = UV * (float)LatticePeriod;
		const int2 I = (int2)floor(P);
		const float2 F = P - (float2)I;
		const float2 S = F * F * (3.0f - 2.0f * F);
		const uint OctaveSeed = Seed + (uint)Octave * 977u;
		const int2 IW = (I % LatticePeriod + LatticePeriod) % LatticePeriod;
		const int2 IX = (IW + int2(1, 0)) % LatticePeriod;
		const int2 IY = (IW + int2(0, 1)) % LatticePeriod;
		const int2 IXY = (IW + int2(1, 1)) % LatticePeriod;
		const float A = ErosionHashCell(IW, OctaveSeed);
		const float B = ErosionHashCell(IX, OctaveSeed);
		const float C = ErosionHashCell(IY, OctaveSeed);
		const float D = ErosionHashCell(IXY, OctaveSeed);
		Field += Amplitude * lerp(lerp(A, B, S.x), lerp(C, D, S.x), S.y);
		Total += Amplitude;
		Amplitude *= 0.5f;
	}

	return Field / Total;
}

// Periodic Voronoi cell depth, used as a subtle local material-hardness/chip pattern.
float ErosionVoronoiDepth(float2 UV, uint Seed)
{
	const int Cells = ErosionVoronoiCells;
	const float2 P = frac(UV) * (float)Cells;
	const int2 Base = (int2)floor(P);
	float Nearest = 1.0e20f;
	float Depth = 0.5f;

	[unroll]
	for (int Y = -1; Y <= 1; ++Y)
	{
		[unroll]
		for (int X = -1; X <= 1; ++X)
		{
			const int2 Cell = Base + int2(X, Y);
			const int2 Wrapped = (Cell % Cells + Cells) % Cells;
			const float A = ErosionHashCell(Wrapped, Seed + 173u);
			const float B = ErosionHashCell(Wrapped, Seed + 619u);
			const float2 Feature = (float2)Cell + float2(A, B);
			const float Distance = dot(Feature - P, Feature - P);
			if (Distance < Nearest)
			{
				Nearest = Distance;
				Depth = ErosionHashCell(Wrapped, Seed + 1297u);
			}
		}
	}
	return Depth;
}

float ErosionReadGate(
	float2 UV,
	Texture2D<float> MaskTex,
	Texture2D<float4> PlacementTex,
	uint bUsePlacement,
	float PlacementTiling,
	uint bInvert)
{
	float Mask = bUsePlacement != 0
		? PlacementTex.SampleLevel(
			LinearWrapSampler, frac(UV * max(PlacementTiling, 1.0f)), 0.0f).r
		: MaskTex.SampleLevel(LinearWrapSampler, UV, 0.0f);
	Mask = bInvert != 0 ? 1.0f - Mask : Mask;
	return saturate(Mask);
}

float2 ErosionTangentDirection()
{
	// Preserve the authored tangent direction and legacy gravity bias in solve and smear.
	const float2 DirectionXY = Direction.xy + float2(0.0f, -saturate(GravityForce) * 0.1f);
	return length(DirectionXY) > 1.0e-6f
		? normalize(DirectionXY) : float2(0.0f, -1.0f);
}

float ErosionResolvedHeight(float2 UV)
{
	return SourceHeight.SampleLevel(LinearWrapSampler, UV, 0.0f)
		- PreviousCarve.SampleLevel(LinearWrapSampler, UV, 0.0f);
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 Pixel = int2(DispatchThreadId.xy);
	const float2 Resolution = float2(OutputSize);
	const float2 UV = (float2(Pixel) + 0.5f) / Resolution;

	if (ResamplePass != 0)
	{
		OutputHeight[Pixel] = PreviousHeight.SampleLevel(LinearWrapSampler, UV, 0.0f);
		const float4 EncodedNormal = PreviousNormal.SampleLevel(LinearWrapSampler, UV, 0.0f);
		const float3 Normal = normalize(EncodedNormal.xyz * 2.0f - 1.0f);
		OutputNormal[Pixel] = float4(Normal * 0.5f + 0.5f, EncodedNormal.w);
		if (ResampleRidge != 0)
		{
			OutputRidge[Pixel] = PreviousRidge.SampleLevel(LinearWrapSampler, UV, 0.0f);
		}
		return;
	}

	const float Gate = ErosionReadGate(
		UV, LayerMask, PlacementMaskTexture, UsePlacementMask, PlacementMaskTiling, InvertMask);

	// Post-iteration deposit smear: drag the settled height downstream along the flow the
	// solve converged to. Refill-only -- the blend can only raise toward the upstream
	// average, and the volume clamp keeps it under what the layer composited -- so tails
	// and runoff runs form below eroded areas and the pass is an exact no-op at Deposit 0.
	if (ResolvePass != 0)
	{
		const float Source = SourceHeight.Load(int3(Pixel, 0));
		const float Height = Source - PreviousCarve.Load(int3(Pixel, 0));
		if (SmearPass == 0 || Gate <= 0.0f)
		{
			OutputHeight[Pixel] = Height;
			return;
		}

		const float2 FlowDir = -ErosionTangentDirection();

		float SmearSum = 0.0f;
		float WeightSum = 0.0f;
		[unroll]
		for (int Tap = 0; Tap < 5; ++Tap)
		{
			const float T = (float)Tap / 5.0f;
			const float2 SampleUV = UV + FlowDir * (ErosionSmearLength * T / Resolution);
			const float Weight = 1.0f - T;
			SmearSum += Weight * ErosionResolvedHeight(SampleUV);
			WeightSum += Weight;
		}
		const float SmearHeight = SmearSum / WeightSum;

		const float Blend = Deposit * Gate;
		float NewHeight = Height + Blend * max(SmearHeight - Height, 0.0f);
		NewHeight = min(NewHeight, max(Source, Height));
		OutputHeight[Pixel] = NewHeight;
		return;
	}

	// Tangent XY aims the horizon ray; authored Z sets its elevation.
	const float2 TangentDir = ErosionTangentDirection();

	const int Span = clamp((int)Radius, 1, ErosionRadiusBound) * max(Stride, 1);
	if (SeedPass != 0)
	{
		const float Source = SourceHeight.Load(int3(Pixel, 0));
		const float3 HorizonDirection = normalize(float3(TangentDir, max(Direction.z, 0.01f)));
		const float HorizonLimit = HorizonDirection.z
			/ max(length(HorizonDirection.xy), 1.0e-4f) / 256.0f;
		const float SlopeNorm = max(max(Resolution.x, Resolution.y), 1.0f) / 256.0f;
		float MaxHorizonSlope = -1.0e6f;
		[unroll]
		for (int Step = 1; Step <= ErosionHorizonSteps; ++Step)
		{
			const float Distance = (float)(Step * Span);
			const float2 SampleUV = UV + TangentDir * (Distance / Resolution);
			const float SampleHeight = SourceHeight.SampleLevel(LinearWrapSampler, SampleUV, 0.0f);
			const float RaySlope = (SampleHeight - Source) / max(Distance, 1.0f) * SlopeNorm;
			MaxHorizonSlope = max(MaxHorizonSlope, RaySlope);
		}

		const float HorizonFeather = lerp(0.015f, 0.08f, saturate(Smoothing)) / 256.0f;
		const float Exposure = 1.0f - smoothstep(
			HorizonLimit - HorizonFeather, HorizonLimit + HorizonFeather, MaxHorizonSlope);
		const float Threshold = saturate(PreserveFlats);
		const float SeedExposure = pow(
			saturate((Exposure - Threshold) / max(1.0f - Threshold, 1.0e-4f)),
			max(SlopePower, 0.01f));

		// Angular flow noise is bent by the source height and its slope along the light
		// tangent. The warp stays periodic with UV, while the horizon band concentrates
		// secondary eikonal seeds on exposed/sheltered boundaries.
		float CellDepth = 0.5f;
		float SecondarySeed = 0.0f;
		if (SecondaryAmount > 0.0f || Variation > 0.0f)
		{
			const float2 PerpDir = float2(-TangentDir.y, TangentDir.x);
			const float2 BendStep = TangentDir * ((float)Span / Resolution);
			const float HeightForward = SourceHeight.SampleLevel(
				LinearWrapSampler, UV + BendStep, 0.0f);
			const float HeightBack = SourceHeight.SampleLevel(
				LinearWrapSampler, UV - BendStep, 0.0f);
			const float HeightBend = 0.5f * (HeightForward - HeightBack);
			const float WarpNoise = ErosionVariationField(UV * 3.0f, Seed + 8111u) - 0.5f;
			const float2 AngularUV = UV
				+ TangentDir * ((Source - 0.5f) * 0.06f + HeightBend * 0.25f)
				+ PerpDir * WarpNoise * 0.025f;
			CellDepth = ErosionVoronoiDepth(AngularUV * 2.0f, Seed + 971u);
			if (SecondaryAmount > 0.0f)
			{
				const float FlowNoise = ErosionVariationField(AngularUV * 3.0f, Seed + 1237u);
				const float SecondaryPattern = smoothstep(0.38f, 0.72f, lerp(FlowNoise, CellDepth, 0.45f));
				const float HorizonBandWidth = HorizonFeather + (0.10f + 0.35f * saturate(SecondaryAmount)) / 256.0f;
				const float HorizonBand = 1.0f - smoothstep(
					HorizonFeather, HorizonBandWidth, abs(MaxHorizonSlope - HorizonLimit));
				SecondarySeed = saturate(SecondaryAmount) * HorizonBand * SecondaryPattern;
			}
		}
		const float CombinedSeed = saturate(SeedExposure + SecondarySeed);

		float ChippedDepth = 1.0f;
		float Hardness = 1.0f;
		if (Variation != 0.0f)
		{
			const float BroadNoise = ErosionVariationField(UV, Seed + 4099u) * 2.0f - 1.0f;
			ChippedDepth = lerp(1.0f, 0.9f + 0.2f * CellDepth, saturate(Variation));
			Hardness = max(0.0f, 1.0f + BroadNoise * Variation * ErosionVariationScale);
		}
		const float SeedDepth = max(Depth, 0.0f) * 0.05f
			* (1.0f - exp(-max(Amount, 0.0f)))
			* CombinedSeed * ChippedDepth * Hardness * Gate;
		OutputCarve[Pixel] = SeedDepth;
		if (WriteRidge != 0u)
		{
			OutputRidge[Pixel] = CombinedSeed * Gate;
		}
		return;
	}

	float Carve = max(SeedCarve.Load(int3(Pixel, 0)), 0.0f);
	if (Gate > 0.0f)
	{
		// Retain the centre so changing jump strides cannot undo earlier relaxation.
		Carve = max(Carve, PreviousCarve.Load(int3(Pixel, 0)));
		// Max-plus relaxation of nonnegative carve depth, equivalent to the min-plus height
		// envelope. Cost controls the ramp slope; immutable source height is resolved later.
		const float StepX = (float)Span / Resolution.x;
		const float StepY = (float)Span / Resolution.y;
		const float SafeUnitDistance = max(abs(UnitDistance), 1.0e-6f);
		[unroll]
		for (int Y = -1; Y <= 1; ++Y)
		{
			[unroll]
			for (int X = -1; X <= 1; ++X)
			{
				if (X == 0 && Y == 0) continue;
				const float2 OffsetUV = float2((float)X * StepX, (float)Y * StepY);
				const float2 OffsetDir = normalize(OffsetUV);
				const float Alignment = abs(dot(OffsetDir, TangentDir));
				const float Anisotropy = lerp(2.0f, 1.0f, Alignment);
				const float Cost = length(OffsetUV) / SafeUnitDistance * Anisotropy;
				const float2 NeighborUV = UV + OffsetUV;
				const float NeighborCarve = PreviousCarve.SampleLevel(
					LinearWrapSampler, NeighborUV, 0.0f);
				Carve = max(Carve, max(NeighborCarve - Cost, 0.0f));
			}
		}
	}

	OutputCarve[Pixel] = Carve;
}
