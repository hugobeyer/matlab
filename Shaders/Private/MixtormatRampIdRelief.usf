#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"
#include "/Plugin/Mixtormat/Private/MixtormatMaskOps.ush"

// Per-region tilt. Takes the gradient field the ramp filter produced and uses it to lift one side
// of every region and sink the other, in the composited height and the matching normal.
//
// This is what stops tiles, cobbles and shards all lying in the same plane. Each region's
// gradient runs along its own random direction, so the surface reads as individually settled
// pieces rather than one flat sheet with a texture on it -- and it costs a multiply, which is why
// it is worth doing before any of the UV work.
//
// A post-layer pass, run where erosion and craquelure relief run. The ramp field is built before
// the layer composites, so tilting there would be painted straight back over. It runs *before*
// craquelure relief in that block on purpose: a crack carved into a tilted tile is right, a tile
// tilted after its crack was carved drags the groove around with it.

// (gradient 0..1, edge feather 0..1).
Texture2D<float2> RampField;
// Optional Pattern-ID edge field: x is distance from the region interior edge in output pixels,
// y is the producer's per-region random draw. Bound on every dispatch; UseEdge gates it.
Texture2D<float2> EdgeField;
Texture2D<float> SourceHeight;
Texture2D<float> GateMask;
uint UseGateMask;
Texture2D<float4> PreviousNormal;
// Bounded analysis roots, not raw identities; excludes pixels outside valid regions.
Texture2D<uint> PatternRegionIds;

RWTexture2D<float> OutputHeight;
RWTexture2D<float4> OutputNormal;

int2 OutputSize;

// Height is authoritative. NormalStrength is an internal neutral Sobel scale; the compositor
// replaces this pass's provisional normal from the final blended height delta.
float HeightAmount;
float NormalStrength;

// Mode shapes a local displacement around neutral 0.5, not the absolute signed height.
// AddSub retains its centred tilt; Min only lowers and Max only raises the surface.
uint BlendMode;

// Pattern IDs only. UseEdge selects the whole pattern model: per-cell elevation plus a chamfer,
// in place of the Ramp From IDs tilt above.
uint UseEdge;
float CellHeightAmount;
float CellHeightRandom;
float BevelHeight;
// Whichever of these matches the unit the edge field was published in. Two values and not one,
// because a pixel width and a cell fraction need different ranges to be draggable, and reusing a
// 0.25..64 pixel slider against a 0..1 relative distance squashes the whole chamfer into the
// first few percent of its curve -- which is what made Profile look like it did nothing.
float BevelWidthPixels;
float BevelWidthCells;
uint BevelRelative;
float BevelVariation;
float BevelRoundness;
float BevelRoundnessRandom;
float BevelInsetPixels;
float GapHeight;
float FeatherGain;

int RampWrap(int X, int Size)
{
	const int R = X % max(Size, 1);
	return R < 0 ? R + Size : R;
}

int2 RampWrapPixel(int2 P)
{
	return int2(RampWrap(P.x, OutputSize.x), RampWrap(P.y, OutputSize.y));
}

// The region ramp's contribution at one pixel, as a signed height delta.
//
// Blend modes operate on the ramp's local signal. Adding their delta preserves underlying
// signed height and detail, including for Replace, Min and Multiply.
//
// Field.x is the ramp, fitted to the region's bounding box by the producer. Field.y is that
// region's own strength draw. Intensity multiplies both as a blend weight, which is what keeps
// this mode-agnostic -- at 0 the surface is untouched under every mode, not just the additive
// ones.
float RampDelta(int2 P)
{
	const int2 W = RampWrapPixel(P);
	const float2 Field = RampField.Load(int3(W, 0)).xy;
	const float Weight = saturate(HeightAmount * Field.y);
	// Apply the mode to a neutral local signal, never to the signed substrate.
	const float Neutral = 0.5f;
	const float Blended = MixtormatApplyMaskOperation(BlendMode, Neutral, saturate(Field.x));
	return (Blended - Neutral) * Weight;
}

// Feather Gain: what the feather's run-out does on the way up, rather than how wide it is.
//
// The published feather is a straight line -- saturate(interior distance / width) -- and a straight
// line is the one shape a normal map cannot show. The Sobel reads a *change* in slope, and a ramp
// of constant slope has none: the whole band comes out as one flat facet and then steps back to
// level at its inner end. That is why feathering a cell can move real height and still look like
// nothing happened.
//
//     Shape(T) = T + Gain * T * (1 - T)
//
// Still pinned at both ends for every Gain, so the grout wall and the flat face stay where they
// are. What changes is everything in between: the slope leaving the wall goes from 1 to 1 + Gain,
// and past Gain 1 the curve arcs above the face and leaves a raised lip just inside the edge --
// the rolled-over rim of a settled tile, and the thing that actually catches light.
//
// The lip is signed displacement too; neither its peak nor the face is limited by 0..1 headroom.
float PatternFeatherShape(float T)
{
	const float Clamped = saturate(T);
	return Clamped + FeatherGain * Clamped * (1.0f - Clamped);
}

// The cell face's elevation across the chamfer band, from the grout line (T = 0, down at the
// base) up to the flat of the cell (T = 1, full height).
//
// This runs uphill, and that is the fix. It used to run the other way -- full height at the edge
// falling to nothing in the interior -- which built a raised lip around a flat face and drove the
// whole gap to full depth, so a positive Bevel Height dug in instead of standing the cell out.
// A chamfered tile is the opposite shape: the face is proud, and the chamfer is the ramp down to
// the grout. Running it uphill also decouples this from Gap Height, because the gap now sits at
// T = 0 and takes no bevel contribution at all; before, the two fought over the same pixels.
//
// Roundness bends the curve between two ends that stay pinned for every value, so it changes the
// chamfer's shape and never its width or its height:
//
//   -1   a cove -- hugs the grout, then sweeps up into the face
//    0   a straight, flat chamfer
//   +1   a bullnose -- lifts away from the grout and rounds over onto the face
//
// The extremes are quarter circles, which is what a real chamfer tool leaves, and the blend
// through zero is continuous from both sides.
float MixtormatChamferProfile(float T, float Roundness)
{
	const float Linear = T;
	if (Roundness >= 0.0f)
	{
		const float Inverse = 1.0f - T;
		const float Bullnose = sqrt(saturate(1.0f - Inverse * Inverse));
		return lerp(Linear, Bullnose, saturate(Roundness));
	}
	const float Cove = 1.0f - sqrt(saturate(1.0f - T * T));
	return lerp(Linear, Cove, saturate(-Roundness));
}

// The chamfer, as a signed height.
//
// Edge.x is signed: negative in the gap, zero on the gap's inner wall, positive into the cell.
// BevelInsetPixels slides the band along that axis, which is what puts the chamfer inside the
// cell or out in the grout -- one continuous control rather than a toggle that pops when flipped.
// Negative inset walks the ramp out into the gap, positive pulls it up onto the cell face, zero
// starts it exactly at the wall.
//
// BevelHeight is signed and lifts the cell *face*: positive stands the cell proud of the grout
// with the chamfer ramping down to it, negative sinks the face below the grout instead. The gap
// itself is untouched either way -- that is Gap Height's job. Both directions preserve the
// underlying signed surface.
//
// Width and profile take independent per-cell draws. Sharing one would tie a wide chamfer to a
// soft one and the variation would read as a single axis instead of two.
float PatternBevelDelta(int2 P)
{
	if (UseEdge == 0 || BevelHeight == 0.0f)
	{
		return 0.0f;
	}

	const int2 W = RampWrapPixel(P);
	const float2 Edge = EdgeField.Load(int3(W, 0));
	const float WidthRandom = saturate(Edge.y);
	// A second, independent draw off the first. The edge field carries one random per cell and
	// has no room for another, so the width draw is quantised back to the integer it came from
	// and pushed through the same salted hash every other per-region draw uses. That is a real
	// decorrelation, not a reshuffle of the same bits: a cell with a wide chamfer is no more
	// likely to have a soft one than a sharp one.
	const float ProfileRandom = MixtormatRegionRandomSalted(
		uint(WidthRandom * 16777215.0f + 0.5f),
		MIXTORMAT_SALT_PATTERN_BEVEL_PROFILE);

	// One-sided, like the cell height: the draw only ever narrows a chamfer from the authored
	// width, never widens it past what was asked for. Straddling the value the way this used to
	// meant half the cells came out wider than the control said, so the control read as a centre
	// point rather than as the width.
	const float WidthVariation = BevelVariation;
	const float BaseWidth = BevelRelative != 0 ? BevelWidthCells : BevelWidthPixels;
	const float Width = max(
		BaseWidth * lerp(1.0f - WidthVariation, 1.0f, WidthRandom),
		1.0e-4f);

	// Additive rather than multiplicative, unlike width and feather. Roundness is signed and
	// centred on zero, so scaling it could only ever make a round chamfer rounder -- it could
	// never turn one cell's bullnose into its neighbour's cove. Offsetting it can, which is the
	// variation worth having on a control whose two halves are different shapes.
	const float Roundness = clamp(
		BevelRoundness + saturate(BevelRoundnessRandom) * (ProfileRandom * 2.0f - 1.0f),
		-1.0f,
		1.0f);

	const float T = saturate((Edge.x - BevelInsetPixels) / Width);
	return BevelHeight * MixtormatChamferProfile(T, Roundness);
}

// Where the grout sits, relative to the cells.
//
// The gap is the region-less band between cells -- no ID, nothing for the per-cell draws to key
// off -- so it needs its own height rather than inheriting one. Signed: negative sinks it into a
// trench, positive stands it proud as a raised mortar line.
//
// It costs no new binding. EdgeField.x is the signed distance from the gap's inner wall, negative
// inside the gap and positive into the cell, so the sign of that one channel already says which
// side of the grout line a pixel is on.
//
// Resolved across a single texel rather than switched hard. The transition is a real step in the
// surface and is meant to look like one, but a bare comparison would alias along every grout line
// in the image; one texel of smoothstep is the narrowest ramp that samples cleanly, and the bevel
// is what softens it further when that is the look wanted.
//
// Inert without a gap: GapPixels 0 means every pixel belongs to a region, so there is nothing
// outside the IDs for this to move.
float PatternGapHeight(int2 P)
{
	if (UseEdge == 0 || GapHeight == 0.0f)
	{
		return 0.0f;
	}
	const float Edge = EdgeField.Load(int3(RampWrapPixel(P), 0)).x;
	return GapHeight * (1.0f - smoothstep(-0.5f, 0.5f, Edge));
}

// The cell's own elevation: one constant per cell, eased out at its boundary by the feather the
// producer wrote.
//
// One-sided, and that is the fix. This used to remap the draw to a signed -1..1 and add it, so
// about half the cells came out *below* the base. A sunk cell still feathers back to base at its
// own wall, which lifts its rim above its middle -- so every other tile read as a recessed panel
// inside a raised frame. That is the picture-frame look, and it was the signed encoding, not the
// chamfer.
//
// Height Random multiplies instead. The draw is remapped to 1 - Random .. 1, so a cell is always
// somewhere between the base and full Height and never under it: at Random 0 every cell sits at
// full Height, at 1 they spread the whole way down to the base. Nothing can go negative, so the
// feather only ever ramps a cell *down* to meet its neighbour and cannot invert a face.
float PatternCellHeight(int2 P)
{
	if (UseEdge == 0 || CellHeightAmount == 0.0f)
	{
		return 0.0f;
	}

	const int2 W = RampWrapPixel(P);
	const uint RegionId = PatternRegionIds.Load(int3(W, 0));
	if (RegionId >= uint(OutputSize.x) * uint(OutputSize.y))
	{
		return 0.0f;
	}

	const float2 Field = RampField.Load(int3(W, 0)).xy;
	const float Multiplier = lerp(1.0f - CellHeightRandom, 1.0f, saturate(Field.x));
	const float RequestedElevation = CellHeightAmount * Multiplier;
	// Uniform face offset preserves substrate detail regardless of its absolute height.
	return RequestedElevation * PatternFeatherShape(Field.y);
}

// Evaluate the same local displacement at the centre and all normal taps.
float ReliefDelta(int2 P)
{
	const float Gate = UseGateMask != 0u
		? saturate(GateMask.Load(int3(RampWrapPixel(P), 0))) : 1.0f;
	if (UseEdge == 0)
	{
		return RampDelta(P) * Gate;
	}

	// Gate the complete delta, not the substrate or the region analysis.
	return (PatternCellHeight(P) + PatternGapHeight(P) + PatternBevelDelta(P)) * Gate;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 P = int2(DispatchThreadId.xy);
	const float Source = SourceHeight.Load(int3(P, 0));

	OutputHeight[P] = Source + ReliefDelta(P);

	// Sobel over the same tilt field the height was moved by, so the normal and the displacement
	// describe one surface. Scaled by the height amount as well as its own weight: a region that
	// is not tipped has no slope to catch light.
	const int Xm = P.x - 1;
	const int Xp = P.x + 1;
	const int Ym = P.y - 1;
	const int Yp = P.y + 1;

	const float Tmm = ReliefDelta(int2(Xm, Ym));
	const float T0m = ReliefDelta(int2(P.x, Ym));
	const float Tpm = ReliefDelta(int2(Xp, Ym));
	const float Tm0 = ReliefDelta(int2(Xm, P.y));
	const float Tp0 = ReliefDelta(int2(Xp, P.y));
	const float Tmp = ReliefDelta(int2(Xm, Yp));
	const float T0p = ReliefDelta(int2(P.x, Yp));
	const float Tpp = ReliefDelta(int2(Xp, Yp));

	// Neutral 1/8 Sobel normalization. Final normals are reconciled from written height.
	const float Scale = NormalStrength / 8.0f;
	const float2 Gradient = float2(
		(Tpm + 2.0f * Tp0 + Tpp) - (Tmm + 2.0f * Tm0 + Tmp),
		(Tmp + 2.0f * T0p + Tpp) - (Tmm + 2.0f * T0m + Tpm)) * Scale;

	// Negated, and that is the fix for relief that reads inside-out.
	//
	// The surface written above is Source + Delta, and the normal of a height field h is
	// (-dh/dx, -dh/dy, 1). This pass had the gradient positive, so every raised feature lit as
	// though it were sunk: a proud cell face read as a dish, a chamfer standing out read as one
	// cut in, and feathering a cell up from the grout looked like feathering it down. The height
	// was right the whole time -- only the light disagreed with it, which is exactly the failure
	// that is hard to see in a heightmap preview and obvious the moment it is lit.
	//
	// MixtormatComposite's border normal is the reference: it differentiates its field the same
	// way and negates, and it is the one that has always looked correct.
	const float3 TiltNormal = normalize(float3(-Gradient, 1.0f));

	const float4 EncodedBase = PreviousNormal.Load(int3(P, 0));
	const float3 BaseNormal = normalize(EncodedBase.xyz * 2.0f - 1.0f);

	// Reoriented normal mapping, matching the erosion, chipping and craquelure normal passes.
	const float3 T = BaseNormal + float3(0.0f, 0.0f, 1.0f);
	const float3 U = TiltNormal * float3(-1.0f, -1.0f, 1.0f);
	const float3 Combined = normalize(T * dot(T, U) / max(T.z, 1.0e-5f) - U);

	OutputNormal[P] = float4(Combined * 0.5f + 0.5f, EncodedBase.w);
}
