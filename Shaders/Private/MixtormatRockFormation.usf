// Rock Formation: a tileable rock surface, tuned against the Copernicus prototype in
// AgentDocs/Prototypes/RockFormation_EdgeToolkit.opencl.txt. The maths is that file's, the
// structure is this plugin's.
//
// Chunks are anisotropic Voronoi cells (strata weight squashes them into layers), BSP-split,
// each a tilted slab with a faceted top, a planar chamfer and a steep wall that keeps falling past
// its edge. Height is the highest chunk at each pixel.
//
// Nothing moves a chunk after packing. The packing carries Size Random (a power diagram: per-cell
// weights shift the bisectors) and Stretch (an anisotropic metric along an angle). Spin and
// Stretch Random reshape a chunk inside its own leaf and are then scaled to fit it, so the chunk
// stays one clean shape rather than having its corners clipped. Tilt is the only lean: a shared
// lean, the cell's own random lean, and a small share of the piece's own.
//
// Edges carry jag (a zigzag of straight segments, relative to each chunk), a chamfer whose width
// varies along the rim, and angular rim chips. Seams -- the edges a Fracture split cut inside a
// cell -- follow the outline's controls by fixed ratios. Tops carry rounds of facet chips.
//
// Every control is normalised; the full-scale values are the constants below. Style 0..1 spans
// the part of the preset table that reads well.
//
// Four stages:
// ROCK_STAGE 0 (Build): one thread per cell. Builds the cell, walks its BSP tree and writes each
//   leaf chunk's surface, inset edges, edge tags and gapped outline into structured buffers.
// ROCK_STAGE 1 (Field): per pixel. Evaluates only the precomputed chunks of the cells around it.
//   Depends on the settings and resolution only, so it is cached.
// ROCK_STAGE 2 (Combine): writes the layer's input height from the field. Cheap.
// ROCK_STAGE 3 (Outputs): derives normalised scalar gates from the cached field.
//
// Leaves are stored for the canonical cells of one tile. A pixel reaches a neighbouring tile's
// copy by shifting itself by whole tiles; every field the chunks use is tile-periodic.

#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorPlacement.ush"

#define ROCK_TAU   6.283185307179586f
#define ROCK_BIG   1e20f
#define ROCK_MAXV  24
#define ROCK_CRACK 0x80000000u
#define ROCK_NP    13

// Full-scale angles for the normalised controls, in degrees.
#define ROCK_SPIN_DEG          180.0f
#define ROCK_TILT_DEG          45.0f
#define ROCK_STRETCH_ANGLE_DEG 180.0f
// Where Style 0 and 1 land in the preset table (0 cliff, 1 layered, 2 boulder, 3 rubble). The
// C++ layout resolve uses the same two numbers.
#define ROCK_STYLE_FROM 1.0f
#define ROCK_STYLE_TO   2.5f
// Cracks' fixed ratios, so the two generators' jag reads the same.
#define ROCK_LACUNARITY     2.2f
#define ROCK_JAG_SCALE      0.25f
#define ROCK_JAG_REF_SCALE  3.75f
// Jag is relative to each chunk: one this far across (centroid to farthest vertex, in cell
// widths -- about an unsplit cell) gets the authored jag.
#define ROCK_JAG_REF_RADIUS 0.7f
// A split piece's own random lean and facet variation, as a share of its rock's: pieces of one
// broken rock lean and chip alike.
#define ROCK_PIECE_LEAN  0.25f
#define ROCK_PIECE_FACET 0.25f
// Seams are fresher breaks than the weathered outline: a narrower bevel, smaller and finer
// teeth, a more uneven bevel width.
#define ROCK_SEAM_CHAMFER     0.6f
#define ROCK_SEAM_JAG         0.5f
#define ROCK_SEAM_JAG_SCALE   2.0f
#define ROCK_SEAM_CHAMFER_JAG 1.5f
// Facet chip cut slope, tan 38 deg.
#define ROCK_FACET_K 0.78f

int2 OutputSize;

float Style;
int Cells;
uint Seed;
float FractureAmount;
float ChamferAmount;
float FractureHeightBias;
float GapAmount;
float ChamferRandom;
float Spin;
float SpinRandom;
float TiltAngle;
float TiltDirection;
float TiltRandom;
float SizeRandom;
float Stretch;
float StretchAngle;
float StretchRandom;
float HeightClusters;
float Skew;
float EdgeJag;
float JagScale;
float JagDetail;
float ChamferJag;
float RimChips;
float RimChipSize;
float FacetChips;
int FacetIterations;
float FacetFalloff;
float FacetRandom;
float FacetAlign;

Texture2D<float> RockHeight;
Texture2D<uint> RockIds;
Texture2D<float2> RockBoundaryField;
RWTexture2D<float> OutRockNormalizedHeight;
RWTexture2D<float> OutRockSlope;
RWTexture2D<float> OutRockGap;
RWTexture2D<float> OutRockHeight;
RWTexture2D<float> OutRockTop;
RWTexture2D<float> OutRockChamfer;
RWTexture2D<float> OutRockWall;
RWTexture2D<float> OutRockTopRamp;
RWTexture2D<float> OutRockChamferRamp;
RWTexture2D<float> OutRockWallRamp;
RWTexture2D<float> OutRockEdgeDistance;
// XY: local chunk-boundary distance in UV units (negative inside), outline sampled.
// This is a bounded neighbourhood query, not a global SDF or a propagation solve.
RWTexture2D<float2> OutRockBoundaryField;
RWTexture2D<uint> OutRockIds;
RWTexture2D<float> OutHeight;

// One leaf chunk, in its canonical cell's rest frame. FRockLeafStride in
// MixtormatGpuGeneratorPasses.cpp mirrors this layout: nine floats, then eight uints.
struct FRockLeaf
{
	float Cx, Cy;          // centroid
	float Sx, Sy;          // top slope (tilt)
	float TopConstant;     // T(p) = TopConstant + dot(S, p)

	float Radius;          // reach: farthest vertex + wall fall-off + jag + chip
	float Rv;              // farthest vertex from the centroid; facet planes scale by it
	float JagOffset;       // the chunk's own shift along its edges, so its jag is its own
	float JagSize;         // the chunk's size relative to ROCK_JAG_REF_RADIUS; scales its jag
	uint Ck;               // the cell's hash: facet variation is drawn mostly from it
	uint Pk;               // the piece's hash: facet planes are drawn from it
	uint ChipOn;
	uint EdgeCount;
	uint VertexCount;
	uint Id;
	uint SeamBits;         // bit e set = edge e is a seam (a Fracture split), not the outline
	uint Pad;
};

int MaxLeaves;
int CellsV;
float RowHeight;
float WallSlope;
float ChamferSlope;

RWStructuredBuffer<FRockLeaf> OutLeaves;
RWStructuredBuffer<float4> OutEdges;     // inward normal.xy, inset offset, chamfer width
RWStructuredBuffer<uint> OutEdgeTags;    // each edge's key, for its jag, chamfer jag and chips
RWStructuredBuffer<float2> OutVertices;  // gapped outline
RWStructuredBuffer<uint> OutLeafCounts;
StructuredBuffer<FRockLeaf> Leaves;
StructuredBuffer<float4> Edges;
StructuredBuffer<uint> EdgeTags;
StructuredBuffer<float2> Vertices;
StructuredBuffer<uint> LeafCounts;

// strata, splits, split_angle, h_bias, height_var,
// layer_var, chip, wall, cell_gap, seam_gap, outer_ch, inner_ch, irr
static const float RockPreset[4][ROCK_NP] = {
	{ 1.0f, 3.0f, 30.0f, 0.2f, 0.35f, 0.25f, 0.35f, 72.0f, 0.03f, 0.015f, 0.08f, 0.05f, 0.8f },
	{ 1.0f, 2.0f,  6.0f, 0.7f, 0.30f, 0.45f, 0.25f, 72.0f, 0.03f, 0.015f, 0.08f, 0.05f, 0.8f },
	{ 0.0f, 2.0f, 30.0f, 0.0f, 0.35f, 0.25f, 0.40f, 58.0f, 0.03f, 0.015f, 0.08f, 0.05f, 0.9f },
	{ 0.0f, 1.0f, 30.0f, 0.0f, 0.60f, 0.20f, 0.40f, 60.0f, 0.04f, 0.020f, 0.10f, 0.06f, 0.9f },
};

struct FRockPat
{
	int cu, cv, splits;
	float rh, a2, strata, irr, split_angle, h_bias;
	float3 metric;         // symmetric 2x2 (m00, m01, m11): strata squash x Stretch
	float hvar, lvar, chip, wall_k;
	float cell_gap, seam_gap, outer_ch, inner_ch;
	float chamfer, seam_chamfer, chamfer_random, fracture_height_bias;
	uint seed;
	float height_clusters, skew;
	float spin, spin_random, tilt_angle, tilt_dir, tilt_random, size_random, stretch_random;
	// Index 0 = outer edges, 1 = seams.
	float jag_amp[2], jag_freq[2], chamfer_jag[2];
	float jag_detail;
	float rim_chips, rim_chip_size;
	int facet_iterations;
	float facet_falloff, facet_random, facet_align;
	int build_reach_i, build_reach_j, field_reach_i, field_reach_j;
	float height_lo, height_hi;
};

struct FRockPoly
{
	float2 v[ROCK_MAXV];
	uint t[ROCK_MAXV];
	int n;
};

// ---- helpers ---------------------------------------------------------------

uint RockHash(uint v)
{
	uint s = v * 747796405u + 2891336453u;
	uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
	return (w >> 22u) ^ w;
}

float RockRand(uint a, uint b, uint c)
{
	return (float)(RockHash(a ^ RockHash(b + RockHash(c))) >> 8) * (1.0f / 16777216.0f);
}

int RockWrap(int i, int n) { return ((i % n) + n) % n; }
float RockCross(float2 a, float2 b) { return a.x * b.y - a.y * b.x; }
float2 RockDir(float a) { return float2(cos(a), sin(a)); }
uint RockEdgeKey(uint a) { return (RockHash(a) & 0x7fffffffu) | 1u; }

float2 RockRotate(float2 v, float a)
{
	float c = cos(a), s = sin(a);
	return float2(c * v.x - s * v.y, s * v.x + c * v.y);
}

// ---- edge toolkit ------------------------------------------------------------

// Piecewise-linear random zigzag: straight segments between random bend heights in -1..1.
float RockZig(float x, uint key, uint salt)
{
	const float fl = floor(x);
	const int i = (int)fl;
	const float f = x - fl;
	return lerp(RockRand(key, (uint)i, salt) * 2.0f - 1.0f, RockRand(key, (uint)(i + 1), salt) * 2.0f - 1.0f, f);
}

// Three octaves of zigzag along an edge, -1..1.
float RockZigFbm(FRockPat P, float u, uint key, float freq)
{
	float sum = 0.0f, norm = 0.0f, amp = 1.0f;
	for (int o = 0; o < 3; o++)
	{
		sum += amp * RockZig(u * freq, key, 4099u + (uint)o * 57u);
		norm += abs(amp);
		amp *= P.jag_detail;
		freq *= ROCK_LACUNARITY;
	}
	return norm > 0.0f ? sum / norm : 0.0f;
}

// Jag: sideways shift of an edge at position u along it. Set 0 = outer edges, 1 = seams.
float RockJag(FRockPat P, float u, uint key, int set)
{
	return P.jag_amp[set] == 0.0f ? 0.0f : P.jag_amp[set] * RockZigFbm(P, u, key, P.jag_freq[set]);
}

// Chamfer jag: the bevel's width swells and thins along the rim by its own zigzag, on its own key,
// so it does not follow the outline's teeth. Multiplicative: at 1 the width runs from nothing to
// double, never negative.
float RockChamferScale(FRockPat P, float u, uint key, int set)
{
	return P.chamfer_jag[set] == 0.0f ? 1.0f
		: 1.0f + P.chamfer_jag[set] * RockZigFbm(P, u, key ^ 0x5bd1e995u, P.jag_freq[set]);
}

// Rim chips: scattered angular bites along an edge, each widening the bevel by up to its depth.
// Rock breaks into flat facets, so a chip is straight-sided: an asymmetric triangle with its
// deepest point anywhere across the chip, and on about half of them a flat floor where the flake
// came off whole. u and size in cell widths.
float RockRimChips(FRockPat P, float u, uint key)
{
	const float density = P.rim_chips, size = P.rim_chip_size;
	if (density <= 0.0f || size <= 0.0f)
	{
		return 0.0f;
	}
	const int i0 = (int)floor(u / size);
	float bite = 0.0f;
	for (int k = -1; k <= 1; k++)
	{
		const int i = i0 + k;
		if (RockRand(key, (uint)i, 9311u) >= density)
		{
			continue;
		}
		const float c = ((float)i + RockRand(key, (uint)i, 9312u)) * size;
		const float rr = size * (0.35f + 0.65f * RockRand(key, (uint)i, 9313u));
		const float x = (u - c) / rr;
		if (abs(x) >= 1.0f)
		{
			continue;
		}
		const float apex = (RockRand(key, (uint)i, 9314u) - 0.5f) * 1.4f;
		const float tri = x < apex ? (x + 1.0f) / (apex + 1.0f) : (1.0f - x) / (1.0f - apex);
		const float floorAt = RockRand(key, (uint)i, 9315u) < 0.5f ? 0.67f : 1.0f;
		const float depth = rr * (0.5f + 0.5f * RockRand(key, (uint)i, 9316u));
		bite = max(bite, depth * min(tri, floorAt) / floorAt);
	}
	return bite;
}

// ---- convex polygons (CCW; t[i] tags edge i -> i+1) --------------------------

void RockBox(inout FRockPoly p, float2 c, float2 e)
{
	p.v[0] = c + float2(-e.x, -e.y);
	p.v[1] = c + float2(e.x, -e.y);
	p.v[2] = c + float2(e.x, e.y);
	p.v[3] = c + float2(-e.x, e.y);
	p.t[0] = 0u; p.t[1] = 0u; p.t[2] = 0u; p.t[3] = 0u;
	p.n = 4;
}

// Keep dot(n, x) <= d.
void RockClip(inout FRockPoly p, float2 n, float d, uint tag)
{
	bool anyOut = false;
	for (int i = 0; i < p.n; i++)
	{
		anyOut = anyOut || dot(n, p.v[i]) > d;
	}
	if (!anyOut)
	{
		return;
	}

	FRockPoly o = (FRockPoly)0;
	int m = 0;
	for (int j = 0; j < p.n; j++)
	{
		float2 a = p.v[j];
		float2 b = p.v[j + 1 == p.n ? 0 : j + 1];
		float da = dot(n, a) - d;
		float db = dot(n, b) - d;
		if (da <= 0.0f)
		{
			if (m < ROCK_MAXV) { o.v[m] = a; o.t[m] = p.t[j]; m++; }
			if (db > 0.0f && m < ROCK_MAXV) { o.v[m] = lerp(a, b, da / (da - db)); o.t[m] = tag; m++; }
		}
		else if (db <= 0.0f && m < ROCK_MAXV)
		{
			o.v[m] = lerp(a, b, da / (da - db)); o.t[m] = p.t[j]; m++;
		}
	}
	o.n = m;
	p = o;
}

float2 RockCentroid(FRockPoly p, out float area)
{
	float2 c = 0.0f, mean = 0.0f;
	float s = 0.0f;
	for (int i = 0; i < p.n; i++)
	{
		float2 a = p.v[i], b = p.v[i + 1 == p.n ? 0 : i + 1];
		float k = RockCross(a, b);
		s += k;
		c += (a + b) * k;
		mean += a;
	}
	area = 0.5f * s;
	return abs(s) < 1e-12f ? mean / (float)max(p.n, 1) : c / (3.0f * s);
}

// ---- cells: anisotropic power diagram ----------------------------------------

float2 RockSite(FRockPat P, int i, int j, out uint id)
{
	int wi = RockWrap(i, P.cu), wj = RockWrap(j, P.cv);
	uint h = RockHash(P.seed ^ RockHash((uint)wi + RockHash((uint)wj * 0x85EBCA6Bu + 7u)));
	float bond = RockRand(P.seed, (uint)wj, 53u) * P.strata;
	float jx = (RockRand(h, 1u, 31u) - 0.5f) * P.irr;
	float jy = (RockRand(h, 2u, 31u) - 0.5f) * P.irr * (1.0f - P.strata);
	id = (uint)(wi + wj * P.cu);
	float row_phase = ROCK_TAU * (float)wj / (float)P.cv;
	float row_skew = P.skew * sin(row_phase);
	return float2((float)i + 0.5f + bond + jx + row_skew, ((float)j + 0.5f + jy) * P.rh);
}

float2 RockMetricMul(FRockPat P, float2 d)
{
	return float2(P.metric.x * d.x + P.metric.y * d.y, P.metric.y * d.x + P.metric.z * d.y);
}

float RockMetric(FRockPat P, float2 d) { return dot(d, RockMetricMul(P, d)); }

// Size Random: a per-cell power-diagram weight, hashed on the wrapped cell id so it tiles.
float RockSiteWeight(FRockPat P, uint id)
{
	return P.size_random * 0.35f * (2.0f * RockRand(P.seed, id, 57u) - 1.0f);
}

// Bisector of s and o under the metric and the two power weights, as a p-space line keeping
// s's side: |x-s|^2 - ws <= |x-o|^2 - wo.
float3 RockBisector(FRockPat P, float2 s, float2 o, float ws, float wo)
{
	float2 m = RockMetricMul(P, o - s);
	float l = length(m);
	return float3(m / l, 0.5f * (RockMetric(P, o) - RockMetric(P, s) - wo + ws) / l);
}

void RockCellPoly(FRockPat P, int i, int j, out FRockPoly cell, out uint cid)
{
	cell = (FRockPoly)0;
	uint id, oid;
	float2 s = RockSite(P, i, j, id);
	const float ws = RockSiteWeight(P, id);
	RockBox(cell, s, float2(3.0f, 3.0f * P.rh));
	// The reach follows the row height: with rows thinner than a cell is wide, a cell's true
	// neighbours sit more than two rows away.
	for (int dj = -P.build_reach_j; dj <= P.build_reach_j; dj++)
	{
		for (int di = -P.build_reach_i; di <= P.build_reach_i; di++)
		{
			if (di == 0 && dj == 0)
			{
				continue;
			}
			float2 o = RockSite(P, i + di, j + dj, oid);
			if (length(o - s) < 1e-6f)
			{
				continue;
			}
			float3 b = RockBisector(P, s, o, ws, RockSiteWeight(P, oid));
			RockClip(cell, b.xy, b.z, RockEdgeKey(min(id, oid) * 0x9E3779B9u + max(id, oid) + 17u));
		}
	}
	cid = RockHash(P.seed ^ (id * 0x27D4EB2Du + 5u));
}

// ---- BSP fracture ----------------------------------------------------------

float3 RockSplitLine(FRockPat P, uint cid, uint node, FRockPoly p)
{
	float2 lo = p.v[0], hi = lo;
	for (int i = 1; i < p.n; i++) { lo = min(lo, p.v[i]); hi = max(hi, p.v[i]); }
	float2 dim = hi - lo;

	uint a = RockHash(P.seed ^ (cid * 0x9E3779B9u));
	int axis = dim.y > dim.x ? 1 : 0;
	if (RockRand(a, node, 733u) < P.h_bias)
	{
		axis = 1;
	}

	float tilt = radians(P.split_angle) * sqrt(RockRand(a, node, 138u))
		* (RockRand(a, node, 137u) < 0.5f ? -1.0f : 1.0f);
	float2 n = RockDir((axis != 0 ? 0.25f * ROCK_TAU : 0.0f) + tilt);

	float pmin = ROCK_BIG, pmax = -ROCK_BIG;
	for (int k = 0; k < p.n; k++)
	{
		float pr = dot(n, p.v[k]);
		pmin = min(pmin, pr);
		pmax = max(pmax, pr);
	}
	return float3(n, lerp(pmin, pmax, 0.5f + (RockRand(a, node, 139u) - 0.5f) * 0.28f));
}

void RockNodePoly(FRockPat P, uint cid, uint node, int depth, inout FRockPoly p)
{
	for (int level = 0; level < depth; level++)
	{
		uint anc = node >> (uint)(depth - level);
		uint bit = (node >> (uint)(depth - level - 1)) & 1u;
		float3 l = RockSplitLine(P, cid, anc, p);
		uint key = ROCK_CRACK | (RockHash(cid * 7919u + anc) & 0x7fffffffu);
		if (bit != 0u)
		{
			RockClip(p, -l.xy, -l.z, key);
		}
		else
		{
			RockClip(p, l.xy, l.z, key);
		}
	}
}

// ---- chunk build -------------------------------------------------------------

// Inset edge line and chamfer width for edge i; false for degenerate edges.
//
// The chamfer is a share of the room this edge has: three quarters of the way from its inset
// line to the centre. A bevel past it would cross the chunk, so the min below is that geometric
// limit, reached only when Chamfer Random pushes a share past 1.
bool RockEdgeLine(FRockPat P, FRockPoly leaf, int i, float2 c,
	out float2 nn, out float dg, out float w, out bool crack)
{
	nn = 0.0f; dg = 0.0f; w = 0.0f; crack = false;
	float2 a = leaf.v[i];
	float2 e = leaf.v[i + 1 == leaf.n ? 0 : i + 1] - a;
	float len = length(e);
	if (len < 1e-6f)
	{
		return false;
	}
	uint tag = leaf.t[i];
	nn = float2(e.y, -e.x) / len;
	crack = (tag & ROCK_CRACK) != 0u;
	float d = dot(nn, a);
	float clearance = max(0.0f, d - dot(nn, c));
	dg = d - min((crack ? P.seam_gap : P.cell_gap) * 0.5f, clearance * 0.75f);
	const float room = 0.75f * max(0.0f, dg - dot(nn, c));
	const float ww = (crack ? P.seam_chamfer * P.inner_ch : P.chamfer * P.outer_ch) * room
		* lerp(1.0f, lerp(0.4f, 1.6f, RockRand(P.seed, tag, 91u)), P.chamfer_random);
	w = min(max(ww, 0.0f), room);
	return true;
}

void RockWriteLeaf(FRockPat P, FRockPoly leaf, uint cid, uint node, float layerRand, uint slot)
{
	FRockLeaf L = (FRockLeaf)0;
	int n = leaf.n;

	uint ck = RockHash(P.seed ^ (cid * 0x9E3779B9u));
	uint pk = RockHash(ck ^ (node * 0x85EBCA6Bu));

	// Spin and Stretch Random: turn / narrow about the centroid, then scale the whole shape by
	// the largest factor that keeps every vertex inside every leaf edge. Fitting keeps the chunk
	// one clean shape; clipping it back would trim its corners, which reads as a carve. Each edge
	// keeps its own tag, so gaps and seams still know what they are.
	if (P.spin != 0.0f || P.spin_random != 0.0f || P.stretch_random > 0.0f)
	{
		float area0;
		const float2 c0 = RockCentroid(leaf, area0);
		const float angle = radians(P.spin + P.spin_random * (2.0f * RockRand(pk, 7u, 66u) - 1.0f));
		const float2 axis = RockDir(RockRand(pk, 8u, 66u) * ROCK_TAU);
		const float squeeze = 1.0f - P.stretch_random * RockRand(pk, 9u, 66u);
		FRockPoly moved = leaf;
		for (int mv = 0; mv < leaf.n; mv++)
		{
			float2 d = leaf.v[mv] - c0;
			d -= axis * dot(d, axis) * (1.0f - squeeze);
			moved.v[mv] = c0 + RockRotate(d, angle);
		}
		float fit = 1.0f;
		for (int ce = 0; ce < leaf.n; ce++)
		{
			const float2 a = leaf.v[ce];
			const float2 e = leaf.v[ce + 1 == leaf.n ? 0 : ce + 1] - a;
			const float el = length(e);
			if (el < 1e-6f)
			{
				continue;
			}
			const float2 nn = float2(e.y, -e.x) / el;
			const float room = dot(nn, a) - dot(nn, c0);
			for (int mv2 = 0; mv2 < moved.n; mv2++)
			{
				const float outBy = dot(nn, moved.v[mv2] - c0);
				if (outBy > room && outBy > 1e-9f)
				{
					fit = min(fit, room / outBy);
				}
			}
		}
		for (int mv3 = 0; mv3 < moved.n; mv3++)
		{
			moved.v[mv3] = c0 + (moved.v[mv3] - c0) * fit;
		}
		leaf = moved;
	}

	float top = 1.0f - P.height_clusters * (P.hvar * 0.5f * (RockRand(ck, 1u, 61u) + RockRand(pk, 1u, 62u))
		+ P.lvar * layerRand);
	top += P.fracture_height_bias * (2.0f * RockRand(pk, 5u, 61u) - 1.0f);

	float ar;
	float2 c = RockCentroid(leaf, ar);
	float rv = 0.0f;
	for (int i = 0; i < n; i++)
	{
		rv = max(rv, length(leaf.v[i] - c));
	}

	// Tilt: the shared lean, plus the cell's own random lean, plus a little of the piece's own,
	// so the pieces of one split rock tip together and only deviate slightly from each other.
	float2 s = RockDir(radians(P.tilt_dir)) * tan(radians(P.tilt_angle))
		+ tan(radians(P.tilt_random)) * (
			RockDir(RockRand(ck, 2u, 61u) * ROCK_TAU) * sqrt(RockRand(ck, 3u, 61u)) +
			ROCK_PIECE_LEAN * RockDir(RockRand(pk, 2u, 62u) * ROCK_TAU) * sqrt(RockRand(pk, 3u, 62u)));
	float smax = -ROCK_BIG;
	for (int k = 0; k < n; k++)
	{
		smax = max(smax, dot(s, leaf.v[k] - c));
	}

	L.Cx = c.x; L.Cy = c.y;
	L.Sx = s.x; L.Sy = s.y;
	L.TopConstant = top - smax - dot(s, c);

	L.Rv = rv;
	L.Ck = ck;
	L.Pk = pk;
	// Neighbouring chunks share their border's key, so without this they would jag in step across
	// a gap; a per-chunk shift along the edge breaks that.
	L.JagOffset = RockRand(pk, 12u, 69u) * 64.0f;
	L.JagSize = rv / ROCK_JAG_REF_RADIUS;
	// Walls fall at WallSlope from a top of at most 1, so past this they cannot win; jag and chips
	// can move an edge outward, so the reach grows by both.
	L.Radius = rv + 1.0f / max(P.wall_k, 1.0e-4f) + 0.5f * max(abs(P.cell_gap), abs(P.seam_gap))
		+ max(abs(P.jag_amp[0]), abs(P.jag_amp[1])) * L.JagSize + P.rim_chip_size;
	L.ChipOn = P.chip > 0.0f ? 1u : 0u;

	uint base = slot * ROCK_MAXV;
	uint edgeCount = 0u;
	uint seamBits = 0u;
	FRockPoly gapped = leaf;
	// Negative gap expands the domain before any height shaping. Start from a containing
	// polygon: clipping the original leaf can only shrink, even when its edge lines expand.
	if (min(P.cell_gap, P.seam_gap) < 0.0f)
	{
		float domainScale = 1.0f;
		for (int ge = 0; ge < n; ge++)
		{
			float2 gn;
			float gd, gw;
			bool seam;
			if (RockEdgeLine(P, leaf, ge, c, gn, gd, gw, seam))
			{
				const float room = dot(gn, leaf.v[ge] - c);
				if (room > 1e-6f)
				{
					domainScale = max(domainScale, (gd - dot(gn, c)) / room);
				}
			}
		}
		for (int gv = 0; gv < n; gv++)
		{
			gapped.v[gv] = c + (leaf.v[gv] - c) * domainScale;
		}
	}
	for (int e = 0; e < n; e++)
	{
		float2 nn;
		float dg, w;
		bool crack;
		if (!RockEdgeLine(P, leaf, e, c, nn, dg, w, crack))
		{
			continue;
		}
		OutEdges[base + edgeCount] = float4(nn, dg, w);
		OutEdgeTags[base + edgeCount] = RockEdgeKey(leaf.t[e] + 101u);
		if (crack)
		{
			seamBits |= 1u << edgeCount;
		}
		edgeCount++;
		RockClip(gapped, nn, dg, leaf.t[e]);
	}
	for (int v = 0; v < gapped.n; v++)
	{
		OutVertices[base + (uint)v] = gapped.v[v];
		// The expanded outline must remain inside the field query's enclosing radius.
		L.Radius = max(L.Radius, length(gapped.v[v] - c)
			+ 1.0f / max(P.wall_k, 1.0e-4f)
			+ max(abs(P.jag_amp[0]), abs(P.jag_amp[1])) * L.JagSize + P.rim_chip_size);
	}
	L.EdgeCount = edgeCount;
	L.SeamBits = seamBits;
	L.VertexCount = (uint)gapped.n;
	// The chunk's slot: unique per chunk and small. Consumers such as UV From IDs index per-id
	// buffers sized to the pixel count, so an id must stay below it; preview colours scramble it.
	L.Id = slot;
	OutLeaves[slot] = L;
}

// ---- field: one pixel against the precomputed chunks -------------------------------

// Facet variation, drawn per rock (cell) with a little per piece, so the pieces of one broken
// rock chip alike.
float RockFacetDraw(FRockLeaf L, uint salt)
{
	return RockRand(L.Ck, salt, 72u) + ROCK_PIECE_FACET * (RockRand(L.Pk, salt, 73u) - 0.5f);
}

// Facet chips, in rounds. Each plane cuts K * (dot(u, p) - R) off the top. Round 0 is three
// planes; round k adds 3 + 2k in fresh directions, their bites scaled by the falloff, so later
// rounds break smaller along the edges earlier ones left (or deeper, with a falloff above 1).
// Facet Random varies per rock how many rounds it gets, how deep it bites and how fast each round
// shrinks. Facet Align swings the planes toward the low (+) or high (-) side of the chunk's lean.
float RockFacetCut(FRockPat P, FRockLeaf L, float2 pr)
{
	const float2 c = float2(L.Cx, L.Cy);
	const float2 lean = float2(L.Sx, L.Sy);
	const float leanLength = length(lean);
	float cut = 0.0f;
	float size = 1.0f;

	// Some rocks get fewer rounds, and every piece of one rock the same count, so this draw is
	// the rock's alone. It is under 1, so up to Facet Random 1 round 0 always survives.
	const int rounds = P.facet_iterations
		- (int)floor(RockRand(L.Ck, 13u, 72u) * P.facet_random * (float)P.facet_iterations);
	const float depth = lerp(1.0f, 0.5f + RockFacetDraw(L, 14u), P.facet_random);

	for (int it = 0; it < rounds; it++)
	{
		const uint salt = (uint)it * 10u;
		const int planes = 3 + 2 * it;
		const float ph = RockRand(L.Pk, 4u + salt, 63u) * ROCK_TAU;
		for (int j = 0; j < planes; j++)
		{
			float2 u = RockDir(ph + (float)j * ROCK_TAU / (float)planes
				+ (RockRand(L.Pk, (uint)j + salt, 64u) - 0.5f) * 1.6f);
			// A chunk with no lean has no side to swing to, hence the guard.
			if (P.facet_align != 0.0f && leanLength > 1e-6f)
			{
				const float2 side = -lean / leanLength * sign(P.facet_align);
				const float2 swung = lerp(u, side, abs(P.facet_align));
				const float sl = length(swung);
				u = sl > 1e-6f ? swung / sl : side;
			}
			// The bite, as a share of the chunk's radius, eased so it approaches 1 but never gets
			// there: a plane can never pass the centre and slice the whole top away, however deep
			// Facet Chips or a growing falloff push it. Almost exact for the usual bites.
			float bite = P.chip * depth * size * (0.4f + 0.6f * RockRand(L.Pk, (uint)j + salt, 65u));
			bite = bite / sqrt(sqrt(1.0f + bite * bite * bite * bite));
			const float R = L.Rv * (1.0f - bite) + dot(u, c);
			const float k = it == 0 ? ROCK_FACET_K : ROCK_FACET_K * lerp(0.8f, 1.3f, RockRand(L.Pk, (uint)j + salt, 68u));
			// The break line carries the jag too, at the round's size, eased toward twice the first
			// round's so a growing falloff cannot saw the teeth across the chunk's borders.
			const float grow = size / sqrt(sqrt(1.0f + 0.0625f * size * size * size * size));
			const float js = grow * L.JagSize;
			// A zero falloff removes later rounds' jag without dividing by their zero size.
			float shift = 0.0f;
			if (js != 0.0f)
			{
				const float along = dot(pr, float2(-u.y, u.x)) / js + L.JagOffset;
				shift = RockJag(P, along, RockHash(L.Pk ^ ((uint)j + salt) * 0x9E3779B9u), 0) * js;
			}
			cut = max(cut, k * (dot(u, pr) - R + shift));
		}
		size *= P.facet_falloff * lerp(1.0f, 0.5f + RockFacetDraw(L, (uint)it + 20u), P.facet_random);
	}
	return cut;
}

// Height of one chunk at pr, the class of surface that set it (0 top, 1 chamfer, 2 wall), and
// where along that surface the pixel sits.
//
// The ramp runs 0 -> 1 across the surface that won, bounded by how each is built rather than by a
// saturate:
//   Top      inward distance past the chamfer over that plus the distance to the chunk centre --
//            0 at the chamfer's inner edge, 1 at the centre.
//   Chamfer  across the bevel, from its foot on the wall (0) to the top (1).
//   Wall     1 where the wall meets the bevel or the top, falling by one per unit of height it
//            drops -- so 0 one full top-height down, since tops are at most 1. Past one unit down
//            it goes negative; that is still the wall, so it is left alone.
float RockLeafHeight(FRockPat P, FRockLeaf L, uint slot, float2 pr, out int cls, out float ramp)
{
	float T = L.TopConstant + dot(float2(L.Sx, L.Sy), pr);
	if (L.ChipOn != 0u)
	{
		T -= RockFacetCut(P, L, pr);
	}

	float H = T;
	cls = 0;
	float edgeDi = 0.0f;
	float edgeW = 0.0f;
	// Nearest inward distance past any chamfer, for the top's ramp.
	float topInset = ROCK_BIG;
	uint base = slot * ROCK_MAXV;
	for (uint e = 0u; e < L.EdgeCount; e++)
	{
		float4 E = Edges[base + e];
		const uint tag = EdgeTags[base + e];
		const int set = (int)((L.SeamBits >> e) & 1u);
		// Position along the edge, its jag, its chamfer jag and its chips -- all relative to the
		// chunk, and shifted by the chunk's own offset.
		const float u = dot(pr, float2(-E.y, E.x)) + L.JagOffset;
		float di = E.z - dot(E.xy, pr) + RockJag(P, u / L.JagSize, tag, set) * L.JagSize;
		float w = E.w * RockChamferScale(P, u / L.JagSize, tag, set) + RockRimChips(P, u, tag * 2u + 1u);
		topInset = min(topInset, di - max(w, 0.0f));
		float wall = T + WallSlope * di;
		if (wall < H) { H = wall; cls = 2; edgeDi = di; edgeW = w; }
		if (w > 0.0f)
		{
			float bevel = T + ChamferSlope * (di - w);
			if (bevel < H) { H = bevel; cls = 1; edgeDi = di; edgeW = w; }
		}
	}

	// Where the bevel meets the wall: T + WallSlope * d = T + ChamferSlope * (d - w). The gather caps
	// ChamferSlope at WallSlope, so the difference is never negative; the guard is only for the
	// equal case, where the two never meet.
	const float footDi = edgeW > 0.0f
		? -ChamferSlope * edgeW / max(WallSlope - ChamferSlope, 1.0e-6f) : 0.0f;
	if (cls == 1)
	{
		ramp = (edgeDi - footDi) / (edgeW - footDi);
	}
	else if (cls == 2)
	{
		ramp = 1.0f + WallSlope * (edgeDi - footDi);
	}
	else
	{
		const float inset = L.EdgeCount > 0u ? topInset : 0.0f;
		const float toCentre = length(pr - float2(L.Cx, L.Cy));
		ramp = inset + toCentre > 0.0f ? inset / (inset + toCentre) : 1.0f;
	}
	return H;
}

// Exact signed distance to the gapped outline, negative inside.
float RockLeafSd(FRockLeaf L, uint slot, float2 q)
{
	uint count = L.VertexCount;
	if (count < 3u)
	{
		return ROCK_BIG;
	}
	uint base = slot * ROCK_MAXV;
	float dmin = ROCK_BIG;
	bool inside = true;
	for (uint i = 0u; i < count; i++)
	{
		float2 a = Vertices[base + i];
		float2 e = Vertices[base + (i + 1u == count ? 0u : i + 1u)] - a;
		float2 w = q - a;
		float t = clamp(dot(w, e) / max(dot(e, e), 1e-20f), 0.0f, 1.0f);
		dmin = min(dmin, length(w - e * t));
		if (RockCross(e, w) < 0.0f)
		{
			inside = false;
		}
	}
	return inside ? -dmin : dmin;
}

// With jag on, the outline is the half-plane form of the jagged inset lines: exact along the
// edges, approximate past the corners.
float RockLeafSdJag(FRockPat P, FRockLeaf L, uint slot, float2 q)
{
	if (L.EdgeCount < 3u)
	{
		return ROCK_BIG;
	}
	uint base = slot * ROCK_MAXV;
	float sd = -ROCK_BIG;
	for (uint e = 0u; e < L.EdgeCount; e++)
	{
		const float4 E = Edges[base + e];
		const int set = (int)((L.SeamBits >> e) & 1u);
		const float u = dot(q, float2(-E.y, E.x)) + L.JagOffset;
		sd = max(sd, dot(E.xy, q) - E.z - RockJag(P, u / L.JagSize, EdgeTags[base + e], set) * L.JagSize);
	}
	return sd;
}

FRockPat RockSetup()
{
	// Style maps onto the useful part of the table, which has four rows, so the position is
	// bounded to the table; Style itself is not.
	float st = clamp(lerp(ROCK_STYLE_FROM, ROCK_STYLE_TO, Style), 0.0f, 3.0f);
	int i0 = min((int)st, 2);
	float t = st - (float)i0;
	float v[ROCK_NP];
	for (int k = 0; k < ROCK_NP; k++)
	{
		v[k] = lerp(RockPreset[i0][k], RockPreset[i0 + 1][k], t);
	}

	FRockPat P = (FRockPat)0;
	P.cu = max(Cells, 1);
	P.cv = max(CellsV, 1);
	P.rh = (float)P.cu / (float)P.cv;
	P.strata = v[0];
	P.a2 = (1.0f + 3.0f * v[0]) * (1.0f + 3.0f * v[0]);
	// Metric = T^T T with T = diag(1, sqrt(a2)) * K, K stretching along StretchAngle. Stretch is
	// exponential: each step of 1 doubles the cells along the angle, -1 doubles them across.
	{
		const float sa = radians(StretchAngle * ROCK_STRETCH_ANGLE_DEG);
		const float cs = cos(sa), sn = sin(sa);
		const float k = exp2(-Stretch);
		const float k00 = k * cs * cs + sn * sn;
		const float k01 = (k - 1.0f) * cs * sn;
		const float k11 = k * sn * sn + cs * cs;
		const float sy = sqrt(P.a2);
		const float t00 = k00, t01 = k01, t10 = sy * k01, t11 = sy * k11;
		P.metric = float3(t00 * t00 + t10 * t10, t00 * t01 + t10 * t11, t01 * t01 + t11 * t11);
	}
	P.splits = max((int)round(v[1] * FractureAmount), 0);
	P.split_angle = v[2];
	P.h_bias = v[3];
	P.hvar = v[4];
	P.lvar = v[5];
	P.height_clusters = HeightClusters;
	P.skew = Skew;
	P.chip = v[6] * FacetChips;
	P.wall_k = tan(radians(v[7]));
	// Signed domain offset: positive shrinks, negative expands, zero leaves packing unchanged.
	// 1 is twice the style's natural gap; only positive gaps get the anti-aliasing pixel floor.
	const float pixel = (float)P.cu / (float)max(OutputSize.x, 1);
	const float gapFloor = GapAmount > 0.0f ? pixel : 0.0f;
	P.cell_gap = v[8] * GapAmount * 2.0f + gapFloor;
	P.seam_gap = v[9] * GapAmount * 2.0f + gapFloor;
	// The preset keeps only its character for the chamfer: outer edges vs split seams, rubble a
	// little wider than cliff.
	P.outer_ch = v[10] / 0.08f;
	P.inner_ch = v[11] / 0.05f;
	P.chamfer = ChamferAmount;
	P.seam_chamfer = ChamferAmount * ROCK_SEAM_CHAMFER;
	P.chamfer_random = ChamferRandom;
	P.fracture_height_bias = FractureHeightBias;
	P.irr = v[12];
	P.seed = RockHash(Seed + 0x51ED27u);

	// Stored in degrees from here on.
	P.spin = Spin * ROCK_SPIN_DEG;
	P.spin_random = SpinRandom * ROCK_SPIN_DEG;
	P.tilt_angle = TiltAngle * ROCK_TILT_DEG;
	P.tilt_dir = TiltDirection * 360.0f;
	P.tilt_random = TiltRandom * ROCK_TILT_DEG;
	P.size_random = SizeRandom;
	P.stretch_random = StretchRandom;

	// Jag is a steepness, as in Cracks: bigger bends (lower Jag Scale) get a proportionally larger
	// amplitude, so changing the scale never makes the edges spikier or flatter. Seams follow by
	// the seam ratios.
	P.jag_freq[0] = JagScale;
	P.jag_amp[0] = EdgeJag * ROCK_JAG_SCALE * ROCK_JAG_REF_SCALE / max(P.jag_freq[0], 1e-3f);
	P.jag_freq[1] = JagScale * ROCK_SEAM_JAG_SCALE;
	P.jag_amp[1] = EdgeJag * ROCK_SEAM_JAG * ROCK_JAG_SCALE * ROCK_JAG_REF_SCALE / max(P.jag_freq[1], 1e-3f);
	P.chamfer_jag[0] = ChamferJag;
	P.chamfer_jag[1] = ChamferJag * ROCK_SEAM_CHAMFER_JAG;
	P.jag_detail = JagDetail;
	P.rim_chips = RimChips;
	P.rim_chip_size = RimChipSize;
	P.facet_iterations = max(FacetIterations, 0);
	P.facet_falloff = FacetFalloff;
	P.facet_random = FacetRandom;
	P.facet_align = FacetAlign;

	// Search reach in cells, from the row height rather than a fixed +-2. Rows thinner than a cell
	// is wide put a cell's true neighbours, and a chunk's falling wall, more than two rows away; a
	// fixed window missed them and cut hard seams along the row borders.
	//   build: a cell's Voronoi neighbours lie within about two cell widths either way.
	//   field: how far a chunk can reach past its own cell -- half a cell of site jitter, the wall
	//          fall-off, the gap, the jag at up to twice the reference chunk, and a chip -- plus
	//          one cell, since the pixel can sit anywhere in its own. Strata's row bond can also
	//          shift a site by up to a whole cell sideways.
	P.build_reach_i = max(2, (int)ceil(2.0f * P.rh));
	P.build_reach_j = max(2, (int)ceil(2.0f / P.rh));
	const float reach = 0.5f + 1.0f / max(P.wall_k, 1.0e-4f)
		+ 0.5f * max(abs(P.cell_gap), abs(P.seam_gap)) + 2.0f * max(abs(P.jag_amp[0]), abs(P.jag_amp[1])) + P.rim_chip_size;
	P.field_reach_i = max(2, (int)ceil(reach + P.strata) + 1);
	P.field_reach_j = max(2, (int)ceil(reach / P.rh) + 1);

	// Analytic height bounds, for Height Mode Analytic.
	//   hi: the highest a peak can be -- 1, plus the full fracture height bias.
	//   lo: the lowest top (all height variation and bias down), minus the most a top can fall
	//       across its chunk (steepest possible lean over a chunk's full width), minus the wall
	//       falling across the widest half gap.
	const float leanMax = tan(radians(abs(P.tilt_angle)))
		+ tan(radians(abs(P.tilt_random))) * (1.0f + ROCK_PIECE_LEAN);
	const float chunkWidth = 2.0f * 1.5f * max(1.0f, P.rh);
	P.height_hi = 1.0f + abs(P.fracture_height_bias);
	P.height_lo = 1.0f - P.height_clusters * (P.hvar + P.lvar) - abs(P.fracture_height_bias)
		- leanMax * chunkWidth
		- P.wall_k * 0.5f * max(0.0f, max(P.cell_gap, P.seam_gap));
	return P;
}

#if ROCK_STAGE == 3
// Gates use analytic bounds, independent of the generator's signed output convention.
float RockNormalizedHeightAt(int2 Pixel, float HeightLo, float HeightRange)
{
	Pixel = int2(RockWrap(Pixel.x, OutputSize.x), RockWrap(Pixel.y, OutputSize.y));
	if (RockIds.Load(int3(Pixel, 0)) == MIXTORMAT_INVALID_REGION)
	{
		return 0.0f;
	}
	return saturate((RockHeight.Load(int3(Pixel, 0)) - HeightLo) / HeightRange);
}
#endif

#if ROCK_STAGE == 0
[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	FRockPat P = RockSetup();
	const uint CellIndex = DispatchThreadId.x;
	if (CellIndex >= (uint)(P.cu * P.cv))
	{
		return;
	}
	const int wi = (int)(CellIndex % (uint)P.cu);
	const int wj = (int)(CellIndex / (uint)P.cu);

	FRockPoly cell;
	uint cid;
	RockCellPoly(P, wi, wj, cell, cid);
	const float layerRand = RockRand(P.seed, (uint)wj, 56u);

	// Every leaf of the cell's BSP tree (stackless heap walk).
	uint written = 0u;
	uint node = 1u;
	for (int guard = 0; guard < 1024; guard++)
	{
		int depth = firstbithigh(node);
		FRockPoly poly = cell;
		RockNodePoly(P, cid, node, depth, poly);
		float ar;
		RockCentroid(poly, ar);
		if ((int)node <= P.splits && poly.n >= 3 && ar > 1e-6f)
		{
			node <<= 1;
			continue;
		}
		if (poly.n >= 3 && written < (uint)MaxLeaves)
		{
			RockWriteLeaf(P, poly, cid, node, layerRand, CellIndex * (uint)MaxLeaves + written);
			written++;
		}
		while ((node & 1u) != 0u && node > 1u)
		{
			node >>= 1;
		}
		if (node <= 1u)
		{
			break;
		}
		node += 1u;
	}
	OutLeafCounts[CellIndex] = written;
}
#else
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 Pixel = int2(DispatchThreadId.xy);
	if (any(Pixel >= OutputSize))
	{
		return;
	}

#if ROCK_STAGE == 1
	const FRockPat P = RockSetup();
	const float2 UV = MixtormatGeneratorUV((float2(Pixel) + 0.5f) / float2(OutputSize));
	const float2 p = UV * (float)P.cu;
	const int ci = (int)floor(p.x);
	const int cj = (int)floor(p.y / RowHeight);
	const bool bJag = P.jag_amp[0] != 0.0f || P.jag_amp[1] != 0.0f;

	bool hit = false;
	float bestH = 0.0f;
	int bestCls = 0;
	float bestRamp = 0.0f;
	uint bestSlot = 0u;
	float nearestOutside = ROCK_BIG;
	float deepestInside = 0.0f;
	bool hasBoundary = false;

	for (int dj = -P.field_reach_j; dj <= P.field_reach_j; dj++)
	{
		for (int di = -P.field_reach_i; di <= P.field_reach_i; di++)
		{
			const int i = ci + di, j = cj + dj;
			const int wi = RockWrap(i, P.cu), wj = RockWrap(j, CellsV);
			// Shift the pixel into the canonical tile instead of shifting the geometry.
			const float2 pl = p - float2((float)(i - wi), (float)(j - wj) * RowHeight);
			const uint cellIndex = (uint)(wi + wj * P.cu);
			const uint count = LeafCounts[cellIndex];
			for (uint k = 0u; k < count; k++)
			{
				const uint slot = cellIndex * (uint)MaxLeaves + k;
				const FRockLeaf L = Leaves[slot];
				// Chunks never move after packing, so the rest frame is the canonical tile.
				const float2 c = float2(L.Cx, L.Cy);
				const float centreDistance = length(pl - c);
				// Radius encloses the gapped polygon; a farther chunk cannot improve either the
				// closest exterior edge or the deepest interior boundary.
				if (GeneratorLayer != 0u || centreDistance - L.Radius < max(nearestOutside, deepestInside))
				{
					float sd = bJag ? RockLeafSdJag(P, L, slot, pl) : RockLeafSd(L, slot, pl);
					if (GeneratorLayer != 0u && any(abs(GeneratorUVScale) != 1.0f) && sd < ROCK_BIG)
					{
						// Differentiate the same jagged outline, not the unjagged packing polygon.
						const float E = 1e-4f;
						const float2 X = float2(E, 0.0f), Y = float2(0.0f, E);
						const float2 G = float2(
							(bJag ? RockLeafSdJag(P, L, slot, pl + X) : RockLeafSd(L, slot, pl + X))
								- (bJag ? RockLeafSdJag(P, L, slot, pl - X) : RockLeafSd(L, slot, pl - X)),
							(bJag ? RockLeafSdJag(P, L, slot, pl + Y) : RockLeafSd(L, slot, pl + Y))
								- (bJag ? RockLeafSdJag(P, L, slot, pl - Y) : RockLeafSd(L, slot, pl - Y)));
						const float GL = length(G);
						if (GL != 0.0f) { sd = MixtormatGeneratorDistance(sd, G / GL); }
					}
					if (sd < ROCK_BIG)
					{
						hasBoundary = true;
						nearestOutside = min(nearestOutside, abs(sd));
						if (sd < 0.0f) deepestInside = max(deepestInside, -sd);
					}
				}
				if (centreDistance > L.Radius)
				{
					continue;
				}
				int cls;
				float ramp;
				const float H = RockLeafHeight(P, L, slot, pl, cls, ramp);
				if (!hit || H > bestH)
				{
					hit = true;
					bestH = H;
					bestCls = cls;
					bestRamp = ramp;
					bestSlot = slot;
				}
			}
		}
	}

	// Cache raw heights only; IDs preserve empty pixels through later mode resolution.
	OutRockHeight[Pixel] = hit ? bestH : 0.0f;
	OutRockTop[Pixel] = hit && bestCls == 0 ? 1.0f : 0.0f;
	OutRockChamfer[Pixel] = hit && bestCls == 1 ? 1.0f : 0.0f;
	OutRockWall[Pixel] = hit && bestCls == 2 ? 1.0f : 0.0f;
	OutRockTopRamp[Pixel] = hit && bestCls == 0 ? bestRamp : 0.0f;
	OutRockChamferRamp[Pixel] = hit && bestCls == 1 ? bestRamp : 0.0f;
	OutRockWallRamp[Pixel] = hit && bestCls == 2 ? bestRamp : 0.0f;
	const float boundaryDistance = hasBoundary
		? (deepestInside > 0.0f ? -deepestInside : nearestOutside) / (float)P.cu : 0.0f;
	OutRockEdgeDistance[Pixel] = boundaryDistance;
	OutRockBoundaryField[Pixel] = float2(boundaryDistance, hasBoundary ? 1.0f : 0.0f);
	OutRockIds[Pixel] = hit ? Leaves[bestSlot].Id : MIXTORMAT_INVALID_REGION;
#elif ROCK_STAGE == 3
	const FRockPat P = RockSetup();
	const float heightRange = max(P.height_hi - P.height_lo, 1e-6f);
	OutRockNormalizedHeight[Pixel] = RockNormalizedHeightAt(Pixel, P.height_lo, heightRange);
	// Central differences in cell widths, not pixels or tile widths. Wrap to preserve tiling
	// and account for each axis separately at non-square resolutions.
	const float2 gradient = float2(
		RockNormalizedHeightAt(Pixel + int2(1, 0), P.height_lo, heightRange)
			- RockNormalizedHeightAt(Pixel - int2(1, 0), P.height_lo, heightRange),
		RockNormalizedHeightAt(Pixel + int2(0, 1), P.height_lo, heightRange)
			- RockNormalizedHeightAt(Pixel - int2(0, 1), P.height_lo, heightRange))
		* float2(OutputSize) / (2.0f * (float)P.cu);
	// Inclination / 90 degrees: 0 = flat, 0.5 = 45 degrees, approaching 1 = vertical.
	OutRockSlope[Pixel] = RockIds.Load(int3(Pixel, 0)) != MIXTORMAT_INVALID_REGION
		? saturate(atan(length(MixtormatGeneratorSourceGradient(gradient))) * (4.0f / ROCK_TAU)) : 0.0f;
	// Height hits include walls extending past the outline, so IDs/classes are not coverage.
	// Explicit analytical RockGap mask only; it never gates height blending or layer visibility.
	// The union's signed gapped-outline distance is negative inside; unsampled pixels are gap.
	const float2 boundary = RockBoundaryField.Load(int3(Pixel, 0));
	OutRockGap[Pixel] = boundary.y > 0.0f && boundary.x <= 0.0f ? 0.0f : 1.0f;
#else
	// Resolve the generator's native signed height. Normalization and scale are the shared
	// generator output pass's job, not this shader's.
	OutHeight[Pixel] = RockHeight.Load(int3(Pixel, 0));
#endif
}
#endif
