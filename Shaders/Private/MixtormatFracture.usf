#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatFractureShape.ush"
#include "/Plugin/Mixtormat/Private/MixtormatUV.ush"

int2 OutputSize;
uint FractureSource;
uint HasRegionIds;
uint FractureSeed;
float FractureScale;
float FractureAmount;
float FractureWidthPixels;
float FractureDepth;
float FractureVariation;
float LayerTiling;
int2 LayerUVScale;
float2 LayerUVOffset;
uint LayerFlipU;
uint LayerFlipV;
int LayerRotation;

Texture2D<uint> RegionIds;
Texture2D<float> SourceHeight;
SamplerState LinearWrapSampler;
// Parent identity and generated sub-piece identity stay separate; neither is blended numerically.
RWTexture2D<uint2> OutPieceIds;
RWTexture2D<float2> OutSourcePosition;

float HeightAt(float2 P, uint Parent, float LocalHeight)
{
	if (HasRegionIds != 0u)
	{
		const int2 Base = int2(floor(P));
		[unroll]
		for (int Y = 0; Y <= 1; ++Y)
		{
			[unroll]
			for (int X = 0; X <= 1; ++X)
			{
				const uint Id = RegionIds.Load(int3(FractureWrap(Base + int2(X, Y), OutputSize), 0));
				if (Id == MIXTORMAT_INVALID_REGION || Id != Parent)
				{
					return LocalHeight;
				}
			}
		}
	}
	return SourceHeight.SampleLevel(LinearWrapSampler, (P + 0.5f) / float2(OutputSize), 0);
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 P = int2(DispatchThreadId.xy);
	const float2 UV = (float2(P) + 0.5f) / float2(OutputSize);
	const int Period = (int)round(FractureScale);
	const float Radius = FractureWidthPixels * 2.0f;
	// Keep Pattern/Ramp identity in its original pixel domain, including gaps.
	// Generated mode adds sub-pieces; it must not borrow another parent's height.
	const uint Parent = HasRegionIds != 0u ? RegionIds.Load(int3(P, 0)) : 0u;
	if (Parent == MIXTORMAT_INVALID_REGION)
	{
		OutPieceIds[P] = uint2(Parent, 0u);
		OutSourcePosition[P] = float2(P);
		return;
	}
	const float H = SourceHeight.Load(int3(P, 0));
	const float Lower = min(min(HeightAt(float2(P) + float2(Radius, 0), Parent, H),
		HeightAt(float2(P) - float2(Radius, 0), Parent, H)),
		min(HeightAt(float2(P) + float2(0, Radius), Parent, H),
		HeightAt(float2(P) - float2(0, Radius), Parent, H)));
	const float HighEdge = smoothstep(0.0f, FractureDepth, H - Lower);
	const uint WarpSeed = FractureOwnerSeed(uint2(Parent, 0u), FractureSeed);
	const float2 Curl = MixtormatPeriodicCurlField(UV, Period, WarpSeed);
	const float Fractal = FractureFractal(UV, Period, WarpSeed ^ 0x27d4eb2du);
	// Fixed pixel displacement folds increasingly short wavelengths at high Scale.
	// Bound derived displacement relative to wavelength, not the bound parameters.
	const float WavelengthPixels = float(min(OutputSize.x, OutputSize.y)) / float(Period);
	const float WarpPixels = FractureWidthPixels / (1.0f + 2.0f * FractureWidthPixels / WavelengthPixels);
	const float2 Q = float2(P) + WarpPixels * FractureAmount
		* FractureVariation * (0.35f + 0.65f * HighEdge)
		* Curl * (1.0f + 0.35f * Fractal);


	uint Piece = 0u;
	if (FractureSource != 1u)
	{
		const float2 SourceUV = MixtormatSourceUV(
			(Q + 0.5f) / float2(OutputSize),
			max(float2(LayerUVScale) * max(LayerTiling, 1.0e-4f), float2(1.0f, 1.0f)),
			LayerUVOffset, LayerFlipU, LayerFlipV, LayerRotation);
		const FMixtormatCellularResult Cell = MixtormatCellularMetric(
			SourceUV * float(Period), int2(Period, Period), FractureSeed + 211u,
			0.96f, 0.08f, float2(0.82f, 1.18f));
		Piece = Cell.CellId;
	}

	OutPieceIds[P] = uint2(Parent, Piece);
	OutSourcePosition[P] = Q;
}
