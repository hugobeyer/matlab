#ifndef MIXTORMAT_FRACTURE_SHAPE_USH
#define MIXTORMAT_FRACTURE_SHAPE_USH

#include "/Plugin/Mixtormat/Private/MixtormatCellular.ush"
#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"

int2 FractureWrap(int2 P, int2 Size)
{
	return int2(MixtormatWrapI(P.x, Size.x), MixtormatWrapI(P.y, Size.y));
}

float2 FractureDelta(float2 A, float2 B, int2 Size)
{
	const float2 D = A - B;
	return D - round(D / float2(Size)) * float2(Size);
}

uint FractureOwnerSeed(uint2 Owner, uint Seed)
{
	return MixtormatRegionHash(Owner.x ^ MixtormatRegionHash(Owner.y) ^ Seed);
}

// Three low-roughness octaves retain broad variation without global stripe directions.
// Integer lacunarity preserves tile seams. Unit-gradient noise is bounded by sqrt(2);
// normalizing that bound and the octave weights keeps the derived width positive.
float FractureFractal(float2 UV, int Period, uint Seed)
{
	const float Coarse = MixtormatPeriodicNoiseD(UV * float(Period), Period, Seed).x;
	const float Medium = MixtormatPeriodicNoiseD(
		UV * float(Period * 2), Period * 2, Seed ^ 0x9e3779b9u).x;
	const float Fine = MixtormatPeriodicNoiseD(
		UV * float(Period * 4), Period * 4, Seed ^ 0x85ebca6bu).x;
	return (Coarse + 0.18f * Medium + 0.0324f * Fine) * (0.70710678118f / 1.2124f);
}

float2 FractureShapeFields(float2 UV, int Period, uint Seed)
{
	const float2 Curl = MixtormatPeriodicCurlField(UV, Period, Seed);
	const float2 WarpedUV = UV + Curl * (0.125f / float(Period));
	return float2(
		FractureFractal(WarpedUV, Period, Seed ^ 0x27d4eb2du),
		FractureFractal(WarpedUV, Period, Seed ^ 0xc2b2ae35u));
}

// Three planar sections retain slope breaks instead of rounding every face with pow(distance).
float FractureFace(float U, float Profile)
{
	const float H1 = pow(0.35f, Profile);
	const float H2 = pow(0.72f, Profile);
	if (U < 0.35f)
	{
		return lerp(0.0f, H1, U / 0.35f);
	}
	if (U < 0.72f)
	{
		return lerp(H1, H2, (U - 0.35f) / 0.37f);
	}
	return lerp(H2, 1.0f, (U - 0.72f) / 0.28f);
}

#endif
