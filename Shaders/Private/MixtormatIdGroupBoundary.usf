#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGully.ush"

int2 OutputSize;
int OutlineWidth;
Texture2D<uint> GroupIds;
RWTexture2D<float> OutputBoundary;

int2 GroupBoundaryWrap(int2 P)
{
	return int2(MixtormatWrapI(P.x, OutputSize.x), MixtormatWrapI(P.y, OutputSize.y));
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}
	const int2 P = int2(DispatchThreadId.xy);
	const uint Center = GroupIds.Load(int3(P, 0));
	const int2 Directions[8] = {
		int2(1, 0), int2(-1, 0), int2(0, 1), int2(0, -1),
		int2(1, 1), int2(-1, 1), int2(1, -1), int2(-1, -1)};
	float Boundary = 0.0f;
	[loop]
	for (int Radius = 1; Radius <= OutlineWidth && Boundary == 0.0f; ++Radius)
	{
		[unroll]
		for (int Direction = 0; Direction < 8; ++Direction)
		{
			if (GroupIds.Load(int3(GroupBoundaryWrap(
				P + Directions[Direction] * Radius), 0)) != Center)
			{
				Boundary = 1.0f;
				break;
			}
		}
	}
	OutputBoundary[P] = Boundary;
}
