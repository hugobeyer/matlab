#ifndef MIXTORMAT_DIAGNOSTIC_COLOR_USH
#define MIXTORMAT_DIAGNOSTIC_COLOR_USH

#include "/Plugin/Mixtormat/Private/MixtormatDebugColor.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorWarp.ush"

// Code-owned styling; Flow/UV palette entries are sRGB, converted before filtering/blending.
// Mask ink keeps the existing PostFX's linear color exactly; its coverage lives only in alpha.
#define MIXTORMAT_DIAGNOSTIC_MASK_COLOR_LINEAR float3(0.5f, 0.05f, 0.05f)
#define MIXTORMAT_DIAGNOSTIC_CHECKER_DENSITY 16.0f
#define MIXTORMAT_DIAGNOSTIC_LINE_WIDTH 0.025f // Total width in checker cells.
#define MIXTORMAT_DIAGNOSTIC_TINT_AMOUNT 0.55f
#define MIXTORMAT_DIAGNOSTIC_EPSILON 1.0e-5f
#define MIXTORMAT_DIAGNOSTIC_SAMPLES_PER_AXIS 2 // 2x2 subpixel boxes, including tint boundaries.
#define MIXTORMAT_DIAGNOSTIC_SAMPLE_COUNT (MIXTORMAT_DIAGNOSTIC_SAMPLES_PER_AXIS * MIXTORMAT_DIAGNOSTIC_SAMPLES_PER_AXIS)
#define MIXTORMAT_DIAGNOSTIC_CHECKER_DARK float3(0.20f, 0.22f, 0.25f)
#define MIXTORMAT_DIAGNOSTIC_CHECKER_LIGHT float3(0.52f, 0.55f, 0.60f)
#define MIXTORMAT_DIAGNOSTIC_GRID_COLOR float3(1.0f, 1.0f, 1.0f)
#define MIXTORMAT_DIAGNOSTIC_CONTRACTION_COLOR float3(0.12f, 0.40f, 1.0f)
#define MIXTORMAT_DIAGNOSTIC_EXPANSION_COLOR float3(1.0f, 0.82f, 0.12f)
#define MIXTORMAT_DIAGNOSTIC_FOLD_COLOR float3(1.0f, 0.10f, 0.08f)
#define MIXTORMAT_DIAGNOSTIC_FLOW_SATURATION 0.85f
#define MIXTORMAT_DIAGNOSTIC_FLOW_STRENGTH_SCALE 1.0f
#define MIXTORMAT_DIAGNOSTIC_FLOW_MIN_VALUE 0.55f
#define MIXTORMAT_DIAGNOSTIC_TWO_PI 6.28318530718f

// Float4 published fields need RG only. B/A are NOT a generic validity mask.
// Address each tap periodically, but subtract its wrapped source texel-centre UV BEFORE
// interpolation. Neither absolute coordinates nor displacement winding are wrapped/rounded.
bool MixtormatDiagnosticSampleDisplacement(Texture2D<float4> Source, int2 Size,
	float2 QueryUV, out float2 Displacement)
{
	Displacement = float2(0.0f, 0.0f);
	if (!all(isfinite(QueryUV)) || any(Size <= 0)) { return false; }
	int2 Base;
	float4 Weights;
	MixtormatGeneratorWarpBilinear(QueryUV, Size, Base, Weights);
	[unroll]
	for (int Tap = 0; Tap < 4; ++Tap)
	{
		// A zero-weight neighbour must not turn an exact finite texel into NaN.
		if (Weights[Tap] > 0.0f)
		{
			const int2 Wrapped = MixtormatGeneratorWarpWrap(Base + int2(Tap % 2, Tap / 2), Size);
			const float2 StoredUV = Source.Load(int3(Wrapped, 0)).rg;
			if (!all(isfinite(StoredUV))) { return false; }
			const float2 SourceUV = (float2(Wrapped) + 0.5f) / float2(Size);
			Displacement += (StoredUV - SourceUV) * Weights[Tap];
		}
	}
	return all(isfinite(Displacement));
}

// J columns are destination-UV derivatives per unit SOURCE UV, not per pixel.
// Central differences use exactly one producer texel each way, then add identity.
// Differentiating displacement avoids false seam folds and preserves multi-tile travel.
bool MixtormatDiagnosticWarp(Texture2D<float4> Source, int2 Size, float2 QueryUV,
	out float2 W, out float2 JX, out float2 JY)
{
	W = JX = JY = float2(0.0f, 0.0f);
	float2 D, Left, Right, Bottom, Top;
	const float2 SourceTexel = 1.0f / float2(Size);
	if (!MixtormatDiagnosticSampleDisplacement(Source, Size, QueryUV, D)
		|| !MixtormatDiagnosticSampleDisplacement(Source, Size, QueryUV - float2(SourceTexel.x, 0.0f), Left)
		|| !MixtormatDiagnosticSampleDisplacement(Source, Size, QueryUV + float2(SourceTexel.x, 0.0f), Right)
		|| !MixtormatDiagnosticSampleDisplacement(Source, Size, QueryUV - float2(0.0f, SourceTexel.y), Bottom)
		|| !MixtormatDiagnosticSampleDisplacement(Source, Size, QueryUV + float2(0.0f, SourceTexel.y), Top))
	{
		return false;
	}
	W = QueryUV + D;
	JX = float2(1.0f, 0.0f) + (Right - Left) * (0.5f * float(Size.x));
	JY = float2(0.0f, 1.0f) + (Top - Bottom) * (0.5f * float(Size.y));
	return all(isfinite(W)) && all(isfinite(JX)) && all(isfinite(JY));
}

// Primitive of a zero-mean period-two square wave (+1, -1). Bounded even over
// many periods: no large accumulated integral whose subtraction would lose precision.
float MixtormatDiagnosticCheckerIntegral(float X)
{
	const float Phase = frac(X * 0.5f) * 2.0f;
	return min(Phase, 2.0f - Phase);
}

float MixtormatDiagnosticCheckerAverage(float Center, float Width)
{
	const float Phase = frac(Center * 0.5f) * 2.0f;
	if (Width <= MIXTORMAT_DIAGNOSTIC_EPSILON) { return Phase < 1.0f ? 1.0f : -1.0f; }
	return clamp((MixtormatDiagnosticCheckerIntegral(Phase + 0.5f * Width)
		- MixtormatDiagnosticCheckerIntegral(Phase - 0.5f * Width)) / Width, -1.0f, 1.0f);
}

// Bounded primitive of (periodic white-line coverage - its mean). The line is
// centred on each integer checker boundary, so coverage stays stable across wraps.
float MixtormatDiagnosticGridIntegral(float X)
{
	const float Phase = frac(X);
	return min(Phase, MIXTORMAT_DIAGNOSTIC_LINE_WIDTH)
		- MIXTORMAT_DIAGNOSTIC_LINE_WIDTH * Phase;
}

float MixtormatDiagnosticGridAverage(float Center, float Width)
{
	const float Phase = frac(Center + 0.5f * MIXTORMAT_DIAGNOSTIC_LINE_WIDTH);
	if (Width <= MIXTORMAT_DIAGNOSTIC_EPSILON)
	{
		return Phase < MIXTORMAT_DIAGNOSTIC_LINE_WIDTH ? 1.0f : 0.0f;
	}
	return saturate(MIXTORMAT_DIAGNOSTIC_LINE_WIDTH
		+ (MixtormatDiagnosticGridIntegral(Phase + 0.5f * Width)
		- MixtormatDiagnosticGridIntegral(Phase - 0.5f * Width)) / Width);
}

float4 MixtormatDiagnosticUVColor(Texture2D<float4> Source, int2 Size, float2 QueryUV,
	float2 OutputTexel, uint Rotate90)
{
	float2 W, JX, JY;
	if (!MixtormatDiagnosticWarp(Source, Size, QueryUV, W, JX, JY)) { return 0.0f; }
	const float Det = JX.x * JY.y - JX.y * JY.x;
	if (!isfinite(Det)) { return 0.0f; }

	// A display-domain rotation changes footprint axes, NOT stored vector components
	// or the warp's source-frame determinant. These are W-UV changes per output pixel.
	const float2 PixelDX = (Rotate90 != 0 ? -JY : JX) * OutputTexel.x;
	const float2 PixelDY = (Rotate90 != 0 ? JX : JY) * OutputTexel.y;
	// Texture-pixel AABB of each subpixel box, from J and the compose texel size.
	// Separable integrated periodic coverage approximates the projected parallelogram.
	const float2 TextureFootprint = (abs(PixelDX) + abs(PixelDY)) * float2(Size)
		/ float(MIXTORMAT_DIAGNOSTIC_SAMPLES_PER_AXIS);
	const float2 CellWidth = TextureFootprint / float2(Size) * MIXTORMAT_DIAGNOSTIC_CHECKER_DENSITY;
	const float2 Cell = W * MIXTORMAT_DIAGNOSTIC_CHECKER_DENSITY;
	if (!all(isfinite(Cell)) || !all(isfinite(CellWidth))) { return 0.0f; }
	const float Checker = 0.5f - 0.5f
		* MixtormatDiagnosticCheckerAverage(Cell.x, CellWidth.x)
		* MixtormatDiagnosticCheckerAverage(Cell.y, CellWidth.y);
	float3 Color = lerp(MixtormatDebugColor(MIXTORMAT_DIAGNOSTIC_CHECKER_DARK),
		MixtormatDebugColor(MIXTORMAT_DIAGNOSTIC_CHECKER_LIGHT), Checker);

	// Apply determinant styling at EACH subpixel, not just at the output centre.
	const float3 Tint = Det <= 0.0f ? MIXTORMAT_DIAGNOSTIC_FOLD_COLOR
		: (Det < 1.0f ? MIXTORMAT_DIAGNOSTIC_CONTRACTION_COLOR : MIXTORMAT_DIAGNOSTIC_EXPANSION_COLOR);
	const float TintWeight = Det <= 0.0f ? 1.0f
		: saturate(abs(log2(max(Det, MIXTORMAT_DIAGNOSTIC_EPSILON))));
	Color = lerp(Color, MixtormatDebugColor(Tint), MIXTORMAT_DIAGNOSTIC_TINT_AMOUNT * TintWeight);
	const float LineX = MixtormatDiagnosticGridAverage(Cell.x, CellWidth.x);
	const float LineY = MixtormatDiagnosticGridAverage(Cell.y, CellWidth.y);
	const float GridCoverage = LineX + LineY - LineX * LineY;
	Color = lerp(Color, MixtormatDebugColor(MIXTORMAT_DIAGNOSTIC_GRID_COLOR), GridCoverage);
	// Valid UVs cover the entire checker, even black cells. Coverage is not luminance.
	return float4(Color, 1.0f);
}

float4 MixtormatDiagnosticFlowColor(Texture2D<float4> Source, SamplerState SourceSampler, float2 QueryUV)
{
	if (!all(isfinite(QueryUV))) { return 0.0f; }
	const float2 Flow = Source.SampleLevel(SourceSampler, QueryUV, 0).rg;
	if (!all(isfinite(Flow))) { return 0.0f; }
	const float MaxComponent = max(abs(Flow.x), abs(Flow.y));
	if (!(MaxComponent > 0.0f)) { return 0.0f; }
	// Scale first to avoid length-squared overflow for large but finite Vector2 fields.
	const float2 Scaled = Flow / MaxComponent;
	const float Hue = atan2(Scaled.y, Scaled.x) / MIXTORMAT_DIAGNOSTIC_TWO_PI + 0.5f;
	// Keep every finite nonzero direction legible. Compress magnitude rather than clipping
	// at one; this form avoids overflowing length(Flow) for large finite components.
	const float RelativeStrength = MaxComponent / (MaxComponent
		+ (1.0f / MIXTORMAT_DIAGNOSTIC_FLOW_STRENGTH_SCALE) / length(Scaled));
	const float Value = lerp(MIXTORMAT_DIAGNOSTIC_FLOW_MIN_VALUE, 1.0f, RelativeStrength);
	const float3 HueColor = saturate(abs(frac(Hue + float3(0.0f, 2.0f / 3.0f, 1.0f / 3.0f)) * 6.0f - 3.0f) - 1.0f);
	const float3 Color = MixtormatDebugColor(Value
		* lerp(float3(1.0f, 1.0f, 1.0f), HueColor, MIXTORMAT_DIAGNOSTIC_FLOW_SATURATION));
	// Direction hue / strength value, never absolute UV or B/A-derived validity.
	return float4(Color, 1.0f);
}

#endif
