#include "/Engine/Public/Platform.ush"

// Mask-weighted roughness for what a carving filter removed. Shared by Erosion and Chipping.
//
// Both are post-layer filters: by the time either runs, the layer has already composited RAM.
// This reads that packed surface data and applies only the roughness weight derived from the
// effect coverage; base colour remains owned by the layer stack.
//
// Its own shader rather than another mode on the carving shaders. Those parameter structs are
// already large, and the extra texture slots would have to be bound, and dummied at the right
// size, on every carving, blur and resample dispatch that has no use for them.
//
// Two ways in, because the two filters know their coverage differently:
//
//   UseCoverageTexture 0 -- erosion. Coverage is the carve depth, still available as the
//     difference of the two height textures the filter has been ping-ponging. Nothing has to
//     be copied aside for it.
//   UseCoverageTexture 1 -- chipping. Coverage is read directly, because chipping already
//     computes it. Reconstructing it from the height pair would be worse: at chip depths
//     around 0.035 that difference is small enough to reintroduce the cancellation the R32F
//     work removed, and it would go to zero with Depth even though the chip is still there.

Texture2D<float> SourceHeight;
Texture2D<float> CarvedHeight;
Texture2D<float> CoverageTexture;
Texture2D<float4> SourceRAM;
SamplerState LinearWrapSampler;

RWTexture2D<float4> OutputRAM;

int2 OutputSize;
float RoughnessAmount;
float CarveDepth;
uint UseCoverageTexture;

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 Pixel = int2(DispatchThreadId.xy);
	const float2 UV = (float2(Pixel) + 0.5f) / float2(OutputSize);

	float Coverage;
	if (UseCoverageTexture != 0)
	{
		// Already at this resolution and already normalised, so it is loaded rather than
		// sampled and needs no CarveDepth.
		Coverage = saturate(CoverageTexture.Load(int3(Pixel, 0)));
	}
	else
	{
		// Sampled, not loaded: the carve pair lives at the internal erosion resolution, which
		// is twice this one unless the cap bit. At 2:1 a bilinear tap at this texel centre
		// lands on the 2x2 centroid, so the coverage is filtered rather than point-decimated
		// -- the same argument the height and normal resample rests on.
		const float Src = SourceHeight.SampleLevel(LinearWrapSampler, UV, 0.0f);
		const float Carved = CarvedHeight.SampleLevel(LinearWrapSampler, UV, 0.0f);

		// Erosion only ever removes, so this is non-negative by construction. The max is
		// against rounding, not against the filter adding material.
		const float Carve = max(Src - Carved, 0.0f);

		// The depth that reads as fully carved. Without it coverage would be in raw height
		// units, where every usable carve saturates instantly and both controls are all or
		// nothing.
		Coverage = saturate(Carve / max(CarveDepth, 1.0e-5f));
	}

	float4 RAM = SourceRAM.Load(int3(Pixel, 0));

	// Roughness is a signed, mask-weighted offset. R is the roughness channel the composite reads.
	RAM.r = saturate(RAM.r + RoughnessAmount * Coverage);

	OutputRAM[Pixel] = RAM;
}
