// Analytic ferrous corrosion. Relative units; no hidden steel or inferred coating breach.
#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorPlacement.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorHeightModules.ush"
#include "/Plugin/Mixtormat/Private/MixtormatNoise.ush"

int2 OutputSize;
uint Seed;
uint Structure;
float ClusterPeriod;
// @param Coverage saturates
float Coverage;
// @param PitDepth
float PitDepth;
// @param Buildup
float Buildup;
// @param Flaking saturates
float Flaking;
// @param SurfaceBias
float SurfaceBias;
// @param Variation saturates
float Variation;
// @param HeightScale
float HeightScale;
// @param Roughness saturates
float Roughness;
uint ColorCount;
uint ColorInterpolation;
float4 ColorPositions[MIXTORMAT_COLOR_RAMP_MAX_STOPS];
float4 ColorColors[MIXTORMAT_COLOR_RAMP_MAX_STOPS];
Texture2D<float> SubstrateHeight;
SamplerState LinearWrapSampler;
RWTexture2D<float> OutHeight;
RWTexture2D<float> OutCoverage;
RWTexture2D<float4> OutColor;
RWTexture2D<float4> OutRAM;
RWTexture2D<float4> OutOptics;

static const int RUST_NOISE_OCTAVES = 4;
static const float RUST_NOISE_ROUGHNESS = 0.55f;
static const float RUST_NOISE_LACUNARITY = 2.0f;
static const float2 RUST_NOISE_AA_RANGE = float2(0.35f, 0.9f);

// Reuse Noise's periodic gradient lattice and octave contract. Filter each octave,
// retaining the full normalization so unresolved detail tends to its mean, not a new look.
float RustNoise(float2 UV, float Period, uint Salt, float FootprintUV)
{
	float Value = 0.0f, Weight = 1.0f, WeightSum = 0.0f;
	[unroll] for (int Octave = 0; Octave < RUST_NOISE_OCTAVES; ++Octave)
	{
		int P = MixtormatNoiseOctavePeriod(Period);
		float Resolved = 1.0f - smoothstep(RUST_NOISE_AA_RANGE.x, RUST_NOISE_AA_RANGE.y,
			FootprintUV * Period);
		if (P > 0 && Resolved > 0.0f)
		{
			Value += MixtormatPeriodicNoiseD(UV * float(P), P,
				Seed ^ (Salt + uint(Octave) * 0x2545F491u)).x
				* MIXTORMAT_NOISE_SQRT2 * Weight * Resolved;
		}
		WeightSum += Weight;
		Weight *= RUST_NOISE_ROUGHNESS;
		Period *= RUST_NOISE_LACUNARITY;
	}
	return Value / WeightSum;
}
float2 RustUV(float2 UV)
{
	float2 P = MixtormatGeneratorUV(UV);
	return (0.5f + mul(MixtormatSourceOrientation(GeneratorUVFlipU, GeneratorUVFlipV,
		GeneratorUVRotation), P - 0.5f)) * GeneratorUVScale + GeneratorUVOffset;
}

// Loss and retained product have separate lifetimes. Buildup=0 still permits thin oxide;
// Flaking=1 removes all oxide/products without changing the attack or loss fields.
float4 RustFields(float2 UV, float Bias, float Footprint)
{
	float FootprintUV = Footprint / max(ClusterPeriod, 1.0f);
	float Broad = RustNoise(UV, ClusterPeriod, 17u, FootprintUV);
	float2 Drift = float2(RustNoise(UV, ClusterPeriod, 43u, FootprintUV),
		RustNoise(UV, ClusterPeriod, 61u, FootprintUV));
	// Continuous domain deformation varies spacing, shape and local orientation together.
	// Variation is not clamped to the inspector's suggested interval.
	float2 Q = UV + Drift * Variation / max(ClusterPeriod, 1.0f);
	float DetailFootprint = FootprintUV * (1.0f + abs(Variation) * 4.0f);
	float Meso = RustNoise(Q, ClusterPeriod * 3.0f, 83u, DetailFootprint);
	float Fine = RustNoise(Q, ClusterPeriod * 12.0f, 191u, DetailFootprint);
	float AttackField = 0.5f + Broad * 0.65f + Meso * 0.25f + Bias * 0.18f;
	float AA = max(Footprint * 0.45f, 0.025f);
	float Threshold = 1.0f - Coverage;
	float Attack = Coverage <= 0 ? 0 : (Coverage >= 1 ? 1 : smoothstep(Threshold-AA, Threshold+AA, AttackField));
	// Coverage reveals fixed profiles; shedding never changes consumed metal.
	float Basin = saturate(0.5f + Broad);
	float Pits = saturate(0.5f + Meso);
	float Loss = Attack * PitDepth * (0.18f + 0.48f * Basin + 0.34f * Pits);
	float RetentionField = 0.5f + RustNoise(Q, ClusterPeriod * 2.0f, 227u, DetailFootprint);
	float Survives = Flaking <= 0 ? 1 : (Flaking >= 1 ? 0 : smoothstep(Flaking-AA, Flaking+AA, RetentionField));
	float Aggregate = saturate(0.5f + Fine + Meso * 0.25f);
	float Seam = 1.0f;
	float Deposit = 0.4f + 0.35f * Basin;
	if (Structure == 1u) Deposit *= 0.55f + 0.85f * Aggregate;
	if (Structure == 2u)
	{
		int PlatePeriod = MixtormatNoiseOctavePeriod(ClusterPeriod * 3.0f);
		float PlateResolved = 1.0f - smoothstep(RUST_NOISE_AA_RANGE.x, RUST_NOISE_AA_RANGE.y,
			DetailFootprint * ClusterPeriod * 3.0f);
		if (PlatePeriod > 0 && PlateResolved > 0.0f)
		{
			FMixtormatNoiseWorley Plate = MixtormatNoiseV2Worley(Q, PlatePeriod, Seed ^ 83u, 1.0f, 0);
			Seam = lerp(1.0f, smoothstep(0.012f, 0.065f, Plate.F2 - Plate.F1), PlateResolved);
		}
		float Terraces = 0.3f + 0.35f * smoothstep(0.25f,0.35f,Pits)
			+ 0.35f * smoothstep(0.65f,0.75f,Pits);
		Deposit = Terraces * Seam;
	}
	Deposit *= 1.0f + Variation * Broad * 0.7f;
	float Retained = Attack * Survives * Buildup * saturate(Deposit);
	float Oxide = Attack * Survives * (Structure == 2u ? lerp(.35f,1.0f,Seam) : 1.0f);
	// Never color a whole Voronoi owner: continuous multiscale pigment crosses cell borders.
	float Pigment = saturate(0.5f + Variation * (Broad * 0.75f + Meso * 0.55f + Fine * 0.2f));
	return float4(Retained - Loss, Oxide, Pigment, Aggregate);
}

[numthreads(8,8,1)]
void MainCS(uint3 Id : SV_DispatchThreadID)
{
	int2 P = int2(Id.xy);
	if (any(P >= OutputSize)) return;
	float2 Texel = 1.0f / float2(OutputSize);
	float2 UV = (float2(P)+.5f) * Texel;
	float2 Q = RustUV(UV);
	float2 DX = RustUV(UV+float2(Texel.x,0))-Q;
	float2 DY = RustUV(UV+float2(0,Texel.y))-Q;
	float Footprint = max(length(DX+DY),length(DX-DY)) * float(ClusterPeriod);
	// Immutable substrate sampling at a bounded feature-relative radius. A geometric cue only.
	float2 D = max(Texel, (0.2f / float(ClusterPeriod)).xx);
	float H = SubstrateHeight.SampleLevel(LinearWrapSampler, UV, 0);
	float Mean = (SubstrateHeight.SampleLevel(LinearWrapSampler, UV+float2(D.x,0),0)
		+ SubstrateHeight.SampleLevel(LinearWrapSampler, UV-float2(D.x,0),0)
		+ SubstrateHeight.SampleLevel(LinearWrapSampler, UV+float2(0,D.y),0)
		+ SubstrateHeight.SampleLevel(LinearWrapSampler, UV-float2(0,D.y),0)) * .25f;
	float Bias = isfinite(H) && isfinite(Mean) ? clamp((Mean-H)*32.0f,-1.0f,1.0f)*SurfaceBias : 0;
	float Height = 0, Cover = 0, Rough = 0;
	float3 Color = 0;
	const float2 Samples[4] = {float2(-.25f,-.25f),float2(.25f,-.25f),float2(-.25f,.25f),float2(.25f,.25f)};
	[unroll] for (int I=0; I<4; ++I)
	{
		float4 F = RustFields(Q+DX*Samples[I].x+DY*Samples[I].y, Bias, Footprint);
		Height += F.x * .25f;
		Cover += F.y * .25f;
		Color += MixtormatEvalColorRamp(F.z, ColorCount, ColorInterpolation, ColorPositions, ColorColors).rgb * F.y * .25f;
		Rough += saturate(Roughness + Variation * (F.w-.5f)*.18f) * F.y * .25f;
	}
	// Unpremultiply only material fields. The signed relief is NEVER divided by coverage.
	OutHeight[P] = Height * HeightScale;
	OutCoverage[P] = Cover;
	OutColor[P] = float4(Cover > 0 ? Color / Cover : 0, 1);
	OutRAM[P] = float4(Cover > 0 ? Rough / Cover : Roughness, 1, 0, .04f);
	OutOptics[P] = float4(.04f,0,0,0);
}
