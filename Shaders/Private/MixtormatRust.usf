// Analytic ferrous corrosion. Relative units; no hidden steel or inferred coating breach.
#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorPlacement.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorHeightModules.ush"
#include "/Plugin/Mixtormat/Private/MixtormatNoise.ush"

int2 OutputSize;
uint Seed;
uint Structure;
float ClusterPeriod;
// @param Coverage saturates
float Coverage;
// @param PitDepth
float PitDepth;
// @param Buildup
float Buildup;
// @param Flaking saturates
float Flaking;
// @param SurfaceBias
float SurfaceBias;
// @param Variation saturates
float Variation;
// @param HeightScale
float HeightScale;
// @param Roughness saturates
float Roughness;
uint ColorCount;
uint ColorInterpolation;
float4 ColorPositions[MIXTORMAT_COLOR_RAMP_MAX_STOPS];
float4 ColorColors[MIXTORMAT_COLOR_RAMP_MAX_STOPS];
Texture2D<float> SubstrateHeight;
SamplerState LinearWrapSampler;
RWTexture2D<float> OutHeight;
RWTexture2D<float> OutCoverage;
RWTexture2D<float4> OutColor;
RWTexture2D<float4> OutRAM;
RWTexture2D<float4> OutOptics;

static const int RUST_NOISE_OCTAVES = 4;
static const float RUST_NOISE_ROUGHNESS = 0.55f;
static const float RUST_NOISE_LACUNARITY = 2.0f;
static const float2 RUST_NOISE_AA_RANGE = float2(0.35f, 0.9f);

// Reuse Noise's periodic gradient lattice and octave contract. Filter each octave,
// retaining the full normalization so unresolved detail tends to its mean, not a new look.
// Returns float3(Value, dValue/dU, dValue/dV) in UV space so domain warps can propagate
// their exact 2x2 Jacobian into downstream filter footprints.
float3 RustNoiseD(float2 UV, float Period, uint Salt, float FootprintUV)
{
	float Value = 0.0f, Weight = 1.0f, WeightSum = 0.0f;
	float2 Grad = float2(0.0f, 0.0f);
	[unroll] for (int Octave = 0; Octave < RUST_NOISE_OCTAVES; ++Octave)
	{
		int P = MixtormatNoiseOctavePeriod(Period);
		float Resolved = 1.0f - smoothstep(RUST_NOISE_AA_RANGE.x, RUST_NOISE_AA_RANGE.y,
			FootprintUV * Period);
		if (P > 0 && Resolved > 0.0f)
		{
			float3 N = MixtormatPeriodicNoiseD(UV * float(P), P,
				Seed ^ (Salt + uint(Octave) * 0x2545F491u));
			float Scale = MIXTORMAT_NOISE_SQRT2 * Weight * Resolved;
			Value += N.x * Scale;
			Grad += N.yz * (float(P) * Scale);
		}
		WeightSum += Weight;
		Weight *= RUST_NOISE_ROUGHNESS;
		Period *= RUST_NOISE_LACUNARITY;
	}
	return float3(Value, Grad) / WeightSum;
}

float RustNoise(float2 UV, float Period, uint Salt, float FootprintUV)
{
	return RustNoiseD(UV, Period, Salt, FootprintUV).x;
}

// Single-octave filtered periodic gradient noise for fast micro-detail and directional warps.
float RustSingleNoise(float2 UV, float Period, uint Salt, float FootprintUV)
{
	int P = MixtormatNoiseOctavePeriod(Period);
	float Resolved = 1.0f - smoothstep(RUST_NOISE_AA_RANGE.x, RUST_NOISE_AA_RANGE.y,
		FootprintUV * Period);
	if (P <= 0 || Resolved <= 0.0f)
	{
		return 0.0f;
	}
	return MixtormatPeriodicNoiseD(UV * float(P), P, Seed ^ Salt).x * MIXTORMAT_NOISE_SQRT2 * Resolved;
}

// Filtered periodic Worley evaluation: returns float4(F1, F2, EdgeDistance = F2 - F1, CellRand01)
// plus outputs the cell center offset (sample - feature point) in OutDelta for asymmetric plate tilt.
float4 RustWorley(float2 UV, float Period, uint Salt, float Jitter, float FootprintUV, out float2 OutDelta)
{
	OutDelta = float2(0.0f, 0.0f);
	int P = MixtormatNoiseOctavePeriod(Period);
	float Resolved = 1.0f - smoothstep(RUST_NOISE_AA_RANGE.x, RUST_NOISE_AA_RANGE.y,
		FootprintUV * Period);
	if (P <= 0 || Resolved <= 0.0f)
	{
		return float4(0.5f, 0.75f, 0.25f, 0.5f);
	}
	FMixtormatNoiseWorley W = MixtormatNoiseV2Worley(UV, P, Seed ^ Salt, Jitter, 0);
	OutDelta = (W.Direction * W.F1) * Resolved;
	float CellRand = float(MixtormatHashU(W.CellId ^ (Seed + Salt * 0x9E3779B9u)) & 0xFFFFu) / 65535.0f;
	float F1 = lerp(0.5f, W.F1, Resolved);
	float F2 = lerp(0.75f, W.F2, Resolved);
	float Edge = lerp(0.25f, saturate(W.F2 - W.F1), Resolved);
	return float4(F1, F2, Edge, lerp(0.5f, CellRand, Resolved));
}

float2 RustUV(float2 UV)
{
	float2 P = MixtormatGeneratorUV(UV);
	return (0.5f + mul(MixtormatSourceOrientation(GeneratorUVFlipU, GeneratorUVFlipV,
		GeneratorUVRotation), P - 0.5f)) * GeneratorUVScale + GeneratorUVOffset;
}

// Multi-scale isotropic substrate crevice & ridge sensor.
// Evaluates height differences across three feature-coupled rings (micro-scratch,
// meso-groove/rib, macro-pocket) using 8 rotated taps per ring to prevent 4-tap axis ghosting.
// For SurfaceBias > 0, captures both the crevice floor/walls AND a smooth shoulder bleed halo
// so corrosion spreads organically across crack/groove lips instead of being repelled by a negative moat.
// Strictly invariant to adding a constant offset to SubstrateHeight.
float SampleSubstrateBias(float2 UV, float2 Texel, float BasePeriod)
{
	if (abs(SurfaceBias) <= 1e-5f)
	{
		return 0.0f;
	}
	float H0 = SubstrateHeight.SampleLevel(LinearWrapSampler, UV, 0);
	if (!isfinite(H0))
	{
		return 0.0f;
	}

	const float2 Dirs[8] =
	{
		float2( 1.0f,  0.0f),
		float2(-1.0f,  0.0f),
		float2( 0.0f,  1.0f),
		float2( 0.0f, -1.0f),
		float2( 0.70710678f,  0.70710678f),
		float2(-0.70710678f,  0.70710678f),
		float2( 0.70710678f, -0.70710678f),
		float2(-0.70710678f, -0.70710678f)
	};

	float InvPeriod = 1.0f / max(BasePeriod, 1.0f);
	float2 R0 = max(Texel * 1.5f, max((0.14f * InvPeriod).xx, float2(0.0015f, 0.0015f)));
	float2 R1 = max(Texel * 4.0f, max((0.45f * InvPeriod).xx, float2(0.0050f, 0.0050f)));
	float2 R2 = max(Texel * 10.0f, max((1.15f * InvPeriod).xx, float2(0.0140f, 0.0140f)));

	float Sum0 = 0.0f, Sum1 = 0.0f, Sum2 = 0.0f;
	float Min0 = H0, Min1 = H0, Min2 = H0;
	float Max0 = H0, Max1 = H0, Max2 = H0;
	[unroll] for (int I = 0; I < 8; ++I)
	{
		float S0 = SubstrateHeight.SampleLevel(LinearWrapSampler, UV + Dirs[I] * R0, 0);
		float S1 = SubstrateHeight.SampleLevel(LinearWrapSampler, UV + Dirs[I] * R1, 0);
		float S2 = SubstrateHeight.SampleLevel(LinearWrapSampler, UV + Dirs[I] * R2, 0);
		Sum0 += S0; Min0 = min(Min0, S0); Max0 = max(Max0, S0);
		Sum1 += S1; Min1 = min(Min1, S1); Max1 = max(Max1, S1);
		Sum2 += S2; Min2 = min(Min2, S2); Max2 = max(Max2, S2);
	}
	float Mean0 = Sum0 * 0.125f;
	float Mean1 = Sum1 * 0.125f;
	float Mean2 = Sum2 * 0.125f;
	if (!isfinite(Mean0) || !isfinite(Mean1) || !isfinite(Mean2))
	{
		return 0.0f;
	}

	if (SurfaceBias > 0.0f)
	{
		// Crevice floor/wall recess + shoulder bleed halo around nearby cracks/grooves.
		float Floor0 = max(0.0f, Mean0 - H0) + 0.35f * max(0.0f, Max0 - H0);
		float Floor1 = max(0.0f, Mean1 - H0) + 0.35f * max(0.0f, Max1 - H0);
		float Floor2 = max(0.0f, Mean2 - H0) + 0.30f * max(0.0f, Max2 - H0);

		float Shoulder0 = max(0.0f, Mean0 - Min0) * 0.48f;
		float Shoulder1 = max(0.0f, Mean1 - Min1) * 0.42f;
		float Shoulder2 = max(0.0f, Mean2 - Min2) * 0.28f;

		float Crevice0 = tanh(max(Floor0, Shoulder0) * 58.0f);
		float Crevice1 = tanh(max(Floor1, Shoulder1) * 40.0f);
		float Crevice2 = tanh(max(Floor2, Shoulder2) * 24.0f);
		float Crevice = saturate(Crevice0 * 0.36f + Crevice1 * 0.42f + Crevice2 * 0.22f);

		// Map [0..1] crevice affinity so strong positive SurfaceBias focuses initiation into
		// crevices and their shoulders while pulling corrosion back from flat uncreviced expanses.
		return (Crevice * 1.45f - 0.32f * SurfaceBias) * SurfaceBias;
	}
	else
	{
		// Convex ridge, rib crest, and sharp crack/edge lip affinity when SurfaceBias < 0.
		float Crest0 = max(0.0f, H0 - Mean0) + 0.40f * max(0.0f, H0 - Min0);
		float Crest1 = max(0.0f, H0 - Mean1) + 0.35f * max(0.0f, H0 - Min1);
		float Crest2 = max(0.0f, H0 - Mean2) + 0.25f * max(0.0f, H0 - Min2);

		float Ridge0 = tanh(Crest0 * 58.0f);
		float Ridge1 = tanh(Crest1 * 40.0f);
		float Ridge2 = tanh(Crest2 * 24.0f);
		float Ridge = saturate(Ridge0 * 0.36f + Ridge1 * 0.42f + Ridge2 * 0.22f);

		float Strength = -SurfaceBias;
		return (Ridge * 1.45f - 0.32f * Strength) * Strength;
	}
}

// Loss and retained product have separate lifetimes. Buildup=0 still permits thin oxide;
// Flaking=1 removes all oxide/products without changing the attack or loss fields.
// Coverage reveals fixed spatial profiles: pit depth, deposit profile, flake retention, and
// pigment never depend on Coverage/Threshold, so increasing Coverage expands the footprint
// without deepening or renormalizing already-covered features.
// Returns float4(SignedHeightDelta, VisibleOxideCoverage, RampPigment01, LocalRoughnessDelta).
float4 RustFields(float2 UV, float2 DX, float2 DY, float Bias, float Footprint)
{
	float BasePeriod = max(ClusterPeriod, 1.0f);
	float FootprintUV = Footprint / BasePeriod;
	float Var = Variation;

	// 1. Hierarchical domain warp: macro susceptibility drift + meso colony distortion,
	// propagating the exact 2x2 analytic Jacobian dQ/dUV onto the pixel step vectors (DX, DY).
	float MacroPeriod = max(2.0f, round(pow(BasePeriod, 0.55f) * 0.85f));
	float MacroWarpScale = 0.28f * Var / MacroPeriod;
	float ColonyWarpScale = 0.55f * Var / BasePeriod;

	float3 MacroDriftU = RustNoiseD(UV, MacroPeriod, 19u, FootprintUV);
	float3 MacroDriftV = RustNoiseD(UV, MacroPeriod, 37u, FootprintUV);
	float3 ColonyDriftU = RustNoiseD(UV, BasePeriod, 43u, FootprintUV);
	float3 ColonyDriftV = RustNoiseD(UV, BasePeriod, 61u, FootprintUV);

	float2 MacroDrift = float2(MacroDriftU.x, MacroDriftV.x);
	float2 ColonyDrift = float2(ColonyDriftU.x, ColonyDriftV.x);

	float2 QMacro = UV + MacroDrift * MacroWarpScale;
	float2 Q = QMacro + ColonyDrift * ColonyWarpScale;

	// Exact 2x2 Jacobian J = I + d(MacroWarp)/dUV + d(ColonyWarp)/dUV applied to DX and DY.
	float2 GradQu = float2(1.0f, 0.0f) + MacroDriftU.yz * MacroWarpScale + ColonyDriftU.yz * ColonyWarpScale;
	float2 GradQv = float2(0.0f, 1.0f) + MacroDriftV.yz * MacroWarpScale + ColonyDriftV.yz * ColonyWarpScale;
	float2 DX_Q = float2(dot(GradQu, DX), dot(GradQv, DX));
	float2 DY_Q = float2(dot(GradQu, DY), dot(GradQv, DY));
	float2 DX_Macro = DX + float2(dot(MacroDriftU.yz, DX), dot(MacroDriftV.yz, DX)) * MacroWarpScale;
	float2 DY_Macro = DY + float2(dot(MacroDriftU.yz, DY), dot(MacroDriftV.yz, DY)) * MacroWarpScale;

	float MacroFootprint = max(FootprintUV, max(length(DX_Macro + DY_Macro), length(DX_Macro - DY_Macro)));
	float DetailFootprint = max(FootprintUV, max(length(DX_Q + DY_Q), length(DX_Q - DY_Q)));

	// 2. Correlated multi-scale susceptibility and colony nucleation.
	// MacroZone groups attack into broader corroded regions; ColonyFBM and ColonyCells form
	// coalescing corrosion islands, while FreckleCells add pinpoint satellite initiation sites.
	float MacroZone = RustNoise(QMacro, MacroPeriod, 11u, MacroFootprint);
	float Broad = RustNoise(Q, BasePeriod * 0.85f, 17u, DetailFootprint);
	float Meso = RustNoise(Q, BasePeriod * 2.5f, 83u, DetailFootprint);
	float Fine = RustNoise(Q, BasePeriod * 8.0f, 191u, DetailFootprint);
	float Micro = RustSingleNoise(Q, BasePeriod * 22.0f, 313u, DetailFootprint);

	float2 ColonyDelta;
	float4 ColonyCell = RustWorley(Q, BasePeriod * 1.15f, 101u, 0.9f, DetailFootprint, ColonyDelta);
	float ColonyNucleus = saturate(1.0f - ColonyCell.x * 1.15f);

	float2 PitDelta;
	float4 PitCell = RustWorley(Q + ColonyDrift * (0.25f / BasePeriod), BasePeriod * 3.2f, 149u, 0.95f, DetailFootprint, PitDelta);
	float PitNucleus = saturate(1.0f - PitCell.x * 1.35f);

	// Pinpoint satellite freckling & filiform creep around colony borders.
	float2 FreckleDelta;
	float4 FreckleCell = RustWorley(Q, BasePeriod * 7.5f, 199u, 1.0f, DetailFootprint, FreckleDelta);
	float FreckleSpatter = saturate(1.0f - FreckleCell.x * 1.65f) * smoothstep(0.35f, 0.85f, FreckleCell.w);

	// Combine regional envelope, colony bodies, satellite freckles, and substrate crevice bias.
	float RegionalSusceptibility = 0.5f
		+ MacroZone * 0.34f
		+ Broad * 0.38f
		+ Meso * 0.22f
		+ (ColonyNucleus - 0.35f) * 0.24f
		+ (FreckleSpatter - 0.15f) * 0.14f * (0.35f + 0.65f * saturate(Var));

	float BiasInfluence = Bias * (0.52f + 0.28f * saturate(0.5f + Broad));
	float AttackField = saturate(RegionalSusceptibility + BiasInfluence + Fine * 0.08f * saturate(Var));

	float AA = max(DetailFootprint * BasePeriod * 0.38f, 0.018f);
	float Threshold = 1.0f - Coverage;
	float Attack = Coverage <= 0.0f ? 0.0f
		: (Coverage >= 1.0f ? 1.0f : smoothstep(Threshold - AA, Threshold + AA, AttackField));

	// Fixed spatial colony core intensity (strictly independent of Coverage/Threshold so changing
	// Coverage never alters surviving pit depth, deposit buildup, or flake retention).
	float ColonyCore = smoothstep(0.22f, 0.82f, AttackField);
	float Basin = saturate(0.5f + Broad);
	float Pits = saturate(0.5f + Meso);

	// 3. Metal recession (PitDepth): sparse steep-walled pits -> overlapping pits -> connected valleys.
	// Fixed profile revealed by Attack; shedding (Flaking) never restores consumed metal.
	float ValleyErosion = (0.25f + 0.75f * ColonyCore) * saturate(0.42f + 0.58f * Basin + 0.28f * Meso);
	float PrimaryPitBowl = pow(PitNucleus, 1.65f) * (0.45f + 0.55f * PitCell.w);
	float MicroPitBowl = pow(FreckleSpatter, 1.8f) * 0.45f;
	float PitLocalization = saturate(PrimaryPitBowl * 0.68f + ValleyErosion * 0.46f + MicroPitBowl * 0.26f
		+ max(Bias, 0.0f) * 0.22f);
	float Loss = Attack * PitDepth * (0.14f + 0.86f * PitLocalization);

	// 4. Structure-specific deposit envelope, delamination plates, and shedding (Flaking).
	float Deposit = 0.0f;
	float RetentionField = 0.5f;
	float PlateCrackSeam = 1.0f;
	float PlateEdgeLift = 0.0f;
	float PlateTier = 0.5f;
	float NoduleCrest = 0.0f;

	float GranularAggregate = saturate(0.5f + Fine * 0.65f + Micro * 0.35f + (FreckleSpatter - 0.25f) * 0.45f);

	if (Structure == 0u)
	{
		// Smooth: thin discoloration & coherent low-relief ferric film with subtle mottled variation.
		Deposit = (0.35f + 0.45f * Basin + 0.20f * Pits)
			* (1.0f + 0.35f * Var * Broad);
		RetentionField = saturate(0.52f + 0.38f * RustNoise(Q, BasePeriod * 1.8f, 227u, DetailFootprint)
			+ 0.20f * (ColonyCore - 0.5f));
	}
	else if (Structure == 1u)
	{
		// Granular: clumped nodular oxyhydroxide pustules, coarse crusty mounds, and sandy aggregates.
		float2 NoduleDelta;
		float4 NoduleCell = RustWorley(Q + ColonyDrift * (0.4f / BasePeriod), BasePeriod * 4.5f, 251u, 0.95f, DetailFootprint, NoduleDelta);
		float CoarseNodule = smoothstep(0.68f, 0.08f, NoduleCell.x) * (0.45f + 0.55f * NoduleCell.w);
		float FineNodule = pow(FreckleSpatter, 1.25f);
		NoduleCrest = saturate(CoarseNodule * 0.70f + FineNodule * 0.45f + max(Fine, 0.0f) * 0.35f);

		float MoundEnvelope = 0.42f + 0.58f * saturate(0.5f + Broad + Meso * 0.4f);
		Deposit = MoundEnvelope * (0.42f + 0.78f * NoduleCrest + 0.38f * GranularAggregate)
			* (1.0f + Var * 0.55f * Basin);

		// Granular shedding crumbles unstable outer/loose clusters first while preserving consolidated scab cores.
		RetentionField = saturate(0.48f
			+ 0.36f * RustNoise(Q, BasePeriod * 2.0f, 227u, DetailFootprint)
			+ 0.24f * (CoarseNodule - 0.35f)
			+ 0.16f * (ColonyCore - 0.45f));
	}
	else
	{
		// Layered: brittle polygonal scale plates with ordered elevation tiers, sharp fracture seams,
		// asymmetric curled edge lift, and plate-coherent spalling/delamination.
		float2 PlateWarp = float2(
			RustSingleNoise(Q, BasePeriod * 4.0f, 269u, DetailFootprint),
			RustSingleNoise(Q, BasePeriod * 4.0f, 281u, DetailFootprint)) * (0.14f / BasePeriod);
		float2 PlateDelta;
		float4 Plate = RustWorley(Q + PlateWarp, BasePeriod * 2.6f, 83u, 0.88f, DetailFootprint, PlateDelta);

		// Sub-plate secondary fracture network for smaller internal chips and terraced steps.
		float2 SubPlateDelta;
		float4 SubPlate = RustWorley(Q - PlateWarp * 0.6f, BasePeriod * 5.8f, 173u, 0.85f, DetailFootprint, SubPlateDelta);

		PlateTier = Plate.w;
		// Sharp fracture seam between adjacent scale plates (0 in crack, 1 inside plate).
		float PrimarySeam = smoothstep(0.008f, 0.055f, Plate.z);
		float SecondarySeam = lerp(1.0f, smoothstep(0.010f, 0.050f, SubPlate.z), 0.45f);
		PlateCrackSeam = PrimarySeam * SecondarySeam;

		// Asymmetric edge lift: each plate curls upward along one persistent tilt direction near its border
		// rather than lifting its entire perimeter into a crater rim.
		float TiltAngle = frac(Plate.w * 7.13f + 0.17f) * 6.2831853f;
		float2 TiltDir = float2(cos(TiltAngle), sin(TiltAngle));
		float AsymmetricProj = saturate(dot(-PlateDelta, TiltDir) * 1.85f + 0.15f);
		float BorderBand = (1.0f - smoothstep(0.03f, 0.22f, Plate.z)) * PrimarySeam;
		PlateEdgeLift = BorderBand * AsymmetricProj * (0.35f + 0.65f * saturate(Flaking) + 0.35f * saturate(Var));

		// Multi-tier stepped plate thickness + internal strata terraces.
		float StrataStep = 0.38f + 0.34f * PlateTier
			+ 0.28f * smoothstep(0.32f, 0.42f, SubPlate.w)
			+ 0.18f * smoothstep(0.68f, 0.78f, Pits);
		Deposit = (StrataStep + PlateEdgeLift * 0.42f) * PlateCrackSeam
			* (0.80f + 0.45f * Var * Basin);

		// Plate-coherent retention: whole scale plates and fractured edge chips delaminate together.
		float PlateRetention = 0.62f * Plate.w + 0.23f * SubPlate.w
			+ 0.15f * (0.5f + RustSingleNoise(Q, BasePeriod * 1.5f, 227u, DetailFootprint));
		RetentionField = saturate(PlateRetention * smoothstep(0.004f, 0.035f, Plate.z));
	}

	float Survives = Flaking <= 0.0f ? 1.0f
		: (Flaking >= 1.0f ? 0.0f : smoothstep(Flaking - AA, Flaking + AA, RetentionField));

	// Surviving deposit relief above the recessed metal bed.
	float Retained = Attack * Survives * Buildup * saturate(Deposit);

	// Visible oxide coverage:
	// - Surviving rust covers the surface (with deep layered fracture cracks partially exposing dark inner oxide).
	// - When Flaking < 1 and PitDepth > 0, spalled/shed beds inside deep pits retain a thin dark corroded
	//   residue unless Flaking reaches 1.0 (which enforces 100% oxide removal per contract).
	float SpalledPitResidue = saturate(1.0f - Flaking) * (1.0f - Survives)
		* smoothstep(0.25f, 0.75f, PitLocalization) * saturate(PitDepth * 18.0f) * 0.42f;
	float SeamOxide = Structure == 2u ? lerp(0.42f, 1.0f, PlateCrackSeam) : 1.0f;
	float Oxide = saturate(Attack * (Survives * SeamOxide + SpalledPitResidue));

	// 5. Mineral-inspired pigment (0..1 into ColorRamp; strictly unlit & Coverage-independent):
	// - 0.00..0.30: Dark pit cores, spalled beds, and fracture seams.
	// - 0.30..0.70: Red-brown / dark chestnut across consolidated crust & scale plates.
	// - 0.70..1.00: Bright orange-ochre bloom on granular nodules, lifted rims, and porous pockets.
	float ColonyRimZone = saturate(1.0f - abs(ColonyCore - 0.38f) * 2.8f) * Survives;
	float PitCoreDarkening = PitLocalization * (0.65f - 0.35f * Survives + 0.30f * saturate(PitDepth * 12.0f));
	float SeamDarkening = Structure == 2u ? (1.0f - PlateCrackSeam) * 0.55f : 0.0f;
	float BloomCrest = Structure == 1u
		? (NoduleCrest * 0.48f + ColonyRimZone * 0.26f)
		: (Structure == 2u
			? ((1.0f - PlateTier) * 0.22f + PlateEdgeLift * 0.32f + ColonyRimZone * 0.22f)
			: (ColonyRimZone * 0.30f + (1.0f - ColonyCore) * 0.20f));

	float MineralGrain = (Fine * 0.32f + Micro * 0.22f + (FreckleCell.w - 0.5f) * 0.18f) * (0.25f + 0.75f * saturate(Var));
	float BasePigment = 0.48f
		+ Var * (Broad * 0.34f + Meso * 0.26f)
		+ BloomCrest * (0.35f + 0.45f * saturate(Var))
		- PitCoreDarkening * (0.42f + 0.25f * saturate(Var))
		- SeamDarkening
		+ MineralGrain;
	float Pigment = saturate(BasePigment);

	// Microstructure roughness modulation around the artist's Roughness value.
	float RoughnessMod = (GranularAggregate - 0.5f) * 0.22f
		+ NoduleCrest * 0.12f
		+ PitLocalization * 0.10f
		- (Structure == 2u ? PlateCrackSeam * 0.08f : 0.0f);

	return float4(Retained - Loss, Oxide, Pigment, RoughnessMod);
}

[numthreads(8,8,1)]
void MainCS(uint3 Id : SV_DispatchThreadID)
{
	int2 P = int2(Id.xy);
	if (any(P >= OutputSize)) return;
	float2 Texel = 1.0f / float2(OutputSize);
	float2 UV = (float2(P)+.5f) * Texel;
	float2 Q = RustUV(UV);
	float2 DX = RustUV(UV+float2(Texel.x,0))-Q;
	float2 DY = RustUV(UV+float2(0,Texel.y))-Q;
	float Footprint = max(length(DX+DY),length(DX-DY)) * float(ClusterPeriod);
	// Immutable multi-scale substrate sampling. A geometric cue only; strictly height-offset invariant.
	float Bias = SampleSubstrateBias(UV, Texel, ClusterPeriod);
	float Height = 0, Cover = 0, Rough = 0;
	float3 Color = 0;
	const float2 Samples[4] = {float2(-.25f,-.25f),float2(.25f,-.25f),float2(-.25f,.25f),float2(.25f,.25f)};
	[unroll] for (int I=0; I<4; ++I)
	{
		float4 F = RustFields(Q+DX*Samples[I].x+DY*Samples[I].y, DX, DY, Bias, Footprint);
		Height += F.x * .25f;
		Cover += F.y * .25f;
		Color += MixtormatEvalColorRamp(F.z, ColorCount, ColorInterpolation, ColorPositions, ColorColors).rgb * F.y * .25f;
		Rough += saturate(Roughness + Variation * F.w) * F.y * .25f;
	}
	// Unpremultiply only material fields. The signed relief is NEVER divided by coverage.
	OutHeight[P] = Height * HeightScale;
	OutCoverage[P] = Cover;
	OutColor[P] = float4(Cover > 0 ? Color / Cover : 0, 1);
	OutRAM[P] = float4(Cover > 0 ? Rough / Cover : Roughness, 1, 0, .04f);
	OutOptics[P] = float4(.04f,0,0,0);
}
