#ifndef MIXTORMAT_MOSS_LEAVES_USH
#define MIXTORMAT_MOSS_LEAVES_USH

// Shared by height and material. Heights are selected before pixel coverage is averaged.
// The basal cushion is the support surface; all leaves conform to it with positive relief.
// This is a top-envelope bake with full 3D blade arch, keel, and rosette normal slopes.
struct FMossLeafSurface
{
	float Height;
	float Coverage;
	float Tip;
	float Variation;
	float Damaged;
	float2 ResidualSlope;
};

FMossLeafSurface MossLeafPoint(float2 Q, int Period, float3 Flow)
{
	FMossLeafSurface R = (FMossLeafSurface)0;
	uint BestId = 0xffffffffu;
	int2 Base = int2(floor(Q));
	uint Count = GrowthForm == 3u ? 9u : (GrowthForm == 2u ? 7u : 5u);
	[loop] for (int Y = -1; Y <= 1; ++Y) [loop] for (int X = -1; X <= 1; ++X)
	{
		int2 Cell = Base + int2(X, Y);
		int2 Wrapped = (Cell % Period + Period) % Period;
		float2 Cluster = Random22(Wrapped, 606u);
		float ClusterGrowth = TileNoise((float2(Wrapped) + 0.5f) / float(Period),
			max(1, int(round(float(Period) / 8.0f))), 613u);
		// Nearby shoots share a patch-scale growth cue but retain their own posture.
		// Root jitter plus maximum leaf reach stays inside the existing 3x3 search.
		[unroll] for (uint Shoot = 0u; Shoot < 2u; ++Shoot)
		{
			float2 Tuft = Random22(Wrapped, 619u + Shoot * 137u);
			float2 Root = float2(Cell) + 0.5f + (Cluster - 0.5f) * 0.4f + (Tuft - 0.5f) * 0.25f;
			if (length(Q - Root) > 1.0f) continue;
			float TuftScale = lerp(0.65f, 1.05f, saturate(ClusterGrowth * 0.65f + Tuft.y * 0.35f));
			float Angle = MossTuftAngle(Flow, frac(Cluster.x + (Tuft.x - 0.5f) * 0.5f));
			float2 Stem = float2(cos(Angle), sin(Angle));

			// Wide feather so damaged tufts grade into living neighbours
			// through the 4-sample leaf average instead of switching on/off.
			float Damaged = smoothstep(0.94f - saturate(Damage), 1.06f - saturate(Damage), Tuft.y);
			[loop] for (uint Leaf = 0u; Leaf < Count; ++Leaf)
			{
				float2 Vary = Random22(Wrapped, 707u + Leaf * 131u + Shoot * 1543u);
				float Slot = float(Leaf) / max(float(Count - 1u), 1.0f);
				float Fan = Slot * 2.0f - 1.0f;
				float2 Attach = Root;
				float LeafAngle = Angle;
				float Length = lerp(0.38f, 0.64f, Vary.y) * TuftScale;
				if (GrowthForm == 0u)
				{
					LeafAngle += float(Leaf) * 2.39996323f;
					Length *= 0.75f;
				}
				else if (GrowthForm == 1u) LeafAngle += Fan * lerp(0.35f, 1.1f, Hydration);
				else
				{
					float Row = floor(float(Leaf) * 0.5f) / max(floor(float(Count) * 0.5f), 1.0f);
					float Sign = (Leaf & 1u) == 0u ? -1.0f : 1.0f;
					Attach += Stem * (Row - 0.5f) * 0.4f * TuftScale;
					LeafAngle += Sign * (GrowthForm == 3u ? 1.05f : 0.7f);
					Length *= GrowthForm == 3u ? lerp(0.72f, 0.30f, Row) : 0.65f;
				}
				LeafAngle += (Vary.x - 0.5f) * MOSS_SHOOT_FLOW_JITTER;
				float2 Axis = float2(cos(LeafAngle), sin(LeafAngle));
				float2 Across = float2(-Axis.y, Axis.x);
				float2 D = Q - Attach;
				float U = dot(D, Axis) / Length;
				if (U <= 0.0f || U >= 1.0f) continue;
				float Curl = (1.0f - Hydration) * (0.35f + 0.3f * Vary.x);
				float Bend = (Vary.x - 0.5f) * 0.35f + Curl;
				float V = dot(D, Across) - Bend * Length * U * U;
				float Width = Length * lerp(0.14f, 0.40f, saturate(FiberThickness))
					* sin(3.141592654f * U) * lerp(0.45f, 1.0f, Hydration);
				if (abs(V) >= Width) continue;
				float AcrossU = V / max(Width, 1.0e-6f);
				float Arch = sin(3.141592654f * U);
				float Keel = exp(-14.0f * AcrossU * AcrossU);
				float Attachment = Arch * saturate(1.0f - AcrossU * AcrossU);
				float H = (0.18f + 0.52f * Arch + 0.16f * Keel + Curl * U * U) * Attachment
					* TuftScale * lerp(0.65f, 1.0f, Vary.y) * lerp(1.0f, 0.3f, Damaged);
				if (GrowthForm == 2u || GrowthForm == 3u) H *= 0.68f;
				uint Id = Hash21(Wrapped, 1777u + Leaf * 131u + Shoot * 1543u);
				if (H < R.Height || (H == R.Height && Id >= BestId)) continue;
				BestId = Id;
				R.Height = H;
				R.Coverage = 1.0f;
				R.Tip = smoothstep(0.38f, 0.94f, U);
				R.Variation = (Tuft.y - 0.5f) * 0.65f + (Vary.y - 0.5f) * 0.35f;
				R.Damaged = Damaged;

				// Full 3D leaf blade normal slope: longitudinal arch & curl + transverse cup, midrib keel & lamina striation.
				float AlongSlope = (cos(3.141592654f * U) * 0.85f - 0.45f * U + Curl * 0.6f * (1.0f - 2.0f * U)) * (1.0f - AcrossU * AcrossU);
				float CupSlope = -AcrossU * (0.95f + 0.55f * Keel) * Arch;
				float Striation = sin(18.84955592f * AcrossU + Vary.x * 6.283185307f) * 0.18f * Arch * (1.0f - AcrossU * AcrossU);
				float2 RootRadial = D / max(length(D), 0.12f);
				float3 BladeGrad = float3(0, 0, 0);
				float2 SlopeVec = Axis * AlongSlope + Across * (CupSlope + Striation) + RootRadial * (0.28f * (1.0f - U));
				R.ResidualSlope = SlopeVec * TuftScale * lerp(1.0f, 0.45f, Damaged);
			}
		}
	}
	return R;
}

FMossLeafSurface MossLeafSurface(float2 DestinationUV)
{
	float2 Texel = 1.0f / float2(OutputSize);
	float2 UV = MixtormatGeneratorUV(DestinationUV);
	int Period = MossShootPeriod();
	float2 DX = TorusDelta(UV, MixtormatGeneratorUV(DestinationUV + float2(Texel.x, 0))) * float(Period);
	float2 DY = TorusDelta(UV, MixtormatGeneratorUV(DestinationUV + float2(0, Texel.y))) * float(Period);
	float2 JX = DX / (Texel.x * float(Period)), JY = DY / (Texel.y * float(Period));
	float3 Flow = MossShootFlow(DestinationUV, JX, JY);
	FMossLeafSurface R = (FMossLeafSurface)0;
	float Footprint = max(length(DX + DY), length(DX - DY));
	float Resolved = 1.0f - smoothstep(MOSS_SHOOT_AA_RANGE.x, MOSS_SHOOT_AA_RANGE.y, Footprint);
	if (Resolved <= 0.0f) return R;
	const float2 Samples[4] = {float2(-0.25f,-0.25f), float2(0.25f,-0.25f), float2(-0.25f,0.25f), float2(0.25f,0.25f)};
	[unroll] for (int I = 0; I < 4; ++I)
	{
		FMossLeafSurface S = MossLeafPoint(UV * float(Period) + DX * Samples[I].x + DY * Samples[I].y, Period, Flow);
		R.Height += S.Height * 0.25f;
		R.Coverage += S.Coverage * 0.25f;
		R.Tip += S.Tip * 0.25f;
		R.Variation += S.Variation * 0.25f;
		R.Damaged += S.Damaged * 0.25f;
		R.ResidualSlope += S.ResidualSlope * 0.25f;
	}
	R.Height *= Resolved;
	R.Tip *= Resolved;
	R.Variation *= Resolved;
	R.Damaged *= Resolved;
	R.ResidualSlope = float2(dot(R.ResidualSlope, JX), dot(R.ResidualSlope, JY)) * Resolved;
	return R;
}
#endif
