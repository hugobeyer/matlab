#include "/Engine/Public/Platform.ush"

int2 OutputSize;
// @param Amount
float Amount;
uint HasPrevious;
uint HasMask;
Texture2D<float> SourceHeight;
Texture2D<float> PreviousShift;
Texture2D<float> ScopedMask;
RWTexture2D<float> OutShift;

// Signed height becomes a bedding-coordinate shift, never an addition to finished relief.
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 P = int2(DispatchThreadId.xy);
	if (any(P >= OutputSize)) { return; }
	const float Previous = HasPrevious != 0u ? PreviousShift.Load(int3(P, 0)) : 0.0f;
	const float Gate = HasMask != 0u ? ScopedMask.Load(int3(P, 0)) : 1.0f;
	OutShift[P] = Previous + Amount * Gate * SourceHeight.Load(int3(P, 0));
}
