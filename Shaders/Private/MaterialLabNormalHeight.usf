#include "/Engine/Public/Platform.ush"

Texture2D<float4> InputNormal;
Texture2D<float4> InputComplex;
RWTexture2D<float4> OutputComplex;
RWTexture2D<float> OutputHeight;

int2 OutputSize;
uint Log2Size;
uint Axis;
uint StageSize;
uint Inverse;
float NormalYSign;
float MinNormalZ;
float MaxGradient;

static const float MaterialLabTwoPi = 6.28318530717958647692f;

float2 ComplexMultiply(float2 A, float2 B)
{
	return float2(
		A.x * B.x - A.y * B.y,
		A.x * B.y + A.y * B.x);
}

[numthreads(8, 8, 1)]
void DecodeGradientCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	uint2 Pixel = DispatchThreadId.xy;
	float3 Normal = InputNormal.Load(int3(Pixel, 0)).rgb * 2.0f - 1.0f;
	Normal.y *= NormalYSign;
	float2 Gradient = abs(Normal.z) > MinNormalZ
		? -Normal.xy / Normal.z
		: float2(0.0f, 0.0f);
	Gradient = clamp(Gradient, -MaxGradient, MaxGradient);
	OutputComplex[Pixel] = float4(Gradient.x, 0.0f, Gradient.y, 0.0f);
}

[numthreads(8, 8, 1)]
void BitReverseCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	uint2 Pixel = DispatchThreadId.xy;
	uint2 SourcePixel = uint2(
		reversebits(Pixel.x) >> (32u - Log2Size),
		reversebits(Pixel.y) >> (32u - Log2Size));
	OutputComplex[Pixel] = InputComplex.Load(int3(SourcePixel, 0));
}

[numthreads(8, 8, 1)]
void FFTCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	uint2 Pixel = DispatchThreadId.xy;
	uint I = Axis == 0u ? Pixel.x : Pixel.y;
	uint HalfSize = StageSize >> 1u;
	uint J = I & (HalfSize - 1u);
	uint Base = I & ~(StageSize - 1u);
	uint Index0 = Base + J;
	uint Index1 = Index0 + HalfSize;

	uint2 Coordinate0 = Pixel;
	uint2 Coordinate1 = Pixel;
	if (Axis == 0u)
	{
		Coordinate0.x = Index0;
		Coordinate1.x = Index1;
	}
	else
	{
		Coordinate0.y = Index0;
		Coordinate1.y = Index1;
	}

	float4 A = InputComplex.Load(int3(Coordinate0, 0));
	float4 B = InputComplex.Load(int3(Coordinate1, 0));
	float Direction = Inverse != 0u ? 1.0f : -1.0f;
	float Angle = Direction * MaterialLabTwoPi * float(J) / float(StageSize);
	float2 Twiddle = float2(cos(Angle), sin(Angle));
	float4 T = float4(
		ComplexMultiply(Twiddle, B.xy),
		ComplexMultiply(Twiddle, B.zw));
	float4 Result = (I & HalfSize) == 0u ? A + T : A - T;
	if (Inverse != 0u)
	{
		Result *= 0.5f;
	}
	OutputComplex[Pixel] = Result;
}

[numthreads(8, 8, 1)]
void PoissonCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	uint2 Pixel = DispatchThreadId.xy;
	int SignedX = Pixel.x < uint(OutputSize.x / 2) ? int(Pixel.x) : int(Pixel.x) - OutputSize.x;
	int SignedY = Pixel.y < uint(OutputSize.y / 2) ? int(Pixel.y) : int(Pixel.y) - OutputSize.y;
	float2 Frequency = float2(
		float(SignedX) / float(OutputSize.x),
		float(SignedY) / float(OutputSize.y));

	float4 GradientSpectrum = InputComplex.Load(int3(Pixel, 0));
	float2 InnerProduct =
		Frequency.x * GradientSpectrum.xy
		+ Frequency.y * GradientSpectrum.zw;
	float Denominator = MaterialLabTwoPi * dot(Frequency, Frequency);
	float2 HeightSpectrum = Denominator > 1.0e-12f
		? float2(InnerProduct.y, -InnerProduct.x) / Denominator
		: float2(0.0f, 0.0f);
	OutputComplex[Pixel] = float4(HeightSpectrum, 0.0f, 0.0f);
}

[numthreads(8, 8, 1)]
void ExtractHeightCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	uint2 Pixel = DispatchThreadId.xy;
	OutputHeight[Pixel] = InputComplex.Load(int3(Pixel, 0)).x;
}
