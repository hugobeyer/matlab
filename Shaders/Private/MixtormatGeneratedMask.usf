#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatCurvature.ush"
#include "/Plugin/Mixtormat/Private/MixtormatMaskShaping.ush"

Texture2D<float> PreviousMask;
Texture2D<float4> SurfaceNormal;
Texture2D<float4> SurfaceRAM;
Texture2D<float> SurfaceHeight;
Texture2D<float> SurfaceRidge;
SamplerState LinearWrapSampler;
RWTexture2D<float> OutputMask;

int2 OutputSize;
uint Initialize;
uint SurfaceValid;
uint FlipNormalY;

float CurvatureWeight;
float CurvatureBias;
float CurvatureStrength;
float CurvaturePower;
int CurvatureRadius;
int CurvatureSmoothing;
float DirectionWeight;
float3 Direction;
float DirectionBroadness;
float AOWeight;
float HeightWeight;
float HeightBias;
float RidgeWeight;
float MixScale;

uint BlendMode;
float Weight;

// Sign chooses polarity; magnitude chooses influence. Negative height selects valleys,
// negative AO selects exposed areas, and negative direction selects away-facing slopes.
float SignalContribution(float Signal, float Influence)
{
	return abs(Influence) * (Influence < 0.0f ? 1.0f - Signal : Signal);
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const float2 UV = (float2(DispatchThreadId.xy) + 0.5f) / float2(OutputSize);
	const float Previous = Initialize != 0
		? 0.0f
		: PreviousMask.SampleLevel(LinearWrapSampler, UV, 0.0f);

	// No surface exists beneath the bottom layer. Do not let normalization, inversion,
	// or an inverted signal manufacture coverage there. Keep first-pass initialization.
	if (SurfaceValid == 0 || Weight == 0.0f)
	{
		OutputMask[DispatchThreadId.xy] = saturate(Previous);
		return;
	}

	float Raw = 0.0f;

	[branch] if (CurvatureWeight != 0.0f)
	{
		float Curvature;
		float Cavity;
		float Convex;
		MixtormatEvaluateCurvature(
			SurfaceNormal, LinearWrapSampler, UV, OutputSize,
			CurvatureRadius, CurvatureSmoothing, CurvatureStrength, CurvaturePower,
			FlipNormalY, Curvature, Cavity, Convex);
		Raw += SignalContribution(lerp(Cavity, Convex, CurvatureBias), CurvatureWeight);
	}

	[branch] if (DirectionWeight != 0.0f)
	{
		const float3 Normal = MixtormatSampleNormal(SurfaceNormal, LinearWrapSampler, UV, FlipNormalY);
		const float Facing = pow(saturate(dot(Normal, Direction)), DirectionBroadness);
		Raw += SignalContribution(Facing, DirectionWeight);
	}

	[branch] if (AOWeight != 0.0f)
	{
		const float Occlusion = saturate(1.0f - SurfaceRAM.SampleLevel(LinearWrapSampler, UV, 0.0f).g);
		Raw += SignalContribution(Occlusion, AOWeight);
	}

	[branch] if (HeightWeight != 0.0f)
	{
		// The CPU schedules the shared measured-range normalization only for active height.
		const float Height = saturate(SurfaceHeight.SampleLevel(LinearWrapSampler, UV, 0.0f) + HeightBias);
		Raw += SignalContribution(Height, HeightWeight);
	}

	[branch] if (RidgeWeight != 0.0f)
	{
		const float Ridge = saturate(SurfaceRidge.SampleLevel(LinearWrapSampler, UV, 0.0f));
		Raw += SignalContribution(Ridge, RidgeWeight);
	}

	// Bounded mixing is separate from measured input normalization and artist shaping.
	// The latter remain entirely owned by the universal mask path, including raw output.
	const float Incoming = MixtormatShapeMaskInput(Raw * MixScale);
	OutputMask[DispatchThreadId.xy] = MixtormatBlendShapedMask(Previous, Incoming, BlendMode, Weight);
}
