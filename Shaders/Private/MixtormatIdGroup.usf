#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"
#include "/Plugin/Mixtormat/Private/MixtormatDebugColor.ush"

int2 OutputSize;
uint Mode;
uint WriteDebug;

Texture2D<uint> SourceAIds;
Texture2D<uint> SourceBIds;
RWTexture2D<uint> OutputIds;
RWTexture2D<float4> OutputDebug;

uint DifferenceId(uint A, uint B)
{
	if (A == MIXTORMAT_INVALID_REGION)
	{
		return B;
	}
	if (B == MIXTORMAT_INVALID_REGION || A == B)
	{
		return A;
	}

	// Difference is symmetric: swapping the two children preserves the combined identity.
	const uint Low = min(A, B);
	const uint High = max(A, B);
	uint Result = MixtormatRegionHash(MixtormatRegionHash(Low ^ 0x9e3779b9u)
		^ MixtormatRegionHash(High ^ 0x85ebca6bu));
	return Result == MIXTORMAT_INVALID_REGION ? 0xfffffffeu : Result;
}

uint MaxId(uint A, uint B)
{
	if (A == MIXTORMAT_INVALID_REGION)
	{
		return B;
	}
	if (B == MIXTORMAT_INVALID_REGION)
	{
		return A;
	}
	return max(A, B);
}

[numthreads(8, 8, 1)]
void ResolveCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 P = int2(DispatchThreadId.xy);
	const uint A = SourceAIds.Load(int3(P, 0));
	const uint B = SourceBIds.Load(int3(P, 0));
	const uint GroupId = Mode == 0u ? DifferenceId(A, B) : MaxId(A, B);
	OutputIds[P] = GroupId;

	if (WriteDebug != 0u)
	{
		OutputDebug[P] = GroupId == MIXTORMAT_INVALID_REGION
			? 0.0f : float4(MixtormatRegionDebugColor(GroupId), 1.0f);
	}
}
