#ifndef MIXTORMAT_DEBUG_COLOR_USH
#define MIXTORMAT_DEBUG_COLOR_USH

#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"

// The one debug palette, and the one place it is converted.
//
// Four copies of these two constants had drifted into the composite, the stain resolve, the
// cluster preview and two C++ clears. They were the same numbers, but nothing held them together,
// and a debug view whose colours disagree with the next one is worse than no debug view.
//
// The constants are authored in **sRGB** -- they are the colours meant to appear on screen -- and
// the preview surface is unlit emissive into a tonemapped, post-processed viewport. Writing them
// raw put linear 0.25 through an sRGB encode and produced roughly 0.54 on screen, which is why
// every preview read as fluorescent rather than as the dark plum and dark green intended.
//
// Converting here makes the displayed colour the authored one: while a debug view is up the
// preview viewport neutralises the tone curve, exposure, vignette and grading and leaves only the
// linear-to-sRGB encode (SMixtormatPreviewViewport's unlit presentation), so this conversion is
// the exact inverse of what reaches the pixel. Anything written into the debug target without it
// displays brighter than intended.

float MixtormatSrgbToLinearChannel(float C)
{
	return C <= 0.04045f ? C / 12.92f : pow((C + 0.055f) / 1.055f, 2.4f);
}

float3 MixtormatSrgbToLinear(float3 C)
{
	return float3(
		MixtormatSrgbToLinearChannel(C.r),
		MixtormatSrgbToLinearChannel(C.g),
		MixtormatSrgbToLinearChannel(C.b));
}

// Dark plum at 0, dark green at 1. Deliberately dark and deliberately low-contrast in luminance:
// a debug view is read for *where* a signal is, and a full black-to-white ramp makes the bright
// end bloom into the dark end at a glance.
#define MIXTORMAT_DEBUG_LOW  float3(0.08f, 0.02f, 0.12f)
#define MIXTORMAT_DEBUG_HIGH float3(0.04f, 0.25f, 0.08f)

// A 0..1 signal as the palette colour, ready to write into the debug target.
float3 MixtormatDebugRamp(float Value)
{
	return MixtormatSrgbToLinear(
		lerp(MIXTORMAT_DEBUG_LOW, MIXTORMAT_DEBUG_HIGH, saturate(Value)));
}

// An arbitrary colour -- a hashed region id, say -- brought into the same space as the ramp above,
// so the data previews and the coverage previews read at one brightness.
float3 MixtormatDebugColor(float3 SrgbColor)
{
	return MixtormatSrgbToLinear(saturate(SrgbColor));
}

float3 MixtormatRegionDebugColor(uint Root)
{
	// Scrambled twice before use, so consecutive ids (compacted bands, neighbouring cells) land
	// on unrelated colours instead of reading as a sequence. A random hue at high saturation
	// and value keeps neighbours distinguishable; plain random RGB drifts to muddy greys.
	const uint Scrambled = MixtormatRegionHash(MixtormatRegionHash(Root ^ 0x9E3779B9u) + 0x632BE5ABu);
	const float Hue = MixtormatRegionRandom(Scrambled);
	const float Saturation = lerp(0.55f, 0.95f, MixtormatRegionRandom(Scrambled ^ 0x85EBCA6Bu));
	const float Value = lerp(0.55f, 1.0f, MixtormatRegionRandom(Scrambled ^ 0xC2B2AE35u));
	const float3 Rgb = saturate(abs(frac(Hue + float3(0.0f, 2.0f / 3.0f, 1.0f / 3.0f)) * 6.0f - 3.0f) - 1.0f);
	return MixtormatDebugColor(Value * lerp(float3(1.0f, 1.0f, 1.0f), Rgb, Saturation));
}

#endif
