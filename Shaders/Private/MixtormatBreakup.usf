#include "/Engine/Public/Platform.ush"

#define BREAKUP_TAU 6.28318530717958647692f
#define BREAKUP_REFERENCE_RES 1024.0f

Texture2D<uint> RegionIds;
Texture2D<float> SourceHeight;
Texture2D<float> CurrentHeight;
Texture2D<float2> BreakupField;
Texture2D<uint> BreakupRegionIds;
Texture2D<float> BreakupCoverage;
Texture2D<float> LayerMask;
Texture2D<float> PlacementMaskTexture;
Texture2D<float4> PreviousNormal;
Texture2D<float4> PreviousRAM;

SamplerState LinearWrapSampler;

RWTexture2D<float2> OutputField;
RWTexture2D<uint> OutputRegionIds;
RWTexture2D<float> OutputHeight;
RWTexture2D<float> OutputCoverage;
RWTexture2D<float4> OutputNormal;
RWTexture2D<float4> OutputRAM;

int2 OutputSize;

uint Seed;

int MacroCells;
int MidCells;
int DetailCells;

float Density;
float SizeMin;
float SizeMax;
float Stretch;
float Angularity;
float Jitter;

int OperationMid;
int OperationDetail;
float BlendSmooth;

float DistortAmount;
int DistortFrequency;
float Inset;

uint InvertField;
uint HasRegionIds;

float Relief;
float ThicknessVariation;

float GapWidth;
float GapDepth;
float GapVariation;

float FoldHeight;
float FoldWidth;
float CreaseWidth;
float CreaseDepth;

float PushAmount;
float PushWidth;
float PushRelief;

float Variation;
float Strength;

float NormalStrength;
float NormalSharpness;
float AOAmount;
float AORadius;
float RoughnessAmount;

uint UsePlacementMask;
float PlacementMaskTiling;
uint InvertMask;

uint BreakupHashU(uint x)
{
	x ^= x >> 16;
	x *= 0x7feb352du;
	x ^= x >> 15;
	x *= 0x846ca68bu;
	x ^= x >> 16;
	return x;
}

uint BreakupHashCoord(int x, int y, uint s)
{
	return BreakupHashU(
		(uint)x * 73856093u ^
		(uint)y * 19349663u ^
		s * 83492791u);
}

float BreakupHash01(uint x)
{
	return (float)(BreakupHashU(x) & 0x00ffffffu) * (1.0f / 16777216.0f);
}

int BreakupWrapI(int x, int n)
{
	const int safeN = max(n, 1);
	const int r = x % safeN;
	return r < 0 ? r + safeN : r;
}

int2 BreakupWrapPixel(int2 p)
{
	return int2(
		BreakupWrapI(p.x, OutputSize.x),
		BreakupWrapI(p.y, OutputSize.y));
}

float BreakupSmooth(float a, float b, float x)
{
	const float t = saturate((x - a) / max(b - a, 1.0e-6f));
	return t * t * (3.0f - 2.0f * t);
}

float BreakupFade(float x)
{
	return x * x * x * (x * (x * 6.0f - 15.0f) + 10.0f);
}

float BreakupSMin(float a, float b, float k)
{
	if (k <= 1.0e-6f)
	{
		return min(a, b);
	}
	const float h = saturate(0.5f + 0.5f * (b - a) / k);
	return lerp(b, a, h) - k * h * (1.0f - h);
}

float BreakupSMax(float a, float b, float k)
{
	return -BreakupSMin(-a, -b, k);
}

float2 BreakupRotate(float2 p, float a)
{
	const float c = cos(a);
	const float s = sin(a);
	return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}

float2 BreakupGradient(uint h)
{
	float2 g = float2(
		BreakupHash01(h ^ 0x68bc21ebu) * 2.0f - 1.0f,
		BreakupHash01(h ^ 0x02e5be93u) * 2.0f - 1.0f);
	const float l2 = dot(g, g);
	return l2 > 1.0e-6f ? g * rsqrt(l2) : float2(1.0f, 0.0f);
}

float BreakupPeriodicGradientNoise(float2 uv, int period, uint seed)
{
	period = max(period, 1);

	const float2 p = uv * (float)period;
	const int2 i = int2(floor(p));
	const float2 f = frac(p);

	const int2 i00 = int2(BreakupWrapI(i.x, period), BreakupWrapI(i.y, period));
	const int2 i10 = int2(BreakupWrapI(i.x + 1, period), BreakupWrapI(i.y, period));
	const int2 i01 = int2(BreakupWrapI(i.x, period), BreakupWrapI(i.y + 1, period));
	const int2 i11 = int2(BreakupWrapI(i.x + 1, period), BreakupWrapI(i.y + 1, period));

	const float n00 = dot(BreakupGradient(BreakupHashCoord(i00.x, i00.y, seed)), f);
	const float n10 = dot(BreakupGradient(BreakupHashCoord(i10.x, i10.y, seed)), f - float2(1.0f, 0.0f));
	const float n01 = dot(BreakupGradient(BreakupHashCoord(i01.x, i01.y, seed)), f - float2(0.0f, 1.0f));
	const float n11 = dot(BreakupGradient(BreakupHashCoord(i11.x, i11.y, seed)), f - float2(1.0f, 1.0f));

	const float2 u = float2(BreakupFade(f.x), BreakupFade(f.y));
	return lerp(lerp(n00, n10, u.x), lerp(n01, n11, u.x), u.y) * 1.41421356237f;
}

float2 BreakupPeriodicVectorNoise(float2 uv, int period, uint seed)
{
	return float2(
		BreakupPeriodicGradientNoise(uv, period, seed + 17u),
		BreakupPeriodicGradientNoise(uv, period, seed + 193u));
}

// Seamless multi-scale gradient-noise domain warp. Every octave is an integer period on the
// torus, so the result closes exactly at the UV boundary. The second and third octaves are warped
// by the previous one, which breaks the obvious directional waves the old sine field produced.
float2 BreakupDistort(float2 uv, int frequency, float amount, uint seed)
{
	if (abs(amount) <= 1.0e-6f)
	{
		return frac(uv);
	}

	const int p0 = max(frequency, 1);
	const int p1 = p0 * 2;
	const int p2 = p0 * 4;

	const float2 n0 = BreakupPeriodicVectorNoise(uv, p0, seed + 101u);
	const float2 uv1 = frac(uv + n0 * (0.20f / (float)p0));
	const float2 n1 = BreakupPeriodicVectorNoise(uv1, p1, seed + 503u);

	const float2 turn = float2(-n0.y, n0.x);
	const float2 uv2 = frac(uv + turn * (0.11f / (float)p0) + n1 * (0.08f / (float)p1));
	const float2 n2 = BreakupPeriodicVectorNoise(uv2, p2, seed + 911u);

	const float2 warp = n0 * 0.56f + n1 * 0.30f + n2 * 0.14f;
	const float2 curl = float2(-warp.y, warp.x);
	const float2 direction = warp * 0.82f + curl * 0.18f;

	return frac(uv + direction * (amount / BREAKUP_REFERENCE_RES));
}

float BreakupShape(float2 q, float sx, float sy, float angularity, float shear)
{
	q.x += q.y * shear;

	const float ax = abs(q.x) / max(sx, 1.0e-6f);
	const float ay = abs(q.y) / max(sy, 1.0e-6f);

	const float boxField = max(ax, ay);
	const float diamond = ax + ay;
	const float metric = lerp(boxField, diamond, saturate(angularity));

	return (metric - 1.0f) * min(sx, sy);
}

struct FBreakupSample
{
	float Distance;
	uint Id;
};

FBreakupSample BreakupFamily(
	float2 uv,
	int cells,
	uint seed,
	float density,
	float sizeMin,
	float sizeMax,
	float stretchAmount,
	float angularity,
	float jitter)
{
	FBreakupSample result;
	result.Distance = 1000.0f;
	result.Id = 0u;

	cells = max(cells, 1);

	const float2 p = uv * (float)cells;
	const int bx = (int)floor(p.x);
	const int by = (int)floor(p.y);

	[unroll]
	for (int oy = -1; oy <= 1; ++oy)
	{
		[unroll]
		for (int ox = -1; ox <= 1; ++ox)
		{
			const int gx = bx + ox;
			const int gy = by + oy;
			const int hx = BreakupWrapI(gx, cells);
			const int hy = BreakupWrapI(gy, cells);

			const uint id = BreakupHashCoord(hx, hy, seed);
			if (BreakupHash01(id ^ 0x9e3779b9u) > density)
			{
				continue;
			}

			const float rx = BreakupHash01(id ^ 0x243f6a88u);
			const float ry = BreakupHash01(id ^ 0x85a308d3u);
			const float rs = BreakupHash01(id ^ 0x13198a2eu);
			const float ra = BreakupHash01(id ^ 0x03707344u);
			const float rt = BreakupHash01(id ^ 0xa4093822u);
			const float rg = BreakupHash01(id ^ 0x299f31d0u);
			const float rang = BreakupHash01(id ^ 0x082efa98u);
			const float rsh = BreakupHash01(id ^ 0xec4e6c89u);

			const float2 center = float2(
				(float)gx + 0.5f + (rx - 0.5f) * jitter,
				(float)gy + 0.5f + (ry - 0.5f) * jitter) / (float)cells;

			float2 q = BreakupRotate(uv - center, ra * BREAKUP_TAU);

			const float radius = lerp(sizeMin, sizeMax, rs) / (float)cells;
			float stretch = lerp(1.0f, max(stretchAmount, 1.0f), rt);
			if (rg > 0.5f)
			{
				stretch = 1.0f / stretch;
			}

			const float sx = radius * stretch;
			const float sy = radius / stretch;
			const float ang = saturate(angularity + (rang - 0.5f) * 0.30f);
			const float shear = (rsh - 0.5f) * 0.75f;

			const float d = BreakupShape(q, sx, sy, ang, shear);
			if (d < result.Distance)
			{
				result.Distance = d;
				result.Id = id;
			}
		}
	}

	return result;
}

FBreakupSample BreakupCombine(FBreakupSample a, FBreakupSample b, float k, int operation)
{
	FBreakupSample result;

	if (operation == 1)
	{
		const float db = -b.Distance;
		result.Distance = BreakupSMax(a.Distance, db, k);
		result.Id = a.Distance >= db ? a.Id : b.Id;
		return result;
	}

	if (operation == 2)
	{
		result.Distance = BreakupSMax(a.Distance, b.Distance, k);
		result.Id = a.Distance >= b.Distance ? a.Id : b.Id;
		return result;
	}

	result.Distance = BreakupSMin(a.Distance, b.Distance, k);
	result.Id = a.Distance <= b.Distance ? a.Id : b.Id;
	return result;
}

float BreakupSamplePlacement(float2 uv)
{
	float value;

	if (UsePlacementMask != 0u)
	{
		value = PlacementMaskTexture.SampleLevel(
			LinearWrapSampler,
			frac(uv * max(PlacementMaskTiling, 1.0f)),
			0.0f);
	}
	else
	{
		value = LayerMask.SampleLevel(LinearWrapSampler, uv, 0.0f);
	}

	if (InvertMask != 0u)
	{
		value = 1.0f - value;
	}

	return saturate(value);
}

float BreakupLoadSDF(int2 pixel)
{
	return BreakupField.Load(int3(BreakupWrapPixel(pixel), 0)).x;
}

uint BreakupLoadId(int2 pixel)
{
	return BreakupRegionIds.Load(int3(BreakupWrapPixel(pixel), 0));
}

float BreakupIdBoundary(int2 pixel, uint centerId, int radius)
{
	radius = max(radius, 1);

	const int2 o0 = int2(radius, 0);
	const int2 o1 = int2(0, radius);
	const int2 o2 = int2(radius, radius);
	const int2 o3 = int2(radius, -radius);

	float edge = 0.0f;
	edge = max(edge, BreakupLoadId(pixel + o0) != centerId ? 1.0f : 0.0f);
	edge = max(edge, BreakupLoadId(pixel - o0) != centerId ? 1.0f : 0.0f);
	edge = max(edge, BreakupLoadId(pixel + o1) != centerId ? 1.0f : 0.0f);
	edge = max(edge, BreakupLoadId(pixel - o1) != centerId ? 1.0f : 0.0f);
	edge = max(edge, BreakupLoadId(pixel + o2) != centerId ? 1.0f : 0.0f);
	edge = max(edge, BreakupLoadId(pixel - o2) != centerId ? 1.0f : 0.0f);
	edge = max(edge, BreakupLoadId(pixel + o3) != centerId ? 1.0f : 0.0f);
	edge = max(edge, BreakupLoadId(pixel - o3) != centerId ? 1.0f : 0.0f);
	return edge;
}

float BreakupResolutionScale()
{
	return max((float)max(OutputSize.x, OutputSize.y) / BREAKUP_REFERENCE_RES, 1.0e-4f);
}

float BreakupHeightDeltaAt(int2 p)
{
	p = BreakupWrapPixel(p);
	return SourceHeight.Load(int3(p, 0)) - CurrentHeight.Load(int3(p, 0));
}

float2 BreakupDeltaGradient(int2 p, int radius)
{
	radius = max(radius, 1);

	const float dmm = BreakupHeightDeltaAt(p + int2(-radius, -radius));
	const float d0m = BreakupHeightDeltaAt(p + int2(0, -radius));
	const float dpm = BreakupHeightDeltaAt(p + int2(radius, -radius));
	const float dm0 = BreakupHeightDeltaAt(p + int2(-radius, 0));
	const float dp0 = BreakupHeightDeltaAt(p + int2(radius, 0));
	const float dmp = BreakupHeightDeltaAt(p + int2(-radius, radius));
	const float d0p = BreakupHeightDeltaAt(p + int2(0, radius));
	const float dpp = BreakupHeightDeltaAt(p + int2(radius, radius));

	return float2(
		(dpm + 2.0f * dp0 + dpp) - (dmm + 2.0f * dm0 + dmp),
		(dmp + 2.0f * d0p + dpp) - (dmm + 2.0f * d0m + dpm))
		/ (8.0f * (float)radius);
}

float BreakupHeightOcclusion(int2 p, int radius)
{
	radius = max(radius, 1);

	const float h = CurrentHeight.Load(int3(BreakupWrapPixel(p), 0));
	float occ = 0.0f;

	occ += max(CurrentHeight.Load(int3(BreakupWrapPixel(p + int2(radius, 0)), 0)) - h, 0.0f);
	occ += max(CurrentHeight.Load(int3(BreakupWrapPixel(p - int2(radius, 0)), 0)) - h, 0.0f);
	occ += max(CurrentHeight.Load(int3(BreakupWrapPixel(p + int2(0, radius)), 0)) - h, 0.0f);
	occ += max(CurrentHeight.Load(int3(BreakupWrapPixel(p - int2(0, radius)), 0)) - h, 0.0f);
	occ += 0.7071f * max(CurrentHeight.Load(int3(BreakupWrapPixel(p + int2(radius, radius)), 0)) - h, 0.0f);
	occ += 0.7071f * max(CurrentHeight.Load(int3(BreakupWrapPixel(p + int2(-radius, radius)), 0)) - h, 0.0f);
	occ += 0.7071f * max(CurrentHeight.Load(int3(BreakupWrapPixel(p + int2(radius, -radius)), 0)) - h, 0.0f);
	occ += 0.7071f * max(CurrentHeight.Load(int3(BreakupWrapPixel(p - int2(radius, radius)), 0)) - h, 0.0f);

	return occ * 0.14645f;
}

[numthreads(8, 8, 1)]
void FieldCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 pixel = int2(DispatchThreadId.xy);
	const float2 sourceUV = (float2(pixel) + 0.5f) / float2(OutputSize);
	const float2 uv = BreakupDistort(sourceUV, DistortFrequency, DistortAmount, Seed + 1001u);

	const int mc = max(MacroCells, 1);
	const int md = max(MidCells, 1);
	const int dc = max(DetailCells, 1);

	FBreakupSample d0 = BreakupFamily(
		uv, mc, Seed + 11u,
		Density, SizeMin, SizeMax, Stretch, Angularity, Jitter);

	FBreakupSample d1 = BreakupFamily(
		uv, md, Seed + 107u,
		saturate(Density * 0.92f), SizeMin * 0.85f, SizeMax * 0.95f,
		Stretch, Angularity, Jitter);

	FBreakupSample d2 = BreakupFamily(
		uv, dc, Seed + 251u,
		saturate(Density * 0.72f), SizeMin * 0.65f, SizeMax * 0.82f,
		Stretch, saturate(Angularity + 0.08f), Jitter);

	FBreakupSample result = BreakupCombine(d0, d1, BlendSmooth / (float)mc, OperationMid);
	result = BreakupCombine(result, d2, BlendSmooth / (float)md, OperationDetail);

	float sd = result.Distance * BREAKUP_REFERENCE_RES;
	if (InvertField != 0u)
	{
		sd = -sd;
	}

	// Positive inset shrinks pieces and opens space. Negative inset grows them.
	sd += Inset;

	uint finalId = result.Id;
	if (HasRegionIds != 0u && finalId != 0u)
	{
		const uint regionId = RegionIds.Load(int3(pixel, 0));
		finalId = BreakupHashU(finalId ^ regionId * 0x9e3779b9u);
	}
	if (finalId == 0u && result.Id != 0u)
	{
		finalId = 1u;
	}

	const float idRandom = BreakupHash01(finalId ^ Seed * 0x85ebca6bu);
	const float gapScale = lerp(
		1.0f - saturate(GapVariation),
		1.0f + saturate(GapVariation),
		frac(idRandom * 2.41421356237f + 0.317f));
	const float placement = BreakupSamplePlacement(sourceUV);
	const float idInset = max(GapWidth * gapScale * 0.15f, 0.0f);

	const bool bPiece =
		result.Id != 0u &&
		sd < -idInset &&
		placement > 1.0e-4f;

	OutputField[pixel] = float2(clamp(sd, -4096.0f, 4096.0f), idRandom);
	OutputRegionIds[pixel] = bPiece ? finalId : 0u;
}

[numthreads(8, 8, 1)]
void ApplyCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 pixel = int2(DispatchThreadId.xy);
	const float2 uv = (float2(pixel) + 0.5f) / float2(OutputSize);

	const float sourceHeight = SourceHeight.Load(int3(pixel, 0));
	const float2 field = BreakupField.Load(int3(pixel, 0));
	const float sd = field.x;
	const float r0 = field.y;

	const float r1 = frac(r0 * 1.61803398875f + 0.173f);
	const float r2 = frac(r0 * 2.41421356237f + 0.517f);
	const float r3 = frac(r0 * 3.14159265359f + 0.731f);

	const float placement = BreakupSamplePlacement(uv);

	const float reliefWidth = max(CreaseWidth * 2.0f, 1.0f);
	const float inside = BreakupSmooth(0.0f, reliefWidth, -sd);

	float fold = 0.0f;
	if (sd >= 0.0f)
	{
		fold = 1.0f - BreakupSmooth(0.0f, max(FoldWidth, 1.0e-4f), sd);
		fold = fold * fold * (3.0f - 2.0f * fold);
	}

	const float crease =
		1.0f - BreakupSmooth(0.0f, max(CreaseWidth, 1.0e-4f), abs(sd));
	const float pushBand =
		1.0f - BreakupSmooth(0.0f, max(PushWidth, 1.0e-4f), abs(sd));

	const float sdfL = BreakupLoadSDF(pixel + int2(-1, 0));
	const float sdfR = BreakupLoadSDF(pixel + int2(1, 0));
	const float sdfD = BreakupLoadSDF(pixel + int2(0, -1));
	const float sdfU = BreakupLoadSDF(pixel + int2(0, 1));

	float2 gradient = float2(sdfR - sdfL, sdfU - sdfD);
	const float gradientLength = length(gradient);
	gradient = gradientLength > 1.0e-5f
		? gradient / gradientLength
		: float2(0.0f, 0.0f);

	const float thicknessScale = lerp(
		1.0f - saturate(ThicknessVariation),
		1.0f + saturate(ThicknessVariation),
		r0);

	const float foldVariation = lerp(
		1.0f - saturate(Variation) * 0.55f,
		1.0f + saturate(Variation) * 0.55f,
		r1);
	const float creaseVariation = lerp(
		1.0f - saturate(Variation) * 0.35f,
		1.0f + saturate(Variation) * 0.35f,
		r2);
	const float pushVariation = lerp(
		1.0f - saturate(Variation) * 0.60f,
		1.0f + saturate(Variation) * 0.60f,
		r3);

	const float gapScale = lerp(
		1.0f - saturate(GapVariation),
		1.0f + saturate(GapVariation),
		r2);
	const float gapWidth = max(GapWidth * gapScale, 0.0f);
	const float gapSdf = gapWidth > 1.0e-5f
		? 1.0f - BreakupSmooth(0.0f, gapWidth, abs(sd))
		: 0.0f;

	float gapIds = 0.0f;
	if (gapWidth > 0.0f)
	{
		const uint centerId = BreakupLoadId(pixel);
		const int radius = max(1, (int)round(gapWidth * BreakupResolutionScale()));
		const int nearRadius = max(1, radius / 2);
		const float farEdge = BreakupIdBoundary(pixel, centerId, radius);
		const float nearEdge = BreakupIdBoundary(pixel, centerId, nearRadius);
		gapIds = saturate(farEdge * 0.55f + nearEdge * 0.45f);
	}
	const float gap = max(gapSdf, gapIds);

	const float side = sd >= 0.0f ? 1.0f : -1.0f;
	const float pushUV = PushAmount / BREAKUP_REFERENCE_RES;
	const float2 warpedUV = frac(
		uv + gradient * side * pushUV * pushBand * pushVariation);

	float warpedHeight = sourceHeight;
	if (abs(PushAmount) > 1.0e-6f)
	{
		warpedHeight = SourceHeight.SampleLevel(LinearWrapSampler, warpedUV, 0.0f);
	}

	// Push now has a structural component in addition to UV advection. A flat source can therefore
	// still visibly separate/bulge at a breakup boundary.
	const float pushActivation = saturate(abs(PushAmount) / 8.0f);
	const float pushHeight =
		side *
		(PushAmount >= 0.0f ? 1.0f : -1.0f) *
		PushRelief *
		pushBand *
		pushVariation *
		pushActivation;

	const float gapDepthVariation = lerp(0.80f, 1.20f, r3);

	const float delta =
		inside * Relief * thicknessScale +
		fold * FoldHeight * foldVariation -
		crease * CreaseDepth * creaseVariation -
		gap * GapDepth * gapDepthVariation +
		pushHeight;

	const float amount = saturate(Strength * placement);
	const float result = lerp(sourceHeight, warpedHeight + delta, amount);

	OutputHeight[pixel] = saturate(result);
	OutputCoverage[pixel] = saturate(
		max(
			max(inside, fold),
			max(max(crease, gap), pushBand * pushActivation))
		* amount);
}

[numthreads(8, 8, 1)]
void ShadeCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const int2 pixel = int2(DispatchThreadId.xy);
	const float coverage = saturate(BreakupCoverage.Load(int3(pixel, 0)));

	const float2 sharpGradient = BreakupDeltaGradient(pixel, 1);
	const int broadRadius = max(2, (int)round(lerp(4.0f, 2.0f, saturate(NormalSharpness))));
	const float2 broadGradient = BreakupDeltaGradient(pixel, broadRadius);

	float2 g = lerp(broadGradient, sharpGradient, saturate(NormalSharpness));
	g += sharpGradient * saturate(NormalSharpness) * 0.35f;
	g *= NormalStrength;

	const float3 reliefNormal = normalize(float3(g, 1.0f));
	const float4 encodedBase = PreviousNormal.Load(int3(pixel, 0));
	const float3 baseNormal = normalize(encodedBase.xyz * 2.0f - 1.0f);

	const float3 t = baseNormal + float3(0.0f, 0.0f, 1.0f);
	const float3 u = reliefNormal * float3(-1.0f, -1.0f, 1.0f);
	const float3 combined = normalize(t * dot(t, u) / max(t.z, 1.0e-5f) - u);
	OutputNormal[pixel] = float4(combined * 0.5f + 0.5f, encodedBase.w);

	float4 ram = PreviousRAM.Load(int3(pixel, 0));
	ram.r = saturate(ram.r + RoughnessAmount * coverage);

	if (AOAmount > 0.0f && coverage > 0.0f)
	{
		const float resolutionScale = BreakupResolutionScale();
		const int aoRadiusPixels = max(1, (int)round(max(AORadius, 1.0f) * resolutionScale));
		const int aoNearPixels = max(1, aoRadiusPixels / 2);

		const float heightAO =
			BreakupHeightOcclusion(pixel, aoNearPixels) * 18.0f +
			BreakupHeightOcclusion(pixel, aoRadiusPixels) * 10.0f;

		const float sd = BreakupField.Load(int3(pixel, 0)).x;
		const float edgeAO =
			1.0f - BreakupSmooth(0.0f, max(AORadius, 1.0f), abs(sd));

		const uint centerId = BreakupLoadId(pixel);
		const float idAO = BreakupIdBoundary(pixel, centerId, aoNearPixels);

		const float ao = saturate(
			heightAO +
			edgeAO * 0.35f +
			idAO * 0.25f) * coverage;

		ram.g = saturate(ram.g * (1.0f - saturate(AOAmount) * ao));
	}

	OutputRAM[pixel] = ram;
}
