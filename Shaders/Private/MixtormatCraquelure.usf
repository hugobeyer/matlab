#include "/Engine/Public/Platform.ush"
#include "/Plugin/MaterialLab/Private/MixtormatCellular.ush"
#include "/Plugin/MaterialLab/Private/MixtormatMaskOps.ush"

// Craquelure. A crack network on a cellular lattice, blended into the layer mask.
//
// Its own node rather than a signal on the generated mask. Everything that node produces is
// derived from the surface accumulated beneath it, and it early-returns when there is none;
// craquelure is generated from a lattice and means something on the bottom layer where the
// others have nothing to read. Living there forced that early return to be picked apart into a
// per-signal guard, which made the node's contract conditional on which weights happened to be
// non-zero. Pulling it out restores the plain test and gives cracks their own controls.
//
// A mask rather than a filter, so it can drive anything downstream -- chipping placement, a
// stain, a peel -- rather than only cutting the surface itself.

Texture2D<float> PreviousMask;
SamplerState LinearWrapSampler;
RWTexture2D<float> OutputMask;

// (distance to the nearest crack in pixels, crack id), the same pair the propagated mode's jump
// flood produces. Relief reads one field and never learns which mode built it: the lattice knows
// its own boundary distance analytically, so it needs no flood to say the same thing.
RWTexture2D<float4> OutputDistance;

int2 OutputSize;
uint Initialize;

int Period;
float Jitter;
float Width;
float Variation;
uint Seed;

float Warp;
int WarpPeriod;
uint WarpSeed;

uint BlendMode;
uint Invert;
float Weight;
float Balance;
float Contrast;
float Offset;

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	if (any(DispatchThreadId.xy >= uint2(OutputSize)))
	{
		return;
	}

	const float2 UV = (float2(DispatchThreadId.xy) + 0.5f) / float2(OutputSize);
	const float Previous = Initialize != 0
		? 0.0f
		: PreviousMask.SampleLevel(LinearWrapSampler, UV, 0.0f);

	const int Cells = max(Period, 1);
	float2 SampleUV = UV;

	// Curl warp follows coherent, divergence-free arcs. The old two-noise X/Y displacement
	// compressed cells into diagonal smears and changed character whenever Scale moved.
	if (abs(Warp) > 0.0f)
	{
		SampleUV = MixtormatPeriodicCurlWarp(UV, WarpPeriod, WarpSeed, Warp);
	}

	// Scale and period are the same number here, unlike MixtormatGullyField where the period is
	// the base period shifted by the octave. There is one octave in a crack network, so the
	// lattice the UV is scaled onto is the lattice that wraps.
	const FMixtormatCellularResult Cell = MixtormatCellular(
		SampleUV * (float)Cells, Cells, Seed, Jitter);

	// Distance to the cell boundary, not F2 - F1. The point-difference form varies its width
	// with cell size, so a network built from it comes out heavy in the large cells and
	// hairline in the small ones; the boundary distance holds an even width, which is what
	// reads as cracking rather than as noise.
	//
	// Width is in cell units, so it means the same thing at any Period. Floored well above
	// zero: as the window closes the smoothstep becomes a step at the cell boundary, which
	// aliases into a dashed line rather than fading out. Weight is the off switch.
	float Crack = 1.0f - smoothstep(0.0f, max(Width, 0.002f), Cell.EdgeDistance);

	// Per-crack variation breaks the network up, so it reads as cracks that opened at
	// different times rather than as a uniform lattice. Applied to the crack rather than to
	// the cell, so it thins lines instead of tinting regions.
	//
	// Keyed on the wall id, not the cell id. A crack is the boundary between two cells and
	// the pixels either side of it belong to different ones, so a per-cell value splits
	// every crack down its centre -- one half dim, the other bright, with the seam running
	// along the feature itself. The wall id is symmetric in the pair, so the whole crack
	// takes one value. It still changes at junctions, where the nearest wall becomes a
	// different pair; cracks do change character where they meet.
	Crack *= lerp(1.0f, MixtormatCellRandom01(Cell.EdgeId), saturate(Variation));

	// EdgeDistance is in cell units, because the UV handed to the lattice was scaled by the cell
	// count. One cell spans OutputSize.x / Cells pixels, so this is the same quantity the flood
	// reports and Width means the same fraction of a cell in both.
	const float DistancePixels =
		Cell.EdgeDistance * (float)OutputSize.x / (float)Cells;
	//
	// The id is carried as a small whole number rather than as the hash reinterpreted through
	// asfloat. A raw hash lands on NaN and denormal bit patterns about as often as not, and those
	// are the two things a float32 texture write is allowed not to hand back unchanged. Held
	// under 2^24 it is exact, which is the same reason the propagated mode's lineage id is.
	OutputDistance[DispatchThreadId.xy] =
		float4(DistancePixels, (float)(Cell.EdgeId % 16777213u), 0.0f, 0.0f);

	const float Incoming = MixtormatShapeMask(saturate(Crack), Contrast, Offset, Balance, Invert);
	const float Result = MixtormatApplyMaskOperation(BlendMode, Previous, Incoming);
	OutputMask[DispatchThreadId.xy] = saturate(lerp(Previous, Result, Weight));
}
