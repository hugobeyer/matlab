#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"

// Per-region gradient. Gives every region its own local frame and runs a linear ramp across it,
// oriented by a random angle drawn off the region's ID.
//
// This is the half of the prototype that feeds relief. The UV field it also emits -- for mapping
// detail or a whole material through each region's own frame -- is deliberately not produced
// here; only the gradient and the edge falloff the tilt pass needs.
//
// Three stages, driven by Stage exactly as the cluster filter is. Every file-scope uniform below
// is declared in FMixtormatRampIdsCS::FParameters whether a given stage reads it or not: UE binds
// the whole file, not the entry point's subset.
Texture2D<uint> RegionIds;
// Four ints per pixel -- min x, max x, min y, max y -- strided rather than four buffers or a
// buffer of int4. Atomics on a struct member of a structured buffer are the kind of thing dxc
// accepts and a driver disagrees about; plain strided ints are unambiguous everywhere.
RWStructuredBuffer<int> RegionBounds;
RWTexture2D<float2> OutputRamp;

int2 OutputSize;
uint Stage;

uint Seed;
uint RotateRandom;
// Quantises each region's angle so a lattice reads as deliberately laid rather than scattered.
// The step is in degrees and applied to the true screen-space angle, which is the only place it
// means what it says -- see the fit below.
uint AngleStepping;
float AngleStepDegrees;
float IntensityRandom;

#define RAMP_STAGE_INIT 0
#define RAMP_STAGE_BOUNDS 1
#define RAMP_STAGE_RESOLVE 2

// Offset from the region's root the short way round the torus.
//
// This is what makes the whole thing tile, and it is why the bounding box has to be built in
// root-relative coordinates rather than absolute ones. A region straddling the seam has pixels at
// x=2 and x=1022; min/max over those gives a box spanning the image, and every UV derived from it
// is wrong. Measured as deltas, the same region gets a small correct box.
int WrapDelta(int P, int A, int Size)
{
	int D = P - A;
	const int Half = Size / 2;
	if (D > Half)
	{
		D -= Size;
	}
	if (D < -Half)
	{
		D += Size;
	}
	return D;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint2 Pixel = DispatchThreadId.xy;
	if (any(Pixel >= uint2(OutputSize)))
	{
		return;
	}
	const uint Index = Pixel.x + Pixel.y * uint(OutputSize.x);

	if (Stage == RAMP_STAGE_INIT)
	{
		RegionBounds[Index * 4u + 0u] = 2147483647;
		RegionBounds[Index * 4u + 1u] = -2147483647;
		RegionBounds[Index * 4u + 2u] = 2147483647;
		RegionBounds[Index * 4u + 3u] = -2147483647;
		return;
	}

	const uint RawId = RegionIds.Load(int3(Pixel, 0));
	const bool bValid = RawId != MIXTORMAT_INVALID_REGION && RawId < uint(OutputSize.x * OutputSize.y);
	// The ID *is* the root pixel's linear index, which is what carries the root's position for
	// free. Nothing collapses these to a dense range; doing so would destroy exactly this.
	const uint RootId = bValid ? RawId : Index;
	const int RootX = int(RootId % uint(OutputSize.x));
	const int RootY = int(RootId / uint(OutputSize.x));
	const int DeltaX = WrapDelta(int(Pixel.x), RootX, OutputSize.x);
	const int DeltaY = WrapDelta(int(Pixel.y), RootY, OutputSize.y);

	if (Stage == RAMP_STAGE_BOUNDS)
	{
		if (bValid)
		{
			InterlockedMin(RegionBounds[RootId * 4u + 0u], DeltaX);
			InterlockedMax(RegionBounds[RootId * 4u + 1u], DeltaX);
			InterlockedMin(RegionBounds[RootId * 4u + 2u], DeltaY);
			InterlockedMax(RegionBounds[RootId * 4u + 3u], DeltaY);
		}
		return;
	}

	// A pixel in no region gets the neutral ramp and zero strength, so the relief pass leaves it
	// flat rather than lifting it by half an amount.
	if (!bValid)
	{
		OutputRamp[Pixel] = float2(0.5f, 0.0f);
		return;
	}

	const int MinX = RegionBounds[RootId * 4u + 0u];
	const int MaxX = RegionBounds[RootId * 4u + 1u];
	const int MinY = RegionBounds[RootId * 4u + 2u];
	const int MaxY = RegionBounds[RootId * 4u + 3u];

	const float SpanX = max(float(MaxX - MinX), 1.0f);
	const float SpanY = max(float(MaxY - MinY), 1.0f);

	const uint Seeded = MixtormatRegionSeed(RootId, Seed);
	float Angle = RotateRandom != 0
		? MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_HUE) * 6.28318530718f
		: 0.0f;
	if (AngleStepping != 0)
	{
		const float Step = radians(max(AngleStepDegrees, 0.01f));
		Angle = round(Angle / Step) * Step;
	}

	const float CosA = cos(Angle);
	const float SinA = sin(Angle);

	// The ramp fits the cell exactly, at every angle and every aspect.
	//
	// This is the whole of what "fit the cell" means, and the old code got it wrong in a way that
	// only showed off-axis. It normalised to the bounding box first, giving a unit square, then
	// rotated that square about its centre and saturated. But rotating a unit square makes the
	// projection onto the ramp axis span +/-(|cos| + |sin|)/2 -- at 45 degrees that is +/-0.707,
	// so the gradient ran -0.207..1.207 and the saturate clipped two opposite corners into flat
	// bands. The ramp overshot the cell instead of framing it.
	//
	// Measured in pixels from the box centre and divided by the box's true extent along the ramp
	// direction, the projection lands on exactly -0.5..0.5 for any angle and any aspect. Nothing
	// clips, and no scale or bias is needed to bring it back into range -- which is why both are
	// gone.
	//
	// Pixel space and not the normalised square, deliberately: on a 4:1 brick a "45 degree" ramp
	// in normalised space is not 45 degrees on screen, and the angle stepping above would land on
	// visually uneven intervals. Here the angle means what it says.
	const float2 Centre = float2(float(MinX + MaxX), float(MinY + MaxY)) * 0.5f;
	const float2 Offset = float2(float(DeltaX), float(DeltaY)) - Centre;
	const float Extent = max(SpanX * abs(CosA) + SpanY * abs(SinA), 1.0f);
	const float Gray = saturate((Offset.x * CosA + Offset.y * SinA) / Extent + 0.5f);

	// Per-cell strength, carried in .y. This channel used to be the edge feather; the relief pass
	// multiplies by it either way, so the meaning changed and the arithmetic did not. Base plus
	// jitter, not range times amount: unlike a per-cell height offset, a uniform ramp strength is
	// meaningful on its own -- every cell tilts equally, each in its own direction -- so
	// IntensityRandom 0 leaves every cell at full strength rather than switching the node off.
	const float Jitter = lerp(
		1.0f - saturate(IntensityRandom),
		1.0f,
		MixtormatRegionRandomSalted(Seeded, MIXTORMAT_SALT_SAT));

	OutputRamp[Pixel] = float2(Gray, Jitter);
}
