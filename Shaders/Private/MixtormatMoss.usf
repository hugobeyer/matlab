// Copyright 2026 Hugo Beyer. All Rights Reserved.
// Biological moss: habitat-driven colony expansion, height-coupled moisture
// transport, inter-colony contact seams. Moisture flows downhill on the
// composite substrate height and pools in depressions.
// Cushion bulk has two selectable solvers (CushionMode): 0 = deposition
// thickness PDE (simulated state, creep + repose slump on substrate+moss),
// 1 = legacy SDF inflation (Jump-Flood interior distance -> dome profile).
// Chemical = (moisture, coverage), GrowthState = (arrival, colony, biomass, moisture),
// MossThickness = (thickness, thickness * biomass).

#include "/Engine/Public/Platform.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorPlacement.ush"
#include "/Plugin/Mixtormat/Private/MixtormatGeneratorHeightModules.ush"
#include "/Plugin/Mixtormat/Private/MixtormatRegionId.ush"

// Thirteen permutations: 0 analysis, 1 seed, 2 meso, 3 height/preview,
// 4 expansion step, 5 resolve, 6 thickness init, 7 thickness deposition step,
// 8 SDF boundary seeds, 9 jump flood, 10 SDF distance/inflation, 11 inflation smooth,
// 12 material (color ramp, moisture roughness, tufted arc-blade detail normal).
// Stages 0/1/4/6/7/8/9/10/11 use SimulationSize; 2/3/5/12 use OutputSize.
#ifndef MOSS_STAGE
#define MOSS_STAGE 0
#endif

// Common Uniforms
int2 OutputSize;
int2 SimulationSize;
uint Seed;
float HeightScale;
uint bNormalizeHeight;

// Habitat Uniforms
float CavityAttraction;
float OcclusionInfluence;
float Moisture;
float SurfaceAnglePreference;
float Competition;
float ExposureTolerance;

// Seeding Uniforms
float SeedMaskTiling;
uint bSeedMaskInvert;
uint HasSeedMask;
Texture2D<float4> SeedMask;

// Growth Uniforms
int ColonyDensity;
float GrowthSpread;

float Coverage;
uint GrowthIterations;
uint IterationIndex;
uint Preview;

uint CushionMode;
int HeightJump;
float DryRoughness;
float WetRoughness;
float NormalStrength;
uint ColorRampCount;
uint ColorRampInterpolation;
float4 ColorRampPositions[MIXTORMAT_COLOR_RAMP_MAX_STOPS];
float4 ColorRampColors[MIXTORMAT_COLOR_RAMP_MAX_STOPS];

// Structure Uniforms
float CushionSize;
float CushionHeight;
float MatureHeight;
float ClumpDensity;
float ShootDensity;
float ShootLength;
float FiberThickness;

// Physical Behavior Uniforms

float Softness;
float Plumpness;

// Textures & Samplers
Texture2D<float> SubstrateHeight;
Texture2D<float4> SubstrateAnalysis;
Texture2D<float4> HabitatColony;
Texture2D<float> MesoCushionHeight;
Texture2D<float2> Chemical;
Texture2D<float4> GrowthState;
Texture2D<float4> ActivationHabitat;
Texture2D<float> GrowthCoverage;
Texture2D<float> GrowthAge;
Texture2D<uint> GrowthIds;
Texture2D<float2> MossThickness;
Texture2D<float2> HeightSeeds;
Texture2D<float> GrowthInteriorDistance;
Texture2D<float2> CushionInflation;
SamplerState LinearWrapSampler;

// Stage outputs
RWTexture2D<float4> OutSubstrateAnalysis;
RWTexture2D<float2> OutChemical;
RWTexture2D<float4> OutGrowthState;
RWTexture2D<float4> OutActivationHabitat;
RWTexture2D<float> OutMesoHeight;
RWTexture2D<float> OutGrowthHeight;
RWTexture2D<float4> OutHabitatColony;
RWTexture2D<float> OutGrowthCoverage;
RWTexture2D<float> OutGrowthAge;
RWTexture2D<uint> OutGrowthIds;
RWTexture2D<float2> OutMossThickness;
RWTexture2D<float4> OutMossColor;
RWTexture2D<float4> OutMossRAM;
RWTexture2D<float4> OutMossNormal;
RWTexture2D<float> OutMossRoughness;
RWTexture2D<float2> OutHeightSeeds;
RWTexture2D<float> OutGrowthInteriorDistance;
RWTexture2D<float2> OutCushionInflation;

static const float MOSS_ACTIVE_B = 0.1f;
static const float MOSS_EMPTY_B = 0.001f;
static const uint MOSS_CLUMP_SALT = 909u;
static const float MOSS_CLUMP_RELIEF_FRACTION = 0.5f;
static const float MOSS_SHOOT_RELIEF_FRACTION = 0.5f;
static const float2 MOSS_SHOOT_RADIUS_RANGE = float2(0.12f, 0.65f);
static const float MOSS_COARSE_RELIEF_FRACTION = 0.1f;
static const float MOSS_SMOOTH_RADIUS_FRACTION = 0.5f;
static const float2 MOSS_INOCULATION_GATE_RANGE = float2(0.05f, 0.35f);

// --- Helpers ---
float2 WrapUV(float2 uv) { return frac(uv); }
float2 TorusDelta(float2 a, float2 b) { float2 d = b - a; return d - floor(d + 0.5f); }
uint Hash21(int2 p, uint salt)
{
	uint x = uint(p.x * 0x1f1f1f1f ^ p.y * 0x5b5b5b5b) ^ salt ^ Seed;
	x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; return x ^ (x >> 16);
}
float Random21(int2 p, uint salt) { return float(Hash21(p, salt) >> 8) * (1.0f / 16777216.0f); }
float2 Random22(int2 p, uint salt)
{
	return float2(float(Hash21(p, salt) >> 8) * (1.0f / 16777216.0f),
		float(Hash21(p, salt + 0x9e3779b9u) >> 8) * (1.0f / 16777216.0f));
}
float TileNoise(float2 uv, int period, uint salt)
{
	float2 p = frac(uv) * float(period); int2 c = int2(floor(p)); float2 f = frac(p);
	f = f * f * (3.0f - 2.0f * f);
	int2 c00 = (c % period + period) % period;
	int2 c10 = ((c + int2(1, 0)) % period + period) % period;
	int2 c01 = ((c + int2(0, 1)) % period + period) % period;
	int2 c11 = ((c + int2(1, 1)) % period + period) % period;
	float v00 = Random21(c00, salt), v10 = Random21(c10, salt), v01 = Random21(c01, salt), v11 = Random21(c11, salt);
	return lerp(lerp(v00, v10, f.x), lerp(v01, v11, f.x), f.y);
}
float2 CurlDomainWarp(float2 uv, int period, uint salt)
{
	float e = 1.0f / float(period);
	float nU = TileNoise(uv + float2(0, e), period, salt);
	float nD = TileNoise(uv - float2(0, e), period, salt);
	float nR = TileNoise(uv + float2(e, 0), period, salt);
	float nL = TileNoise(uv - float2(e, 0), period, salt);
	return float2(nU - nD, -(nR - nL));
}
float MossCellDome(float2 UV, int Period, uint Salt)
{
	int2 BaseCell = int2(floor(UV * float(Period))); float MinDistance = 1.0f;
	[unroll] for (int Y = -1; Y <= 1; ++Y) [unroll] for (int X = -1; X <= 1; ++X)
	{
		int2 Cell = BaseCell + int2(X, Y);
		int2 Wrapped = (Cell % Period + Period) % Period;
		float2 Center = (float2(Wrapped) + Random22(Wrapped, Salt)) / float(Period);
		MinDistance = min(MinDistance, length(TorusDelta(UV, Center)));
	}
	float Radius = MinDistance * float(Period);
	return sqrt(max(0.0f, 1.0f - Radius * Radius));
}
int2 WrapSimulationPixel(int2 Pixel) { return (Pixel % SimulationSize + SimulationSize) % SimulationSize; }
float MossCoverageThreshold() { return lerp(0.22f, 0.06f, Coverage); }
float ResolveMossCoverage(float B) { if (Coverage <= 0.0f || B <= MOSS_EMPTY_B) return 0.0f; float Low = MossCoverageThreshold(); return smoothstep(Low, Low + 0.10f, B); }

#if MOSS_STAGE == 3 || MOSS_STAGE == 5
float MossMaturity(float Arrival) { return Arrival >= 0.0f ? saturate((float(GrowthIterations) - Arrival + 1.0f) / (float(GrowthIterations) + 1.0f)) : 0.0f; }
struct FMossSimulationSample { float2 Concentrations; float Maturity; float CoveredAge; uint ColonyId; };
FMossSimulationSample SampleMossSimulation(float2 DestinationUV)
{
	float2 Position = frac(DestinationUV) * float2(SimulationSize) - 0.5f;
	int2 Anchor = int2(floor(Position)); float2 Blend = frac(Position);
	FMossSimulationSample Result; Result.Concentrations = 0.0f; Result.Maturity = 0.0f; Result.CoveredAge = 0.0f; Result.ColonyId = MIXTORMAT_INVALID_REGION;
	float BestContribution = 0.0f;
	[unroll] for (int Y = 0; Y < 2; ++Y) [unroll] for (int X = 0; X < 2; ++X)
	{
		int2 Tap = WrapSimulationPixel(Anchor + int2(X, Y));
		float TapWeight = (X == 0 ? 1.0f - Blend.x : Blend.x) * (Y == 0 ? 1.0f - Blend.y : Blend.y);
		float2 TapChemical = Chemical.Load(int3(Tap, 0)); float4 TapState = GrowthState.Load(int3(Tap, 0));
		float TapMaturity = MossMaturity(TapState.x); bool Covered = ResolveMossCoverage(TapChemical.y) > 0.0f;
		Result.Concentrations += TapChemical * TapWeight; Result.Maturity += TapMaturity * TapWeight; Result.CoveredAge += (Covered ? TapMaturity : 0.0f) * TapWeight;
		if (Covered && TapState.x >= 0.0f && TapState.y >= 1.0f && TapWeight > 0.0f)
		{
			float Contribution = TapChemical.y * TapWeight; uint Label = uint(TapState.y);
			if (Contribution > BestContribution || (Contribution == BestContribution && Label < Result.ColonyId)) { BestContribution = Contribution; Result.ColonyId = Label; }
		}
	}
	return Result;
}
#endif

// ============================================================================
// STAGE 0: Substrate Multiscale Analysis
// ============================================================================
#if MOSS_STAGE == 0
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Pixel = int2(DispatchThreadId.xy); if (any(Pixel >= SimulationSize)) return;
	float2 Texel = 1.0f / float2(SimulationSize);
	float2 DestinationUV = (float2(Pixel) + 0.5f) * Texel;
	float hC = SubstrateHeight.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0);
	float hR = SubstrateHeight.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV + float2(Texel.x, 0)), 0);
	float hL = SubstrateHeight.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV - float2(Texel.x, 0)), 0);
	float hU = SubstrateHeight.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV + float2(0, Texel.y)), 0);
	float hD = SubstrateHeight.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV - float2(0, Texel.y)), 0);
	float2 Grad = float2(hR - hL, hU - hD) / (2.0f * Texel);
	float Slope = saturate(length(Grad) * 0.15f);
	float Laplacian = (hR + hL + hU + hD - 4.0f * hC);
	float FineCrevice = saturate(Laplacian * 16.0f);
	const float2 DirTable[8] = { float2(1,0), float2(0.7071,0.7071), float2(0,1), float2(-0.7071,0.7071), float2(-1,0), float2(-0.7071,-0.7071), float2(0,-1), float2(0.7071,-0.7071) };
	float SumMedium = 0, SumBroad = 0, HorizonShelterSum = 0;
	[unroll] for (int d = 0; d < 8; ++d)
	{
		float2 Dir = DirTable[d];
		float hMed = SubstrateHeight.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV + Dir * Texel * 4.0f), 0); SumMedium += hMed;
		float h8 = SubstrateHeight.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV + Dir * Texel * 8.0f), 0);
		float h16 = SubstrateHeight.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV + Dir * Texel * 16.0f), 0); SumBroad += h16;
		float DirectionTexel = length(Dir * Texel);
		float Slope8 = (h8 - hC) / (8.0f * DirectionTexel); float Slope16 = (h16 - hC) / (16.0f * DirectionTexel);
		HorizonShelterSum += saturate(max(Slope8, Slope16) * 0.05f);
	}
	float AvgMedium = SumMedium * 0.125f, AvgBroad = SumBroad * 0.125f;
	float MediumDepression = saturate((AvgMedium - hC) * 8.0f);
	float BroadBasin = saturate((AvgBroad - hC) * 4.0f);
	float Cavity = saturate(FineCrevice * 0.50f + MediumDepression * 0.30f + BroadBasin * 0.20f);
	float Ridge = saturate((hC - AvgBroad) * 8.0f + (hC - AvgMedium) * 4.0f);
	float Shelter = saturate(HorizonShelterSum * 0.125f);
	OutSubstrateAnalysis[Pixel] = float4(Cavity, Shelter, Slope, Ridge);
}
#endif

// ============================================================================
// STAGE 1: Habitat + Biological Seeding (no Gray-Scott chemicals)
// ============================================================================
#if MOSS_STAGE == 1
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Pixel = int2(DispatchThreadId.xy); if (any(Pixel >= SimulationSize)) return;
	float2 DestinationUV = (float2(Pixel) + 0.5f) / float2(SimulationSize);
	float2 UV = MixtormatGeneratorUV(DestinationUV);
	float4 Sub = SubstrateAnalysis.Load(int3(Pixel, 0));
	float Cavity = smoothstep(0.0005f, 0.025f, Sub.r);
	float Shelter = smoothstep(0.002f, 0.12f, Sub.g);
	float Slope = Sub.b; float Ridge = Sub.a;
	float Exposure = saturate((1.0f - Shelter) * (0.35f + 0.65f * Ridge));
	float Habitat = Moisture;
	Habitat += CavityAttraction * Cavity * (0.5f + 0.5f * Moisture);
	Habitat += OcclusionInfluence * Shelter * 0.75f;
	Habitat += 0.30f * Cavity * Moisture * (1.0f - Ridge);
	// Attenuate suitability rather than subtracting through a hard zero cutoff.
	float HabitatPenalty = (1.0f - saturate(ExposureTolerance)) * Exposure * 0.5f
		+ max(SurfaceAnglePreference, 0.0f) * pow(Slope, 1.4f) * 1.2f;
	Habitat = saturate(Habitat) * exp(-HabitatPenalty);
	int Period = max(ColonyDensity, 1);
	float Inoculation = TileNoise(UV, Period, 101u) * 0.57f + TileNoise(UV, Period * 2, 202u) * 0.29f + TileNoise(UV, Period * 4, 303u) * 0.14f;
	float Patches = smoothstep(0.58f, 0.68f, Inoculation);
	float HabitatGate = Habitat;
	float SeedHabitat = saturate(CavityAttraction * Cavity + OcclusionInfluence * Shelter);
	float SeedGate = smoothstep(MOSS_INOCULATION_GATE_RANGE.x, MOSS_INOCULATION_GATE_RANGE.y, SeedHabitat);
	float HabitatSeed = Patches * SeedGate * HabitatGate;
	float MaskSeed = 0.0f;
	if (HasSeedMask != 0u) { MaskSeed = SeedMask.SampleLevel(LinearWrapSampler, frac(UV * SeedMaskTiling), 0).r; if (bSeedMaskInvert != 0u) MaskSeed = 1.0f - MaskSeed; }
	// Mask is seeds, not a gate: boost local habitat so seeds can spread beyond the mask
	float SeededHabitat = saturate(Habitat + MaskSeed * 0.7f);
	float Activation = saturate(HabitatSeed + MaskSeed);
	float B = Random21(Pixel, 808u) * Activation;
	bool Active = B >= MOSS_ACTIVE_B;
	uint Label = Active ? uint(Pixel.y * SimulationSize.x + Pixel.x) + 1u : 0u;
	OutActivationHabitat[Pixel] = float4(Activation, SeededHabitat, MaskSeed, saturate(SeededHabitat));
	OutChemical[Pixel] = float2(saturate(SeededHabitat), B);
	OutGrowthState[Pixel] = float4(Active ? 0.0f : -1.0f, float(Label), 0.0f, 0.0f);
}
#endif

// ============================================================================
// STAGE 2: Mush cushion body (isotropic squash, turgor, wet rim)
// ============================================================================
#if MOSS_STAGE == 2
// Mush body: isotropic squash + turgor plumping + wet rim meniscus. No gravity
// direction: a soft cushion slumps equally in all directions and re-inflates
// when the solver moisture field is wet.
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Pixel = int2(DispatchThreadId.xy); if (any(Pixel >= OutputSize)) return;
	float2 Texel = 1.0f / float2(OutputSize);
	float2 DestinationUV = (float2(Pixel) + 0.5f) * Texel;
	float2 UV = MixtormatGeneratorUV(DestinationUV);
	float4 Hab = HabitatColony.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0);
	float ColonyMask = Hab.r;
	if (ColonyMask <= 0.001f) { OutMesoHeight[Pixel] = 0.0f; return; }
	float TargetSize = max(CushionSize, 1e-6f);
	float4 SolverState = GrowthState.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0);
	float Biomass = saturate(SolverState.z);
	float Plump = lerp(1.0f, 0.70f + 0.60f * saturate(SolverState.w), Plumpness);
	// Cushion profile source: .x = profile, .y = biomass-weighted profile.
	// Mode 0: simulated deposition thickness (Stage 7). Mode 1: SDF inflation (Stage 11).
	float2 ProfileSource = CushionMode == 1u
		? CushionInflation.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0)
		: MossThickness.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0);
	float Interior = CushionMode == 1u
		? max(0.0f, GrowthInteriorDistance.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0)) : ProfileSource.x;
	float MatureProfile = min(ProfileSource.y, ProfileSource.x * Biomass);
	float BulkHeight = (CushionHeight * ProfileSource.x + MatureHeight * MatureProfile) * (1.0f - 0.30f * Softness) * Plump;
	// Wet rim: SDF mode peaks at the cushion rim; deposition peaks at the taper.
	float Rim = CushionMode == 1u
		? exp(-pow((Interior / max(0.5f * TargetSize, 1e-6f) - 0.82f) * 5.0f, 2.0f))
		: exp(-pow((ProfileSource.x - 0.18f) * 5.0f, 2.0f)) * step(0.001f, ProfileSource.x);
	BulkHeight += CushionHeight * 0.18f * Softness * Plump * Rim;
	int CushionDim = max(1, int(round(1.0f / TargetSize)));
	float2 Warp = CurlDomainWarp(UV, CushionDim, 404u) * 0.25f;
	float2 WarpedUV = UV + Warp / float(CushionDim);
	float CoarseDetail = TileNoise(WarpedUV, CushionDim, 505u) - 0.5f;
	float Detail = MOSS_COARSE_RELIEF_FRACTION * CoarseDetail;
	if (ClumpDensity > 0.0f)
	{
		int ClumpDim = max(1, int(round(ClumpDensity)));
		float Clumps = MossCellDome(UV, ClumpDim, MOSS_CLUMP_SALT);
		float ClumpPresence = saturate(ClumpDensity);
		// Soft lobes merge and slump instead of staying hard beads.
		float FatClumps = lerp(Clumps, sqrt(max(Clumps, 0.0f)), saturate(Biomass + Softness * 0.5f));
		Detail += MOSS_CLUMP_RELIEF_FRACTION * ClumpPresence * (FatClumps - 0.5f) * (1.0f - 0.45f * Softness);
		BulkHeight += max(MatureHeight, 0.0f) * MatureProfile
			* ClumpPresence * FatClumps * MOSS_CLUMP_RELIEF_FRACTION * (1.0f - 0.35f * Softness) * Plump;
	}
	OutMesoHeight[Pixel] = BulkHeight * (1.0f + Detail);
}
#endif

// ============================================================================

// ============================================================================
// STAGE 3: Micro Shoots (resolution-independent) + Final Assembly
// ============================================================================
#if MOSS_STAGE == 3
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Pixel = int2(DispatchThreadId.xy); if (any(Pixel >= OutputSize)) return;
	float2 Texel = 1.0f / float2(OutputSize);
	float2 DestinationUV = (float2(Pixel) + 0.5f) * Texel;
	float2 UV = MixtormatGeneratorUV(DestinationUV);
	if (Preview != 0u)
	{
		float Value = 0.0f;
		if (Preview == 1u || Preview == 2u) { float2 AB = Chemical.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0); Value = Preview == 1u ? AB.x : AB.y; }
		else if (Preview == 3u) Value = ActivationHabitat.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0).r;
		else if (Preview == 4u) { FMossSimulationSample S = SampleMossSimulation(DestinationUV); Value = S.Maturity; }
		else if (Preview == 5u) Value = ActivationHabitat.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0).b;
		else if (Preview == 6u) Value = GrowthState.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0).z;
		OutGrowthHeight[Pixel] = saturate(Value); return;
	}
	float ColonyMask = GrowthCoverage.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0);
	float ColonyAge = GrowthAge.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0);
	float4 Hab = HabitatColony.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0);
	float Meso = MesoCushionHeight.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0);
	if (ColonyMask <= MOSS_EMPTY_B) { OutGrowthHeight[Pixel] = 0.0f; return; }
	if (ShootLength == 0.0f) { OutGrowthHeight[Pixel] = Meso * ColonyMask; return; }
	// FIX: resolution-independent shoot frequency (UV-space, not OutputSize-dependent)
	float ShootFreq = lerp(24.0f, 96.0f, saturate(ShootDensity));
	int ShootDim = max(1, int(round(ShootFreq)));
	float2 ShootUV = UV * float(ShootDim); int2 ShootCell = int2(floor(ShootUV));
	// Estimate placed pixel coverage in cell units, including upstream UV deformation.
	float2 DX = TorusDelta(UV, MixtormatGeneratorUV(DestinationUV + float2(Texel.x, 0))) * float(ShootDim);
	float2 DY = TorusDelta(UV, MixtormatGeneratorUV(DestinationUV + float2(0, Texel.y))) * float(ShootDim);
	float Footprint = max(length(DX + DY), length(DX - DY));
	float DetailAA = 1.0f - smoothstep(0.35f, 0.9f, Footprint);
	float ShootProfile = 0.0f;
	float TurgorMoisture = saturate(GrowthState.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0).w);
	float Plump = lerp(1.0f, 0.70f + 0.60f * TurgorMoisture, Plumpness);
	// Bounded width keeps the 3x3 neighbourhood sufficient even for broad tufts.
	float Thickness = max(FiberThickness, 0.0f);
	float WidthScale = lerp(MOSS_SHOOT_RADIUS_RANGE.x, MOSS_SHOOT_RADIUS_RANGE.y,
		Thickness / (1.0f + Thickness));
	[unroll] for (int sy = -1; sy <= 1; ++sy) [unroll] for (int sx = -1; sx <= 1; ++sx)
	{
		int2 Cell = ShootCell + int2(sx, sy);
		int2 Wrapped = (Cell % ShootDim + ShootDim) % ShootDim;
		// Unwrapped cell positions retain distinct periodic images on small lattices.
		float2 Root = float2(Cell) + Random22(Wrapped, 606u);
		float2 Offset = ShootUV - Root;
		[unroll] for (int Leaf = 0; Leaf < 3; ++Leaf)
		{
			uint Salt = 707u + uint(Leaf) * 131u;
			float2 Variation = Random22(Wrapped, Salt);
			float Angle = 6.283185307f * (Variation.x + float(Leaf) / 3.0f);
			float2 Axis = float2(cos(Angle), sin(Angle));
			float2 Across = float2(-Axis.y, Axis.x);
			float Length = lerp(0.32f, 0.65f, Variation.y);
			float U = dot(Offset, Axis) / Length;
			float T = saturate(U);
			float Bend = (Variation.x - 0.5f) * Length * T * (1.0f - T);
			float V = dot(Offset, Across) - Bend;
			float Width = max(1.0e-6f, WidthScale * Length * sin(3.141592654f * T));
			float Variance = (pow(dot(Across, DX), 2.0f) + pow(dot(Across, DY), 2.0f)) / 12.0f;
			float FilteredWidth = sqrt(Width * Width + Variance);
			float Blade = exp(-0.5f * V * V / (FilteredWidth * FilteredWidth)) * Width / FilteredWidth;
			float RibWidth = Width * 0.2f;
			float RibVariance = RibWidth * RibWidth + Variance + 1.0e-12f;
			float Midrib = exp(-0.5f * V * V / RibVariance) * RibWidth * rsqrt(RibVariance);
			float Envelope = smoothstep(0.0f, 0.2f, U) * (1.0f - smoothstep(0.75f, 1.0f, U));
			float Curl = lerp(0.5f, 1.0f, T * T) * lerp(0.7f, 1.0f, Variation.y);
			ShootProfile = max(ShootProfile, (Blade * 0.75f + Midrib * 0.25f) * Envelope * Curl);
		}
	}
	ShootProfile *= DetailAA;
	// Shoots fade at the cushion boundary: thickness taper (deposition) or interior distance (SDF).
	float EdgeFade = CushionMode == 1u
		? smoothstep(0.0f, 1.0f / float(ShootDim), max(0.0f, GrowthInteriorDistance.SampleLevel(LinearWrapSampler, DestinationUV, 0)))
		: smoothstep(0.02f, 0.35f, MossThickness.SampleLevel(LinearWrapSampler, DestinationUV, 0).x);
	float ShootHeightBudget = MOSS_SHOOT_RELIEF_FRACTION
		* (max(CushionHeight, 0.0f) + max(MatureHeight, 0.0f) * ColonyAge) * EdgeFade;
	float MicroRelief = ShootProfile * ShootLength * ShootHeightBudget * saturate(ColonyAge * 2.0f) * (1.0f - 0.45f * Softness) * Plump;
	MicroRelief *= lerp(0.75f, 1.0f, Hab.a);
	float CombinedHeight = (Meso + MicroRelief) * ColonyMask;
	OutGrowthHeight[Pixel] = CombinedHeight;
}
#endif

// ============================================================================
// STAGE 4: Growth Solver (moisture diffusion + biomass-pressure front)
// Habitat gates the front; moisture, maturity, competition and step cost shape it.
// ============================================================================
#if MOSS_STAGE == 4
// Solver step: Chemical.x moisture diffuses, is replenished from habitat supply
// (ActivationHabitat.a), and is depleted by biomass. The front advances by
// mature-biomass pressure, not uniform chance: diagonal steps cost sqrt(2),
// dry or young neighbours push weakly, and a cell touched by a foreign colony
// is pinched by Competition. GrowthState.w carries local moisture to shading.
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Pixel = int2(DispatchThreadId.xy); if (any(Pixel >= SimulationSize)) return;
	float2 Center = Chemical.Load(int3(Pixel, 0));
	float4 PreviousState = GrowthState.Load(int3(Pixel, 0));
	float4 HabitatField = ActivationHabitat.Load(int3(Pixel, 0));
	float LocalHabitat = HabitatField.g;
	float Supply = HabitatField.a;
	// Height-coupled moisture transport on the composite substrate height:
	// flux follows the downhill gradient, depressions retain (pool) moisture,
	// exposed highs drain. This replaces uniform isotropic diffusion.
	const int2 Card[4] = { int2(1,0), int2(-1,0), int2(0,1), int2(0,-1) };
	float2 SimTexel = 1.0f / float2(SimulationSize);
	float2 SimUV = (float2(Pixel) + 0.5f) * SimTexel;
	float HC = SubstrateHeight.SampleLevel(LinearWrapSampler, WrapUV(SimUV), 0);
	float WeightedSum = Center.x; float WeightTotal = 1.0f; float Drain = 0.0f;
	[unroll] for (int i = 0; i < 4; ++i)
	{
		int2 NP = WrapSimulationPixel(Pixel + Card[i]);
		float HN = SubstrateHeight.SampleLevel(LinearWrapSampler, WrapUV(SimUV + float2(Card[i]) * SimTexel), 0);
		float Drop = HC - HN; // >0: neighbour is downhill
		float W = 1.0f + 6.0f * saturate(Drop * 64.0f);
		WeightedSum += Chemical.Load(int3(NP, 0)).x * W; WeightTotal += W;
		Drain += saturate(-Drop * 64.0f);
	}
	float Pooling = saturate(1.0f - Drain * 0.25f); // local low: all neighbours higher
	float Diffused = lerp(Center.x, WeightedSum / WeightTotal, lerp(0.25f, 0.55f, Pooling));
	float Uptake = PreviousState.z * 0.025f * step(MOSS_ACTIVE_B, Center.y);
	float LocalMoisture = saturate(lerp(Diffused, Supply, 0.06f + 0.10f * Moisture + 0.15f * Pooling * Moisture) - Uptake);
	if (Center.y >= MOSS_ACTIVE_B)
	{
		float Grow = 1.0f - exp(-0.028f * (0.25f + 0.75f * LocalMoisture) * (0.40f + 0.60f * LocalHabitat));
		float Biomass = saturate(PreviousState.z + (1.0f - PreviousState.z) * Grow - (1.0f - LocalMoisture) * 0.002f * PreviousState.z);
		OutChemical[Pixel] = float2(LocalMoisture, Center.y);
		OutGrowthState[Pixel] = float4(PreviousState.x, PreviousState.y, Biomass, LocalMoisture);
		return;
	}
	const int2 Offsets[8] = { int2(1,0),int2(-1,0),int2(0,1),int2(0,-1),int2(1,1),int2(-1,1),int2(1,-1),int2(-1,-1) };
	uint FirstRoot = 0u; bool bForeignContact = false;
	[unroll] for (int Tap = 0; Tap < 8; ++Tap)
	{
		int2 Neighbor = WrapSimulationPixel(Pixel + Offsets[Tap]);
		if (Chemical.Load(int3(Neighbor, 0)).y < MOSS_ACTIVE_B) continue;
		uint Root = uint(max(GrowthState.Load(int3(Neighbor, 0)).y, 0.0f));
		if (Root == 0u) continue;
		if (FirstRoot == 0u) FirstRoot = Root; else if (Root != FirstRoot) bForeignContact = true;
	}
	float SeamPinch = lerp(1.0f, 0.30f, Competition * (bForeignContact ? 1.0f : 0.0f));
	float BestScore = 0.0f; uint BestRoot = 0u;
	[unroll] for (int Tap = 0; Tap < 8; ++Tap)
	{
		int2 Neighbor = WrapSimulationPixel(Pixel + Offsets[Tap]);
		float2 NeighborChemical = Chemical.Load(int3(Neighbor, 0));
		if (NeighborChemical.y < MOSS_ACTIVE_B) continue;
		float4 NeighborState = GrowthState.Load(int3(Neighbor, 0));
		if (NeighborState.y < 1.0f) continue;
		float StepCost = (Offsets[Tap].x != 0 && Offsets[Tap].y != 0) ? 1.41421356f : 1.0f;
		float Maturity = saturate(1.0f - max(NeighborState.x, 0.0f) / (float(GrowthIterations) + 1.0f));
		float Pressure = (0.30f + 0.70f * NeighborState.z) * (0.45f + 0.55f * Maturity) * (0.40f + 0.60f * saturate(NeighborState.w));
		float Chance = saturate((0.20f + 0.80f * LocalHabitat) * (0.35f + 0.65f * LocalMoisture)
			* lerp(0.30f, 1.0f, GrowthSpread) * (0.35f + 0.65f * Pressure) / StepCost * SeamPinch + 0.03f);
		float Roll = Random21(Pixel + int2(IterationIndex * 7919, 0), 12345u + uint(Tap));
		if (Roll > Chance) continue;
		float Score = Pressure * (0.50f + 0.50f * LocalHabitat);
		if (Score > BestScore) { BestScore = Score; BestRoot = uint(NeighborState.y); }
	}
	if (BestRoot != 0u)
	{
		float NewB = lerp(0.15f, 0.5f, saturate(LocalHabitat * (0.5f + 0.5f * LocalMoisture)));
		OutChemical[Pixel] = float2(LocalMoisture, NewB);
		OutGrowthState[Pixel] = float4(float(IterationIndex + 1u), float(BestRoot), 0.05f, LocalMoisture);
	}
	else
	{
		// Uncolonized cells still diffuse moisture ahead of the front (pre-wetting).
		OutChemical[Pixel] = float2(LocalMoisture, Center.y);
		OutGrowthState[Pixel] = float4(PreviousState.x, PreviousState.y, PreviousState.z, LocalMoisture);
	}
}
#endif

// ============================================================================

// ============================================================================
// STAGE 5: Resolve Growth Fields
// ============================================================================
#if MOSS_STAGE == 5
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Pixel = int2(DispatchThreadId.xy); if (any(Pixel >= OutputSize)) return;
	float2 DestinationUV = (float2(Pixel) + 0.5f) / float2(OutputSize);
	FMossSimulationSample Simulation = SampleMossSimulation(DestinationUV);
	float ResolvedCoverage = ResolveMossCoverage(Simulation.Concentrations.y);
	float ResolvedAge = ResolvedCoverage > 0.0f ? Simulation.CoveredAge : 0.0f;
	uint ResolvedId = ResolvedCoverage > 0.0f ? Simulation.ColonyId : MIXTORMAT_INVALID_REGION;
	float Habitat = ActivationHabitat.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0).g;
	OutHabitatColony[Pixel] = float4(ResolvedCoverage, ResolvedAge, 0.0f, Habitat);
	OutGrowthCoverage[Pixel] = ResolvedCoverage;
	OutGrowthAge[Pixel] = ResolvedAge;
	OutGrowthIds[Pixel] = ResolvedId;
}
#endif

// ============================================================================
// STAGES 6-7: Deposition thickness PDE (CushionMode=0)
// Thickness grows logistically toward a biomass/habitat carrying capacity,
// creeps laterally (rate scales with CushionSize + Softness) and slumps where
// total height (substrate + moss) exceeds the angle of repose. Edges taper
// from the PDE itself; no distance field is computed.
// ============================================================================
#if MOSS_STAGE == 6
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Pixel = int2(DispatchThreadId.xy); if (any(Pixel >= SimulationSize)) return;
	float B = Chemical.Load(int3(Pixel, 0)).y;
	float Biomass = saturate(GrowthState.Load(int3(Pixel, 0)).z);
	float T = ResolveMossCoverage(B) > 0.0f ? 0.05f * (0.25f + 0.75f * Biomass) : 0.0f;
	OutMossThickness[Pixel] = float2(T, T * Biomass);
}
#elif MOSS_STAGE == 7
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Pixel = int2(DispatchThreadId.xy); if (any(Pixel >= SimulationSize)) return;
	float2 Texel = 1.0f / float2(SimulationSize);
	float2 UV = (float2(Pixel) + 0.5f) * Texel;
	float B = Chemical.Load(int3(Pixel, 0)).y;
	float4 State = GrowthState.Load(int3(Pixel, 0));
	float Biomass = saturate(State.z);
	float Habitat = saturate(ActivationHabitat.Load(int3(Pixel, 0)).g);
	bool Covered = ResolveMossCoverage(B) > 0.0f;
	float T = MossThickness.Load(int3(Pixel, 0)).x;
	float HeightBudget = max(CushionHeight + MatureHeight, 1e-6f);
	float HC = SubstrateHeight.SampleLevel(LinearWrapSampler, WrapUV(UV), 0);
	float TotalC = HC + T * HeightBudget;
	// Carrying capacity: wet, mature, sheltered interiors grow thickest.
	float K = Covered ? saturate((0.30f + 0.70f * Biomass) * (0.45f + 0.55f * Habitat)
		* lerp(1.0f, 0.70f + 0.60f * saturate(State.w), Plumpness)) : 0.0f;
	float Creep = saturate(0.08f + CushionSize * 1.6f + Softness * 0.18f);
	float NeighborSum = 0.0f; float Slump = 0.0f;
	const int2 Card[4] = { int2(1,0), int2(-1,0), int2(0,1), int2(0,-1) };
	[unroll] for (int i = 0; i < 4; ++i)
	{
		int2 NP = WrapSimulationPixel(Pixel + Card[i]);
		float TN = MossThickness.Load(int3(NP, 0)).x;
		bool CoveredN = ResolveMossCoverage(Chemical.Load(int3(NP, 0)).y) > 0.0f;
		NeighborSum += (CoveredN || TN > 0.0f) ? TN : T; // no leak into bare substrate
		float HN = SubstrateHeight.SampleLevel(LinearWrapSampler, WrapUV(UV + float2(Card[i]) * Texel), 0);
		// Thermal slump: shed thickness downhill above repose slope of total height.
		Slump += max(0.0f, (TotalC - (HN + TN * HeightBudget)) - 0.004f);
	}
	float NewT = T + (K - T) * (Covered ? 0.10f : 0.0f);       // logistic-style growth/decay
	NewT = lerp(NewT, NeighborSum * 0.25f, Creep * 0.45f);     // lateral creep
	NewT = saturate(NewT - Slump * 0.20f);                     // angle-of-repose slump
	if (!Covered) NewT *= 0.90f;                               // halo decay outside footprint
	OutMossThickness[Pixel] = float2(NewT, NewT * Biomass);
}
// ============================================================================
// STAGES 8-11: Legacy SDF cushion (CushionMode=1) — boundary seeds, Jump-Flood,
// interior distance -> dome inflation, boundary-constrained smoothing.
// ============================================================================
#elif MOSS_STAGE == 8
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Pixel = int2(DispatchThreadId.xy); if (any(Pixel >= SimulationSize)) return;
	float2 UV = (float2(Pixel) + 0.5f) / float2(SimulationSize);
	float B = Chemical.Load(int3(Pixel, 0)).y;
	if (ResolveMossCoverage(B) <= 0.0f) { OutHeightSeeds[Pixel] = UV; return; }
	float2 BestSeed = float2(-1, -1); float BestDistanceSquared = 1e20f;
	[unroll] for (int Y = -1; Y <= 1; ++Y) [unroll] for (int X = -1; X <= 1; ++X)
	{
		if (X == 0 && Y == 0) continue;
		int2 Offset = int2(X, Y);
		float NeighborB = Chemical.Load(int3(WrapSimulationPixel(Pixel + Offset), 0)).y;
		if (ResolveMossCoverage(NeighborB) > 0.0f) continue;
		float T = saturate((B - MossCoverageThreshold()) / max(B - NeighborB, 1e-8f));
		float2 Delta = float2(Offset) * T / float2(SimulationSize);
		float DistanceSquared = dot(Delta, Delta);
		if (DistanceSquared < BestDistanceSquared) { BestDistanceSquared = DistanceSquared; BestSeed = frac(UV + Delta); }
	}
	OutHeightSeeds[Pixel] = BestSeed;
}
#elif MOSS_STAGE == 9
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Pixel = int2(DispatchThreadId.xy); if (any(Pixel >= SimulationSize)) return;
	float2 UV = (float2(Pixel) + 0.5f) / float2(SimulationSize);
	float2 BestSeed = float2(-1, -1); float BestDistanceSquared = 1e20f;
	[unroll] for (int Y = -1; Y <= 1; ++Y) [unroll] for (int X = -1; X <= 1; ++X)
	{
		int2 Tap = WrapSimulationPixel(Pixel + int2(X, Y) * HeightJump);
		float2 Candidate = HeightSeeds.Load(int3(Tap, 0)); if (any(Candidate < 0.0f)) continue;
		float2 Delta = TorusDelta(UV, Candidate); float DistanceSquared = dot(Delta, Delta);
		if (DistanceSquared < BestDistanceSquared) { BestDistanceSquared = DistanceSquared; BestSeed = Candidate; }
	}
	OutHeightSeeds[Pixel] = BestSeed;
}
#elif MOSS_STAGE == 10
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Pixel = int2(DispatchThreadId.xy); if (any(Pixel >= SimulationSize)) return;
	float InteriorDistance = 0.0f;
	if (ResolveMossCoverage(Chemical.Load(int3(Pixel, 0)).y) > 0.0f)
	{
		float2 UV = (float2(Pixel) + 0.5f) / float2(SimulationSize);
		float2 Nearest = HeightSeeds.Load(int3(Pixel, 0));
		InteriorDistance = any(Nearest < 0.0f) ? length(float2(1,1)) : length(TorusDelta(UV, Nearest));
	}
	OutGrowthInteriorDistance[Pixel] = InteriorDistance;
	float Radius = 0.5f * max(CushionSize, 1e-6f);
	float T = saturate(InteriorDistance / Radius);
	float Dome = sqrt(saturate(T * (2.0f - T)));
	float Profile = pow(Dome, 1.0f - 0.55f * Softness) * (0.7f + 0.3f * T);
	float4 SolverState = GrowthState.Load(int3(Pixel, 0));
	Profile *= lerp(1.0f, 0.70f + 0.60f * saturate(SolverState.w), Plumpness);
	OutCushionInflation[Pixel] = float2(Profile, Profile * SolverState.z);
}
#elif MOSS_STAGE == 11
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Pixel = int2(DispatchThreadId.xy); if (any(Pixel >= SimulationSize)) return;
	float Distance = GrowthInteriorDistance.Load(int3(Pixel, 0));
	if (Distance <= 0.0f) { OutCushionInflation[Pixel] = 0.0f; return; }
	float2 UV = (float2(Pixel) + 0.5f) / float2(SimulationSize);
	float Radius = 0.5f * max(CushionSize, 1e-6f);
	float Support = MOSS_SMOOTH_RADIUS_FRACTION * (0.60f + 0.90f * Softness) * min(Radius, Distance);
	const float Kernel[5] = {1,4,6,4,1}; float2 Smoothed = 0; float WeightSum = 0;
	[unroll] for (int Y = -2; Y <= 2; ++Y) [unroll] for (int X = -2; X <= 2; ++X)
	{
		float TapWeight = Kernel[X+2] * Kernel[Y+2];
		float2 TapUV = WrapUV(UV + float2(X,Y) * (Support * 0.5f));
		Smoothed += CushionInflation.SampleLevel(LinearWrapSampler, TapUV, 0) * TapWeight; WeightSum += TapWeight;
	}
	OutCushionInflation[Pixel] = Smoothed / WeightSum;
}
#endif

// ============================================================================
// STAGE 12: Material — age/moisture color ramp, wet/dry roughness, and
// tufted arc-blade detail normals (normals only; height stays Stage 3).
// Tufts: 2 rows x 5 blades in a root arc sector per shoot cell, fan blades
// bend outward, per-colony variation from GrowthIds. Blade selection by
// strongest coverage, then normalized normal blending.
// ============================================================================
#if MOSS_STAGE == 12
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Pixel = int2(DispatchThreadId.xy); if (any(Pixel >= OutputSize)) return;
	float2 Texel = 1.0f / float2(OutputSize);
	float2 DestinationUV = (float2(Pixel) + 0.5f) * Texel;
	float2 UV = MixtormatGeneratorUV(DestinationUV);
	float CoverageValue = GrowthCoverage.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0);
	float Age = GrowthAge.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0);
	uint ColonyId = GrowthIds.Load(int3(Pixel, 0));
	float MoistureField = saturate(GrowthState.SampleLevel(LinearWrapSampler, WrapUV(DestinationUV), 0).w);
	float IdHash = Random21(int2(int(ColonyId % 4096u), int(ColonyId / 4096u)), 991u);
	// Color: ramp over age/moisture, per-colony hue shift, wet darkening.
	float RampX = saturate(Age * 0.65f + MoistureField * 0.35f + (IdHash - 0.5f) * 0.12f);
	float3 Color = MixtormatEvalColorRamp(RampX, ColorRampCount, ColorRampInterpolation,
		ColorRampPositions, ColorRampColors).rgb;
	Color *= 1.0f - 0.35f * MoistureField;
	Color *= 0.9f + 0.2f * IdHash;
	float Roughness = saturate(lerp(DryRoughness, WetRoughness, MoistureField) + (IdHash - 0.5f) * 0.16f);
	OutMossColor[Pixel] = float4(max(Color, 0.0f), 1.0f);
	OutMossRAM[Pixel] = float4(Roughness, 1.0f, 0.0f, 0.04f);
	OutMossRoughness[Pixel] = Roughness;
	// Tufted arc-blade detail normal.
	float3 Normal = float3(0, 0, 1);
	if (CoverageValue > 0.001f && ShootLength > 0.0f)
	{
		float ShootFreq = lerp(24.0f, 96.0f, saturate(ShootDensity));
		int ShootDim = max(1, int(round(ShootFreq)));
		float2 ShootUV = UV * float(ShootDim);
		int2 BaseCell = int2(floor(ShootUV));
		float3 NormalSum = float3(0, 0, 0); float WeightSum = 0.0f;
		[unroll] for (int CY = -1; CY <= 1; ++CY) [unroll] for (int CX = -1; CX <= 1; ++CX)
		{
			int2 Cell = BaseCell + int2(CX, CY);
			int2 Wrapped = (Cell % ShootDim + ShootDim) % ShootDim;
			float2 TuftRandom = Random22(Wrapped, 606u);
			float2 Root = float2(Cell) + 0.25f + 0.5f * TuftRandom;
			float TuftAngle = 6.283185307f * TuftRandom.x;
			[unroll] for (int Blade = 0; Blade < 5; ++Blade)
			{
				float Slot = (float(Blade) + 0.5f) / 5.0f;
				float FanSide = 2.0f * Slot - 1.0f;
				float2 BladeRandom = Random22(Wrapped, 707u + uint(Blade) * 131u);
				float Angle = TuftAngle + FanSide * 0.9f + (BladeRandom.x - 0.5f) * 0.5f;
				float2 Along = float2(cos(Angle), sin(Angle));
				float2 Across = float2(-Along.y, Along.x);
				float Length = lerp(0.35f, 0.7f, BladeRandom.y);
				float2 Offset = ShootUV - Root;
				float U = dot(Offset, Along) / Length;
				if (U <= 0.0f || U >= 1.0f) continue;
				// Arc bend outward: blade centerline curves away from tuft center.
				float ArcBend = FanSide * (0.25f + 0.45f * Softness) * Length;
				float V = dot(Offset, Across) - ArcBend * U * U;
				float Width = max(0.06f, lerp(0.12f, 0.65f, FiberThickness / (1.0f + FiberThickness)) * Length * sin(3.141592654f * saturate(U)));
				float Mark = 1.0f - smoothstep(Width * 0.7f, Width, abs(V));
				if (Mark <= 0.0f) continue;
				// Analytic blade normal: across ridge slope + along arc slope.
				float AcrossSlope = (V / Width) * 1.4f;
				float AlongSlope = ArcBend * 2.0f * U / Length + lerp(0.15f, 0.65f, U);
				float3 BladeNormal = normalize(float3(Across * -AcrossSlope + Along * AlongSlope, 1.0f));
				float Weight = Mark * (0.4f + 0.6f * U);
				NormalSum += BladeNormal * Weight; WeightSum += Weight;
			}
		}
		if (WeightSum > 0.0f)
		{
			float Strength = saturate(CoverageValue * 2.0f) * NormalStrength * saturate(ShootLength * 2.0f);
			Normal = normalize(lerp(float3(0, 0, 1), normalize(NormalSum / WeightSum), saturate(Strength)));
		}
	}
	OutMossNormal[Pixel] = float4(Normal * 0.5f + 0.5f, 1.0f);
}
#endif
