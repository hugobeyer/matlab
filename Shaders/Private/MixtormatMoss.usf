static const float3 MOSS_DEAD_BROWN = float3(0.34f, 0.22f, 0.085f);
static const float3 MOSS_HUMUS_BASE = float3(0.032f, 0.028f, 0.014f);
static const float MOSS_SHOOT_FLOW_JITTER = 0.55f;
static const float2 MOSS_SHOOT_AA_RANGE = float2(0.45f, 1.05f);

int2 WrapSim(int2 P)
{
	return (P % SimulationSize + SimulationSize) % SimulationSize;
}

uint Hash21(int2 P, uint Salt)
{
	uint H = uint(P.x) * 374761393u + uint(P.y) * 668265263u + (Seed + Salt) * 2246822519u;
	H = (H ^ (H >> 13u)) * 1274126177u;
	return H ^ (H >> 16u);
}

float Random21(int2 P, uint Salt)
{
	return float(Hash21(P, Salt) & 0x00ffffffu) / 16777215.0f;
}

float2 Random22(int2 P, uint Salt)
{
	uint H0 = Hash21(P, Salt);
	uint H1 = Hash21(P, Salt + 1013u);
	return float2(float(H0 & 0x00ffffffu), float(H1 & 0x00ffffffu)) / 16777215.0f;
}

float TileNoise(float2 UV, int Period, uint Salt)
{
	int SafePeriod = max(Period, 1);
	float2 G = frac(UV) * float(SafePeriod);
	int2 I = int2(floor(G));
	float2 F = frac(G);
	float2 U = F * F * (3.0f - 2.0f * F);
	int2 I00 = (I % SafePeriod + SafePeriod) % SafePeriod;
	int2 I10 = ((I + int2(1, 0)) % SafePeriod + SafePeriod) % SafePeriod;
	int2 I01 = ((I + int2(0, 1)) % SafePeriod + SafePeriod) % SafePeriod;
	int2 I11 = ((I + int2(1, 1)) % SafePeriod + SafePeriod) % SafePeriod;
	float A = Random21(I00, Salt);
	float B = Random21(I10, Salt);
	float C = Random21(I01, Salt);
	float D = Random21(I11, Salt);
	return lerp(lerp(A, B, U.x), lerp(C, D, U.x), U.y);
}

float2 TorusDelta(float2 From, float2 To)
{
	return frac(To - From + 0.5f) - 0.5f;
}

int MossShootPeriod()
{
	float BaseFreq = lerp(112.0f, 420.0f, saturate(ShootDensity));
	return clamp(int(round(BaseFreq / max(LeafScale, 0.1f))), 16, 1024);
}

float3 MossShootFlow(float2 DestinationUV, float2 JX, float2 JY)
{
	float2 Texel = 1.0f / float2(max(OutputSize, int2(1, 1)));
	float M0 = MesoCushionHeight.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f);
	float MX = MesoCushionHeight.SampleLevel(LinearWrapSampler, DestinationUV + float2(Texel.x, 0.0f), 0.0f) - M0;
	float MY = MesoCushionHeight.SampleLevel(LinearWrapSampler, DestinationUV + float2(0.0f, Texel.y), 0.0f) - M0;
	float2 CushionGrad = float2(MX, MY) * float2(OutputSize);
	float4 State = GrowthState.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f);
	float2 RootVec = TorusDelta(State.zw, DestinationUV);
	float2 Combined = -CushionGrad * 1.6f + RootVec * 6.0f;
	float Mag = length(Combined);
	float2 Dir = Mag > 1e-4f ? (Combined / Mag) : float2(1.0f, 0.0f);
	return float3(Dir, saturate(Mag * 1.5f));
}

float MossTuftAngle(float3 Flow, float Random01)
{
	float FlowAngle = atan2(Flow.y, Flow.x);
	float RandomAngle = (Random01 * 2.0f - 1.0f) * 3.14159265359f;
	float Align = (GrowthForm == 1u) ? saturate(0.55f + 0.35f * Flow.z) : saturate(Flow.z * 0.65f);
	return lerp(RandomAngle, FlowAngle + (Random01 - 0.5f) * 0.85f, Align);
}

#include "/Plugin/Mixtormat/Private/MixtormatMossLeaves.ush"

// -----------------------------------------------------------------------------
// Compute MainCS by MOSS_STAGE
// -----------------------------------------------------------------------------
[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
#if MOSS_STAGE == 0
	// Stage 0: Resolution-Invariant Multiscale Substrate Analysis
	// R = Cavity (fine + meso concave crevice / mortar joint / bark fissure trap)
	// G = Shelter (smooth multiscale ambient occlusion & recess, free of 8px/16px ring echoes)
	// B = Directional Gravitational Shelf Suitability (1 = upward shelf catching water/spores, 0 = overhang)
	// A = Ridge Exposure (convex peaks & sharp exposed edges)
	int2 P = int2(DispatchThreadId.xy);
	if (any(P >= SimulationSize)) { return; }

	float2 DestinationUV = (float2(P) + 0.5f) / float2(SimulationSize);
	float H0 = SubstrateHeight.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f);

	// Gravitational downhill axis in destination UV space (-90 deg = +Y downward in UV)
	float GravRad = SlopeAngle * (3.14159265359f / 180.0f);
	float2 DownhillDir = float2(cos(GravRad), -sin(GravRad));

	const float Radii[4] = { 0.0022f, 0.0068f, 0.019f, 0.048f };
	const float RingWeights[4] = { 0.34f, 0.30f, 0.22f, 0.14f };

	float Jitter = Random21(P, 19u) * 6.283185307f;
	float CavitySum = 0.0f;
	float ShelterSum = 0.0f;
	float RidgeSum = 0.0f;
	float2 GradAccum = float2(0.0f, 0.0f);

	[unroll]
	for (int Ring = 0; Ring < 4; ++Ring)
	{
		float Radius = Radii[Ring];
		float RingAvg = 0.0f;
		float RingPosDiff = 0.0f;
		float2 RingGrad = float2(0.0f, 0.0f);

		[unroll]
		for (int Tap = 0; Tap < 8; ++Tap)
		{
			float Angle = (float(Tap) + float(Ring) * 0.375f) * (6.283185307f / 8.0f) + Jitter * 0.18f;
			float2 Dir = float2(cos(Angle), sin(Angle));
			float HTap = SubstrateHeight.SampleLevel(LinearWrapSampler, DestinationUV + Dir * Radius, 0.0f);
			float Diff = HTap - H0;
			RingAvg += HTap * 0.125f;
			RingPosDiff += max(0.0f, Diff) * 0.125f;
			RingGrad += Dir * (Diff / max(Radius, 1e-4f)) * 0.25f;
		}

		float Concave = max(0.0f, RingAvg - H0);
		float Convex = max(0.0f, H0 - RingAvg);
		float NormScale = 1.0f / (0.016f + Radius * 1.5f);

		float CavWeight = (Ring < 2) ? 0.65f : 0.20f;
		CavitySum += tanh(Concave * NormScale * 1.85f) * CavWeight;
		ShelterSum += tanh(RingPosDiff * NormScale * 1.45f) * RingWeights[Ring];
		RidgeSum += tanh(Convex * NormScale * 1.75f) * RingWeights[Ring];

		if (Ring < 2)
		{
			GradAccum += RingGrad * (Ring == 0 ? 0.6f : 0.4f);
		}
	}

	float Cavity = saturate(CavitySum * 1.15f);
	float Shelter = saturate(ShelterSum * 1.35f + Cavity * 0.25f);
	float Ridge = saturate(RidgeSum * 1.25f);

	// Directional Gravitational Slope Suitability:
	// Upward-facing shelves where height drops along DownhillDir (dot(GradAccum, DownhillDir) < 0)
	// catch water and spores; steep underside overhangs shed them.
	float SignedDownhillGrad = dot(GradAccum, DownhillDir);
	float Steepness = length(GradAccum);
	float ShelfSignal = tanh(-SignedDownhillGrad * 0.85f);
	float FlatSignal = exp(-Steepness * 0.35f);
	float GravSuitability = saturate(0.5f + 0.42f * ShelfSignal + 0.18f * (FlatSignal - 0.5f));

	OutSubstrateAnalysis[P] = float4(Cavity, Shelter, GravSuitability, Ridge);

#elif MOSS_STAGE == 1
	// Stage 1: Colony Seeding & Habitat Initialization
	// Supports SeedMode:
	//   0 = Combined (Habitat & Colonies)
	//   1 = Crevices & Shelter
	//   2 = Colony Scatter
	int2 P = int2(DispatchThreadId.xy);
	if (any(P >= SimulationSize)) { return; }

	float2 DestinationUV = (float2(P) + 0.5f) / float2(SimulationSize);
	float2 UV = MixtormatGeneratorUV(DestinationUV);
	float4 Analysis = SubstrateAnalysis.Load(int3(P, 0));

	float Cavity = Analysis.x;
	float Shelter = Analysis.y;
	float GravShelf = Analysis.z;
	float Ridge = Analysis.w;

	// Directional gravitational slope response
	float GravBias = lerp(1.0f, saturate(GravShelf * 1.65f), saturate(SurfaceAnglePreference));
	float OverhangPenalty = saturate((0.45f - GravShelf) * 2.2f) * saturate(SurfaceAnglePreference);

	int Cells = max(1, ColonyDensity);
	float3 PatchFbm;
		MixtormatNoiseFbm(UV, max(2, Cells / 2), 3, 0.5f, 2.0f, Seed + 71u, PatchFbm.x, PatchFbm.yz);
	float PatchVar = PatchFbm.x * 0.5f + 0.5f;

	float Favor = 0.24f
		+ Cavity * saturate(CavityAttraction) * 0.85f
		+ Shelter * saturate(OcclusionInfluence) * 0.70f
		+ saturate(Moisture) * (0.35f + 0.30f * Shelter + 0.20f * Cavity)
		+ (GravShelf - 0.45f) * saturate(SurfaceAnglePreference) * 0.65f
		+ (PatchVar - 0.5f) * 0.20f;

	float ExposurePenalty = Ridge * (1.0f - saturate(ExposureTolerance)) * 0.78f + OverhangPenalty * 0.65f;
	float Habitat = saturate((Favor - ExposurePenalty) * GravBias);

	// Periodic Voronoi colony nuclei
	float2 Grid = frac(UV) * float(Cells);
	int2 BaseCell = int2(floor(Grid));
	float BestDist = 1e9f;
	float2 BestRootUV = frac(UV);
	int2 BestWrapped = int2(0, 0);

	[unroll]
	for (int Y = -1; Y <= 1; ++Y)
	{
		[unroll]
		for (int X = -1; X <= 1; ++X)
		{
			int2 Cell = BaseCell + int2(X, Y);
			int2 Wrapped = (Cell % Cells + Cells) % Cells;
			float2 Jitter = Random22(Wrapped, 101u);
			float2 Center = float2(Cell) + 0.15f + Jitter * 0.70f;
			float Dist = length(Grid - Center);
			if (Dist < BestDist)
			{
				BestDist = Dist;
				BestWrapped = Wrapped;
				BestRootUV = frac((float2(Wrapped) + 0.15f + Jitter * 0.70f) / float(Cells));
			}
		}
	}

	float CellRoll = Random21(BestWrapped, 211u);
	float ColonyRadius = lerp(0.18f, 0.44f, saturate(Coverage));
	float ColonyCore = saturate(1.0f - smoothstep(ColonyRadius * 0.35f, ColonyRadius, BestDist));
	float ActiveThresh = saturate(Coverage * 0.82f + Habitat * 0.45f);
	float ColonyActive = smoothstep(1.0f - ActiveThresh, 1.0f - ActiveThresh + 0.25f, 1.0f - CellRoll);
	float ColonySeed = ColonyCore * ColonyActive;

	// Crevice & Shelter direct nucleation (mortar joints, rock cracks, bark furrows, upward ledges)
	float CreviceSignal = Cavity * saturate(CavityAttraction) * 0.78f
		+ Shelter * saturate(OcclusionInfluence) * 0.48f
		+ max(0.0f, GravShelf - 0.5f) * saturate(SurfaceAnglePreference) * 0.68f;
	float3 FineNoise;
		MixtormatNoiseFbm(UV, max(6, Cells * 2), 3, 0.5f, 2.0f, Seed + 313u, FineNoise.x, FineNoise.yz);
	float CreviceThresh = lerp(0.60f, 0.12f, saturate(Coverage));
	float HabitatSeed = smoothstep(CreviceThresh, CreviceThresh + 0.18f, CreviceSignal + FineNoise.x * 0.18f);

	float ProcSeed = 0.0f;
	if (SeedMode == 1u)
	{
		// Crevices & Shelter
		ProcSeed = saturate(HabitatSeed * 1.15f + ColonySeed * Habitat * 0.25f);
	}
	else if (SeedMode == 2u)
	{
		// Colony Scatter
		ProcSeed = saturate(ColonySeed * lerp(0.55f, 1.15f, Habitat));
	}
	else
	{
		// Combined (Habitat & Colonies)
		ProcSeed = max(ColonySeed * lerp(0.45f, 1.1f, Habitat), HabitatSeed * 0.95f);
	}

	// Pioneer spore splatter around suitable micro-pockets
	if (Splatter > 0.001f)
	{
		FMixtormatNoiseWorley SporeWorley = MixtormatNoiseV2Worley(UV, max(14, Cells * 3), Seed + 509u, 1.0f, 0);
		float SporeDot = saturate(1.0f - SporeWorley.F1 * lerp(3.4f, 1.75f, saturate(Splatter)));
		float SporeGate = smoothstep(0.30f, 0.70f, Habitat + FineNoise.x * 0.22f);
		ProcSeed = max(ProcSeed, SporeDot * SporeGate * saturate(Splatter) * 0.85f);
	}

	if (HasSeedMask != 0u)
	{
		float2 MaskUV = frac(UV * max(1.0f, SeedMaskTiling));
		float MaskVal = SeedMask.SampleLevel(LinearWrapSampler, MaskUV, 0.0f).r;
		if (bSeedMaskInvert != 0u) { MaskVal = 1.0f - MaskVal; }
		ProcSeed *= saturate(MaskVal);
	}

	float InitialB = saturate(ProcSeed);
	float InitialA = saturate(Habitat * 0.78f + saturate(Moisture) * 0.22f);
	float InitialArrival = InitialB > 0.08f ? 0.0f : 1.0f;
	float InitialBiomass = InitialB * saturate(0.45f + 0.55f * Habitat);

	OutChemical[P] = float2(InitialA, InitialB);
	OutGrowthState[P] = float4(InitialArrival, InitialBiomass, BestRootUV.x, BestRootUV.y);
	OutActivationHabitat[P] = float4(InitialB * InitialA, Habitat, GravShelf, Cavity);

#elif MOSS_STAGE == 4
	// Stage 4: Colony-Front Reaction-Diffusion & Competition Step
	int2 P = int2(DispatchThreadId.xy);
	if (any(P >= SimulationSize)) { return; }

	float2 CenterChem = Chemical.Load(int3(P, 0));
	float4 CenterState = GrowthState.Load(int3(P, 0));
	float4 ActHab = ActivationHabitat.Load(int3(P, 0));
	float Habitat = ActHab.y;

	const int2 Offsets[8] = {
		int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1),
		int2(-1, -1), int2(1, -1), int2(-1, 1), int2(1, 1)
	};
	const float Weights[8] = {
		0.16f, 0.16f, 0.16f, 0.16f,
		0.09f, 0.09f, 0.09f, 0.09f
	};

	float2 AvgChem = float2(0.0f, 0.0f);
	float AvgArrival = 0.0f;
	float AvgBiomass = 0.0f;
	float ForeignCover = 0.0f;
	float2 BestRoot = CenterState.zw;
	float BestCover = CenterChem.y;

	[unroll]
	for (int I = 0; I < 8; ++I)
	{
		int2 NP = WrapSim(P + Offsets[I]);
		float2 NC = Chemical.Load(int3(NP, 0));
		float4 NS = GrowthState.Load(int3(NP, 0));
		AvgChem += NC * Weights[I];
		AvgArrival += NS.x * Weights[I];
		AvgBiomass += NS.y * Weights[I];

		float RootDist = length(TorusDelta(CenterState.zw, NS.zw));
		if (RootDist > 0.002f && NC.y > 0.05f && CenterChem.y > 0.05f)
		{
			ForeignCover += NC.y * Weights[I];
		}
		if (NC.y > BestCover + 0.02f)
		{
			BestCover = NC.y;
			BestRoot = NS.zw;
		}
	}

	float SpreadSpeed = lerp(0.35f, 1.35f, saturate(GrowthSpread));
	float Inhibition = saturate(1.0f - ForeignCover * saturate(Competition) * 2.15f);

	float NewA = saturate(lerp(CenterChem.x, AvgChem.x, 0.32f) + (Habitat - 0.44f) * 0.035f);
	float GrowthDrive = (Habitat - lerp(0.58f, 0.15f, saturate(Coverage))) * SpreadSpeed * Inhibition;
	float DiffusedB = lerp(CenterChem.y, AvgChem.y, 0.28f * SpreadSpeed);
	float NewB = saturate(DiffusedB + GrowthDrive * 0.065f * (0.25f + 0.75f * AvgChem.y) - ForeignCover * saturate(Competition) * 0.04f);

	float StepNorm = float(IterationIndex + 1u) / float(max(1u, GrowthIterations));
	float NewArrival = CenterState.x;
	if (CenterChem.y <= 0.15f && NewB > 0.15f)
	{
		NewArrival = min(CenterState.x, StepNorm);
	}
	else if (NewB > 0.15f)
	{
		NewArrival = min(CenterState.x, AvgArrival + 1.0f / float(max(1u, GrowthIterations)));
	}

	float Maturity = saturate(1.0f - NewArrival);
	float TargetBiomass = NewB * saturate(0.35f + 0.65f * Maturity) * Inhibition * lerp(0.55f, 1.15f, Habitat);
	float NewBiomass = saturate(lerp(CenterState.y, TargetBiomass, 0.20f));

	OutChemical[P] = float2(NewA, NewB);
	OutGrowthState[P] = float4(NewArrival, NewBiomass, BestRoot.x, BestRoot.y);

#elif MOSS_STAGE == 8
	// Stage 8: Jump-Flood Boundary Seed Init on Simulation Grid
	int2 P = int2(DispatchThreadId.xy);
	if (any(P >= SimulationSize)) { return; }

	float2 Chem = Chemical.Load(int3(P, 0));
	float4 State = GrowthState.Load(int3(P, 0));
	bool bInside = Chem.y >= 0.20f;
	bool bBoundary = false;

	const int2 Offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
	[unroll]
	for (int I = 0; I < 4; ++I)
	{
		int2 NP = WrapSim(P + Offsets[I]);
		float2 NC = Chemical.Load(int3(NP, 0));
		float4 NS = GrowthState.Load(int3(NP, 0));
		bool bNInside = NC.y >= 0.20f;
		float RootDist = length(TorusDelta(State.zw, NS.zw));
		if (bNInside != bInside || (bInside && bNInside && RootDist > 0.002f && Competition > 0.15f))
		{
			bBoundary = true;
		}
	}

	float2 SeedUV = (float2(P) + 0.5f) / float2(SimulationSize);
	OutHeightSeeds[P] = bBoundary ? SeedUV : float2(-1.0f, -1.0f);

#elif MOSS_STAGE == 9
	// Stage 9: Jump-Flood Step on Simulation Grid
	int2 P = int2(DispatchThreadId.xy);
	if (any(P >= SimulationSize)) { return; }

	float2 MyUV = (float2(P) + 0.5f) / float2(SimulationSize);
	float2 BestSeed = HeightSeeds.Load(int3(P, 0));
	float BestDistSq = 1e30f;
	if (BestSeed.x >= 0.0f)
	{
		float2 D = TorusDelta(MyUV, BestSeed);
		BestDistSq = dot(D, D);
	}

	int Step = max(1, HeightJump);
	[unroll]
	for (int Y = -1; Y <= 1; ++Y)
	{
		[unroll]
		for (int X = -1; X <= 1; ++X)
		{
			int2 NP = WrapSim(P + int2(X, Y) * Step);
			float2 Cand = HeightSeeds.Load(int3(NP, 0));
			if (Cand.x >= 0.0f)
			{
				float2 D = TorusDelta(MyUV, Cand);
				float DistSq = dot(D, D);
				if (DistSq < BestDistSq)
				{
					BestDistSq = DistSq;
					BestSeed = Cand;
				}
			}
		}
	}

	OutHeightSeeds[P] = BestSeed;

#elif MOSS_STAGE == 10
	// Stage 10: Resolve Signed Interior Distance & Raw Cushion Envelope
	int2 P = int2(DispatchThreadId.xy);
	if (any(P >= SimulationSize)) { return; }

	float2 MyUV = (float2(P) + 0.5f) / float2(SimulationSize);
	float2 BestSeed = HeightSeeds.Load(int3(P, 0));
	float2 Chem = Chemical.Load(int3(P, 0));
	float4 State = GrowthState.Load(int3(P, 0));
	bool bInside = Chem.y >= 0.20f;

	float Dist = 0.0f;
	if (BestSeed.x >= 0.0f)
	{
		Dist = length(TorusDelta(MyUV, BestSeed));
	}
	float SignedDist = bInside ? Dist : -Dist;
	OutGrowthInteriorDistance[P] = SignedDist;

	float Span = max(CushionSize, 0.003f);
	float InteriorU = saturate(max(0.0f, SignedDist) / Span);
	float DomePower = lerp(0.42f, 0.88f, saturate(Softness));
	float Dome = pow(sin(InteriorU * 1.5707963f), DomePower);
	OutCushionInflation[P] = float2(Dome * smoothstep(0.08f, 0.35f, Chem.y), State.y);

#elif MOSS_STAGE == 11
	// Stage 11: Smooth Cushion Envelope on Simulation Grid
	int2 P = int2(DispatchThreadId.xy);
	if (any(P >= SimulationSize)) { return; }

	const int2 Offsets[9] = {
		int2(0, 0), int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1),
		int2(-1, -1), int2(1, -1), int2(-1, 1), int2(1, 1)
	};
	const float Weights[9] = {
		0.24f, 0.12f, 0.12f, 0.12f, 0.12f,
		0.07f, 0.07f, 0.07f, 0.07f
	};

	float2 Acc = float2(0.0f, 0.0f);
	[unroll]
	for (int I = 0; I < 9; ++I)
	{
		Acc += CushionInflation.Load(int3(WrapSim(P + Offsets[I]), 0)) * Weights[I];
	}
	OutCushionInflation[P] = Acc;

#elif MOSS_STAGE == 5
	// Stage 5: Full-Resolution Coverage, Age, RegionIds & HabitatColony Resolve
	int2 P = int2(DispatchThreadId.xy);
	if (any(P >= OutputSize)) { return; }

	float2 DestinationUV = (float2(P) + 0.5f) / float2(OutputSize);
	float2 UV = MixtormatGeneratorUV(DestinationUV);

	float2 Chem = Chemical.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f);
	float4 State = GrowthState.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f);
	float4 ActHab = ActivationHabitat.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f);

	// Nearest simulation texel for crisp colony root identity
	int2 SimP = WrapSim(int2(frac(DestinationUV) * float2(SimulationSize)));
	float4 NearestState = GrowthState.Load(int3(SimP, 0));
	int2 RootIdCoord = int2(round(frac(NearestState.zw) * 4096.0f));
	uint ColonyId = (Hash21(RootIdCoord, 307u) & 0x00fffffeu) | 1u;

	// Pioneer spore splatter & dithered edge breakup at full output resolution
	int Cells = max(1, ColonyDensity);
	float3 EdgeFbm;
	MixtormatNoiseFbm(UV, max(12, Cells * 3), 3, 0.5f, 2.0f, Seed + 911u, EdgeFbm.x, EdgeFbm.yz);
	FMixtormatNoiseWorley MicroWorley = MixtormatNoiseV2Worley(UV, max(32, Cells * 5), Seed + 977u, 1.0f, 0);
	float SporeSpeckle = saturate(1.0f - MicroWorley.F1 * lerp(2.85f, 1.40f, saturate(Splatter)));

	float BaseCover = smoothstep(0.14f, 0.36f, Chem.y + EdgeFbm.x * 0.08f * saturate(Splatter));
	float HaloZone = smoothstep(0.03f, 0.28f, Chem.y + ActHab.w * 0.22f) * (1.0f - BaseCover * 0.65f);
	float SplatterCover = SporeSpeckle * HaloZone * saturate(Splatter);

	float CrustoseMask = saturate(HaloZone * (0.45f + 0.55f * SporeSpeckle));
	float EffectiveCover = saturate(max(BaseCover, SplatterCover));
	float Age = saturate((1.0f - State.x) * EffectiveCover);

	OutHabitatColony[P] = float4(ActHab.y, CrustoseMask, float(ColonyId & 0x3ffu) / 1023.0f, State.y);
	OutGrowthCoverage[P] = EffectiveCover;
	OutGrowthAge[P] = Age;
	OutGrowthIds[P] = EffectiveCover > 0.02f ? ColonyId : 0u;

#elif MOSS_STAGE == 2
	// Stage 2: Full-Resolution Multi-Scale Cushion & Hummock Synthesis
	int2 P = int2(DispatchThreadId.xy);
	if (any(P >= OutputSize)) { return; }

	float2 DestinationUV = (float2(P) + 0.5f) / float2(OutputSize);
	float2 UV = MixtormatGeneratorUV(DestinationUV);

	float2 Inflation = CushionInflation.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f);
	float Sdf = GrowthInteriorDistance.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f);
	float4 HabCol = HabitatColony.Load(int3(P, 0));
	float CrustoseMask = HabCol.y;
	float Biomass = HabCol.w;

	// Sub-cushion hummock pillows (Worley F1/F2 domes + FBM warp)
	float SubPillow = 1.0f;
	if (ClumpDensity > 0.5f)
	{
		int ClumpCells = max(2, int(round(ClumpDensity)));
		float3 WarpNoise;
				MixtormatNoiseFbm(UV, max(2, ClumpCells / 2), 2, 0.5f, 2.0f, Seed + 601u, WarpNoise.x, WarpNoise.yz);
		float2 WarpedUV = frac(UV + float2(WarpNoise.y, WarpNoise.z) * (0.18f / float(ClumpCells)));
		FMixtormatNoiseWorley W = MixtormatNoiseV2Worley(WarpedUV, ClumpCells, Seed + 643u, 0.92f, 0);
		float Cleft = smoothstep(0.0f, lerp(0.30f, 0.72f, saturate(Softness)), W.F2 - W.F1);
		float Crown = sqrt(saturate(1.0f - W.F1 * W.F1 * 1.15f));
		float PillowProfile = lerp(Crown, 1.0f, saturate(Softness) * 0.55f) * lerp(0.32f, 1.0f, Cleft);
		SubPillow = lerp(1.0f, PillowProfile, saturate(ClumpDensity / 24.0f));
	}

	// Multi-scale thickness variation (controlled by MatureHeight = Thickness Variation)
	int Cells = max(1, ColonyDensity);
	float3 ThickFbm;
		MixtormatNoiseFbm(UV, max(3, Cells), 4, 0.5f, 2.0f, Seed + 733u, ThickFbm.x, ThickFbm.yz);
	float ThickMod = lerp(1.0f, saturate(0.55f + 0.55f * ThickFbm.x) * (0.45f + 0.75f * Biomass), saturate(MatureHeight));

	// GrowthForm habit scale: CreepingMat (2) and Feather (3) form flatter carpets, Cushion (0) forms plump domes
	float HabitBulkScale = (GrowthForm == 2u) ? 0.36f : ((GrowthForm == 3u) ? 0.46f : 1.0f);

	// Turgor swelling from Hydration & Plumpness
	float Turgor = 1.0f + saturate(Plumpness) * (0.40f * saturate(Hydration) + 0.20f * HabCol.x);

	// Pioneer spore micro-tufts around margins
	FMixtormatNoiseWorley SporeW = MixtormatNoiseV2Worley(UV, max(24, Cells * 4), Seed + 829u, 1.0f, 0);
	float SporeTuft = saturate(1.0f - SporeW.F1 * 2.2f) * CrustoseMask * saturate(Splatter);

	float CushionBulk = (Inflation.x * SubPillow * ThickMod + SporeTuft * 0.28f)
		* CushionHeight * HabitBulkScale * Turgor;

	OutMesoHeight[P] = max(0.0f, CushionBulk);

#elif MOSS_STAGE == 3
	// Stage 3: Full-Resolution Micro-Shoot & Leaf Relief Assembly ( Plus Diagnostic Previews)
	int2 P = int2(DispatchThreadId.xy);
	if (any(P >= OutputSize)) { return; }

	float2 DestinationUV = (float2(P) + 0.5f) / float2(OutputSize);

	if (Preview != 0u)
	{
		float2 Chem = Chemical.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f);
		float4 State = GrowthState.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f);
		float4 ActHab = ActivationHabitat.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f);
		float Sdf = GrowthInteriorDistance.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f);
		float Diag = 0.0f;
		if (Preview == 1u) Diag = Chem.x;
		else if (Preview == 2u) Diag = Chem.y;
		else if (Preview == 3u) Diag = ActHab.x;
		else if (Preview == 4u) Diag = 1.0f - State.x;
		else if (Preview == 5u) Diag = exp(-abs(Sdf) * 60.0f);
		else if (Preview == 6u) Diag = State.y;
		OutGrowthHeight[P] = Diag;
		return;
	}

	float Cover = GrowthCoverage.Load(int3(P, 0));
	float Meso = MesoCushionHeight.Load(int3(P, 0));
	float4 HabCol = HabitatColony.Load(int3(P, 0));
	float CrustoseMask = HabCol.y;

	float ShootRelief = 0.0f;
	if (Cover > 0.005f && ShootLength > 0.001f)
	{
		FMossLeafSurface Leaf = MossLeafSurface(DestinationUV);
		ShootRelief = Leaf.Height * ShootLength * 0.048f * lerp(0.35f, 1.0f, saturate(Cover * 1.4f - CrustoseMask * 0.5f));
	}

	float CrustoseRelief = CrustoseMask * 0.005f * saturate(Splatter);
	OutGrowthHeight[P] = (Meso + ShootRelief + CrustoseRelief) * Cover;

#elif MOSS_STAGE == 12
	// Stage 12: Rich Multi-Scale Albedo, Roughness & 3D Cushion/Leaf Normal Synthesis
	int2 P = int2(DispatchThreadId.xy);
	if (any(P >= OutputSize)) { return; }

	float2 DestinationUV = (float2(P) + 0.5f) / float2(OutputSize);
	float2 UV = MixtormatGeneratorUV(DestinationUV);

	float Cover = GrowthCoverage.Load(int3(P, 0));
	float Age = GrowthAge.Load(int3(P, 0));
	uint ColonyId = GrowthIds.Load(int3(P, 0));
	float Meso = MesoCushionHeight.Load(int3(P, 0));
	float4 State = GrowthState.SampleLevel(LinearWrapSampler, DestinationUV, 0.0f);

	FMossLeafSurface Leaf = (FMossLeafSurface)0;
	if (Cover > 0.005f)
	{
		Leaf = MossLeafSurface(DestinationUV);
	}

	int Cells = max(1, ColonyDensity);
	float3 BroadPigment;
	MixtormatNoiseFbm(UV, max(3, Cells / 2), 4, 0.5f, 2.0f, Seed + 1103u, BroadPigment.x, BroadPigment.yz);
	float3 MesoPigment;
	MixtormatNoiseFbm(UV, max(10, Cells * 2), 3, 0.5f, 2.0f, Seed + 1217u, MesoPigment.x, MesoPigment.yz);
	float ColonyHash = float((ColonyId >> 3u) & 0x3ffu) / 1023.0f;

	// Colony identity sampled at the colony root UV: GrowthState is bilinear,
	// so neighbouring colonies feather across their border over a few
	// simulation texels instead of meeting at a hard ID seam. The discrete
	// hash only seasons this continuous field, it no longer drives it.
	float3 RootPigment;
	MixtormatNoiseFbm(frac(State.zw), max(3, Cells / 2), 3, 0.5f, 2.0f, Seed + 1103u, RootPigment.x, RootPigment.yz);
	float ColonyField = saturate(0.5f + RootPigment.x * 0.85f + (ColonyHash - 0.5f) * 0.35f);
	float ColonyShift = ((BroadPigment.x * 0.55f + MesoPigment.x * 0.25f)
		+ (ColonyField - 0.5f) * 0.55f) * saturate(ColonyVariation);
	float ShootShift = Leaf.Variation * saturate(LeafVariation) * 0.65f;

	float NormCushion = saturate(Meso / max(CushionHeight * 0.85f, 0.02f));
	float CrownLift = lerp(0.26f, 0.74f, NormCushion);
	float LivingTip = Leaf.Tip * (1.0f - Leaf.Damaged) * saturate(TipColor) * (0.45f + 0.55f * NormCushion);
	float ThinEdge = saturate(1.0f - Cover * 1.6f);

	// Fine per-leaf grain so adjacent winner leaves intermix tonally
	// instead of tiling flat per-shoot colours.
	float3 FinePigment;
	MixtormatNoiseFbm(UV, max(48, Cells * 6), 2, 0.5f, 2.0f, Seed + 1319u, FinePigment.x, FinePigment.yz);
	float RampT = saturate(CrownLift + ColonyShift + ShootShift + LivingTip * 0.55f
		- ThinEdge * 0.25f + FinePigment.x * 0.10f * saturate(LeafVariation));
	float3 Albedo = MixtormatEvalColorRamp(
		RampT, ColorRampCount, ColorRampInterpolation, ColorRampPositions, ColorRampColors).rgb;

	// Two-axis palette: RampT is the light axis (base -> body -> tip); the
	// colony field is the hue axis, mixing deep-emerald and warm yellow-green
	// ramp readings of the same authored palette. No post-ramp RGB scaling.
	float3 DeepAlbedo = MixtormatEvalColorRamp(
		saturate(RampT * 0.68f), ColorRampCount, ColorRampInterpolation, ColorRampPositions, ColorRampColors).rgb;
	float3 WarmAlbedo = MixtormatEvalColorRamp(
		saturate(RampT + 0.20f), ColorRampCount, ColorRampInterpolation, ColorRampPositions, ColorRampColors).rgb;
	float3 ColonyVariant = lerp(DeepAlbedo, WarmAlbedo, ColonyField);
	Albedo = lerp(Albedo, ColonyVariant, 0.15f + 0.45f * saturate(ColonyVariation));

	// Pioneer protonema film at thin colony edges: yellow-green, no relief.
	float3 Protonema = MixtormatEvalColorRamp(
		0.72f, ColorRampCount, ColorRampInterpolation, ColorRampPositions, ColorRampColors).rgb;
	Albedo = lerp(Albedo, Protonema, ThinEdge * saturate(Splatter) * 0.25f);

	// Deep inter-cushion clefts darken toward the humus/rhizoid base.
	float CleftDarkening = saturate((1.0f - NormCushion) * 0.62f + ThinEdge * 0.55f);
	Albedo = lerp(Albedo, MOSS_HUMUS_BASE * (0.8f + 0.45f * saturate(0.5f + MesoPigment.x)), CleftDarkening * 0.42f);

	// Older interior browns while living tips stay green (audit board 11);
	// browning rises with Age, the previous (1-Age) term inverted this.
	float OlderInterior = saturate(Age * 1.15f) * (1.0f - NormCushion);
	Albedo = lerp(Albedo, MOSS_HUMUS_BASE * 1.6f,
		OlderInterior * 0.38f * (1.0f - LivingTip));

	// Senescent shoots: varied golden-brown, feathered by meso pigment so
	// damaged and living shoots grade into each other; tips resist browning.
	float3 DeadColor = MOSS_DEAD_BROWN * (0.75f + 0.50f * saturate(0.5f + MesoPigment.x));
	float DamageWeight = saturate(Leaf.Damaged * 0.80f
		+ saturate(Damage) * (0.25f + 0.75f * Age) * 0.45f
		+ MesoPigment.x * saturate(Damage) * 0.10f) * (1.0f - LivingTip * 0.60f);
	Albedo = lerp(Albedo, DeadColor, DamageWeight);

	// Hydration is a colour state too (board 09): dry moss desaturates
	// toward olive, hydrated moss gains saturation. Wet film stays separate.
	float Luminance = dot(Albedo, float3(0.333f, 0.333f, 0.333f));
	float3 DryAlbedo = lerp(float3(Luminance, Luminance, Luminance), Albedo, 0.72f)
		* float3(1.06f, 1.02f, 0.82f);
	Albedo = lerp(Albedo, DryAlbedo, (1.0f - saturate(Hydration)) * 0.38f);
	Albedo = lerp(float3(Luminance, Luminance, Luminance), Albedo,
		1.0f + saturate(Hydration) * 0.12f);

	// Surface wetness & hydration darkening
	float LocalWetness = saturate(SurfaceWetness * (0.70f + 0.30f * (1.0f - NormCushion)));
	Albedo *= lerp(1.0f, 0.52f, LocalWetness * saturate(WetDarkening));

	float Rough = lerp(DryRoughness, WetRoughness, LocalWetness);
	Rough = saturate(Rough + (Leaf.Damaged * 0.08f - Leaf.Tip * 0.05f) * saturate(LeafVariation)
		+ OlderInterior * 0.05f + (1.0f - saturate(Hydration)) * 0.05f);

	// Full 3D Moss Normal (Cushion Dome + Clump Hummocks + 3D Leaf Blades + Granular Crust)
	float2 OutTexel = 1.0f / float2(max(OutputSize, int2(1, 1)));
	float MX = MesoCushionHeight.SampleLevel(LinearWrapSampler, DestinationUV + float2(OutTexel.x, 0.0f), 0.0f)
		- MesoCushionHeight.SampleLevel(LinearWrapSampler, DestinationUV - float2(OutTexel.x, 0.0f), 0.0f);
	float MY = MesoCushionHeight.SampleLevel(LinearWrapSampler, DestinationUV + float2(0.0f, OutTexel.y), 0.0f)
		- MesoCushionHeight.SampleLevel(LinearWrapSampler, DestinationUV - float2(0.0f, OutTexel.y), 0.0f);
	float2 CushionSlope = -float2(MX, MY) * float2(OutputSize) * 1.45f;

	float3 GranularNoise;
		MixtormatNoiseFbm(UV, max(48, Cells * 6), 2, 0.5f, 2.0f, Seed + 1451u, GranularNoise.x, GranularNoise.yz);
	float2 GranularSlope = float2(GranularNoise.y, GranularNoise.z) * (0.28f * (0.35f + 0.65f * ThinEdge));

	float2 LeafSlope = Leaf.ResidualSlope * lerp(0.75f, 2.15f, saturate(ShootLength));

	float2 CombinedSlope = (CushionSlope + LeafSlope + GranularSlope) * NormalStrength * saturate(Cover * 1.5f);
	float3 N = normalize(float3(CombinedSlope.x, CombinedSlope.y, 1.0f));

	OutMossColor[P] = float4(saturate(Albedo), 1.0f);
	OutMossRoughness[P] = Rough;
	OutMossRAM[P] = float4(Rough, 1.0f, 0.0f, 0.04f);
	OutMossNormal[P] = float4(N * 0.5f + 0.5f, 1.0f);

#elif MOSS_STAGE == 13
	// Stage 13: Canopy Support Envelope Resolve
	int2 P = int2(DispatchThreadId.xy);
	if (any(P >= OutputSize)) { return; }

	float H = ScaledMossHeight.Load(int3(P, 0));
	OutGrowthHeight[P] = H;
#else
	// Unused stage slot
#endif
}
